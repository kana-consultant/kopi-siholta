---
// Client-side language detection with branded loader
// Shows a loader animation while detecting user language and redirecting
import { Icon } from 'astro-icon/components';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kopi Siholta — Loading…</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <style>
      /* ── Reset ──────────────────────────────── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      /* ── Loader page ─────────────────────────── */
      .page-loader {
        min-height: 100dvh;
        background: #F9F6F0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }

      /* ── Coffee bean icon ────────────────────── */
      @keyframes loaderFloat {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50%       { transform: translateY(-6px) rotate(8deg); }
      }

      .page-loader__bean { animation: loaderFloat 3s ease-in-out infinite; }

      @media (prefers-reduced-motion: reduce) {
        .page-loader__bean { animation: none; }
      }

      /* ── Spinner ─────────────────────────────── */
      @keyframes loaderSpin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
      }

      .page-loader__spinner svg {
        animation: loaderSpin 0.9s linear infinite;
        transform-origin: 20px 20px;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-loader__spinner svg { animation: none; }
      }

      /* ── Brand text ──────────────────────────── */
      .page-loader__brand {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #CD1222;
        margin-top: 4px;
      }

      /* ── Redirect text + dot ─────────────────── */
      @keyframes loaderDotPulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(0.7); }
      }

      .page-loader__text {
        font-size: 13px;
        color: rgba(92, 61, 30, 0.50);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .page-loader__text::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #CD1222;
        animation: loaderDotPulse 1.4s ease-in-out infinite;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-loader__text::before { animation: none; }
      }

      /* ── Fade-out transition ─────────────────── */
      .page-loader.fade-out {
        opacity: 0;
        transform: scale(0.97);
        transition: opacity 400ms ease, transform 400ms ease;
        pointer-events: none;
      }
    </style>
  </head>
  <body>

    <div class="page-loader" id="page-loader" role="status" aria-label="Loading Kopi Siholta" aria-live="polite">

      <!-- Floating coffee bean -->
      <div class="page-loader__bean" aria-hidden="true">
        <Icon name="mdi:coffee" width="52" height="52" />
      </div>

      <!-- Spinning arc -->
      <div class="page-loader__spinner" aria-hidden="true">
        <Icon name="mdi:loading" width="42" height="42" />
      </div>

      <!-- Brand name -->
      <p class="page-loader__brand">Kopi Siholta</p>

      <!-- Redirect text -->
      <p class="page-loader__text">Redirecting to your language page…</p>

    </div>

    <script>
      const DEFAULT_LOCALE   = 'en';
      const INDONESIA_LOCALE = 'id';
      const FRANCE_LOCALE    = 'fr';

      async function detectLocale(): Promise<string> {
        // 1. Check stored preference
        const stored = sessionStorage.getItem('ksi_locale');
        if (stored && ['id','en','fr'].includes(stored)) return stored;

        // 2. France via timezone + navigator language
        const frTz = ['Europe/Paris','Europe/Monaco','Europe/Andorra',
                       'Europe/Luxembourg','Europe/Switzerland','Europe/Belgium','Europe/Netherlands'];
        const tz    = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const lang2 = (navigator.language || '').slice(0, 2).toLowerCase();

        if (frTz.includes(tz) || lang2 === 'fr') return FRANCE_LOCALE;

        // 3. Indonesia via IP geolocation
        try {
          const res = await fetch('https://ipapi.co/json/', { cache: 'no-store' });
          if (res.ok) {
            const d = await res.json();
            const c  = (d.country_name || '').toLowerCase();
            if (c === 'indonesia' || c === 'republic of indonesia') return INDONESIA_LOCALE;
          }
        } catch (_) {}

        // 4. Browser language fallback
        if (lang2 === 'id') return INDONESIA_LOCALE;
        return DEFAULT_LOCALE;
      }

      async function redirect() {
        const screen = document.getElementById('page-loader');
        const locale = await detectLocale();

        sessionStorage.setItem('ksi_locale', locale);

        // Fade out then redirect
        screen?.classList.add('fade-out');
        setTimeout(() => {
          window.location.replace(`/${locale}/`);
        }, 450);
      }

      redirect();
    </script>
  </body>
</html>