---
import '../styles/partnerships.css';
import { Icon } from 'astro-icon/components';
import { Image } from "astro:assets";
import "@/styles/page.css";
import "@/styles/components/stats.css";

import logoHypermart from "@/images/logo/logo-hypermart.webp";
import logoHyfresh from "@/images/logo/logo-hyfresh.png";
import logoAngkasaPura from "@/images/logo/logo-angkasapura.png";
import logoSendys from "@/images/logo/logo-sendys.png";
import logoPrimo from "@/images/logo/logo-primo.png";
import logoSvetofor from "@/images/logo/logo-svetofor.png";
import logoAeki from "@/images/logo/logo-aeki.webp";
import logoAski from "@/images/logo/logo-aski.png";
import logoScai from "@/images/logo/SCAI logo.webp";

import imgGreenBeans from "@/images/partnerships/green-beans.jpg";
import imgProcess from "@/images/farming/process (2).jpg";
import imgCoffeeBeans from "@/images/fnb/caffee.jpg";

interface TrustStat { value: string; label: string; }
interface SolutionCard { alt: string; title: string; tagline: string; body: string; chips: string[]; }
interface BenefitItem { title: string; body: string; }
interface CTA { title: string; subtitle: string; primary: string; }

interface Props {
  titleLine1: string;
  subtitle: string;
  socialProof: string;
  trustStats: TrustStat[];
  cards: SolutionCard[];
  benefits: { headline: string; sub: string; items: BenefitItem[]; };
  cta: CTA;
  lang?: string;
}

const { titleLine1, subtitle, socialProof, trustStats, cards, benefits, cta, lang = 'en' } = Astro.props;

const solutionImages = [imgProcess, imgGreenBeans, imgCoffeeBeans];

const logos = [
  logoHypermart, logoHyfresh, logoAngkasaPura,
  logoSendys, logoPrimo, logoSvetofor,
  logoAeki, logoAski, logoScai,
];
---

<section class="b2b section" id="b2b" aria-labelledby="b2b-heading">
  <div class="container">
    <header class="b2b__header reveal">
      <h2 id="b2b-heading" class="b2b__title">{titleLine1}</h2>
      <p class="b2b__subtitle">{subtitle}</p>
    </header>

    <ul class="partnerships__trust-strip reveal" role="list">
      {trustStats.map((stat) => (
        <li class="trust-stat">
          <span class="trust-stat__value">{stat.value}</span>
          <span class="trust-stat__label">{stat.label}</span>
        </li>
      ))}
    </ul>

    <div
      class="partnerships__logo-cloud reveal"
      aria-label="Our Trusted Partners"
    >
      <div class="logo-cloud__track">
        <div class="logo-cloud__track-inner">
          {logos.map((logo) => (
            <div class="logo-cloud__item">
              <Image src={logo} alt="" height={400} quality="max" class="logo-cloud__img" />
            </div>
          ))}
        </div>

        <div class="logo-cloud__track-inner" aria-hidden="true">
          {logos.map((logo) => (
            <div class="logo-cloud__item">
              <Image src={logo} alt="" height={400} quality="max" class="logo-cloud__img" />
            </div>
          ))}
        </div>
      </div>
      <p class="logo-cloud__proof">{socialProof}</p>
    </div>

    <div class="solutions-grid">
      {
        cards.map((card, i) => (
          <article
            class={`solution-card solution-card--${i === 0 ? 'highlight' : 'cream'} reveal`}
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="solution-card__media">
              <Image
                src={solutionImages[i]}
                alt={card.alt}
                width={400}
                height={250}
                quality={80}
                class="solution-card__image"
                loading="lazy"
              />
            </div>
            <div class="solution-card__content">
              <h3 class="solution-card__headline">{card.title}</h3>
              <p class="solution-card__tagline">{card.tagline}</p>
              <p class="solution-card__body">{card.body}</p>
              <div class="solution-card__chips">
                {card.chips.map((chip) => (
                  <span class="spec-chip">{chip}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="benefits-strip reveal">
      <div class="benefits-headline-wrap">
        <h3 class="benefits-headline">{benefits.headline}</h3>
        <p class="benefits-sub">{benefits.sub}</p>
      </div>
      <ul class="benefit-list" role="list">
        {
          benefits.items.map((b, i) => (
            <li class="benefit-item" style={`transition-delay: ${i * 80}ms`}>
              <Icon name="mdi:checkbox-marked" width={24} height={24} class="benefit-item__check" aria-hidden="true" />
              <div>
                <h4 class="benefit-item__title">{b.title}</h4>
                <p class="benefit-item__body">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <section class="page-cta page-cta--cream" aria-label={cta.title}>
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{cta.title}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{cta.subtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/homepage/#contact`} class="btn btn--primary"
          >{cta.primary}</a
        >
      </div>
    </div>
  </section>
</section>
<script>
  function initAnimations() {
    const targets = document.querySelectorAll<HTMLElement>(
      ".reveal, .animate-on-scroll",
    );

    if (!targets.length) return;

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const isCta =
                entry.target.classList.contains("animate-on-scroll");
              entry.target.classList.add(isCta ? "is-visible" : "visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: "0px 0px -20px 0px" },
      );

      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => {
        const isCta = el.classList.contains("animate-on-scroll");
        el.classList.add(isCta ? "is-visible" : "visible");
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initAnimations);
  document.addEventListener("astro:page-load", initAnimations);

  initAnimations();
</script>
