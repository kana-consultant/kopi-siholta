---
import '@/pages/[lang]/homepage/styles/partnerships.css';
import { Icon } from 'astro-icon/components';
import { Image } from "astro:assets";
import "@/styles/page.css";
import "@/styles/components/stats.css";

import logoHypermart from "@/images/logo/logo-hypermart.webp";
import logoHyfresh from "@/images/logo/logo-hyfresh.png";
import logoAngkasaPura from "@/images/logo/logo-angkasapura.png";
import logoSendys from "@/images/logo/logo-sendys.png";
import logoPrimo from "@/images/logo/logo-primo.png";
import logoSvetofor from "@/images/logo/logo-svetofor.png";
import logoAeki from "@/images/logo/logo-aeki.webp";
import logoAski from "@/images/logo/logo-aski.png";
import logoScai from "@/images/logo/SCAI logo.webp";

import imgGreenBeans from "@/images/partnerships/green-beans.jpg";
import imgProcess from "@/images/farming/process (2).jpg";
import imgCoffeeBeans from "@/images/fnb/caffee.jpg";

import { getTranslations } from '@/i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);

const solutions = [
  {
    id: "modern-retail",
    image: imgProcess,
    imageAlt: t.b2b.cardModernRetailImageAlt,
    headline: t.b2b.cardModernRetailTitle,
    tagline: t.b2b.cardModernRetailTagline,
    body: t.b2b.cardModernRetailBody,
    chips: [
      t.b2b.chipModernRetailReady,
      t.b2b.chipDistribusi,
      t.b2b.chipDocComplete,
    ],
    variant: "highlight",
  },
  {
    id: "green-bean",
    image: imgGreenBeans,
    imageAlt: t.b2b.cardGreenBeanImageAlt,
    headline: t.b2b.cardGreenBeanTitle,
    tagline: t.b2b.cardGreenBeanTagline,
    body: t.b2b.cardGreenBeanBody,
    chips: [t.b2b.chipLintong, t.b2b.chipRobusta, t.b2b.chipExport],
    variant: "cream",
  },
  {
    id: "franchise",
    image: imgCoffeeBeans,
    imageAlt: t.b2b.cardFranchiseImageAlt,
    headline: t.b2b.cardFranchiseTitle,
    tagline: t.b2b.cardFranchiseTagline,
    body: t.b2b.cardFranchiseBody,
    chips: [
      t.b2b.chipFranchiseSupport,
      t.b2b.chipBaristaTraining,
      t.b2b.chipBranding,
    ],
    variant: "cream",
  },
];

const benefits = [
  { title: t.b2b.benefit1Title, body: t.b2b.benefit1Body },
  { title: t.b2b.benefit2Title, body: t.b2b.benefit2Body },
  { title: t.b2b.benefit3Title, body: t.b2b.benefit3Body },
  { title: t.b2b.benefit4Title, body: t.b2b.benefit4Body },
];
---

<section class="b2b section" id="b2b" aria-labelledby="b2b-heading">
  <div class="container">
    <header class="b2b__header reveal">
      <h2 id="b2b-heading" class="b2b__title">{t.b2b.titleLine1}</h2>
      <p class="b2b__subtitle">{t.b2b.subtitle}</p>
    </header>

    <ul class="partnerships__trust-strip reveal" role="list">
      <li class="trust-stat">
        <span class="trust-stat__value">{t.b2b.stat1Value}</span>
        <span class="trust-stat__label">{t.b2b.stat1Label}</span>
      </li>
      <li class="trust-stat">
        <span class="trust-stat__value">{t.b2b.stat2Value}</span>
        <span class="trust-stat__label">{t.b2b.stat2Label}</span>
      </li>
      <li class="trust-stat">
        <span class="trust-stat__value">{t.b2b.stat3Value}</span>
        <span class="trust-stat__label">{t.b2b.stat3Label}</span>
      </li>
    </ul>

    <div
      class="partnerships__logo-cloud reveal"
      aria-label="Our Trusted Partners"
    >
      <div class="logo-cloud__track">
        <div class="logo-cloud__track-inner">
          <div class="logo-cloud__item">
            <Image src={logoHypermart} alt="Hypermart" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoHyfresh} alt="Hyfresh" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoAngkasaPura} alt="Angkasa Pura" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoSendys} alt="Sendys" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoPrimo} alt="Primo" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoSvetofor} alt="Svetofor" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoAeki} alt="AEKI" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoAski} alt="ASKI" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoScai} alt="SCAI" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
        </div>

        <div class="logo-cloud__track-inner" aria-hidden="true">
          <div class="logo-cloud__item">
            <Image src={logoHypermart} alt="Hypermart" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoHyfresh} alt="Hyfresh" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoAngkasaPura} alt="Angkasa Pura" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoSendys} alt="Sendys" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoPrimo} alt="Primo" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoSvetofor} alt="Svetofor" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoAeki} alt="AEKI" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoAski} alt="ASKI" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
          <div class="logo-cloud__item">
            <Image src={logoScai} alt="SCAI" height={400} quality="max" class="logo-cloud__img" /> 
          </div>
        </div>
      </div>
      <p class="logo-cloud__proof">{t.b2b.socialProof}</p>
    </div>

    <div class="solutions-grid">
      {
        solutions.map((s, i) => (
          <article
            class={`solution-card solution-card--${s.variant} reveal`}
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="solution-card__media">
              <Image
                src={s.image}
                alt={s.imageAlt}
                width={400}
                height={250}
                quality={80}
                class="solution-card__image"
                loading="lazy"
              />
            </div>
            <div class="solution-card__content">
              <h3 class="solution-card__headline">{s.headline}</h3>
              <p class="solution-card__tagline">{s.tagline}</p>
              <p class="solution-card__body">{s.body}</p>
              <div class="solution-card__chips">
                {s.chips.map((chip) => (
                  <span class="spec-chip">{chip}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="benefits-strip reveal">
      <div class="benefits-headline-wrap">
        <h3 class="benefits-headline">{t.b2b.benefitsHeadline}</h3>
        <p class="benefits-sub">{t.b2b.benefitsSub}</p>
      </div>
      <ul class="benefit-list" role="list">
        {
          benefits.map((b, i) => (
            <li class="benefit-item" style={`transition-delay: ${i * 80}ms`}>
              <Icon name="mdi:checkbox-marked" width={24} height={24} class="benefit-item__check" aria-hidden="true" />
              <div>
                <h4 class="benefit-item__title">{b.title}</h4>
                <p class="benefit-item__body">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <section class="page-cta page-cta--cream" aria-label={t.b2b.ctaBanner}>
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{t.b2b.ctaTitle}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{t.b2b.ctaSubtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary"
          >{t.b2b.ctaPrimary}</a
        >
      </div>
    </div>
  </section>
</section>
<script>
  function initAnimations() {
    const targets = document.querySelectorAll<HTMLElement>(
      ".reveal, .animate-on-scroll",
    );

    if (!targets.length) return;

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const isCta =
                entry.target.classList.contains("animate-on-scroll");
              entry.target.classList.add(isCta ? "is-visible" : "visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: "0px 0px -20px 0px" },
      );

      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => {
        const isCta = el.classList.contains("animate-on-scroll");
        el.classList.add(isCta ? "is-visible" : "visible");
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initAnimations);
  document.addEventListener("astro:page-load", initAnimations);

  initAnimations();
</script>
