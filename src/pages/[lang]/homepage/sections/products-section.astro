---
import { Image } from 'astro:assets';
import '../styles/products.css';

import arabicaBubuk250 from '@/images/products/arabica-bubuk-250g.webp';
import arabicaBubuk70 from '@/images/products/arabica-bubuk-70g.webp';
import arabicaRosbeans70 from '@/images/products/arabica-rosbeans70g.webp';
import arabicaKapsul70 from '@/images/products/arabica-kapsul-70g.webp';
import robustaBubuk250 from '@/images/products/robusta-bubuk-250g.webp';
import robustaBubuk70 from '@/images/products/robusta-bubuk-70g.webp';
import robustaRosbeans70 from '@/images/products/robusta-rosbeans-70g.webp';
import robustaKapsul70 from '@/images/products/robusta-kapsul-70g.webp';
import shopeeLogo from '@/images/logo/logo-shopee.png';
import tokopediaLogo from '@/images/logo/logo-tokopedia.png';
import halalLogo from '@/images/logo/logo-halal.png';
import bpomLogo from '@/images/logo/logo-bpom.png';

interface ProductItem {
  name: string;
  desc: string;
  tag: string;
  tagVariant: 'bestSeller' | 'valuePack' | 'signature' | 'baristaChoice' | 'popular';
}

interface Cert { name: string; desc: string; }

interface Props {
  title: string;
  subtitle: string;
  items: ProductItem[];
  labels: {
    productDetails: string;
    tersediaDi: string;
    viewCompany: string;
  };
  certs: Cert[];
}

const { title, subtitle, items, labels, certs } = Astro.props;

const images = [
  arabicaBubuk250, arabicaBubuk70, arabicaRosbeans70, arabicaKapsul70,
  robustaBubuk250, robustaBubuk70, robustaRosbeans70, robustaKapsul70,
];

const tagBgMap: Record<string, string> = {
  bestSeller: '#CD1222',
  valuePack: '#5C3D1E',
  signature: '#8B5E3C',
  baristaChoice: '#1E508C',
  popular: '#CD1222',
};

const tokpedLinks = [
  'https://tk.tokopedia.com/ZSxWcQ8Yw/', 'https://tk.tokopedia.com/ZSxWcQTDw/',
  'https://tk.tokopedia.com/ZSxWcQqm4/', 'https://tk.tokopedia.com/ZSxWcaqpU/',
  'https://tk.tokopedia.com/ZSxWcP817/', 'https://tk.tokopedia.com/ZSxWcKGep/',
  'https://tk.tokopedia.com/ZSxW3YW7c/', 'https://tk.tokopedia.com/ZSxWcaqpU/',
];
const shopeeLinks = [
  'https://s.shopee.co.id/7pqW1w7KIL', 'https://s.shopee.co.id/6AiI2wH4dj',
  'https://s.shopee.co.id/2LVZTvUzqv', 'https://s.shopee.co.id/W3vIce8om',
  'https://s.shopee.co.id/5q5RfpFHn7', 'https://s.shopee.co.id/W3vJzWChs',
  'https://s.shopee.co.id/AAEQoR8FPK', 'https://s.shopee.co.id/W3vIce8om',
];

const certLogos = [bpomLogo, halalLogo];
---

<section id="products" class="products-section">
  <div class="container">
    <div class="products-header">
      <h2 class="section-title">{title}</h2>
      <p class="section-subtitle">{subtitle}</p>
    </div>

    <div class="products-grid">
      {items.map((item, i) => (
        <article class="product-card">
          <div class="product-image-wrap">
            <Image
              src={images[i]}
              alt={item.name}
              width={480}
              height={480}
              class="product-image"
              loading={i < 4 ? 'eager' : 'lazy'}
            />
            <div class="image-gradient" />

            <span class="product-tag" style={`--tag-bg: ${tagBgMap[item.tagVariant]}`}>
              {item.tag}
            </span>
          </div>

          <div class="product-body">
            <div class="product-info">
              <h3 class="product-name">{item.name}</h3>
            </div>
          </div>

          <div class="product-reveal">
            <div class="reveal-content">
              <div class="reveal-header">
                <h4 class="reveal-title">{labels.productDetails}</h4>
              </div>
              <p class="reveal-desc">{item.desc}</p>

              <div class="reveal-actions">
                <p class="shop-available-label">{labels.tersediaDi}</p>
                <div class="shop-logos">
                  <a href={shopeeLinks[i]} target="_blank" rel="noopener noreferrer" class="shop-logo-btn" aria-label="Beli di Shopee">
                    <Image src={shopeeLogo} alt="Shopee" width={96} height={96} quality="max" class="shop-logo-img" />                  
                  </a>
                  <a href={tokpedLinks[i]} target="_blank" rel="noopener noreferrer" class="shop-logo-btn" aria-label="Beli di Tokopedia">
                    <Image src={tokopediaLogo} alt="Tokopedia" width={96} height={96} quality="max" class="shop-logo-img" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="certificates">
      <div class="cert-card">
        {certs.map((cert, i) => (
          <>
            <div class="cert-item">
              <Image src={certLogos[i]} alt={`Logo ${cert.name}`} width={120} quality="max" class="cert-img" loading="lazy" />
              <span class="cert-name">{cert.name}</span>
            </div>
            {i < certs.length - 1 && <div class="cert-divider" aria-hidden="true"></div>}
          </>
        ))}
      </div>
    </div>
  </div>
</section>
