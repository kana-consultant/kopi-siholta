---
import { Icon } from "astro-icon/components";
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);
---

<section class="sustainability section section--olive" aria-labelledby="sustainability-heading">
  <div class="container">
    <div class="sustainability__inner animate-on-scroll">
      <div class="sustainability__text">
        <h2 id="sustainability-heading" class="section-title">{t.fnb.sustainabilityTitle ?? 'Sustainability Commitment'}</h2>
        <p class="section-sub">{t.fnb.sustainabilitySubtitle ?? ''}</p>
      </div>
      <div class="sustainability__visual">
        <div class="sustainability__icon-wrap" aria-hidden="true">
          <Icon name="mdi:leaf" width="64" height="64" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.section--olive {
  padding-block: var(--space-8);
  border-bottom: 1px solid rgba(205, 18, 34, 0.3);
}

.sustainability__inner {
  background: rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  display: grid;
  grid-template-columns: 1fr;
  align-items: center;
  gap: var(--space-6);
  border: 1px solid var(--color-neutral-200);
}

.sustainability__text { 
  max-width: 100%; 
}

.sustainability__visual {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sustainability__icon-wrap {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: var(--color-brand-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-brand-red);
}

@media (min-width: 768px) {
  .section--olive { 
    padding-block: var(--space-12); 
  }

  .sustainability__inner {
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    padding: var(--space-8);
  }

  .sustainability__text { 
    max-width: 600px; 
  }
}
</style>