---
import PageHero from '@/components/shared/page-hero.astro';
import fnbBg from '@/images/bg/bg-fnb.jpg';
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);
---
<PageHero
  bgImage={fnbBg}
  alt={t.fnb.gallery?.altAtmosphere ?? 'Suasana Cafe Kopi Siholta'}
  titleLine1={t.fnb.titleLine1}
  titleLine2={t.fnb.titleLine2}
  subtitle={t.fnb.subtitle}
  pageLabel={t.fnb.page}
  homeLabel={t.breadcrumb.home}
  prevLabel={t.breadcrumb.company}
  prevHref={`/${lang}/company`}
  overlayPosition="center 40%"
  lang={lang}
/>
