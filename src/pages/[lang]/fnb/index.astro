---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';
import ScrollReveal from '@/components/shared/scroll-reveal.astro';

import FnbHero from '@/pages/[lang]/fnb/sections/hero.astro';
import FnbStat from '@/pages/[lang]/fnb/sections/stats.astro';
import RetailCoffee from '@/pages/[lang]/fnb/sections/retail-coffee.astro';
import CafeFavorites from '@/pages/[lang]/fnb/sections/cafe-favorites.astro';
import RetailDistribution from '@/pages/[lang]/fnb/sections/retail-distribution.astro';
import Sustainability from '@/pages/[lang]/fnb/sections/sustainability.astro';
import FnbCta from '@/pages/[lang]/fnb/sections/cta.astro';

import { getTranslations } from '@/i18n/utils';

const currentLang: 'id' | 'en' | 'fr' = (Astro.locals as any).lang || 'en';
const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleFnb} description={t.meta.descFnb} lang={currentLang} breadcrumbs={[
  { name: t.breadcrumb.home, href: `/${currentLang}/` },
  { name: t.breadcrumb.fnb, href: `/${currentLang}/fnb` },
]}>
  <Navbar lang={currentLang} />

  <main id="main-content">
    <FnbHero lang={currentLang} />
    <FnbStat lang={currentLang} />
    <RetailCoffee lang={currentLang} />
    <CafeFavorites lang={currentLang} />
    <RetailDistribution lang={currentLang} />
    <Sustainability lang={currentLang} />
    <FnbCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
  <ScrollReveal />
</Base>
