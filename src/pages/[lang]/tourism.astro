---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';

import TourismHero from '../../components/sections/tourism/TourismHero.astro';
import TourismStat from '../../components/sections/tourism/TourismStat.astro';
import Experiences from '../../components/sections/tourism/Experiences.astro';
import TourismCta from '../../components/sections/tourism/TourismCta.astro';

import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

/** Replace newlines with <br> tags — used with set:html */
const nl = (s: string) => s.split('\n').join('<br>');

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

---

<Base title={t.meta.titleTourism} description={t.meta.descTourism} lang={lang}>
  <Navbar lang={lang} />
  <header>
    <TourismHero lang={lang} t={t} />
    <TourismStat lang={lang} t={t} />
  </header>
  <main>
    <Experiences lang={lang} t={t} />
    <TourismCta lang={lang} t={t} />
  </main>
  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
