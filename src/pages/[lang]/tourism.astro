---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';

import TourismHero from '../../components/sections/tourism/TourismHero.astro';
import TourismStat from '../../components/sections/tourism/TourismStat.astro';
import Experiences from '../../components/sections/tourism/Experiences.astro';
import TourismCta from '../../components/sections/tourism/TourismCta.astro';

import { useTranslations } from '../../i18n/utils';

const { lang } = Astro.params;
const currentLang = ['id', 'en', 'fr'].includes(lang || '') ? (lang as 'id' | 'en' | 'fr') : 'id';

const t = useTranslations(currentLang);
---

<Base title={t.meta.titleTourism} description={t.meta.descTourism} lang={currentLang}>
  <Navbar lang={currentLang} />
  
  <main id="main-content">
    <TourismHero lang={currentLang} />
    <TourismStat lang={currentLang} />
    <Experiences lang={currentLang} />
    <TourismCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { 
          e.target.classList.add('is-visible'); 
          observer.unobserve(e.target); 
        }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>