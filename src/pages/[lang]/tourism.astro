---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';

import TourismHero from '@/components/sections/tourism/tourism-hero.astro';
import TourismStat from '@/components/sections/tourism/tourism-stat.astro';
import Experiences from '@/components/sections/tourism/experiences-section.astro';
import TourismCta from '@/components/sections/tourism/tourism-cta.astro';

import { getTranslations } from '@/i18n/utils';

const currentLang: 'id' | 'en' | 'fr' = (Astro.locals as any).lang || 'en';
const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleTourism} description={t.meta.descTourism} lang={currentLang} breadcrumbs={[
  { name: t.breadcrumb.home, href: `/${currentLang}/` },
  { name: t.breadcrumb.tourism, href: `/${currentLang}/tourism` },
]}>
  <Navbar lang={currentLang} />
  
  <main id="main-content">
    <TourismHero lang={currentLang} />
    <TourismStat lang={currentLang} />
    <Experiences lang={currentLang} />
    <TourismCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { 
          e.target.classList.add('is-visible'); 
          observer.unobserve(e.target); 
        }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>