---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import tourismBg from '../../images/bg/bg-tourism.jpg';
import t1Farm from '../../images/tourism/coffee-plantation.jpg';
import t2Factory from '../../images/tourism/process (5).jpg';
import t3Cup from '../../images/tourism/cup-and-test(2).jpg';
import tThumb1 from '../../images/tourism/samosir-island.jpg';
import tThumb2 from '../../images/tourism/Danau\ Toba.jpg';
import tThumb3 from '../../images/tourism/cup-and-test.jpg';
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

/** Replace newlines with <br> tags — used with set:html */
const nl = (s: string) => s.split('\n').join('<br>');

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

const experiences = [
  {
    num: '01',
    labelKey: 'exp1Label', titleKey: 'exp1Title', subtitleKey: 'exp1Subtitle',
    descKey: 'exp1Desc',
    detailsKey: ['exp1Detail1', 'exp1Detail2', 'exp1Detail3', 'exp1Detail4'],
    img: t1Farm, imgAltKey: 'altFarm', thumb: tThumb1,
  },
  {
    num: '02',
    labelKey: 'exp2Label', titleKey: 'exp2Title', subtitleKey: 'exp2Subtitle',
    descKey: 'exp2Desc',
    detailsKey: ['exp2Detail1', 'exp2Detail2', 'exp2Detail3'],
    img: t2Factory, imgAltKey: 'altFactory', thumb: tThumb2,
  },
  {
    num: '03',
    labelKey: 'exp3Label', titleKey: 'exp3Title', subtitleKey: 'exp3Subtitle',
    descKey: 'exp3Desc',
    detailsKey: ['exp3Detail1', 'exp3Detail2', 'exp3Detail3', 'exp3Detail4'],
    img: t3Cup, imgAltKey: 'altCupping', thumb: tThumb3,
  },
];

const stats = [
  { valueKey: 'statAlt',      labelKey: 'statAlt'      },
  { valueKey: 'statFamilies', labelKey: 'statFamilies' },
  { valueKey: 'statCountries', labelKey: 'statCountries' },
  { valueKey: 'statFounded',  labelKey: 'statFounded'  },
];
---

<Base title={t.meta.titleTourism} description={t.meta.descTourism} lang={lang}>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="page-hero page-hero--tall" aria-label="Wisata Kopi Kopi Siholta">
    <div class="page-hero__bg">
      <Image
        src={tourismBg}
        alt={t.tourism.images?.altFarm ?? ''}
        class="page-hero__img"
        style="object-position: center 35%"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--earth" aria-hidden="true"></div>
    </div>

    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item"><a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.tourism.page}</li>
        </ol>
      </nav>

      <div class="page-hero__content">
        <p class="page-hero__label">{t.tourism.label}</p>
        <h1 class="page-hero__title">{t.tourism.titleLine1}<br />{t.tourism.titleLine2}</h1>
        <p class="page-hero__sub">{t.tourism.subtitle}</p>
      </div>
    </div>
  </section>

  <!-- ── Intro Stats ───────────────────────────────────── -->
  <section class="stat-band stat-band--green" aria-label="Fakta Kopi Siholta">
    <div class="container">
      <div class="stat-band__grid">
        {[
          { value: '1.200 mdpl', label: t.tourism.statAlt },
          { value: '200+', label: t.tourism.statFamilies },
          { value: '6+', label: t.tourism.statCountries },
          { value: '2019', label: t.tourism.statFounded },
        ].map(stat => (
          <div class="stat-band__item animate-on-scroll">
            <span class="stat-band__value">{stat.value}</span>
            <span class="stat-band__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Experiences ───────────────────────────────────── -->
  <section class="experiences section section--cream" id="experiences" aria-labelledby="exp-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.tourism.expTag}</p>
        <h2 id="exp-heading" class="section-title">{nl(t.tourism.expTitle)}</h2>
        <p class="section-sub">{t.tourism.expSubtitle}</p>
      </div>

      <div class="exp-list">
        {experiences.map((exp, i) => (
          <article class={`exp-item ${i % 2 !== 0 ? 'exp-item--rev' : ''} animate-on-scroll`}>
            <!-- Image Panel -->
            <div class="exp-item__media">
              <div class="exp-item__img-wrap">
                <Image
                  src={exp.img}
                  alt={t.tourism.images?.[exp.imgAltKey as keyof typeof t.tourism.images] ?? ''}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  widths={[480, 768, 1024]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  class="exp-item__img"
                />
              </div>
              <div class="exp-item__num-badge" aria-hidden="true">
                <span class="exp-item__num">{exp.num}</span>
              </div>
              <div class="exp-item__thumb" aria-hidden="true">
                <Image
                  src={exp.thumb}
                  alt=""
                  loading="lazy"
                  widths={[200, 300]}
                  sizes="80px"
                  class="exp-item__thumb-img"
                />
              </div>
            </div>

            <!-- Content Panel -->
            <div class="exp-item__content">
              <p class="exp-item__label">{t.tourism[exp.labelKey as keyof typeof t.tourism]}</p>
              <h3 class="exp-item__title">{t.tourism[exp.titleKey as keyof typeof t.tourism]}</h3>
              <p class="exp-item__subtitle">{t.tourism[exp.subtitleKey as keyof typeof t.tourism]}</p>
              <p class="exp-item__desc">{t.tourism[exp.descKey as keyof typeof t.tourism]}</p>
              <ul class="exp-item__details" role="list">
                {exp.detailsKey.map(dk => (
                  <li class="exp-item__detail">
                    <Icon name="mdi:check" width="12" height="12" />
                    {t.tourism[dk as keyof typeof t.tourism]}
                  </li>
                ))}
              </ul>
              <a href={`/${lang}/#contact`} class="btn btn--outline-dark exp-item__cta">
                {t.tourism.ctaPesan}
                <Icon name="mdi:chevron-right" width="12" height="12" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA Banner ─────────────────────────────────────── -->
  <section class="page-cta page-cta--cream" aria-label="Pesan Pengalaman Kopi">
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{nl(t.tourism.ctaTitle)}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{t.tourism.ctaSubtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">{t.tourism.cta1}</a>
        <!-- <a href={`/${lang}/company`} class="btn btn--outline-dark">{t.tourism.cta2}</a> -->
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
