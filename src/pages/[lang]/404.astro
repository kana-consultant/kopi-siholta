---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: 'id' | 'en' | 'fr';
}

const { lang: langProp } = Astro.props;
const { lang: langParam } = Astro.params;
const resolvedLang = langProp ?? (['id', 'en', 'fr'].includes(langParam || '') ? (langParam as 'id' | 'en' | 'fr') : 'id');
const currentLang: 'id' | 'en' | 'fr' = resolvedLang;

const t = useTranslations(currentLang);
const nf = t.notFound;
---

<Base title={nf.title} description={nf.message} lang={currentLang}>
  <Navbar lang={currentLang} />

  <main id="main-content" class="error-page">
    <div class="error-page__inner container">

      <div class="error-page__bean" aria-hidden="true">
        <Icon name="mdi:coffee" width="70" height="70" />
      </div>

      <p class="error-page__code" aria-hidden="true">{nf.code}</p>

      <h1 class="error-page__title">{nf.headline}</h1>

      <p class="error-page__message">{nf.message}</p>

      <p class="error-page__suggestion">{nf.suggestion}</p>

      <div class="error-page__actions">
        <a href={`/${currentLang}/`} class="btn btn--primary">
          <Icon name="mdi:home" width="16" height="16" />
          {nf.ctaHome}
        </a>
        <a href={`/${currentLang}/#products`} class="btn btn--outline-dark">
          <Icon name="mdi:shopping-outline" width="16" height="16" />
          {nf.ctaExplore}
        </a>
      </div>

    </div>
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>
<style>
  
.error-page {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand-cream);
  padding-block: var(--space-10);
}

.error-page__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-5);
  max-width: 30rem;
}

.error-page__bean {
  animation: floatBean 3s ease-in-out infinite;
  margin-bottom: var(--space-2);
}

@keyframes floatBean {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50%       { transform: translateY(-0.375rem) rotate(8deg); }
}

.error-page__code {
  font-family: var(--font-display);
  font-size: 3.75rem;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--color-brand-red);
  line-height: 1;
  opacity: 0.12;
  user-select: none;
  margin-top: calc(-1 * var(--space-6));
}

.error-page__title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 5vw, 2.5rem);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.15;
  letter-spacing: -0.01em;
}

.error-page__message {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.7;
  color: var(--color-brand-muted);
  max-width: 22.5rem;
}

.error-page__suggestion {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  line-height: 1.6;
  color: var(--color-brand-brand-muted, var(--color-brand-muted));
  opacity: 0.75;
  max-width: 20rem;
}

.error-page__actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-3);
}

.error-page__actions .btn {
  justify-content: center;
}

@media (min-width: 480px) {
  .error-page {
    min-height: 70vh;
    padding-block: var(--space-16);
  }

  .error-page__code {
    font-size: 5rem;
  }

  .error-page__actions {
    flex-direction: row;
    width: auto;
  }
}

</style>
