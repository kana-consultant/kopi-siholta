---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: 'id' | 'en' | 'fr';
}

const { lang: langProp } = Astro.props;
const { lang: langParam } = Astro.params;
const resolvedLang = langProp ?? (['id', 'en', 'fr'].includes(langParam || '') ? (langParam as 'id' | 'en' | 'fr') : 'id');
const currentLang: 'id' | 'en' | 'fr' = resolvedLang;

const t = useTranslations(currentLang);
const nf = t.notFound;
---

<Base title={nf.title} description={nf.message} lang={currentLang}>
  <Navbar lang={currentLang} />

  <main id="main-content" class="error-page">
    <div class="error-page__inner container">

      <div class="error-page__bean" aria-hidden="true">
        <Icon name="mdi:coffee" width="70" height="70" />
      </div>

      <p class="error-page__code" aria-hidden="true">{nf.code}</p>

      <h1 class="error-page__title">{nf.headline}</h1>

      <p class="error-page__message">{nf.message}</p>

      <p class="error-page__suggestion">{nf.suggestion}</p>

      <div class="error-page__actions">
        <a href={`/${currentLang}/`} class="btn btn--primary">
          <Icon name="mdi:home" width="16" height="16" />
          {nf.ctaHome}
        </a>
        <a href={`/${currentLang}/#products`} class="btn btn--outline-dark">
          <Icon name="mdi:shopping-outline" width="16" height="16" />
          {nf.ctaExplore}
        </a>
      </div>

    </div>
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>
