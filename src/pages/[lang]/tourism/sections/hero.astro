---
import PageHero from '@/components/shared/page-hero.astro';
import tourismBg from '@/images/bg/bg-tourism.jpg';
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);
---
<PageHero
  bgImage={tourismBg}
  alt={t.tourism.images?.altFarm ?? 'Perkebunan Kopi Siholta'}
  titleLine1={t.tourism.titleLine1}
  titleLine2={t.tourism.titleLine2}
  subtitle={t.tourism.subtitle}
  pageLabel={t.tourism.page}
  homeLabel={t.breadcrumb.home}
  prevLabel={t.breadcrumb.company}
  prevHref={`/${lang}/company`}
  overlayPosition="center 35%"
  lang={lang}
/>
