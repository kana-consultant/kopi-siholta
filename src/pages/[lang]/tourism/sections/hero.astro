---
import PageHero from '@/components/shared/page-hero.astro';
import tourismBg from '@/images/bg/bg-tourism.jpg';

interface Props {
  alt: string;
  titleLine1: string;
  titleLine2: string;
  subtitle: string;
  pageLabel: string;
  homeLabel: string;
  prevLabel: string;
  prevHref: string;
  lang: string;
}
const { alt, titleLine1, titleLine2, subtitle, pageLabel, homeLabel, prevLabel, prevHref, lang } = Astro.props;
---
<PageHero
  bgImage={tourismBg}
  alt={alt}
  titleLine1={titleLine1}
  titleLine2={titleLine2}
  subtitle={subtitle}
  pageLabel={pageLabel}
  homeLabel={homeLabel}
  prevLabel={prevLabel}
  prevHref={prevHref}
  overlayPosition="center 35%"
  lang={lang}
/>
