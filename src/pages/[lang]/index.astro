---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';

import Hero from '@/components/sections/homepage/hero-section.astro';
import Heritage from '@/components/sections/homepage/heritage-section.astro';
import Products from '@/components/sections/homepage/products-section.astro';
import Exports from '@/components/sections/homepage/exports-section.astro';
import B2BPartners from '@/components/sections/homepage/partnerships-section.astro';
import OmnichannelLinks from '@/components/sections/homepage/omnichannel-links.astro';
import ContactSection from '@/components/sections/homepage/contact-section.astro';

import { getTranslations } from '@/i18n/utils';
const currentLang = (Astro.locals as any).lang || 'en';

const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleHome} description={t.meta.descHome} lang={currentLang}>
  <Navbar lang={currentLang} />
  <main id="main-content">
    <Hero lang={currentLang} />
    <Heritage lang={currentLang} />
    <Products lang={currentLang} />
    <Exports lang={currentLang} />
    <B2BPartners lang={currentLang} />
    <OmnichannelLinks lang={currentLang} />
    <ContactSection lang={currentLang} />
  </main>
  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const revealEls = document.querySelectorAll('.animate-fade-in-up');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => revealObserver.observe(el));
</script>