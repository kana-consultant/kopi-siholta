---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import Hero from '../../components/sections/homepage/Hero.astro';
import Heritage from '../../components/sections/homepage/Heritage.astro';
import Products from '../../components/sections/homepage/Products.astro';
import Exports from '../../components/sections/homepage/Exports.astro';
import B2BPartners from '../../components/sections/homepage/Partnerships.astro';
import OmnichannelLinks from '../../components/sections/homepage/OmnichannelLinks.astro';
import ContactSection from '../../components/sections/homepage/ContactSection.astro';

const { lang } = Astro.params;
const currentLang = ['id', 'en', 'fr'].includes(lang || '') ? lang : 'id';

const meta = currentLang === 'id'
  ? {
      title: 'Kopi Siholta — Pionir Kopi Specialty Indonesia dari Danau Toba',
      description: 'PT Siholta Toba Indonesia adalah produsen dan eksportir kopi specialty pertama di Indonesia dari Sumatera Lintong, Humbang Hasundutan, Sumatera Utara.',
    }
  : currentLang === 'fr'
  ? {
      title: 'Kopi Siholta — Pionnier du Café Specialty Indonésien du Lac Toba',
      description: "PT Siholta Toba Indonesia est le premier producteur et exportateur de café specialty d'Indonésie, issu de Sumatera Lintong, Humbang Hasundutan, Sumatra Nord.",
    }
  : {
      title: "Kopi Siholta — Indonesia's Specialty Coffee Pioneer from Lake Toba",
      description: "PT Siholta Toba Indonesia is Indonesia's first specialty coffee producer and exporter from Sumatera Lintong, Humbang Hasundutan, North Sumatra.",
    };
---

<Base title={meta.title} description={meta.description} lang={currentLang}>
  <Navbar lang={currentLang} />
  <main id="main-content">
    <Hero lang={currentLang} />
    <Heritage lang={currentLang} />
    <Products lang={currentLang} />
    <Exports lang={currentLang} />
    <B2BPartners lang={currentLang} />
    <OmnichannelLinks lang={currentLang} />
    <ContactSection lang={currentLang} />
  </main>
  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const revealEls = document.querySelectorAll('.animate-fade-in-up');

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -40px 0px',
  });

  revealEls.forEach(el => revealObserver.observe(el));
</script>