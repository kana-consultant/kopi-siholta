---
export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import Hero from '../../components/sections/Hero.astro';
import StatsRibbon from '../../components/sections/StatsRibbon.astro';
import Heritage from '../../components/sections/Heritage.astro';
import Products from '../../components/sections/Products.astro';
import ExportDashboard from '../../components/sections/ExportDashboard.astro';
import B2BPartners from '../../components/sections/Partnerships.astro';
import OmnichannelLinks from '../../components/sections/OmnichannelLinks.astro';
import ContactSection from '../../components/sections/ContactSection.astro';

const { lang = 'id' } = Astro.props;

const meta = lang === 'id'
  ? {
      title: 'Kopi Siholta — Pionir Kopi Specialty Indonesia dari Danau Toba',
      description: 'PT Siholta Toba Indonesia adalah produsen dan eksportir kopi specialty pertama di Indonesia dari Sumatera Lintong, Humbang Hasundutan, Sumatera Utara.',
    }
  : lang === 'fr'
  ? {
      title: 'Kopi Siholta — Pionnier du Café Specialty Indonésien du Lac Toba',
      description: "PT Siholta Toba Indonesia est le premier producteur et exportateur de café specialty d'Indonésie, issu de Sumatera Lintong, Humbang Hasundutan, Sumatra Nord.",
    }
  : {
      title: "Kopi Siholta — Indonesia's Specialty Coffee Pioneer from Lake Toba",
      description: "PT Siholta Toba Indonesia is Indonesia's first specialty coffee producer and exporter from Sumatera Lintong, Humbang Hasundutan, North Sumatra.",
    };
---

<Base title={meta.title} description={meta.description} lang={lang}>
  <Navbar lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <Heritage lang={lang} />
    <Products lang={lang} />
    <ExportDashboard lang={lang} />
    <B2BPartners lang={lang} />
    <OmnichannelLinks lang={lang} />
    <ContactSection lang={lang} />
  </main>
  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const revealEls = document.querySelectorAll('.animate-fade-in-up');

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.1,
    rootMargin: '0px 0px -40px 0px',
  });

  revealEls.forEach(el => revealObserver.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>