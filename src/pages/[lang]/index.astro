---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';
import ScrollReveal from '@/components/shared/scroll-reveal.astro';

import Hero from './index/sections/hero.astro';
import Heritage from './index/sections/heritage-section.astro';
import Products from './index/sections/products-section.astro';
import Exports from './index/sections/exports-section.astro';
import B2BPartners from './index/sections/partnerships-section.astro';
import OmnichannelLinks from './index/sections/omnichannel-links.astro';
import ContactSection from './index/sections/contact-section.astro';

import { getTranslations } from '@/i18n/utils';
const currentLang = (Astro.locals as any).lang || 'en';

const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleHome} description={t.meta.descHome} lang={currentLang}>
  <Navbar lang={currentLang} />
  <main id="main-content">
    <Hero lang={currentLang} />
    <Heritage lang={currentLang} />
    <Products lang={currentLang} />
    <Exports lang={currentLang} />
    <B2BPartners lang={currentLang} />
    <OmnichannelLinks lang={currentLang} />
    <ContactSection lang={currentLang} />
  </main>
  <Footer lang={currentLang} />
  <WhatsAppFAB />
  <ScrollReveal selectors={['.animate-on-scroll', '.animate-fade-in-up']} />
</Base>
