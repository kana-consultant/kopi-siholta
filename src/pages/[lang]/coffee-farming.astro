---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';

import FarmingHero from '@/components/sections/farming/farming-hero.astro';
import FarmingStats from '@/components/sections/farming/farming-stats.astro';
import HarvestingProcedure from '@/components/sections/farming/harvesting-procedure.astro';
import Process from '@/components/sections/farming/process-section.astro';
import Roasting from '@/components/sections/farming/roasting-section.astro';
import Regions from '@/components/sections/farming/regions-section.astro';
import Quality from '@/components/sections/farming/quality-section.astro';
import Farmer from '@/components/sections/farming/farmer-section.astro';
import LocationMap from '@/components/sections/farming/location-map.astro';
import FarmingCta from '@/components/sections/farming/farming-cta.astro';

import { getTranslations } from '@/i18n/utils';

const currentLang: 'id' | 'en' | 'fr' = (Astro.locals as any).lang || 'en';
const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={currentLang} breadcrumbs={[
  { name: t.breadcrumb.home, href: `/${currentLang}/` },
  { name: t.breadcrumb.coffeeFarming, href: `/${currentLang}/coffee-farming` },
]}>
  <Navbar lang={currentLang} />
  
  <header>
    <FarmingHero lang={currentLang} />
    <FarmingStats lang={currentLang} />
  </header>
  
  <main>
    <HarvestingProcedure lang={currentLang} />
    <Process lang={currentLang} />
    <Roasting lang={currentLang} />
    <Regions lang={currentLang} />
    <Quality lang={currentLang} />
    <Farmer lang={currentLang} />
    <LocationMap lang={currentLang} />
    <FarmingCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { 
          e.target.classList.add('is-visible'); 
          observer.unobserve(e.target); 
        }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>