---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import farmingBg from '../../images/bg/bg-farming.jpg';
import fProcess1 from '../../images/farming/coffee-cherry(2).jpg';
import fProcess2 from '../../images/farming/process.jpg';
import fProcess3 from '../../images/farming/process (2).jpg';
import fProcess4 from '../../images/farming/process (3).jpg';
import fProcess5 from '../../images/farming/process (4).jpg';
import fProcess6 from '../../images/farming/process (5).jpg';
import fProcess7b from '../../images/farming/process (7).jpg';
import fProcess8 from '../../images/farming/process(3).jpg';
import fProcess9 from '../../images/farming/process (6).jpg';
import fProcess10 from '../../images/farming/sorting.jpg';
import fGreen   from '../../images/farming/coffee-green.jpg';
import fCup2    from '../../images/farming/cup-and-test(2).jpg';
import fFarm from '../../images/farming/coffee-plantation.jpg';
import fFarm2 from '../../images/farming/coffee-plantation (2).jpg';
import fFarm3 from '../../images/farming/coffee-plantation (3).jpg';
import fCup from '../../images/farming/cup-and-test.jpg';
import fFarmer1 from '../../images/farming/farmer.jpg';
import fFarmer2 from '../../images/farming/farmer-1.jpg';
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

/** Replace newlines with <br> tags — used with set:html */
const nl = (s: string) => s.split('\n').join('<br>');

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

const regions = [
  { nameKey: 'regionLintong', altKey: 'regionLintongAlt', descKey: 'regionLintongDesc', img: fFarm },
  { nameKey: 'regionDolok',   altKey: 'regionDolokAlt',   descKey: 'regionDolokDesc',   img: fFarm2   },
  { nameKey: 'regionHumbang', altKey: 'regionHumbangAlt', descKey: 'regionHumbangDesc', img: fFarm3 },
];

const farmers = [
  { nameKey: 'farmerMargondang', villageKey: 'farmerMargondangVillage', sinceKey: 'farmerMargondangSince', quoteKey: 'farmerMargondangQuote', img: fFarmer1 },
  { nameKey: 'farmerRohani',     villageKey: 'farmerRohaniVillage',     sinceKey: 'farmerRohaniSince',     quoteKey: 'farmerRohaniQuote',     img: fFarmer2 },
];
---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={lang}>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="page-hero page-hero--tall" aria-label="Budidaya Kopi Kopi Siholta">
    <div class="page-hero__bg">
      <Image
        src={farmingBg}
        alt={t.coffeeFarming.farmImages?.altFarm ?? ''}
        class="page-hero__img"
        style="object-position: center 25%"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--farm" aria-hidden="true"></div>
    </div>

    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item"><a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.coffeeFarming.page}</li>
        </ol>
      </nav>

      <div class="farm-hero__content">
        <p class="page-hero__label">{t.coffeeFarming.label}</p>
        <h1 class="page-hero__title">{t.coffeeFarming.titleLine1}<br />{t.coffeeFarming.titleLine2}</h1>
        <p class="page-hero__sub">{t.coffeeFarming.subtitle}</p>
        <a href="#process" class="btn btn--primary">{t.coffeeFarming.ctaHero}</a>
      </div>
    </div>
  </section>

  <!-- ── Stats Band ────────────────────────────────────── -->
  <section class="stat-band stat-band--green" aria-label="Statistik Pertanian Kopi">
    <div class="container">
      <div class="stat-band__grid">
        <div class="stat-band__item animate-on-scroll"><span class="stat-band__value">200+</span><span class="stat-band__label">{t.coffeeFarming.statFamilies}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 80ms"><span class="stat-band__value">1.500 mdpl</span><span class="stat-band__label">{t.coffeeFarming.statMaxAlt}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 160ms"><span class="stat-band__value">Giling Basah</span><span class="stat-band__label">{t.coffeeFarming.statMethod}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 240ms"><span class="stat-band__value">100 ton</span><span class="stat-band__label">{t.coffeeFarming.statCapacity}</span></div>
      </div>
    </div>
  </section>

  <!-- ── Harvesting Procedure ────────────────────────── -->
  <section class="harvest-proc section" id="harvest-procedure" aria-labelledby="harvest-proc-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.harvestProcTag}</p>
        <h2 id="harvest-proc-heading" class="section-title">{nl(t.coffeeFarming.harvestProcTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.harvestProcSubtitle}</p>
      </div>

      <div class="harvest-steps">
        <div class="harvest-steps__grid">
          <div class="harvest-step-card animate-on-scroll">
            <div class="harvest-step-card__num" aria-hidden="true">01</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep1Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep1Desc}</p>
            </div>
          </div>
          <div class="harvest-step-card animate-on-scroll" style="transition-delay:80ms">
            <div class="harvest-step-card__num" aria-hidden="true">02</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep2Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep2Desc}</p>
            </div>
          </div>
          <div class="harvest-step-card animate-on-scroll" style="transition-delay:160ms">
            <div class="harvest-step-card__num" aria-hidden="true">03</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep3Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep3Desc}</p>
            </div>
          </div>
          <div class="harvest-step-card animate-on-scroll" style="transition-delay:240ms">
            <div class="harvest-step-card__num" aria-hidden="true">04</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep4Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep4Desc}</p>
            </div>
          </div>
        </div>
        <div class="harvest-proc__outro animate-on-scroll">
          <p>{t.coffeeFarming.harvestProcOutro}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Process: Coffee Processing Methods ─────────── -->
  <section class="journey section section--cream" id="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.processTag}</p>
        <h2 id="process-heading" class="section-title">{nl(t.coffeeFarming.processTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.processSubtitle}</p>
      </div>

      <!-- Method tabs -->
      <div class="process-tabs animate-on-scroll" role="tablist" aria-label="Coffee processing methods" data-process-tabs>
        <button class="process-tab process-tab--active" role="tab" aria-selected="true" aria-controls="panel-wet" id="tab-wet" data-process-tab="wet" data-short={t.coffeeFarming.processWetTagShort}>
          <span class="process-tab__num">01</span>
          <span class="process-tab__label">{t.coffeeFarming.processWetTag}</span>
        </button>
        <button class="process-tab" role="tab" aria-selected="false" aria-controls="panel-semi" id="tab-semi" data-process-tab="semi" tabindex="-1" data-short={t.coffeeFarming.processSemiTagShort}>
          <span class="process-tab__num">02</span>
          <span class="process-tab__label">{t.coffeeFarming.processSemiTag}</span>
        </button>
        <button class="process-tab" role="tab" aria-selected="false" aria-controls="panel-dry" id="tab-dry" data-process-tab="dry" tabindex="-1" data-short={t.coffeeFarming.processDryTagShort}>
          <span class="process-tab__num">03</span>
          <span class="process-tab__label">{t.coffeeFarming.processDryTag}</span>
        </button>
      </div>

      <!-- Wet Processing Panel -->
      <div class="process-panel process-panel--active" id="panel-wet" role="tabpanel" aria-labelledby="tab-wet" data-process-panel="wet">
        <div class="process-panel__intro animate-on-scroll">
          <h3 class="process-panel__title">{t.coffeeFarming.processWetTitle}</h3>
          <p class="process-panel__desc">{t.coffeeFarming.processWetDesc}</p>
        </div>
        <div class="process-steps">
          <div class="process-step animate-on-scroll">
            <div class="process-step__num" aria-hidden="true">01</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep1Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep1Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:60ms">
            <div class="process-step__num" aria-hidden="true">02</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep2Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep2Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:120ms">
            <div class="process-step__num" aria-hidden="true">03</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep3Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep3Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:180ms">
            <div class="process-step__num" aria-hidden="true">04</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep4Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep4Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:240ms">
            <div class="process-step__num" aria-hidden="true">05</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep5Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep5Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:300ms">
            <div class="process-step__num" aria-hidden="true">06</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep6Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep6Desc}</p>
            </div>
          </div>
        </div>
        <div class="process-panel__outro animate-on-scroll">
          <p>{t.coffeeFarming.processWetOutro}</p>
        </div>
      </div>

      <!-- Semi-Wet Processing Panel -->
      <div class="process-panel" id="panel-semi" role="tabpanel" aria-labelledby="tab-semi" data-process-panel="semi" hidden>
        <div class="process-panel__intro animate-on-scroll">
          <h3 class="process-panel__title">{t.coffeeFarming.processSemiTitle}</h3>
          <p class="process-panel__desc">{t.coffeeFarming.processSemiDesc}</p>
        </div>
        <div class="process-steps">
          <div class="process-step animate-on-scroll">
            <div class="process-step__num" aria-hidden="true">01</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep1Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep1Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:60ms">
            <div class="process-step__num" aria-hidden="true">02</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep2Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep2Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:120ms">
            <div class="process-step__num" aria-hidden="true">03</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep3Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep3Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:180ms">
            <div class="process-step__num" aria-hidden="true">04</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep4Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep4Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:240ms">
            <div class="process-step__num" aria-hidden="true">05</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep5Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep5Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:300ms">
            <div class="process-step__num" aria-hidden="true">06</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep6Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep6Desc}</p>
            </div>
          </div>
        </div>
        <div class="process-panel__outro animate-on-scroll">
          <p>{t.coffeeFarming.processSemiOutro}</p>
        </div>
      </div>

      <!-- Dry Processing Panel -->
      <div class="process-panel" id="panel-dry" role="tabpanel" aria-labelledby="tab-dry" data-process-panel="dry" hidden>
        <div class="process-panel__intro animate-on-scroll">
          <h3 class="process-panel__title">{t.coffeeFarming.processDryTitle}</h3>
          <p class="process-panel__desc">{t.coffeeFarming.processDryDesc}</p>
        </div>
        <div class="process-steps">
          <div class="process-step animate-on-scroll">
            <div class="process-step__num" aria-hidden="true">01</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep1Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep1Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:60ms">
            <div class="process-step__num" aria-hidden="true">02</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep2Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep2Desc}</p>
            </div>
          </div>
          <div class="process-step process-step--split animate-on-scroll" style="transition-delay:120ms">
            <div class="process-step__num" aria-hidden="true">03</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep3aTitle}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep3aDesc}</p>
            </div>
            <div class="process-step__divider" aria-hidden="true">|</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep3bTitle}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep3bDesc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:180ms">
            <div class="process-step__num" aria-hidden="true">04</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep4Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep4Desc}</p>
            </div>
          </div>
        </div>
        <div class="process-panel__outro animate-on-scroll">
          <p>{t.coffeeFarming.processDryOutro}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Regions ─────────────────────────────────────── -->
  <section class="regions section section--cream" aria-labelledby="regions-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.regionsTag}</p>
        <h2 id="regions-heading" class="section-title">{nl(t.coffeeFarming.regionsTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.regionsSubtitle}</p>
      </div>

      <div class="regions__grid">
        {regions.map((region, i) => (
          <article class="region-card animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
            <div class="region-card__media">
              <Image
                src={region.img}
                alt={`Perkebunan kopi di ${t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, 33vw"
                class="region-card__img"
              />
              <div class="region-card__alt-badge">
                <Icon name="mdi:arrow-up" width="10" height="10" />
                {t.coffeeFarming[region.altKey as keyof typeof t.coffeeFarming]}
              </div>
            </div>
            <div class="region-card__body">
              <h3 class="region-card__name">{t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}</h3>
              <p class="region-card__desc">{t.coffeeFarming[region.descKey as keyof typeof t.coffeeFarming]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Quality Editorial — photo + dark panel ───────── -->
  <section class="quality-editorial section" aria-labelledby="quality-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.qualityTag}</p>
        <h2 id="quality-heading" class="section-title">{nl(t.coffeeFarming.qualityTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.qualitySubtitle}</p>
      </div>

      <div class="quality-editorial__body">

        <!-- Left: photo grid -->
        <div class="quality-editorial__gallery">
          <div class="quality-editorial__gallery-item">
            <Image src={fCup2} alt={t.coffeeFarming.qualityGallery1Alt} loading="lazy" widths={[600,1200]} sizes="(max-width:768px) 100vw, 50vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery1}</span>
          </div>
          <div class="quality-editorial__gallery-item">
            <Image src={fGreen} alt={t.coffeeFarming.qualityGallery2Alt} loading="lazy" widths={[300,600]} sizes="(max-width:768px) 50vw, 25vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery2}</span>
          </div>
          <div class="quality-editorial__gallery-item">
            <Image src={fProcess7b} alt={t.coffeeFarming.qualityGallery3Alt} loading="lazy" widths={[300,600]} sizes="(max-width:768px) 50vw, 25vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery3}</span>
          </div>
        </div>

        <!-- Right: editorial text panel -->
        <div class="quality-editorial__panel animate-on-scroll">
          <div>
            <p class="quality-editorial__panel-tag">{t.coffeeFarming.qualityTag}</p>
            <h3 class="quality-editorial__panel-title">{nl(t.coffeeFarming.qualityPanelTitle)}</h3>
          </div>
          <p class="quality-editorial__panel-text">{t.coffeeFarming.qualityPanelText}</p>
          <div class="quality-editorial__panel-stats">
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat1Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat1Label}</span>
            </div>
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat2Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat2Label}</span>
            </div>
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat3Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat3Label}</span>
            </div>
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat4Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat4Label}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Farmer Stories ────────────────────────────────── -->
  <section class="farmers section" aria-labelledby="farmers-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.farmersTag}</p>
        <h2 id="farmers-heading" class="section-title">{nl(t.coffeeFarming.farmersTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.farmersSubtitle}</p>
      </div>

      <div class="farmers__grid">
        {farmers.map((farmer, i) => (
          <article class={`farmer-card animate-on-scroll ${i % 2 !== 0 ? 'farmer-card--rev' : ''}`}>
            <div class="farmer-card__media">
              <Image
                src={farmer.img}
                alt={`${t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]} — ${t.coffeeFarming.farmerRole}`}
                loading="lazy"
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="farmer-card__img"
              />
              <div class="farmer-card__info-badge">
                <span class="farmer-card__village">{t.coffeeFarming[farmer.villageKey as keyof typeof t.coffeeFarming]}</span>
                <span class="farmer-card__since">{t.coffeeFarming[farmer.sinceKey as keyof typeof t.coffeeFarming]}</span>
              </div>
            </div>
            <div class="farmer-card__content">
              <blockquote class="farmer-card__quote">
                <p>"{t.coffeeFarming[farmer.quoteKey as keyof typeof t.coffeeFarming]}"</p>
              </blockquote>
              <div class="farmer-card__author">
                <span class="farmer-card__name">{t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]}</span>
                <span class="farmer-card__role">{t.coffeeFarming.farmerRole}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────── -->
  <section class="page-cta page-cta--cream" aria-label="Bergabung sebagai Petani Partner">
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{nl(t.coffeeFarming.ctaTitle)}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{t.coffeeFarming.ctaSubtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">{t.coffeeFarming.cta1}</a>
        <!-- <a href={`/${lang}/company`} class="btn btn--outline-dark">{t.coffeeFarming.cta2}</a> -->
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  /* ── Mobile: swap long tab label → short label ─── */
  const SHORT_BREAKPOINT = 480;

  function isMobileTab(): boolean {
    return window.matchMedia(`(max-width: ${SHORT_BREAKPOINT - 1}px)`).matches;
  }

  function applyMobileLabels() {
    const isMobile = isMobileTab();
    tabs.forEach(tab => {
      const label = tab.querySelector<HTMLElement>('.process-tab__label');
      const short = tab.dataset.short ?? '';
      if (label) {
        label.textContent = isMobile && short ? short : (tab.dataset.fullLabel ?? label.textContent);
      }
    });
  }

  const tabs    = document.querySelectorAll<HTMLElement>('[data-process-tab]');
  const panels  = document.querySelectorAll<HTMLElement>('[data-process-panel]');

  /* Store full label before any mobile swap */
  tabs.forEach(tab => {
    const label = tab.querySelector<HTMLElement>('.process-tab__label');
    if (label) tab.dataset.fullLabel = label.textContent ?? '';
  });

  applyMobileLabels();
  window.addEventListener('resize', applyMobileLabels);

  /* ── Process method tabs ───────────────────────── */
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.processTab ?? '';

      /* Update ARIA states */
      tabs.forEach(t => {
        const isActive = t.dataset.processTab === target;
        t.classList.toggle('process-tab--active', isActive);
        t.setAttribute('aria-selected', String(isActive));
        t.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      /* Show/hide panels */
      panels.forEach(p => {
        const isActive = p.dataset.processPanel === target;
        if (isActive) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });

      /* Re-trigger animations */
      panels.forEach(p => {
        if (!p.hasAttribute('hidden')) {
          p.style.animation = 'none';
          p.offsetHeight; /* force reflow */
          p.style.animation = '';
        }
      });
    });

    /* Keyboard navigation within tabs */
    tab.addEventListener('keydown', (e: KeyboardEvent) => {
      const tabArr = Array.from(tabs);
      const idx = tabArr.indexOf(tab as HTMLElement);
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const next = tabArr[idx + 1] ?? tabArr[0];
        next.focus();
        (next as HTMLElement).click();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = tabArr[idx - 1] ?? tabArr[tabArr.length - 1];
        prev.focus();
        (prev as HTMLElement).click();
      }
    });
  });

  /* ── Scroll-triggered animations ─────────────── */
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
