---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import farmingBg from '../../images/bg/bg-farming.jpg';
import fProcess1 from '../../images/farming/coffe-cherry.jpg';
import fProcess2 from '../../images/farming/process.jpg';
import fProcess3 from '../../images/farming/process (2).jpg';
import fProcess4 from '../../images/farming/process (3).jpg';
import fProcess5 from '../../images/farming/process (4).jpg';
import fProcess6 from '../../images/farming/process (5).jpg';
import fFarm from '../../images/farming/coffee-plantation.jpg';
import fCup from '../../images/farming/cup-and-test.jpg';
import fFarmer1 from '../../images/farming/farmer-1.jpg';
import fFarmer2 from '../../images/farming/farmer-2.jpg';
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

/** Replace newlines with <br> tags — used with set:html */
const nl = (s: string) => s.split('\n').join('<br>');

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

const process = [
  {
    step: '01', titleKey: 'stepCherry', iconName: 'mdi:flower', descKey: 'stepCherryDesc',
    img: fProcess1, imgAltKey: 'altCherry',
  },
  {
    step: '02', titleKey: 'stepFerment', iconName: 'mdi:flask', descKey: 'stepFermentDesc',
    img: fProcess2, imgAltKey: 'altFerment',
  },
  {
    step: '03', titleKey: 'stepWetHull', iconName: 'mdi:sprout', descKey: 'stepWetHullDesc',
    img: fProcess3, imgAltKey: 'altWetHull',
  },
  {
    step: '04', titleKey: 'stepDrying', iconName: 'mdi:white-balance-sunny', descKey: 'stepDryingDesc',
    img: fProcess4, imgAltKey: 'altDrying',
  },
  {
    step: '05', titleKey: 'stepSorting', iconName: 'mdi:filter-variant', descKey: 'stepSortingDesc',
    img: fProcess5, imgAltKey: 'altSorting',
  },
  {
    step: '06', titleKey: 'stepRoasting', iconName: 'mdi:fire', descKey: 'stepRoastingDesc',
    img: fProcess6, imgAltKey: 'altRoasting',
  },
];

const regions = [
  { nameKey: 'regionLintong', altKey: 'regionLintongAlt', descKey: 'regionLintongDesc', img: fFarm },
  { nameKey: 'regionDolok',   altKey: 'regionDolokAlt',   descKey: 'regionDolokDesc',   img: fCup   },
  { nameKey: 'regionHumbang', altKey: 'regionHumbangAlt', descKey: 'regionHumbangDesc', img: fProcess1 },
];

const farmers = [
  { nameKey: 'farmerMargondang', villageKey: 'farmerMargondangVillage', sinceKey: 'farmerMargondangSince', quoteKey: 'farmerMargondangQuote', img: fFarmer1 },
  { nameKey: 'farmerRohani',     villageKey: 'farmerRohaniVillage',     sinceKey: 'farmerRohaniSince',     quoteKey: 'farmerRohaniQuote',     img: fFarmer2 },
];
---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={lang}>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="page-hero page-hero--tall" aria-label="Budidaya Kopi Kopi Siholta">
    <div class="page-hero__bg">
      <Image
        src={farmingBg}
        alt={t.coffeeFarming.farmImages?.altFarm ?? ''}
        class="page-hero__img"
        style="object-position: center 25%"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--farm" aria-hidden="true"></div>
    </div>

    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item"><a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.coffeeFarming.page}</li>
        </ol>
      </nav>

      <div class="farm-hero__content">
        <p class="page-hero__label">{t.coffeeFarming.label}</p>
        <h1 class="page-hero__title">{t.coffeeFarming.titleLine1}<br />{t.coffeeFarming.titleLine2}</h1>
        <p class="page-hero__sub">{t.coffeeFarming.subtitle}</p>
        <a href="#process" class="btn btn--primary">{t.coffeeFarming.ctaHero}</a>
      </div>
    </div>
    <div class="hero-scroll-line" aria-hidden="true"></div>
  </section>

  <!-- ── Stats Band ────────────────────────────────────── -->
  <section class="stat-band stat-band--green" aria-label="Statistik Pertanian Kopi">
    <div class="container">
      <div class="stat-band__grid">
        <div class="stat-band__item animate-on-scroll"><span class="stat-band__value">200+</span><span class="stat-band__label">{t.coffeeFarming.statFamilies}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 80ms"><span class="stat-band__value">1.500 mdpl</span><span class="stat-band__label">{t.coffeeFarming.statMaxAlt}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 160ms"><span class="stat-band__value">Giling Basah</span><span class="stat-band__label">{t.coffeeFarming.statMethod}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 240ms"><span class="stat-band__value">100 ton</span><span class="stat-band__label">{t.coffeeFarming.statCapacity}</span></div>
      </div>
    </div>
  </section>

  <!-- ── Process: 3-col Bento ──────────────────────────── -->
  <section class="process section" id="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.processTag}</p>
        <h2 id="process-heading" class="section-title">{nl(t.coffeeFarming.processTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.processSubtitle}</p>
      </div>

      <!-- Bento grid layout: wide cards at positions 1 and 6 -->
      <div class="bento-grid--3col">
        {process.map((step, i) => (
          <article class={`feature-card animate-on-scroll ${i === 0 || i === 5 ? 'feature-card--wide' : ''}`} style={`transition-delay: ${i * 60}ms`}>
            {step.img && (
              <div class="feature-card__img-wrap">
                <Image
                  src={step.img}
                  alt={t.coffeeFarming.farmImages?.[step.imgAltKey as keyof typeof t.coffeeFarming.farmImages] ?? ''}
                  loading="lazy"
                  widths={[400, 600]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  class="feature-card__img"
                />
                <div class="feature-card__img-overlay" aria-hidden="true"></div>
              </div>
            )}
            <div class="feature-card__icon" aria-hidden="true">
              <Icon name={step.iconName} width="20" height="20" />
            </div>
            <div class="feature-card__step">{step.step}</div>
            <h3 class="feature-card__title">{t.coffeeFarming[step.titleKey as keyof typeof t.coffeeFarming]}</h3>
            <p class="feature-card__desc">{t.coffeeFarming[step.descKey as keyof typeof t.coffeeFarming]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Regions ─────────────────────────────────────── -->
  <section class="regions section section--cream" aria-labelledby="regions-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.regionsTag}</p>
        <h2 id="regions-heading" class="section-title">{nl(t.coffeeFarming.regionsTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.regionsSubtitle}</p>
      </div>

      <div class="regions__grid">
        {regions.map((region, i) => (
          <article class="region-card animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
            <div class="region-card__media">
              <Image
                src={region.img}
                alt={`Perkebunan kopi di ${t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, 33vw"
                class="region-card__img"
              />
              <div class="region-card__alt-badge">
                <Icon name="mdi:arrow-up" width="10" height="10" />
                {t.coffeeFarming[region.altKey as keyof typeof t.coffeeFarming]}
              </div>
            </div>
            <div class="region-card__body">
              <h3 class="region-card__name">{t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}</h3>
              <p class="region-card__desc">{t.coffeeFarming[region.descKey as keyof typeof t.coffeeFarming]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Farmer Stories ────────────────────────────────── -->
  <section class="farmers section" aria-labelledby="farmers-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.farmersTag}</p>
        <h2 id="farmers-heading" class="section-title">{nl(t.coffeeFarming.farmersTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.farmersSubtitle}</p>
      </div>

      <div class="farmers__grid">
        {farmers.map((farmer, i) => (
          <article class={`farmer-card animate-on-scroll ${i % 2 !== 0 ? 'farmer-card--rev' : ''}`}>
            <div class="farmer-card__media">
              <Image
                src={farmer.img}
                alt={`${t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]} — ${t.coffeeFarming.farmerRole}`}
                loading="lazy"
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="farmer-card__img"
              />
              <div class="farmer-card__info-badge">
                <span class="farmer-card__village">{t.coffeeFarming[farmer.villageKey as keyof typeof t.coffeeFarming]}</span>
                <span class="farmer-card__since">{t.coffeeFarming[farmer.sinceKey as keyof typeof t.coffeeFarming]}</span>
              </div>
            </div>
            <div class="farmer-card__content">
              <blockquote class="farmer-card__quote">
                <p>"{t.coffeeFarming[farmer.quoteKey as keyof typeof t.coffeeFarming]}"</p>
              </blockquote>
              <div class="farmer-card__author">
                <span class="farmer-card__name">{t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]}</span>
                <span class="farmer-card__role">{t.coffeeFarming.farmerRole}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────── -->
  <section class="page-cta page-cta--cream" aria-label="Bergabung sebagai Petani Partner">
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{nl(t.coffeeFarming.ctaTitle)}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{t.coffeeFarming.ctaSubtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">{t.coffeeFarming.cta1}</a>
        <a href={`/${lang}/company`} class="btn btn--outline-dark">{t.coffeeFarming.cta2}</a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
