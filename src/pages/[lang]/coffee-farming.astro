---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import { useTranslations } from '../../i18n/utils';

// Import Sections
import FarmingHero from '../../components/sections/farming/FarmingHero.astro';
import FarmingStats from '../../components/sections/farming/FarmingStats.astro';
import HarvestingProcedure from '../../components/sections/farming/HarvestingProcedure.astro';
import Process from '../../components/sections/farming/Process.astro';
import Roasting from '../../components/sections/farming/Roasting.astro';
import Regions from '../../components/sections/farming/Regions.astro';
import Quality from '../../components/sections/farming/Quality.astro';
import Farmer from '../../components/sections/farming/Farmer.astro';
import LocationMap from '../../components/sections/farming/LocationMap.astro';
import FarmingCta from '../../components/sections/farming/FarmingCta.astro';

const { lang } = Astro.params;

const currentLang = ['id', 'en', 'fr'].includes(lang || '') ? (lang as 'id' | 'en' | 'fr') : 'id';

const t = useTranslations(currentLang);
---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={currentLang}>
  <Navbar lang={currentLang} />
  
  <header>
    <FarmingHero lang={currentLang} />
    <FarmingStats lang={currentLang} />
  </header>
  
  <main>
    <HarvestingProcedure lang={currentLang} />
    <Process lang={currentLang} />
    <Roasting lang={currentLang} />
    <Regions lang={currentLang} />
    <Quality lang={currentLang} />
    <Farmer lang={currentLang} />
    <LocationMap lang={currentLang} />
    <FarmingCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { 
          e.target.classList.add('is-visible'); 
          observer.unobserve(e.target); 
        }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>