---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import farmingBg from '../../images/bg/bg-farming.jpg';
import fProcess1 from '../../images/farming/coffee-cherry(2).jpg';
import fProcess2 from '../../images/farming/process.jpg';
import fProcess3 from '../../images/farming/process (2).jpg';
import fProcess4 from '../../images/farming/process (3).jpg';
import fProcess5 from '../../images/farming/process (4).jpg';
import fProcess6 from '../../images/farming/process (5).jpg';
import fProcess7b from '../../images/farming/process (7).jpg';
import fProcess8 from '../../images/farming/process(3).jpg';
import fProcess9 from '../../images/farming/process (6).jpg';
import fProcess10 from '../../images/farming/sorting.jpg';
import fGreen   from '../../images/farming/coffee-green.jpg';
import fCup2    from '../../images/farming/cup-and-test(2).jpg';
import fFarm from '../../images/farming/coffee-plantation.jpg';
import fFarm2 from '../../images/farming/coffee-plantation (2).jpg';
import fFarm3 from '../../images/farming/coffee-plantation (3).jpg';
import fCup from '../../images/farming/cup-and-test.jpg';
import fFarmer1 from '../../images/farming/farmer.jpg';
import fFarmer2 from '../../images/farming/farmer-1.jpg';
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

/** Replace newlines with <br> tags — used with set:html */
const nl = (s: string) => s.split('\n').join('<br>');

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

const regions = [
  { nameKey: 'regionLintong', altKey: 'regionLintongAlt', descKey: 'regionLintongDesc', img: fFarm },
  { nameKey: 'regionDolok',   altKey: 'regionDolokAlt',   descKey: 'regionDolokDesc',   img: fFarm2   },
  { nameKey: 'regionHumbang', altKey: 'regionHumbangAlt', descKey: 'regionHumbangDesc', img: fFarm3 },
];

const farmers = [
  { nameKey: 'farmerMargondang', villageKey: 'farmerMargondangVillage', sinceKey: 'farmerMargondangSince', quoteKey: 'farmerMargondangQuote', img: fFarmer1 },
  { nameKey: 'farmerRohani',     villageKey: 'farmerRohaniVillage',     sinceKey: 'farmerRohaniSince',     quoteKey: 'farmerRohaniQuote',     img: fFarmer2 },
];
---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={lang}>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="page-hero page-hero--tall" aria-label="Budidaya Kopi Kopi Siholta">
    <div class="page-hero__bg">
      <Image
        src={farmingBg}
        alt={t.coffeeFarming.farmImages?.altFarm ?? ''}
        class="page-hero__img"
        style="object-position: center 25%"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--farm" aria-hidden="true"></div>
    </div>

    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item"><a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a></li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.coffeeFarming.page}</li>
        </ol>
      </nav>

      <div class="farm-hero__content">
        <p class="page-hero__label">{t.coffeeFarming.label}</p>
        <h1 class="page-hero__title">{t.coffeeFarming.titleLine1}<br />{t.coffeeFarming.titleLine2}</h1>
        <p class="page-hero__sub">{t.coffeeFarming.subtitle}</p>
        <a href="#process" class="btn btn--primary">{t.coffeeFarming.ctaHero}</a>
      </div>
    </div>
  </section>

  <!-- ── Stats Band ────────────────────────────────────── -->
  <section class="stat-band stat-band--green" aria-label="Statistik Pertanian Kopi">
    <div class="container">
      <div class="stat-band__grid">
        <div class="stat-band__item animate-on-scroll"><span class="stat-band__value">200+</span><span class="stat-band__label">{t.coffeeFarming.statFamilies}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 80ms"><span class="stat-band__value">1.500 mdpl</span><span class="stat-band__label">{t.coffeeFarming.statMaxAlt}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 160ms"><span class="stat-band__value">Giling Basah</span><span class="stat-band__label">{t.coffeeFarming.statMethod}</span></div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 240ms"><span class="stat-band__value">100 ton</span><span class="stat-band__label">{t.coffeeFarming.statCapacity}</span></div>
      </div>
    </div>
  </section>

  <!-- ── Process: Journey Chapters ─────────────────────── -->
  <section class="journey section section--cream" id="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.processTag}</p>
        <h2 id="process-heading" class="section-title">{nl(t.coffeeFarming.processTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.processSubtitle}</p>
      </div>

      <div class="journey__timeline">

        <div class="journey__chapter animate-on-scroll">
          <div class="journey__chapter-img">
            <Image src={fFarmer2} alt={t.coffeeFarming.farmImages?.altCherry ?? ''} loading="lazy" widths={[600,900]} sizes="(max-width:768px) 100vw, 42vw" class="journey__img" />
          </div>
          <div class="journey__chapter-body">
            <span class="journey__chapter-num" aria-hidden="true">01</span>
            <div class="journey__step">
              <span class="journey__step-dot"></span>
              <span class="journey__step-label">{t.coffeeFarming.processTag}</span>
            </div>
            <div class="journey__divider"></div>
            <h3 class="journey__title">{t.coffeeFarming.stepCherry}</h3>
            <p class="journey__desc">{t.coffeeFarming.stepCherryDesc}</p>
          </div>
        </div>

        <div class="journey__chapter journey__chapter--rev animate-on-scroll">
          <div class="journey__chapter-img">
            <Image src={fProcess8} alt={t.coffeeFarming.farmImages?.altFerment ?? ''} loading="lazy" widths={[600,900]} sizes="(max-width:768px) 100vw, 58vw" class="journey__img" />
          </div>
          <div class="journey__chapter-body">
            <span class="journey__chapter-num" aria-hidden="true">02</span>
            <div class="journey__step">
              <span class="journey__step-dot"></span>
              <span class="journey__step-label">{t.coffeeFarming.processTag}</span>
            </div>
            <div class="journey__divider"></div>
            <h3 class="journey__title">{t.coffeeFarming.stepFerment}</h3>
            <p class="journey__desc">{t.coffeeFarming.stepFermentDesc}</p>
          </div>
        </div>

        <div class="journey__chapter animate-on-scroll">
          <div class="journey__chapter-img">
            <Image src={fProcess3} alt={t.coffeeFarming.farmImages?.altWetHull ?? ''} loading="lazy" widths={[600,900]} sizes="(max-width:768px) 100vw, 42vw" class="journey__img" />
          </div>
          <div class="journey__chapter-body">
            <span class="journey__chapter-num" aria-hidden="true">03</span>
            <div class="journey__step">
              <span class="journey__step-dot"></span>
              <span class="journey__step-label">{t.coffeeFarming.processTag}</span>
            </div>
            <div class="journey__divider"></div>
            <h3 class="journey__title">{t.coffeeFarming.stepWetHull}</h3>
            <p class="journey__desc">{t.coffeeFarming.stepWetHullDesc}</p>
          </div>
        </div>

        <div class="journey__chapter journey__chapter--rev animate-on-scroll">
          <div class="journey__chapter-img">
            <Image src={fProcess9} alt={t.coffeeFarming.farmImages?.altDrying ?? ''} loading="lazy" widths={[600,900]} sizes="(max-width:768px) 100vw, 58vw" class="journey__img" />
          </div>
          <div class="journey__chapter-body">
            <span class="journey__chapter-num" aria-hidden="true">04</span>
            <div class="journey__step">
              <span class="journey__step-dot"></span>
              <span class="journey__step-label">{t.coffeeFarming.processTag}</span>
            </div>
            <div class="journey__divider"></div>
            <h3 class="journey__title">{t.coffeeFarming.stepDrying}</h3>
            <p class="journey__desc">{t.coffeeFarming.stepDryingDesc}</p>
          </div>
        </div>

        <div class="journey__chapter animate-on-scroll">
          <div class="journey__chapter-img">
            <Image src={fProcess10} alt={t.coffeeFarming.farmImages?.altSorting ?? ''} loading="lazy" widths={[600,900]} sizes="(max-width:768px) 100vw, 42vw" class="journey__img" />
          </div>
          <div class="journey__chapter-body">
            <span class="journey__chapter-num" aria-hidden="true">05</span>
            <div class="journey__step">
              <span class="journey__step-dot"></span>
              <span class="journey__step-label">{t.coffeeFarming.processTag}</span>
            </div>
            <div class="journey__divider"></div>
            <h3 class="journey__title">{t.coffeeFarming.stepSorting}</h3>
            <p class="journey__desc">{t.coffeeFarming.stepSortingDesc}</p>
          </div>
        </div>

        <div class="journey__chapter journey__chapter--rev animate-on-scroll">
          <div class="journey__chapter-img">
            <Image src={fProcess6} alt={t.coffeeFarming.farmImages?.altRoasting ?? ''} loading="lazy" widths={[600,900]} sizes="(max-width:768px) 100vw, 58vw" class="journey__img" />
          </div>
          <div class="journey__chapter-body">
            <span class="journey__chapter-num" aria-hidden="true">06</span>
            <div class="journey__step">
              <span class="journey__step-dot"></span>
              <span class="journey__step-label">{t.coffeeFarming.processTag}</span>
            </div>
            <div class="journey__divider"></div>
            <h3 class="journey__title">{t.coffeeFarming.stepRoasting}</h3>
            <p class="journey__desc">{t.coffeeFarming.stepRoastingDesc}</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Regions ─────────────────────────────────────── -->
  <section class="regions section section--cream" aria-labelledby="regions-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.regionsTag}</p>
        <h2 id="regions-heading" class="section-title">{nl(t.coffeeFarming.regionsTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.regionsSubtitle}</p>
      </div>

      <div class="regions__grid">
        {regions.map((region, i) => (
          <article class="region-card animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
            <div class="region-card__media">
              <Image
                src={region.img}
                alt={`Perkebunan kopi di ${t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, 33vw"
                class="region-card__img"
              />
              <div class="region-card__alt-badge">
                <Icon name="mdi:arrow-up" width="10" height="10" />
                {t.coffeeFarming[region.altKey as keyof typeof t.coffeeFarming]}
              </div>
            </div>
            <div class="region-card__body">
              <h3 class="region-card__name">{t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}</h3>
              <p class="region-card__desc">{t.coffeeFarming[region.descKey as keyof typeof t.coffeeFarming]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Quality Editorial — photo + dark panel ───────── -->
  <section class="quality-editorial section" aria-labelledby="quality-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.qualityTag}</p>
        <h2 id="quality-heading" class="section-title">{nl(t.coffeeFarming.qualityTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.qualitySubtitle}</p>
      </div>

      <div class="quality-editorial__body">

        <!-- Left: photo grid -->
        <div class="quality-editorial__gallery">
          <div class="quality-editorial__gallery-item">
            <Image src={fCup2} alt={t.coffeeFarming.qualityGallery1Alt} loading="lazy" widths={[600,1200]} sizes="(max-width:768px) 100vw, 50vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery1}</span>
          </div>
          <div class="quality-editorial__gallery-item">
            <Image src={fGreen} alt={t.coffeeFarming.qualityGallery2Alt} loading="lazy" widths={[300,600]} sizes="(max-width:768px) 50vw, 25vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery2}</span>
          </div>
          <div class="quality-editorial__gallery-item">
            <Image src={fProcess7b} alt={t.coffeeFarming.qualityGallery3Alt} loading="lazy" widths={[300,600]} sizes="(max-width:768px) 50vw, 25vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery3}</span>
          </div>
        </div>

        <!-- Right: editorial text panel -->
        <div class="quality-editorial__panel animate-on-scroll">
          <div>
            <p class="quality-editorial__panel-tag">{t.coffeeFarming.qualityTag}</p>
            <h3 class="quality-editorial__panel-title">{nl(t.coffeeFarming.qualityPanelTitle)}</h3>
          </div>
          <p class="quality-editorial__panel-text">{t.coffeeFarming.qualityPanelText}</p>
          <div class="quality-editorial__panel-stats">
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat1Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat1Label}</span>
            </div>
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat2Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat2Label}</span>
            </div>
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat3Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat3Label}</span>
            </div>
            <div class="quality-editorial__stat">
              <span class="quality-editorial__stat-value">{t.coffeeFarming.qualityStat4Value}</span>
              <span class="quality-editorial__stat-label">{t.coffeeFarming.qualityStat4Label}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Farmer Stories ────────────────────────────────── -->
  <section class="farmers section" aria-labelledby="farmers-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">{t.coffeeFarming.farmersTag}</p>
        <h2 id="farmers-heading" class="section-title">{nl(t.coffeeFarming.farmersTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.farmersSubtitle}</p>
      </div>

      <div class="farmers__grid">
        {farmers.map((farmer, i) => (
          <article class={`farmer-card animate-on-scroll ${i % 2 !== 0 ? 'farmer-card--rev' : ''}`}>
            <div class="farmer-card__media">
              <Image
                src={farmer.img}
                alt={`${t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]} — ${t.coffeeFarming.farmerRole}`}
                loading="lazy"
                widths={[480, 768]}
                sizes="(max-width: 768px) 100vw, 50vw"
                class="farmer-card__img"
              />
              <div class="farmer-card__info-badge">
                <span class="farmer-card__village">{t.coffeeFarming[farmer.villageKey as keyof typeof t.coffeeFarming]}</span>
                <span class="farmer-card__since">{t.coffeeFarming[farmer.sinceKey as keyof typeof t.coffeeFarming]}</span>
              </div>
            </div>
            <div class="farmer-card__content">
              <blockquote class="farmer-card__quote">
                <p>"{t.coffeeFarming[farmer.quoteKey as keyof typeof t.coffeeFarming]}"</p>
              </blockquote>
              <div class="farmer-card__author">
                <span class="farmer-card__name">{t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]}</span>
                <span class="farmer-card__role">{t.coffeeFarming.farmerRole}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────── -->
  <section class="page-cta page-cta--cream" aria-label="Bergabung sebagai Petani Partner">
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{nl(t.coffeeFarming.ctaTitle)}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{t.coffeeFarming.ctaSubtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">{t.coffeeFarming.cta1}</a>
        <!-- <a href={`/${lang}/company`} class="btn btn--outline-dark">{t.coffeeFarming.cta2}</a> -->
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
