---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import { useTranslations } from '../../i18n/utils';

import FarmingHero from '../../components/sections/farming/FarmingHero.astro';
import FarmingStats from '../../components/sections/farming/FarmingStats.astro';
import HarvestingProcedure from '../../components/sections/farming/HarvestingProcedure.astro';
import Process from '../../components/sections/farming/Process.astro';
import Roasting from '../../components/sections/farming/Roasting.astro';
import Regions from '../../components/sections/farming/Regions.astro';
import Quality from '../../components/sections/farming/Quality.astro';
import Farmer from '../../components/sections/farming/Farmer.astro';
import LocationMap from '../../components/sections/farming/LocationMap.astro';
import FarmingCta from '../../components/sections/farming/FarmingCta.astro';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}


---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={lang}>
  <Navbar lang={lang} />
  <header>
    <FarmingHero lang={lang} t={t}/>
    <FarmingStats lang={lang} t={t}/>
  </header>
  <main>
    <HarvestingProcedure lang={lang} t={t} />
    <Process lang={lang} t={t}/>
    <Roasting lang={lang} t={t}/>
    <Regions lang={lang} t={t}/>
    <Quality lang={lang} t={t}/>
    <Farmer lang={lang} t={t}/>
    <LocationMap lang={lang} t={t}/>
    <FarmingCta lang={lang} t={t}/>
  </main>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>

  /* ── Scroll-triggered animations ─────────────── */
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
