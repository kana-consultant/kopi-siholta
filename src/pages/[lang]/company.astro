---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import companyLogo from '../../images/logo/logo-company.jpg';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import companyBg from '../../images/bg/bg-company.jpg';

interface Props {
  lang?: 'id' | 'en' | 'fr';
}

const { lang = 'id' } = Astro.props;

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

// ── Content ──────────────────────────────────────────────────────────
const milestones = [
  {
    year: '2019',
    title: 'Akar Ditanam di Lintong',
    desc: 'PT Siholta Toba Indonesia resmi didirikan. Langkah pertama dimulai dari dataran tinggi Humbang Hasundutan, bekerja langsung dengan puluhan keluarga petani kopi tradisi.',
    iconName: 'mdi:sprout',
  },
  {
    year: '2020',
    title: 'Jaringan Petani Terbangun',
    desc: 'Kolaborasi dengan lebih dari 200 keluarga petani di Lintong dan Dolok. Proses Giling Basah tradisional dipertahankan sebagai ciri autentik kopi specialty.',
    iconName: 'mdi:account-group',
  },
  {
    year: '2021',
    title: 'Pasar Domestik Dikuasai',
    desc: 'Produk Kopi Siholta hadir di Tokopedia dan Shopee. Brand kopi specialty Indonesia mulai dikenal di seluruh nusantara.',
    iconName: 'mdi:shopping',
  },
  {
    year: '2022',
    title: 'Sertifikasi Internasional',
    desc: 'Kopi Siholta memenuhi standar specialty coffee dunia dan mulai menjangkau pasar ekspor ke Amerika, Eropa, dan Asia Timur.',
    iconName: 'mdi:certificate',
  },
  {
    year: '2023',
    title: 'Ekosistem Kopi Terintegrasi',
    desc: 'Ekspansi ke sektor F&B dan wisata kopi. Pengunjung dapat merasakan langsung pengalaman kopi dari pohon hingga cangkir di lokasi kami.',
    iconName: 'mdi:home',
  },
  {
    year: '2024',
    title: 'Visi 2035: Kopi Dunia',
    desc: 'PT Siholta Toba Indonesia menetapkan roadmap untuk menjadi exporter kopi specialty Indonesia terkemuka yang membawa nama Sumatra ke kancah global.',
    iconName: 'mdi:earth',
  },
];

const hexToRgb = (hex: string) =>
  hex.replace('#', '').match(/.{2}/g)?.map(v => parseInt(v, 16)).join(',') ?? '92,61,30';

const sectors = [
  {
    name: 'Coffee Farming',
    label: 'Agronomi & Produksi',
    desc: '200+ keluarga petani partner di dataran tinggi Lintong dan Dolok. Proses Giling Basah tradisional menghasilkan karakter unik kopi specialty Humbang Hasundutan yang telah diakui pasar dunia.',
    highlights: ['200+ Petani Partner', 'Lintong & Dolok Region', 'Giling Basah Tradisional', 'Arabika & Robusta Premium'],
    iconName: 'mdi:coffee',
    bgColor: '#F5F0EA',
    accentColor: '#5C3D1E',
    href: `/${lang}/coffee-farming`,
  },
  {
    name: 'F&B',
    label: 'Minuman & Kuliner',
    desc: 'Dari minuman hingga makanan berbasis kopi specialty Indonesia. Setiap produk F&B dibuat dengan bahan kopi pilihan yang diproses dengan standar specialty coffee.',
    highlights: ['Biji Kopi Pilihan', 'Standar Specialty', 'Varian Minuman', 'Kuliner Kopi Indonesia'],
    iconName: 'mdi:cup',
    bgColor: '#F0F0F5',
    accentColor: '#1A3A5C',
    href: `/${lang}/fnb`,
  },
  {
    name: 'Industry & Tourism',
    label: 'Industri & Pariwisata',
    desc: 'Pengalaman wisata kopi dari kebun hingga proses produksi. Kunjungan farm dan factory tour tersedia untuk tamu yang ingin mendalami cerita di balik setiap cangkir kopi.',
    highlights: ['Farm Tour', 'Factory Tour', 'Tasting Experience', 'Partnership B2B'],
    iconName: 'mdi:office-building',
    bgColor: '#EAF0EA',
    accentColor: '#2A4A20',
    href: `/${lang}/tourism`,
  },
];

// ── Breadcrumb translations ────────────────────────────────────────────
const breadcrumb = {
  id: { home: 'Beranda', page: 'Tentang Kami' },
  en: { home: 'Home', page: 'About Us' },
  fr: { home: 'Accueil', page: 'À Propos' },
};
const t = breadcrumb[lang] ?? breadcrumb.id;
---

<Base
  title="Tentang Kami — PT Siholta Toba Indonesia"
  description="PT Siholta Toba Indonesia: cerita, sejarah, dan tiga sektor usaha kami dalam industri kopi specialty Humbang Hasundutan."
  lang={lang}
>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="company-hero" aria-label="Tentang PT Siholta Toba Indonesia">
    <div class="company-hero__bg">
      <Image
        src={companyBg}
        alt="Perkebunan kopi di dataran tinggi Sumatera"
        class="company-hero__img"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--company" aria-hidden="true"></div>
    </div>

    <div class="container company-hero__inner">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href={`/${lang}/`} class="breadcrumb__link">{t.home}</a>
          </li>
          <li class="breadcrumb__sep" aria-hidden="true">
            <Icon name="mdi:chevron-right" width="10" height="10" />
          </li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
            {t.page}
          </li>
        </ol>
      </nav>

      <div class="company-hero__content page-hero__content">
        <p class="page-hero__label">Tentang Kami</p>
        <h1 class="page-hero__title">Warisan Kopi<br />dari Sumatera Utara</h1>
        <p class="page-hero__sub">Dari dataran tinggi Humbang Hasundutan ke seluruh dunia — sebuah perjalanan yang dimulai dari secangkir kopi dan keyakinan bahwa kopi Indonesia pantas berada di panggung dunia.</p>
      </div>
    </div>
  </section>

  <!-- ── Company Story ───────────────────────────────── -->
  <section class="story section" aria-labelledby="story-heading">
    <div class="container">
      <div class="story__grid">

        <div class="story__intro animate-on-scroll">
          <p class="section-tag">Cerita Kami</p>
          <h2 id="story-heading" class="story__heading">
            <Image
              src={companyLogo}
              alt="PT Siholta Toba Indonesia Logo"
              class="story__logo"
              loading="eager"
              widths={[120, 180, 240]}
              sizes="120px"
            />
            <span>PT SIHOLTA TOBA INDONESIA</span>
          </h2>
          <p class="story__body">Pada 2019, PT Siholta Toba Indonesia didirikan dengan satu misi: membawa kopi specialty Humbang Hasundutan — yang telah dikenal sejak era kolonial Belanda — ke panggung internasional. Nama "Siholta" berarti "pohon tua" dalam bahasa Batak, melambangkan akar yang dalam dan warisan yang dijaga.</p>
          <p class="story__body">Bermula dari puluhan petani partner di Lereng Sumatera, kini kami telah bertumbuh menjadi perusahaan kopi specialty terintegrasi yang menjalankan tiga sektor usaha sekaligus — dari agronomi hingga ke meja tamu Anda.</p>
          <div class="story__stats">
            <div class="story__stat">
              <span class="story__stat-num">2019</span>
              <span class="story__stat-label">Didirikan</span>
            </div>
            <div class="story__stat">
              <span class="story__stat-num">200+</span>
              <span class="story__stat-label">Petani Partner</span>
            </div>
            <div class="story__stat">
              <span class="story__stat-num">3</span>
              <span class="story__stat-label">Sektor Usaha</span>
            </div>
          </div>
        </div>

        <div class="story__image animate-on-scroll">
          <div class="story__image-frame">
            <Image
              src={companyBg}
              alt="Perkebunan kopi PT Siholta Toba Indonesia di Humbang Hasundutan"
              class="story__img"
              loading="lazy"
              widths={[480, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 50vw"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Timeline ───────────────────────────────────── -->
  <section class="timeline section section--cream" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">Garis Waktu</p>
        <h2 id="timeline-heading" class="section-title">Perjalanan Kami</h2>
        <p class="section-sub">Enam tahun membangun ekosistem kopi specialty Indonesia — dari fondasi petani hingga standar dunia.</p>
      </div>

      <ol class="timeline__list" role="list">
        {milestones.map((m, i) => (
          <li class={`timeline__item animate-on-scroll ${i % 2 === 0 ? 'timeline__item--left' : 'timeline__item--right'}`}>
            <div class="timeline__card">
              <div class="timeline__card-icon" aria-hidden="true"><Icon name={m.iconName} width="16" height="16" /></div>
              <div class="timeline__card-year">{m.year}</div>
              <h3 class="timeline__card-title">{m.title}</h3>
              <p class="timeline__card-desc">{m.desc}</p>
            </div>
            <div class="timeline__connector" aria-hidden="true">
              <div class="timeline__dot"></div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Operation Sectors ──────────────────────────── -->
  <section class="sectors section" aria-labelledby="sectors-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">Bidang Usaha</p>
        <h2 id="sectors-heading" class="section-title">Tiga Pilar Operaciones</h2>
        <p class="section-sub">PT Siholta Toba Indonesia menjalankan bisnis kopi melalui tiga sektor yang saling melengkapi — dari hulu hingga hilir.</p>
      </div>

      <div class="sectors__grid">
        {sectors.map((sector, i) => (
          <article
            class="sector-card animate-on-scroll"
            style={`--card-bg: ${sector.bgColor}; --card-accent: ${sector.accentColor}; --card-accent-rgb: ${hexToRgb(sector.accentColor)}`}>
            <div class="sector-card__header">
              <div class="sector-card__icon" aria-hidden="true"><Icon name={sector.iconName} width="24" height="24" /></div>
              <div>
                <p class="sector-card__label">{sector.label}</p>
                <h3 class="sector-card__name">{sector.name}</h3>
              </div>
            </div>
            <p class="sector-card__desc">{sector.desc}</p>
            <ul class="sector-card__highlights" role="list">
              {sector.highlights.map(h => (
                <li class="sector-card__highlight">
                  <Icon name="mdi:circle-small" width="10" height="10" />
                  {h}
                </li>
              ))}
            </ul>
            <a href={sector.href} class="sector-card__cta">
              Jelajahi
              <Icon name="mdi:chevron-right" width="12" height="12" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Location & Map ───────────────────────────────── -->
  <section class="location section" aria-labelledby="location-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">Lokasi Kami</p>
        <h2 id="location-heading" class="section-title">Kunjungi Kantor Kami</h2>
        <p class="section-sub">PT Siholta Toba Indonesia berpusat di dataran tinggi Humbang Hasundutan, Sumatera Utara — dekat dengan tradisi kopi terbaik Indonesia.</p>
      </div>
      <div class="location__map animate-on-scroll">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.756309399054!2d106.9037104!3d-6.295721899999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3007f623b53%3A0x118fc0912e442961!2sPT.%20Siholta%20Toba%20Indonesia!5e0!3m2!1sid!2sid!4v1778757552187!5m2!1sid!2sid"
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Lokasi PT Siholta Toba Indonesia"
        ></iframe>
      </div>
      <div class="location__address animate-on-scroll">
        <Icon name="mdi:map-marker" width="16" height="16" />
        <span>Dusun IV, Desa/Kelurahan Sitolu Bahal, Kec. Lintong Nihuta, Kab. Humbang Hasundutan, Provinsi Sumatera Utara, Kode Pos 22475</span>
      </div>
    </div>
  </section>

  <!-- ── CTA Banner ────────────────────────────────── -->
  <section class="page-cta page-cta--red" aria-label="Hubungi PT Siholta Toba Indonesia">
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title">Mari Mejangkau<br />Dunia Bersama</h2>
        <p class="page-cta__sub">Tertarik dengan kopi specialty Humbang Hasundutan? Hubungi tim kami untuk kemitraan, kunjungan farm, atau pertanyaan bisnis.</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">Hubungi Kami</a>
        <a href={`/${lang}/`} class="btn btn--outline-dark">Kembali ke Beranda</a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  // ── Scroll-triggered animations ────────────────────
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach((el) => observer.observe(el));

  // ── Stagger children of sectors grid ───────────────
  const sectorCards = document.querySelectorAll<HTMLElement>('.sector-card');
  sectorCards.forEach((card, i) => {
    (card as HTMLElement).style.transitionDelay = `${i * 80}ms`;
  });
</script>
