---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import { useTranslations } from '../../i18n/utils';

import CompanyHero from '../../components/sections/company/CompanyHero.astro';
import CompanyStory from '../../components/sections/company/CompanyStory.astro';
import VisiMisi from '../../components/sections/company/VisiMisi.astro';
import Timeline from '../../components/sections/company/Timeline.astro';
import Certifications from '../../components/sections/company/Certifications.astro';
import OperationSectors from '../../components/sections/company/OperationSectors.astro';
import LocationMap from '../../components/sections/company/LocationMap.astro';
import CertModal from '../../components/sections/company/CertModal.astro';
import CompanyCta from '../../components/sections/company/CompanyCta.astro';

const { lang } = Astro.params;
const currentLang = ['id', 'en', 'fr'].includes(lang || '') ? (lang as 'id' | 'en' | 'fr') : 'id';

const t = useTranslations(currentLang);



const tc = t.company as Record<string, string>;



---

<Base title={t.meta.titleCompany} description={t.meta.descCompany} lang={currentLang}>
  <Navbar lang={currentLang} />
  <header>
    <CompanyHero lang={currentLang} tc={tc} t={t}/>
  </header>
  <main>
    <CompanyStory tc={tc} />
    <VisiMisi tc={tc} />
    <Timeline tc={tc} />
    <Certifications tc={tc} />
    <OperationSectors lang={currentLang} tc={tc} />
    <LocationMap t={t} tc={tc} />
    <CompanyCta lang={currentLang} tc={tc} />
  </main>
  <Footer lang={currentLang} />
  <WhatsAppFAB />
  <CertModal tc={tc} />
</Base>

<script>
  // ── Scroll-triggered animations ────────────────────
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach((el) => observer.observe(el));

  // ── Stagger children of sectors grid ───────────────
  const sectorCards = document.querySelectorAll<HTMLElement>('.sector-card');
  sectorCards.forEach((card, i) => {
    (card as HTMLElement).style.transitionDelay = `${i * 80}ms`;
  });

</script>
