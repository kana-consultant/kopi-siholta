---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';

import CompanyHero from '@/components/sections/company/company-hero.astro';
import CompanyStory from '@/components/sections/company/company-story.astro';
import VisiMisi from '@/components/sections/company/visi-misi.astro';
import Timeline from '@/components/sections/company/time-line.astro';
import OperationSectors from '@/components/sections/company/operation-sectors.astro';
import LocationMap from '@/components/sections/company/location-map.astro';
import CertModal from '@/components/sections/company/cert-modal.astro';
import CompanyCta from '@/components/sections/company/company-cta.astro';
import Certifications from '@/components/sections/company/cert-section.astro';
import { getTranslations } from '@/i18n/utils';

const currentLang: 'id' | 'en' | 'fr' = (Astro.locals as any).lang || 'en';
const t = await getTranslations(currentLang);

---

<Base title={t.meta.titleCompany} description={t.meta.descCompany} lang={currentLang} breadcrumbs={[
  { name: t.breadcrumb.home, href: `/${currentLang}/` },
  { name: t.breadcrumb.company, href: `/${currentLang}/company` },
]}>
  <Navbar lang={currentLang} />
  <header>
    <CompanyHero lang={currentLang} />
  </header>
  <main id="main-content">
    <CompanyStory lang={currentLang} />
    <VisiMisi lang={currentLang} />
    <Timeline lang={currentLang} />
    <Certifications lang={currentLang} />
    <OperationSectors lang={currentLang} />
    <LocationMap lang={currentLang} />
    <CompanyCta lang={currentLang} />
  </main>
  <Footer lang={currentLang} />
  <WhatsAppFAB />
  <CertModal lang={currentLang} />
</Base>

<script>
  // ── Scroll-triggered animations ────────────────────
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach((el) => observer.observe(el));

  // ── Stagger children of sectors grid ───────────────
  const sectorCards = document.querySelectorAll<HTMLElement>('.sector-card');
  sectorCards.forEach((card, i) => {
    (card as HTMLElement).style.transitionDelay = `${i * 80}ms`;
  });

</script>
