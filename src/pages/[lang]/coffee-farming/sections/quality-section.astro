---
import { Image } from 'astro:assets';
import fProcess7b from '@/images/farming/process (7).jpg';
import fGreen   from '@/images/farming/coffee-green.jpg';
import fCup2    from '@/images/farming/cup-and-test(2).jpg';
import { nl } from '@/utils/helpers';
import '../styles/quality-section.css';

interface QualityStat {
  value: string;
  label: string;
}

interface GalleryItem {
  label: string;
  alt: string;
}

interface Props {
  title: string;
  subtitle: string;
  panelTitle: string;
  panelText: string;
  stats: QualityStat[];
  gallery: GalleryItem[];
}
const { title, subtitle, panelTitle, panelText, stats, gallery } = Astro.props;

const galleryImages = [fCup2, fGreen, fProcess7b];
---

<section class="quality-editorial section" aria-labelledby="quality-heading">
  <div class="container">
    <header class="section__header animate-on-scroll">
      <h2 id="quality-heading" class="section-title" set:html={nl(title)}></h2>
      <p class="section-sub">{subtitle}</p>
    </header>

    <div class="quality-editorial__body">
      <div class="quality-editorial__gallery">
        {gallery.map((item, i) => (
          <figure class="quality-editorial__gallery-item">
            <Image src={galleryImages[i]!} alt={item.alt} loading="lazy" widths={[600,1200]} sizes="(max-width:768px) 100vw, 50vw" class="quality-editorial__gallery-img" />
            <figcaption class="quality-editorial__gallery-label">{item.label}</figcaption>
          </figure>
        ))}
      </div>

      <article class="quality-editorial__panel animate-on-scroll">
        <header>
          <h3 class="quality-editorial__panel-title" set:html={nl(panelTitle)}></h3>
        </header>
        <p class="quality-editorial__panel-text">{panelText}</p>
        
        <div class="quality-editorial__panel-stats">
          {stats.map((stat, i) => (
            <div class="editorial-stat animate-on-scroll" style={`transition-delay:${i * 80}ms`}>
              <span class="editorial-stat__value">{stat.value}</span>
              <span class="editorial-stat__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
