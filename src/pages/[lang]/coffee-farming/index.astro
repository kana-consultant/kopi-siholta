---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';
import ScrollReveal from '@/components/shared/scroll-reveal.astro';

import FarmingHero from '@/pages/[lang]/coffee-farming/sections/hero.astro';
import FarmingStats from '@/pages/[lang]/coffee-farming/sections/stats.astro';
import HarvestingProcedure from '@/pages/[lang]/coffee-farming/sections/harvesting-procedure.astro';
import Process from '@/pages/[lang]/coffee-farming/sections/process-section.astro';
import Roasting from '@/pages/[lang]/coffee-farming/sections/roasting-section.astro';
import Regions from '@/pages/[lang]/coffee-farming/sections/regions-section.astro';
import Quality from '@/pages/[lang]/coffee-farming/sections/quality-section.astro';
import Farmer from '@/pages/[lang]/coffee-farming/sections/farmer-section.astro';
import LocationMap from '@/pages/[lang]/coffee-farming/sections/location-map.astro';
import FarmingCta from '@/pages/[lang]/coffee-farming/sections/cta.astro';


import { getTranslations } from '@/i18n/utils';

const currentLang: 'id' | 'en' | 'fr' = (Astro.locals as any).lang || 'en';
const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleFarming} description={t.meta.descFarming} lang={currentLang} breadcrumbs={[
  { name: t.breadcrumb.home, href: `/${currentLang}/` },
  { name: t.breadcrumb.coffeeFarming, href: `/${currentLang}/coffee-farming` },
]}>
  <Navbar lang={currentLang} />

  <header>
    <FarmingHero lang={currentLang} />
    <FarmingStats lang={currentLang} />
  </header>

  <main id="main-content">
    <HarvestingProcedure lang={currentLang} />
    <Process lang={currentLang} />
    <Roasting lang={currentLang} />
    <Regions lang={currentLang} />
    <Quality lang={currentLang} />
    <Farmer lang={currentLang} />
    <LocationMap lang={currentLang} />
    <FarmingCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
  <ScrollReveal/>
</Base>
