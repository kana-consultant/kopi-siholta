---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';

import FnbHero from '../../components/sections/fnb/FnbHero.astro';
import FnbStat from '../../components/sections/fnb/FnbStat.astro';
import RetailCoffee from '../../components/sections/fnb/RetailCoffee.astro';
import CafeFavorites from '../../components/sections/fnb/CafeFavorites.astro';
import RetailDistibution from '../../components/sections/fnb/RetailDistibution.astro';
import Sustainability from '../../components/sections/fnb/Sustainability.astro';
import FnbCta from '../../components/sections/fnb/FnbCta.astro';

import { useTranslations } from '../../i18n/utils';

const { lang } = Astro.params;
const currentLang = ['id', 'en', 'fr'].includes(lang || '') ? (lang as 'id' | 'en' | 'fr') : 'id';

const t = useTranslations(currentLang);
---

<Base title={t.meta.titleFnb} description={t.meta.descFnb} lang={currentLang}>
  <Navbar lang={currentLang} />
  
  <main id="main-content">
    <FnbHero lang={currentLang} />
    <FnbStat lang={currentLang} />
    <RetailCoffee lang={currentLang} />
    <CafeFavorites lang={currentLang} />
    <RetailDistibution lang={currentLang} />
    <Sustainability lang={currentLang} />
    <FnbCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { 
          e.target.classList.add('is-visible'); 
          observer.unobserve(e.target); 
        }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>