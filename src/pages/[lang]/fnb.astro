---
export const prerender = false;

import Base from '@/layouts/base-layout.astro';
import Navbar from '@/components/layout/navbar-layout.astro';
import Footer from '@/components/layout/footer-layout.astro';
import WhatsAppFAB from '@/components/layout/wa-fab.astro';

import FnbHero from '@/components/sections/fnb/fnb-hero.astro';
import FnbStat from '@/components/sections/fnb/fnb-stats.astro';
import RetailCoffee from '@/components/sections/fnb/retail-coffee.astro';
import CafeFavorites from '@/components/sections/fnb/cafe-favorites.astro';
import RetailDistribution from '@/components/sections/fnb/retail-distribution.astro';
import Sustainability from '@/components/sections/fnb/sustainability-section.astro';
import FnbCta from '@/components/sections/fnb/fnb-cta.astro';

import { getTranslations } from '@/i18n/utils';

const currentLang: 'id' | 'en' | 'fr' = (Astro.locals as any).lang || 'en';
const t = await getTranslations(currentLang);
---

<Base title={t.meta.titleFnb} description={t.meta.descFnb} lang={currentLang} breadcrumbs={[
  { name: t.breadcrumb.home, href: `/${currentLang}/` },
  { name: t.breadcrumb.fnb, href: `/${currentLang}/fnb` },
]}>
  <Navbar lang={currentLang} />
  
  <main id="main-content">
    <FnbHero lang={currentLang} />
    <FnbStat lang={currentLang} />
    <RetailCoffee lang={currentLang} />
    <CafeFavorites lang={currentLang} />
    <RetailDistribution lang={currentLang} />
    <Sustainability lang={currentLang} />
    <FnbCta lang={currentLang} />
  </main>

  <Footer lang={currentLang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { 
          e.target.classList.add('is-visible'); 
          observer.unobserve(e.target); 
        }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>