---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import fnbBg from '../../images/bg/bg-fnb.jpg';
import fnbHero1 from '../../images/fnb/barista.jpg';
import fnbHero2 from '../../images/fnb/coffee-cup.jpg';
import fnbHero3 from '../../images/fnb/caffee.jpg';
import fnbHero4 from '../../images/fnb/coffee.jpg';
import fnbHero5 from '../../images/fnb/coffee (2).jpg';
import fnbHero6 from '../../images/fnb/coffee (3).jpg';
import fnbHero7 from '../../images/fnb/coffee-cup (2).jpg';
import fnbHero8 from '../../images/fnb/barista (2).jpg';
import fnbHero9 from '../../images/fnb/coffee (3).jpg';
import fnbHero10 from '../../images/hero/hero-4.jpg';
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

/** Replace newlines with <br> tags — used with set:html */
const nl = (s: string) => s.split('\n').join('<br>');

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

/* ── Menu Data ──────────────────────── */
const drinks = [
  {
    nameKey: 'drinkEspresso', noteKey: 'drinkEspressoNote', descKey: 'drinkEspressoDesc',
    priceKey: 'espressoPrice', img: fnbHero2,
    imgAltKey: 'altBarista', tag: 'Signature', tagColor: '#CD1222',
  },
  {
    nameKey: 'drinkAffogato', noteKey: 'drinkAffogatoNote', descKey: 'drinkAffogatoDesc',
    priceKey: 'affogatoPrice', img: fnbHero4,
    imgAltKey: 'altProcess', tag: 'Populer', tagColor: '#5C3D1E',
  },
  {
    nameKey: 'drinkV60', noteKey: 'drinkV60Note', descKey: 'drinkV60Desc',
    priceKey: 'v60Price', img: fnbHero3,
    imgAltKey: 'altAtmosphere', tag: 'Barista Choice', tagColor: '#225522',
  },
  {
    nameKey: 'drinkKopiSusu', noteKey: 'drinkKopiSusuNote', descKey: 'drinkKopiSusuDesc',
    priceKey: 'kopiSusuPrice', img: fnbHero7,
    imgAltKey: 'altCoffeeMilk', tag: 'Best Seller', tagColor: '#D4A046',
  },
];

const food = [
  { nameKey: 'foodRotiBabi',    descKey: 'foodRotiBabiDesc',    priceKey: 'rotiBabiPrice'    },
  { nameKey: 'foodNagasari',    descKey: 'foodNagasariDesc',    priceKey: 'nagasariPrice'    },
  { nameKey: 'foodLapis',       descKey: 'foodLapisDesc',       priceKey: 'lapisPrice'       },
  { nameKey: 'foodBananaBread', descKey: 'foodBananaBreadDesc', priceKey: 'bananaBreadPrice' },
];
---

<Base title={t.meta.titleFnb} description={t.meta.descFnb} lang={lang}>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="page-hero page-hero--mid" aria-label="F&B Kopi Siholta">
    <div class="page-hero__bg">
      <Image
        src={fnbBg}
        alt={t.fnb.gallery?.altAtmosphere ?? ''}
        class="page-hero__img"
        style="object-position: center 40%"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--fnb" aria-hidden="true"></div>
    </div>

    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a>
          </li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item">
            <a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a>
          </li>
          <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.fnb.page}</li>
        </ol>
      </nav>

      <div class="fnb-hero__content">
        <h1 class="page-hero__title">{t.fnb.titleLine1}<br />{t.fnb.titleLine2}</h1>
        <p class="page-hero__sub">{t.fnb.subtitle}</p>
      </div>
    </div>
  </section>
    <!-- ── Stats Band (shared layout) ──────────────────── -->
  <section class="stat-band stat-band--green" aria-label="F&B Statistics">
    <div class="container">
      <div class="stat-band__grid">
        <div class="stat-band__item animate-on-scroll">
          <span class="stat-band__value">{t.fnb.stats.statMenuItemsValue}{t.fnb.stats.statMenuItemsUnit}</span>
          <span class="stat-band__label">{t.fnb.statMenuItems}</span>
        </div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 80ms">
          <span class="stat-band__value">{t.fnb.stats.statDrinksValue}</span>
          <span class="stat-band__label">{t.fnb.statDrinks}</span>
        </div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 160ms">
          <span class="stat-band__value">{t.fnb.stats.statCupsDayValue}{t.fnb.stats.statCupsDayUnit}</span>
          <span class="stat-band__label">{t.fnb.statCupsDay}</span>
        </div>
        <div class="stat-band__item animate-on-scroll" style="transition-delay: 240ms">
          <span class="stat-band__value">{t.fnb.stats.statYearsExpValue}{t.fnb.stats.statYearsExpUnit}</span>
          <span class="stat-band__label">{t.fnb.statYearsExp}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Drinks: Bento Layout ─────────────────────────── -->
  <section class="drinks section" aria-labelledby="drinks-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="drinks-heading" class="section-title">{t.fnb.drinksTitle}</h2>
        <p class="section-sub">{t.fnb.drinksSubtitle}</p>
      </div>

      <!-- Bento: 2-col asymmetric — large left + 3 stacked right -->
      <div class="drinks__grid animate-on-scroll">

        <!-- Feature card: espresso — large, spans 2 rows visually -->
        <article class="drink-card drink-card--feature animate-on-scroll">
          <div class="drink-card__media">
            <Image
              src={drinks[0].img}
              alt={t.fnb.gallery?.[drinks[0].imgAltKey as keyof typeof t.fnb.gallery] ?? ''}
              loading="eager"
              widths={[480, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 55vw"
              class="drink-card__img"
            />
            <div class="drink-card__tag" style={`background: ${drinks[0].tagColor}`}>
              {t.products.tagSignature}
            </div>
          </div>
          <div class="drink-card__body">
            <p class="drink-card__note">{t.fnb[drinks[0].noteKey as keyof typeof t.fnb]}</p>
            <h3 class="drink-card__name">{t.fnb[drinks[0].nameKey as keyof typeof t.fnb]}</h3>
            <p class="drink-card__desc">{t.fnb[drinks[0].descKey as keyof typeof t.fnb]}</p>
            <span class="drink-card__price">{t.fnb.drinks[drinks[0].priceKey as keyof typeof t.fnb.drinks]}</span>
          </div>
        </article>

        <!-- 3 stacked mini cards -->
        <div class="drinks__stack">
          {drinks.slice(1).map((drink, i) => (
            <article class="drink-card drink-card--mini animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
              <div class="drink-card__media">
                <Image
                  src={drink.img}
                  alt={t.fnb.gallery?.[drink.imgAltKey as keyof typeof t.fnb.gallery] ?? ''}
                  loading="lazy"
                  widths={[300, 480]}
                  sizes="(max-width: 768px) 50vw, 25vw"
                  class="drink-card__img"
                />
                <div class="drink-card__tag drink-card__tag--sm" style={`background: ${drink.tagColor}`}>
                  {drink.tag === 'Populer' ? t.products.tagPopular : drink.tag === 'Barista Choice' ? t.products.tagBaristaChoice : t.products.tagBestSeller}
                </div>
              </div>
              <div class="drink-card__body drink-card__body--sm">
                <p class="drink-card__note drink-card__note--sm">{t.fnb[drink.noteKey as keyof typeof t.fnb]}</p>
                <h3 class="drink-card__name drink-card__name--sm">{t.fnb[drink.nameKey as keyof typeof t.fnb]}</h3>
                <p class="drink-card__desc drink-card__desc--sm">{t.fnb[drink.descKey as keyof typeof t.fnb]}</p>
                <span class="drink-card__price drink-card__price--sm">{t.fnb.drinks[drink.priceKey as keyof typeof t.fnb.drinks]}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Full-width Image Break ─────────────────────── -->
  <div class="fnb-image-break" aria-hidden="true">
    <Image
      src={fnbHero10}
      alt=""
      loading="lazy"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      class="fnb-image-break__img"
    />
    <div class="fnb-image-break__overlay">
      <blockquote class="fnb-quote">
        <p>"{t.fnb.quote}"</p>
        <cite>— {t.fnb.quoteAuthor}</cite>
      </blockquote>
    </div>
  </div>

  <!-- ── Food ─────────────────────────────────────── -->
  <section class="food section section--cream" aria-labelledby="food-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="food-heading" class="section-title">{t.fnb.foodTitle}</h2>
        <p class="section-sub">{t.fnb.foodSubtitle}</p>
      </div>

      <div class="food__grid">
        {food.map((item, i) => (
          <article class="food-card animate-on-scroll" style={`transition-delay: ${i * 60}ms`}>
            <div class="food-card__dot" aria-hidden="true"></div>
            <div class="food-card__body">
              <h3 class="food-card__name">{t.fnb[item.nameKey as keyof typeof t.fnb]}</h3>
              <p class="food-card__desc">{t.fnb[item.descKey as keyof typeof t.fnb]}</p>
            </div>
            <span class="food-card__price">{t.fnb.food[item.priceKey as keyof typeof t.fnb.food]}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Gallery Mosaic ────────────────────── -->
  <section class="gallery-mosaic" aria-label={t.fnb.galleryTitle}>
    <div class="gallery-mosaic__grid">
      <!-- Left tall column -->
      <div class="gallery-mosaic__col gallery-mosaic__col--tall">
        <div class="gallery-mosaic__item gallery-mosaic__item--portrait">
          <Image
            src={fnbHero1}
            alt={t.fnb.gallery?.altBarista ?? ''}
            loading="lazy"
            widths={[480, 768]}
            sizes="(max-width: 768px) 100vw, 33vw"
            class="gallery-mosaic__img"
          />
        </div>
      </div>
      <!-- Center column: 2-row layout -->
      <div class="gallery-mosaic__col gallery-mosaic__col--center">
        <div class="gallery-mosaic__row gallery-mosaic__row--pair">
          <div class="gallery-mosaic__item">
            <Image
              src={fnbHero2}
              alt={t.fnb.gallery?.altCoffeeMilk ?? ''}
              loading="lazy"
              widths={[400, 600]}
              sizes="(max-width: 768px) 50vw, 22vw"
              class="gallery-mosaic__img"
            />
          </div>
          <div class="gallery-mosaic__item">
            <Image
              src={fnbHero3}
              alt={t.fnb.gallery?.altAtmosphere ?? ''}
              loading="lazy"
              widths={[400, 600]}
              sizes="(max-width: 768px) 50vw, 22vw"
              class="gallery-mosaic__img"
            />
          </div>
        </div>
        <!-- Bottom row: 1 full-width image -->
        <div class="gallery-mosaic__item gallery-mosaic__item--wide">
          <Image
            src={fnbHero8}
            alt={t.fnb.gallery?.altProcess ?? ''}
            loading="lazy"
            widths={[600, 900]}
            sizes="(max-width: 768px) 100vw, 44vw"
            class="gallery-mosaic__img"
          />
        </div>
      </div>
      <!-- Right tall column -->
      <div class="gallery-mosaic__col gallery-mosaic__col--tall">
        <div class="gallery-mosaic__item gallery-mosaic__item--portrait">
          <Image
            src={fnbHero5}
            alt={t.fnb.gallery?.altVariants ?? ''}
            loading="lazy"
            widths={[480, 768]}
            sizes="(max-width: 768px) 100vw, 33vw"
            class="gallery-mosaic__img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────── -->
  <section class="page-cta page-cta--cream" aria-label={t.fnb.ctaTitle}>
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">{nl(t.fnb.ctaTitle)}</h2>
        <p class="page-cta__sub page-cta__sub--earth">{t.fnb.ctaSubtitle}</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">{t.fnb.cta1}</a>
        <!-- <a href={`/${lang}/tourism`} class="btn btn--outline-dark">{t.fnb.cta2}</a> -->
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>
