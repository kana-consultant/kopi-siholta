---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';
import fnbBg from '../../images/bg/bg-fnb.jpg';
import h1 from '../../images/heritage/heritage-1.jpg';
import h2 from '../../images/heritage/heritage-2.jpg';
import h3 from '../../images/heritage/heritage-3.jpg';
import h4 from '../../images/heritage/heritage-4.jpg';
import h5 from '../../images/heritage/heritage-5.jpg';

interface Props {
  lang?: 'id' | 'en' | 'fr';
}

const { lang = 'id' } = Astro.props;

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}

const breadcrumb = {
  id: { home: 'Beranda', company: 'Tentang Kami', page: 'F&B' },
  en: { home: 'Home', company: 'About Us', page: 'F&B' },
  fr: { home: 'Accueil', company: 'À Propos', page: 'Restauration' },
};
const t = breadcrumb[lang] ?? breadcrumb.id;

const drinks = [
  {
    name: 'Espresso Siholta',
    note: 'Rempah · Bold · Dark Chocolate',
    desc: 'Espresso murni dari biji Arabika Lintong pilihan. Body penuh, aftertaste cokelat pahit yang tahan lama.',
    price: 'Rp 28.000',
    img: h1,
    imgAlt: 'Espresso Siholta — espresso shot dari kopi Lintong',
    tag: 'Signature',
    tagColor: '#CD1222',
  },
  {
    name: 'Affogato Lintong',
    note: 'Vanila · Karamel · Kopi',
    desc: 'Scoop es krim vanila drown dalam espresso panas. Kontras suhu yang memanjakan.',
    price: 'Rp 35.000',
    img: h2,
    imgAlt: 'Affogato Lintong — es krim vanila dengan espresso Siholta',
    tag: 'Populer',
    tagColor: '#5C3D1E',
  },
  {
    name: 'V60 Single Origin',
    note: 'Floral · Fruity · Bright',
    desc: 'Biji Arabika diproses manual brew V60. Menonjolkan profil bright dan fruity khas Lintong.',
    price: 'Rp 38.000',
    img: h3,
    imgAlt: 'V60 Single Origin — manual brew kopi Lintong',
    tag: 'Barista Choice',
    tagColor: '#225522',
  },
  {
    name: 'Kopi Susu Humbang',
    note: 'Creamy · Hazelnut · Balanced',
    desc: 'Espresso dicampur susu steamed dan sirup hazel. Resep rahasia yang dikembangkan tim barista kami.',
    price: 'Rp 32.000',
    img: h4,
    imgAlt: 'Kopi Susu Humbang — signature milk coffee dari Kopi Siholta',
    tag: 'Best Seller',
    tagColor: '#D4A046',
  },
];

const food = [
  { name: 'Roti Babi Klasik', desc: 'Pastry renyah berisi daging cincang rempah khas Sumatera.', price: 'Rp 25.000' },
  { name: 'Nagasari Kopi', desc: 'Kue tradisional dengan infuse bubuk kopi untuk aroma khas.', price: 'Rp 18.000' },
  { name: 'Lapis Sumatera', desc: 'Kue lapis dengan lapisan cream kopi dan cokelat.', price: 'Rp 22.000' },
  { name: 'Banana Bread Lintong', desc: 'Banana bread dengan crumble kopi di setiap gigitan.', price: 'Rp 28.000' },
];
---

<Base
  title="F&B — Kopi Siholta"
  description="Nikmati minuman dan makanan berbasis kopi specialty di outlet F&B Kopi Siholta. Dari espresso hingga kuliner kopi lokal Sumatera."
  lang={lang}
>
  <Navbar lang={lang} />

  <!-- ── Hero ─────────────────────────────────────────── -->
  <section class="page-hero page-hero--mid" aria-label="F&B Kopi Siholta">
    <div class="page-hero__bg">
      <Image
        src={fnbBg}
        alt="Suasana kafe Kopi Siholta dengan minuman kopi specialty"
        class="page-hero__img"
        style="object-position: center 40%"
        loading="eager"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
      <div class="page-hero__overlay page-hero__overlay--fnb" aria-hidden="true"></div>
    </div>

    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href={`/${lang}/`} class="breadcrumb__link">{t.home}</a>
          </li>
          <li class="breadcrumb__sep" aria-hidden="true">
            <Icon name="mdi:chevron-right" width="10" height="10" />
          </li>
          <li class="breadcrumb__item">
            <a href={`/${lang}/company`} class="breadcrumb__link">{t.company}</a>
          </li>
          <li class="breadcrumb__sep" aria-hidden="true">
            <Icon name="mdi:chevron-right" width="10" height="10" />
          </li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
            {t.page}
          </li>
        </ol>
      </nav>

      <div class="fnb-hero__content">
        <p class="page-hero__label">F&B Experience</p>
        <h1 class="page-hero__title">Minum Kopi.<br />Cicipi Tradisi.</h1>
        <p class="page-hero__sub">Setiap cangkir dan setiap gigitan di outlet kami dibuat dengan bahan kopi specialty pilihan dari dataran tinggi Humbang Hasundutan.</p>
      </div>
    </div>

    <div class="hero-scroll-line" aria-hidden="true"></div>
  </section>

  <!-- ── Drinks ───────────────────────────────────────── -->
  <section class="drinks section section--cream" aria-labelledby="drinks-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">Minuman</p>
        <h2 id="drinks-heading" class="section-title">Signature Menu</h2>
        <p class="section-sub">Dibuat dengan الحب dan presisi oleh tim barista kami, menggunakan biji kopi specialty langsung dari sumbernya.</p>
      </div>

      <!-- Editorial 2-col asymmetric grid -->
      <div class="drinks__grid">
        <!-- Large feature card -->
        <article class="drink-card drink-card--feature animate-on-scroll">
          <div class="drink-card__media">
            <Image
              src={drinks[0].img}
              alt={drinks[0].imgAlt}
              loading="eager"
              widths={[480, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="drink-card__img"
            />
            <div class="drink-card__tag" style={`background: ${drinks[0].tagColor}`}>
              {drinks[0].tag}
            </div>
          </div>
          <div class="drink-card__body">
            <p class="drink-card__note">{drinks[0].note}</p>
            <h3 class="drink-card__name">{drinks[0].name}</h3>
            <p class="drink-card__desc">{drinks[0].desc}</p>
            <span class="drink-card__price">{drinks[0].price}</span>
          </div>
        </article>

        <!-- 2x2 stacked cards -->
        <div class="drinks__stack">
          {drinks.slice(1).map((drink, i) => (
            <article class="drink-card drink-card--mini animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
              <div class="drink-card__media drink-card__media--sm">
                <Image
                  src={drink.img}
                  alt={drink.imgAlt}
                  loading="lazy"
                  widths={[300, 480]}
                  sizes="(max-width: 768px) 50vw, 25vw"
                  class="drink-card__img"
                />
                <div class="drink-card__tag drink-card__tag--sm" style={`background: ${drink.tagColor}`}>
                  {drink.tag}
                </div>
              </div>
              <div class="drink-card__body drink-card__body--sm">
                <p class="drink-card__note drink-card__note--sm">{drink.note}</p>
                <h3 class="drink-card__name drink-card__name--sm">{drink.name}</h3>
                <p class="drink-card__desc drink-card__desc--sm">{drink.desc}</p>
                <span class="drink-card__price drink-card__price--sm">{drink.price}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Full-width image break ─────────────────────── -->
  <div class="fnb-image-break" aria-hidden="true">
    <Image
      src={h3}
      alt=""
      loading="lazy"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      class="fnb-image-break__img"
    />
    <div class="fnb-image-break__overlay">
      <blockquote class="fnb-quote">
        <p>"Kopi bukan sekadar minuman — ia adalah perjumpaan antara tradisi dan modernity."</p>
        <cite>— Tim Barista Kopi Siholta</cite>
      </blockquote>
    </div>
  </div>

  <!-- ── Food ─────────────────────────────────────────── -->
  <section class="food section" aria-labelledby="food-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <p class="section-tag">Makanan</p>
        <h2 id="food-heading" class="section-title">Kuliner Kopi Kami</h2>
        <p class="section-sub">Makanan ringan yang melengkapi setiap tegukan kopi. Resep warisan Sumatera dengan sentuhan modern.</p>
      </div>

      <div class="food__grid">
        {food.map((item, i) => (
          <article class="food-card animate-on-scroll" style={`transition-delay: ${i * 60}ms`}>
            <div class="food-card__dot" aria-hidden="true"></div>
            <div class="food-card__body">
              <h3 class="food-card__name">{item.name}</h3>
              <p class="food-card__desc">{item.desc}</p>
            </div>
            <span class="food-card__price">{item.price}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Gallery strip ────────────────────────────────── -->
  <section class="gallery" aria-label="Galeri Kopi Siholta">
    <div class="gallery__strip">
      {[h1, h2, h4, h5, h3, h1].map((img, i) => (
        <div class="gallery__item">
          <Image
            src={img}
            alt={`Galeri Kopi Siholta ${i + 1}`}
            loading="lazy"
            widths={[300, 480]}
            sizes="20vw"
            class="gallery__img"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────── -->
  <section class="page-cta page-cta--cream" aria-label="Kunjungi Outlet Kopi Siholta">
    <div class="container page-cta__inner">
      <div class="page-cta__text animate-on-scroll">
        <h2 class="page-cta__title page-cta__title--earth">Kunjungi<br />Outlet Kami</h2>
        <p class="page-cta__sub page-cta__sub--earth">Datang dan rasakan sendiri pengalaman F&B kopi specialty di lokasi kami di Humbang Hasundutan.</p>
      </div>
      <div class="page-cta__actions animate-on-scroll">
        <a href={`/${lang}/#contact`} class="btn btn--primary">Hubungi Kami</a>
        <a href={`/${lang}/tourism`} class="btn btn--outline-dark">Lihat Paket Tour</a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));
</script>