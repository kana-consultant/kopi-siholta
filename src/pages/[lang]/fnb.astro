---
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFAB from '../../components/layout/WhatsAppFAB.astro';

import FnbHero from '../../components/sections/fnb/FnbHero.astro';
import FnbStat from '../../components/sections/fnb/FnbStat.astro';
import RetailCoffee from '../../components/sections/fnb/RetailCoffee.astro';
import CafeFavorites from '../../components/sections/fnb/CafeFavorites.astro';
import RetailDistibution from '../../components/sections/fnb/RetailDistibution.astro';
import Sustainability from '../../components/sections/fnb/Sustainability.astro';
import FnbCta from '../../components/sections/fnb/FnbCta.astro';

import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'id' | 'en' | 'fr'; }

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

export function getStaticPaths() {
  return [
    { params: { lang: 'id' }, props: { lang: 'id' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'fr' }, props: { lang: 'fr' } },
  ];
}



---

<Base title={t.meta.titleFnb} description={t.meta.descFnb} lang={lang}>
  <Navbar lang={lang} />
  <header>
    <FnbHero lang={lang} t={t} />
    <FnbStat lang={lang} t={t} />
    <RetailCoffee lang={lang} t={t} />
    <CafeFavorites lang={lang} t={t} />
    <RetailDistibution lang={lang} t={t} />
    <Sustainability lang={lang} t={t} />
    <FnbCta lang={lang} t={t} />

  </header>
  <main>

  </main>

  <Footer lang={lang} />
  <WhatsAppFAB />
</Base>

<script>
  const els = document.querySelectorAll<HTMLElement>('.animate-on-scroll');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); observer.unobserve(e.target); }
      });
    },
    { threshold: 0.10, rootMargin: '0px 0px -40px 0px' }
  );
  els.forEach(el => observer.observe(el));

</script>
