---
interface StatItem { value: string; label: string }
interface Props {
  stats: StatItem[]
  variant?: 'green' | 'default'
}

const { stats, variant = 'green' } = Astro.props
---
<section class={`stat-band stat-band--${variant}`} aria-label="Statistik">
  <div class="container">
    <div class="stat-band__grid">
      {stats.map((s, i) => (
        <div class="stat-band__item animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
          <span class="stat-band__value">{s.value}</span>
          <span class="stat-band__label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
