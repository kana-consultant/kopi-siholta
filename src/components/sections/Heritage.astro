---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heritage1 from '../../images/heritage/heritage-1.jpg';
import heritage2 from '../../images/heritage/heritage-2.jpg';
import heritage3 from '../../images/heritage/heritage-3.jpg';
import heritage4 from '../../images/heritage/heritage-4.jpg';
import heritage5 from '../../images/heritage/heritage-5.jpg';
import companyLogo from '../../images/logo/logo-company.jpg';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const sectors = [
  {
    name: 'Coffee Farming',
    iconName: 'mdi:coffee',
    color: '#5C2E10',
    desc: '200+ keluarga petani partner di Lintong & Dolok',
  },
  {
    name: 'F&B',
    iconName: 'mdi:cup',
    color: '#1A3A5C',
    desc: 'Minuman & makanan kopi specialty Indonesia',
  },
  {
    name: 'Industry & Tourism',
    iconName: 'mdi:office-building',
    color: '#2A4A20',
    desc: 'Pariwisata & pabrikasi produk kopi specialty',
  },
];
---

<!-- ── Company Pioneer Banner ───────────────────────── -->
<section class="company-banner" aria-label="PT Siholta Toba Indonesia" id="heritage">
  <div class="container company-banner__inner">
    <div class="company-banner__logo-wrap">
      <Image
        src={companyLogo}
        alt="Logo PT Siholta Toba Indonesia"
        width={72}
        height={72}
        class="company-banner__logo-img"
      />
    </div>
    <div class="company-banner__content">
      <p class="company-banner__tag">Didirikan 2019</p>
      <h2 class="company-banner__name">PT Siholta Toba Indonesia</h2>
      <p class="company-banner__tagline"> Perusahaan ini lahir dari tanah Humbang Hasundutan — sebuah kawasan yang telah dikenal dunia sejak era kolonial sebagai penghasil kopi specialty paling prestisius di Nusantara.</p>
    </div>
    <div class="company-banner__divider" aria-hidden="true"></div>
    <div class="company-banner__sectors">
      <p class="company-banner__sectors-label">3 Sektor Usaha:</p>
      {sectors.map(sector => (
        <div class="company-banner__sector" style={`--sector-color: ${sector.color}`}>
          <span class="company-banner__sector-icon" aria-hidden="true"><Icon name={sector.iconName} width="18" height="18" /></span>
          <span class="company-banner__sector-name">{sector.name}</span>
        </div>
      ))}
    </div>

    <!-- See More CTA -->
    <a href={`/${lang}/company`} class="company-banner__see-more">
      Selengkapnya
      <Icon name="mdi:chevron-right" width="12" height="12" />
    </a>
  </div>
</section>

<!-- ── Heritage Section ─────────────────────────────── -->
<section class="heritage" aria-label="Heritage and Identity">

  <!-- ── Bento Grid ──────────────────────────────────── -->
  <div class="bento">

    <!-- Feature Card: Petani Lokal (large, spans 2 rows) -->
    <article class="bento__card bento__card--feature">
      <div class="bento__card-img-wrap">
        <Image
          src={heritage1}
          alt="Petani lokal memetik buah kopi merah"
          class="bento__card-img"
          loading="eager"
          widths={[480, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 50vw"
        />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">Warisan dari<br />Lereng Sumatera</h3>
        <p class="bento__card-desc">Lebih dari 200 keluarga petani partner tersebar di dataran tinggi Lintong dan Dolok, merawat pohon kopi tradisi sejak turun-temurun.</p>
        <div class="bento__card-stat">
          <span class="bento__card-stat-num">200+</span>
          <span class="bento__card-stat-label">Keluarga Petani Partner</span>
        </div>
      </div>
    </article>

    <!-- Stat Card: Proses -->
    <article class="bento__card bento__card--stat">
      <div class="bento__card-img-wrap">
        <Image
          src={heritage2}
          alt="Proses pengolahan kopi"
          class="bento__card-img"
          loading="lazy"
          widths={[480, 768]}
          sizes="(max-width: 768px) 100vw, 25vw"
        />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title bento__card-title--sm">Dari Kebun<br />ke Cangkir</h3>
        <p class="bento__card-desc">Washing, honey, dan natural process — standar specialty coffee dunia.</p>
        <div class="bento__card-stat">
          <span class="bento__card-stat-num">3</span>
          <span class="bento__card-stat-label">Metode Proses</span>
        </div>
      </div>
    </article>

    <!-- Text Card: sertifikasi -->
    <article class="bento__card bento__card--text">
      <div class="bento__card-img-wrap">
        <Image
          src={heritage3}
          alt="Proses pengolahan kopi"
          class="bento__card-img"
          loading="lazy"
          widths={[480, 768]}
          sizes="(max-width: 768px) 100vw, 25vw"
        />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <span class="bento__card-num bento__card-num--gold">03</span>
        <span class="bento__card-tag" style="color: var(--color-brand-gold); border-color: rgba(212,160,70,0.4);">Sertifikasi Internasional</span>
        <h3 class="bento__card-title">Standar Dunia,<br />Akar Lokal</h3>
        <p class="bento__card-desc">Lembaga verifikasi internasional telah mengakui kualitas Kopi Siholta untuk ekspor ke Amerika, Eropa, dan Asia Timur.</p>
        <div class="bento__card-badges">
          <span class="bento__badge">🌍 Amerika</span>
          <span class="bento__badge">🌍 Eropa</span>
          <span class="bento__badge">🌍 Asia Timur</span>
        </div>
      </div>
    </article>

    <!-- Image Card: Budaha Batak (portrait) -->
    <article class="bento__card bento__card--portrait">
      <div class="bento__card-img-wrap">
        <Image
          src={heritage4}
          alt="Tradisi budaya Batak Toba"
          class="bento__card-img"
          loading="lazy"
          widths={[400, 600]}
          sizes="(max-width: 768px) 100vw, 20vw"
        />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <span class="bento__card-num bento__card-num--blue">04</span>
        <span class="bento__card-tag" style="color: var(--color-tourism-blue); border-color: rgba(30,80,140,0.3);">Budaya Batak</span>
        <h3 class="bento__card-title bento__card-title--sm">Pekat dengan<br />Jiwa Batak</h3>
        <p class="bento__card-desc">Warisan budaya Batak Toba yang dijaga dan diwariskan.</p>
      </div>
    </article>

    <!-- Wide Image: Gallery Horizontal -->
    <article class="bento__card bento__card--wide">
      <div class="bento__card-img-wrap">
        <Image
          src={heritage5}
          alt="Galeri kopi Siholta"
          class="bento__card-img"
          loading="lazy"
          widths={[600, 900, 1200]}
          sizes="(max-width: 768px) 100vw, 70vw"
        />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <span class="bento__card-tag" style="color: var(--color-brand-gold); border-color: rgba(212,160,70,0.4);">Galeri Warisan</span>
        <h3 class="bento__card-title">Momen dari<br />Humbang Hasundutan</h3>
        <p class="bento__card-desc">Keindahan alam dan tradisi pertanian kopi yang masih lestari hingga hari ini.</p>
      </div>
    </article>

  </div>
</section>


