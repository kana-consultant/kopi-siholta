---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heritage1 from '../../images/heritage/heritage-6.jpg';
import heritage2 from '../../images/farming/farmer-1.jpg';
import heritage3 from '../../images/heritage/heritage-1.jpg';
import heritage4 from '../../images/heritage/batak-people.jpg';
import heritage5 from '../../images/heritage/heritage-5.jpg';
import companyLogo from '../../images/logo/logo-company.jpg';
import { t } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const sectors = [
  { nameKey: 'sectorFarming' as const, iconName: 'mdi:coffee',        href: `/${lang}/coffee-farming` },
  { nameKey: 'sectorFnB' as const,       iconName: 'mdi:cup',         href: `/${lang}/fnb` },
  { nameKey: 'sectorIndustry' as const,   iconName: 'mdi:office-building', href: `/${lang}/tourism` },
];

function multiline(label: string) {
  return label.split('\n');
}
---

<!-- ── Company Pioneer Banner ───────────────────────── -->
<section class="company-banner" aria-label="PT Siholta Toba Indonesia" id="heritage">
  <div class="container company-banner__inner">
    <div class="company-banner__logo-wrap">
      <Image
        src={companyLogo}
        alt={tr.companyBanner.name}
        width={72}
        height={72}
        class="company-banner__logo-img"
      />
    </div>
    <div class="company-banner__content">
      <p class="company-banner__tag">{tr.companyBanner.tag}</p>
      <h2 class="company-banner__name">{tr.companyBanner.name}</h2>
      <p class="company-banner__tagline">{tr.companyBanner.tagline}</p>
    </div>
    <div class="company-banner__divider" aria-hidden="true"></div>
    <div class="company-banner__sectors">
      <p class="company-banner__sectors-label">{tr.companyBanner.sectorsLabel}</p>
      {sectors.map(sector => (
        <a href={sector.href} class="company-banner__sector" style={`--sector-color: ${sector.iconName === 'mdi:coffee' ? '#5C2E10' : sector.iconName === 'mdi:cup' ? '#1A3A5C' : '#2A4A20'}`}>
          <span class="company-banner__sector-icon" aria-hidden="true"><Icon name={sector.iconName} width="18" height="18" /></span>
          <span class="company-banner__sector-name">{tr.companyBanner[sector.nameKey]}</span>
        </a>
      ))}
    </div>

    <a href={`/${lang}/company`} class="company-banner__see-more" aria-label={tr.companyBanner.ctaAria}>
      {tr.companyBanner.cta}
    </a>
  </div>
</section>

<!-- ── Heritage Section ─────────────────────────────── -->
<section class="heritage" aria-label="Heritage and Identity">
  <div class="bento">

    <!-- Feature Card -->
    <article class="bento__card bento__card--feature">
      <div class="bento__card-img-wrap">
        <Image src={heritage1} alt={tr.coffeeFarming.farmImages.altCherry} class="bento__card-img" loading="eager" widths={[480, 768, 1024]} sizes="(max-width: 768px) 100vw, 50vw" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">
          {multiline(tr.heritage.card1Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card1Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card1Desc}</p>
      </div>
    </article>

    <!-- Stat Card -->
    <article class="bento__card bento__card--stat">
      <div class="bento__card-img-wrap">
        <Image src={heritage2} alt={tr.coffeeFarming.farmImages.altFerment} class="bento__card-img" loading="lazy" widths={[480, 768]} sizes="(max-width: 768px) 100vw, 25vw" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title bento__card-title--sm">
          {multiline(tr.heritage.card2Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card2Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card2Desc}</p>
      </div>
    </article>

    <!-- Text Card -->
    <article class="bento__card bento__card--text">
      <div class="bento__card-img-wrap">
        <Image src={heritage3} alt={tr.coffeeFarming.farmImages.altSorting} class="bento__card-img" loading="lazy" widths={[480, 768]} sizes="(max-width: 768px) 100vw, 25vw" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">
          {multiline(tr.heritage.card3Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card3Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card3Desc}</p>
      </div>
    </article>

    <!-- Portrait Card -->
    <article class="bento__card bento__card--portrait">
      <div class="bento__card-img-wrap">
        <Image src={heritage4} alt={tr.coffeeFarming.farmImages.altFarm} class="bento__card-img" loading="lazy" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 20vw" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title bento__card-title--sm">
          {multiline(tr.heritage.card4Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card4Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card4Desc}</p>
      </div>
    </article>

    <!-- Wide Card -->
    <article class="bento__card bento__card--wide">
      <div class="bento__card-img-wrap">
        <Image src={heritage5} alt={tr.coffeeFarming.farmImages.altRoasting} class="bento__card-img" loading="lazy" widths={[600, 900, 1200]} sizes="(max-width: 768px) 100vw, 70vw" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">
          {multiline(tr.heritage.card5Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card5Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card5Desc}</p>
      </div>
    </article>

  </div>
</section>