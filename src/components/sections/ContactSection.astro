---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import waLogo from '../../images/logo/logo-whatsapp.png';
import tokpedLogo from '../../images/logo/logo-tokopedia.png';
import shopeeLogo from '../../images/logo/logo-shopee.png';
import igLogo from '../../images/logo/logo-instagram.png';
import tiktokLogo from '../../images/logo/logo-tiktok.png';
import linktreeLogo from '../../images/logo/logo-linktree.png';
import { t } from '../../i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const tr = t(lang);

const WHATSAPP_NUMBER = '6281322518527';
const WHATSAPP_MSG_ID = 'Halo, saya tertarik dengan Kopi Siholta. Bisa info lengkap lebih lanjut?';
const WHATSAPP_MSG_EN = 'Hello, I\'m interested in Kopi Siholta. Can I get more details?';
const WHATSAPP_MSG_FR = 'Bonjour, je suis intéressé(e) par Kopi Siholta. Pourriez-vous m\'en dire plus ?';
const WHATSAPP_MSG = lang === 'fr' ? WHATSAPP_MSG_FR : lang === 'en' ? WHATSAPP_MSG_EN : WHATSAPP_MSG_ID;
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MSG)}`;
const EMAIL = 'siholtatobaindonesia@gmail.com';
const INSTAGRAM_URL = 'https://www.instagram.com/kopi_siholta.id/';
const TOKPED_URL = 'https://www.tokopedia.com/kopisiholta';
const SHOPEE_URL = 'https://shopee.co.id/kopi_siholta';
const TIKTOK_URL = 'https://www.tiktok.com/@kopisiholta';
const LINKTREE_URL = 'https://linktr.ee/kopisiholta';
---

<section class="contact section" id="contact" aria-label="Contact Section">
  <div class="container contact__inner">

    <div class="contact__info">
      <div class="section__header">
        <h2 class="section-title">{tr.contact.title}</h2>
        <p class="section-sub">{tr.contact.subtitle}</p>
      </div>

      <div class="contact__social-grid">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="contact__social-card" aria-label={tr.contact.followInstagram}>
          <Image src={igLogo} alt="Instagram" width={20} height={20} />
          <span>@kopi_siholta.id</span>
        </a>
        <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer" class="contact__social-card" aria-label={tr.contact.followTiktok}>
          <Image src={tiktokLogo} alt="Instagram" width={20} height={20} />
          <span>@kopi_siholta.id</span>
        </a>
        <a href={LINKTREE_URL} target="_blank" rel="noopener noreferrer" class="contact__social-card" aria-label="Linktree">
          <Image src={linktreeLogo} alt="Instagram" width={26} height={26} />
          <span>@kopi_siholta.id</span>
        </a>
        <a href={TOKPED_URL} target="_blank" rel="noopener noreferrer" class="contact__social-card" aria-label="Tokopedia">
          <Image src={tokpedLogo} alt="Tokopedia" width={20} height={20} />
          <span>@kopisiholta</span>
        </a>
        <a href={SHOPEE_URL} target="_blank" rel="noopener noreferrer" class="contact__social-card" aria-label="Shopee">
          <Image src={shopeeLogo} alt="Shopee" width={20} height={20} />
          <span>@kopi_siholta</span>
        </a>
      </div>

      <div class="contact__details">
        <div class="contact__detail-item">
          <Icon name="mdi:map-marker" width="14" height="14" />
          <span>{tr.contact.address}</span>
        </div>
        <div class="contact__detail-item">
          <Icon name="mdi:email" width="14" height="14" />
          <a href={`mailto:${EMAIL}`} class="contact__link">{EMAIL}</a>
        </div>
        <div class="contact__detail-item">
          <Icon name="mdi:phone" width="14" height="14" />
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="contact__link">+62 813 2251 8527</a>
        </div>
      </div>

      <div class="contact__maps">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.756309399054!2d106.9037104!3d-6.295721899999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3007f623b53%3A0x118fc0912e442961!2sPT.%20Siholta%20Toba%20Indonesia!5e0!3m2!1sid!2sid!4v1778757552187!5m2!1sid!2sid"
          width="100%" height="180"
          style="border:0; border-radius: var(--radius-lg);"
          allowfullscreen="" loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={tr.contact.mapsLabel}
        ></iframe>
      </div>
    </div>

    <div class="contact__form-wrap">
      <form class="contact__form" id="contactForm" novalidate>

        <!-- Row 1: Full Name + Email -->
        <div class="form-row">
          <div class="form-group">
            <label for="fullName" class="form-label">
              {tr.contact.formFullName}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              class="form-input"
              placeholder={tr.contact.formFullNamePlaceholder}
              required
              autocomplete="name"
            />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">
              {tr.contact.formEmail}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder={tr.contact.formEmailPlaceholder}
              required
              autocomplete="email"
            />
          </div>
        </div>

        <!-- Row 2: Phone + Company -->
        <div class="form-row">
          <div class="form-group">
            <label for="phone" class="form-label">
              {tr.contact.formPhone}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="form-input"
              placeholder={tr.contact.formPhonePlaceholder}
              required
              autocomplete="tel"
            />
          </div>
          <div class="form-group">
            <label for="company" class="form-label">
              {tr.contact.formCompany}
              <span class="form-optional">({tr.contact.optional})</span>
            </label>
            <input
              type="text"
              id="company"
              name="company"
              class="form-input"
              placeholder={tr.contact.formCompanyPlaceholder}
              autocomplete="organization"
            />
          </div>
        </div>

        <!-- Row 3: Inquiry Type -->
        <div class="form-group">
          <label for="inquiryType" class="form-label">
            {tr.contact.formInquiryType}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <select id="inquiryType" name="inquiryType" class="form-input form-select" required>
            <option value="" disabled selected>{tr.contact.formInquiryTypePlaceholder}</option>
            <option value={tr.contact.formInquiryOpt1}>{tr.contact.formInquiryOpt1}</option>
            <option value={tr.contact.formInquiryOpt2}>{tr.contact.formInquiryOpt2}</option>
            <option value={tr.contact.formInquiryOpt3}>{tr.contact.formInquiryOpt3}</option>
            <option value={tr.contact.formInquiryOpt4}>{tr.contact.formInquiryOpt4}</option>
          </select>
        </div>

        <!-- Row 4: Message -->
        <div class="form-group">
          <label for="message" class="form-label">
            {tr.contact.formMessage}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            class="form-input form-textarea"
            rows="4"
            placeholder={tr.contact.formMessagePlaceholder}
            required
          ></textarea>
        </div>

        <!-- Action Buttons -->
        <div class="form-actions">
          <button
            type="button"
            id="btnWhatsApp"
            class="btn btn--whatsapp form-btn"
            aria-label={tr.contact.formSendWaAria}
          >
            <Image src={waLogo} alt="WhatsApp" width={18} height={18} />
            {tr.contact.formSendWa}
          </button>
          <button
            type="button"
            id="btnEmail"
            class="btn btn--email form-btn"
            aria-label={tr.contact.formSendEmailAria}
          >
            <Icon name="mdi:email-outline" width={18} height={18} />
            {tr.contact.formSendEmail}
          </button>
        </div>

        <!-- Validation feedback -->
        <p class="form-error" id="formError" role="alert" aria-live="polite" hidden></p>

      </form>
    </div>

  </div>
</section>

<script define:vars={{ WHATSAPP_NUMBER, EMAIL }}>
  const btnWa    = document.getElementById('btnWhatsApp');
  const btnEmail = document.getElementById('btnEmail');
  const errEl    = document.getElementById('formError');

  function getVal(id) { return document.getElementById(id).value.trim(); }

  function validate() {
    const fullName = getVal('fullName');
    const email    = getVal('email');
    const phone    = getVal('phone');
    const inquiry  = document.getElementById('inquiryType').value;
    const message  = getVal('message');
    const company  = getVal('company');

    if (!fullName || !email || !phone || !inquiry || !message) {
      errEl.textContent = 'Please fill in all required fields.';
      errEl.hidden = false;
      return null;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = 'Please enter a valid email address.';
      errEl.hidden = false;
      return null;
    }
    errEl.hidden = true;
    return { fullName, email, phone, company, inquiry, message };
  }

  // ---------- Send via WhatsApp ----------
  btnWa.addEventListener('click', () => {
    const d = validate();
    if (!d) return;
    const companyLine = d.company
      ? `\n*Perusahaan/Instansi:* ${d.company}` : '';
    const waText =
`Nama Lengkap: ${d.fullName}
*Email:* ${d.email}
*No. HP/WA:* ${d.phone}${companyLine}
*Jenis Keperluan:* ${d.inquiry}

*Pesan:*
${d.message}`;
    window.open(
      `https://api.whatsapp.com/send?phone=${WHATSAPP_NUMBER}&text=${encodeURIComponent(waText)}`,
      '_blank', 'noopener,noreferrer'
    );
  });

  // ---------- Send via Email ----------
  btnEmail.addEventListener('click', () => {
    const d = validate();
    if (!d) return;
    const subject = `[Kopi Siholta] ${d.inquiry} — ${d.fullName}`;
    const companyLine = d.company
      ? `Perusahaan/Instansi: ${d.company}\n` : '';
    const body =
`Nama Lengkap: ${d.fullName}
Email: ${d.email}
No. HP/WA: ${d.phone}
${companyLine}Jenis Keperluan: ${d.inquiry}

Pesan:
${d.message}`;
    window.location.href =
      `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
