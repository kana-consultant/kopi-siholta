---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import tourismBg from '@/images/bg/bg-tourism.jpg';
import '@/styles/components/hero.css';

import { getTranslations } from '@/i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);
---

<section class="page-hero page-hero--tall" aria-label={t.tourism.page}>
  <div class="page-hero__bg">
    <Image
      src={tourismBg}
      alt={t.tourism.images?.altFarm ?? 'Perkebunan Kopi Siholta'}
      class="page-hero__img"
      fetchpriority="high"
      style="object-position: center 35%"
      loading="eager"
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <div class="page-hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="container page-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item"><a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a></li>
        <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
        <li class="breadcrumb__item"><a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a></li>
        <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.tourism.page}</li>
      </ol>
    </nav>

    <div class="page-hero__content">
      <h1 class="page-hero__title">{t.tourism.titleLine1}<br />{t.tourism.titleLine2}</h1>
      <p class="page-hero__sub">{t.tourism.subtitle}</p>
    </div>
  </div>
</section>