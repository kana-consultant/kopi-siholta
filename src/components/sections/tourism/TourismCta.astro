---
import { getTranslations } from '../../../i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);

const nl = (s: string) => s.split('\n').join('<br>');
---

<section class="page-cta page-cta--cream" aria-label="Pesan Pengalaman Kopi">
  <div class="container page-cta__inner">
    <div class="page-cta__text animate-on-scroll">
      <h2 class="page-cta__title page-cta__title--earth" set:html={nl(t.tourism.ctaTitle)} />
      <p class="page-cta__sub page-cta__sub--earth">{t.tourism.ctaSubtitle}</p>
    </div>
    <div class="page-cta__actions animate-on-scroll">
      <a href={`/${lang}/#contact`} class="btn btn--primary">{t.tourism.cta1}</a>
    </div>
  </div>
</section>