---
import { Icon } from 'astro-icon/components';
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const partners = [
  {
    type: 'Importer & Distributor',
    label: 'Importir & Distributor',
    iconName: 'mdi:package-variant',
    desc: 'Bergabunglah dengan jaringan distribusi kami untuk membawa Kopi Siholta ke pasar lokal Anda.',
    tag: 'Distributor',
  },
  {
    type: 'HoReCa Partner',
    label: 'Mitra HoReCa',
    iconName: 'mdi:food-fork-drink',
    desc: 'Kafe, hotel, restoran — supplied dengan beans segar dan mendukung cerita brand Anda.',
    tag: 'HoReCa',
  },
  {
    type: 'White Label',
    label: 'White Label',
    iconName: 'mdi:label',
    desc: 'Kemitraan produksi private label untuk brand kopi yang ingin launching produk specialty.',
    tag: 'Private Label',
  },
  {
    type: 'Corporate Gift',
    label: 'Gift Corporate',
    iconName: 'mdi:gift',
    desc: 'Hampers dan gift set untuk keperluan corporate — kopi premium sebagai simbol apresiasi.',
    tag: 'Corporate',
  },
];
---

<section class="b2b section" id="b2b" aria-label="B2B Partnership">
  <div class="container">
    <!-- Header -->
    <div class="section__header">
      <p class="section-tag">Mitra Bisnis</p>
      <h2 class="section-title">Jadilah Bagian dari Cerita Kami</h2>
      <p class="section-sub">Kopi Siholta terbuka untuk kemitraan dengan importir, distributor, kafe, hotel, dan brand kopi global yang sejalan dengan nilai kami.</p>
    </div>

    <!-- Partnership Cards -->
    <div class="b2b__grid">
      {partners.map((partner, i) => (
        <article class="b2b__card animate-fade-in-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
          <div class="b2b__card-icon" aria-hidden="true"><Icon name={partner.iconName} width="20" height="20" /></div>
          <div class="b2b__card-content">
            <p class="b2b__card-tag">{partner.tag}</p>
            <h3 class="b2b__card-title">{partner.label}</h3>
            <p class="b2b__card-desc">{partner.desc}</p>
          </div>
          <a href="#contact" class="b2b__card-cta" aria-label={`Ajukan Kerjasama Kemitraan ${partner.tag} dengan Kopi Siholta`}>
            Ajukan Kerjasama
            <Icon name="mdi:arrow-right" width="12" height="12" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

