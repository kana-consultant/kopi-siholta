---
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const typeKeys = ['type1', 'type2', 'type3', 'type4'] as const;
const iconNames = ['mdi:package-variant', 'mdi:food-fork-drink', 'mdi:label', 'mdi:gift'];
---

<section class="b2b section" id="b2b" aria-label="B2B Partnership">
  <div class="container">
    <div class="section__header">
      <p class="section-tag">{tr.b2b.tag}</p>
      <h2 class="section-title">{tr.b2b.title}</h2>
      <p class="section-sub">{tr.b2b.subtitle}</p>
    </div>

    <div class="b2b__grid">
      {typeKeys.map((key, i) => (
        <article class="b2b__card animate-fade-in-up" style={`animation-delay: ${(i + 1) * 100}ms`}>
          <div class="b2b__card-icon" aria-hidden="true">
            <Icon name={iconNames[i]} width="20" height="20" />
          </div>
          <div class="b2b__card-content">
            <p class="b2b__card-tag">{tr.b2b[`${key}Tag`]}</p>
            <h3 class="b2b__card-title">{tr.b2b[`${key}Label`]}</h3>
            <p class="b2b__card-desc">{tr.b2b[`${key}Desc`]}</p>
          </div>
          <a href="#contact" class="b2b__card-cta" aria-label={tr.b2b.ctaAria}>
            {tr.b2b.cta}
            <Icon name="mdi:chevron-right" width="12" height="12" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>