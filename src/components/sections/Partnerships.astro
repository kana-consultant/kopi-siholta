---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { t } from '../../i18n/utils';
import bgImg from '../../images/farming/process (3).jpg';

import logoHypermart from '../../images/logo/logo-hypermart.png';
import logoHyfresh from '../../images/logo/logo-hyfresh.jpg';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const processTypes = [
  {
    tag: tr.b2b.type1Tag,
    label: tr.b2b.type1Label,
    desc: tr.b2b.type1Desc,
    feature: tr.b2b.type1Feature,
    flavours: ['Citrusy & Herbal', 'Sweetness', 'Bright Acidity'],
    roast: 'Light – Medium',
    cup: 'Clean, Bright, Floral',
    icon: 'mdi:water',
    accentClass: 'process-card--washed',
  },
  {
    tag: tr.b2b.type2Tag,
    label: tr.b2b.type2Label,
    desc: tr.b2b.type2Desc,
    feature: tr.b2b.type2Feature,
    flavours: ['Chocolatey', 'Nutty', 'Spices'],
    roast: 'Medium – Dark',
    cup: 'Full-Bodied, Complex, Earthy',
    icon: 'mdi:weather-sunny',
    accentClass: 'process-card--natural',
  },
  {
    tag: tr.b2b.type3Tag,
    label: tr.b2b.type3Label,
    desc: tr.b2b.type3Desc,
    feature: tr.b2b.type3Feature,
    flavours: ['Intense Sweetness', 'Mellow Fruity', 'Subtle Spice & Nutty'],
    roast: 'Medium',
    cup: 'Balanced, Smooth, Layered',
    icon: 'mdi:flower',
    accentClass: 'process-card--honey',
  },
];
---

<section class="partnerships section" id="b2b" aria-label="B2B Green Bean Supply">
  <div class="container">

    <!-- Header -->
    <div class="partnerships__header">
      <h2 class="partnerships__title">{tr.b2b.title}</h2>
      <p class="partnerships__subtitle">{tr.b2b.subtitle}</p>
    </div>

    <!-- Trust Strip -->
    <div class="partnerships__trust-strip">
      <div class="trust-stat">
        <span class="trust-stat__value">{tr.b2b.stat1Value}</span>
        <span class="trust-stat__label">{tr.b2b.stat1Label}</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__value">{tr.b2b.stat2Value}</span>
        <span class="trust-stat__label">{tr.b2b.stat2Label}</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__value">{tr.b2b.stat3Value}</span>
        <span class="trust-stat__label">{tr.b2b.stat3Label}</span>
      </div>
    </div>

    <!-- Logo Cloud -->
    <div class="partnerships__logo-cloud">
      <div class="logo-cloud__grid">
        <div class="logo-cloud__item">
          <span class="logo-cloud__text">Angkasa Pura</span>
        </div>
        <div class="logo-cloud__item">
          <Image src={logoHypermart} alt="Hypermart" width={100} height={40} class="logo-cloud__img" />
        </div>
        <div class="logo-cloud__item">
          <span class="logo-cloud__text">Primo</span>
        </div>
        <div class="logo-cloud__item">
          <Image src={logoHyfresh} alt="Hyfresh" width={100} height={40} class="logo-cloud__img" />
        </div>
        <div class="logo-cloud__item">
          <span class="logo-cloud__text">Svetofor</span>
        </div>
        <div class="logo-cloud__item">
          <span class="logo-cloud__text">Sendys</span>
        </div>
        <div class="logo-cloud__item">
          <span class="logo-cloud__text">KPD Retail</span>
        </div>
      </div>
      <p class="logo-cloud__proof">{tr.b2b.socialProof}</p>
    </div>

    <!-- Process Section Title -->
    <div class="process-section__header">
      <h3 class="process-section__title">{tr.b2b.processTitle}</h3>
      <p class="process-section__subtitle">{tr.b2b.processSubtitle}</p>
    </div>

    <!-- Process Cards -->
    <div class="process-cards">
      {processTypes.map((type, i) => (
        <article class={`process-card ${type.accentClass}`} style={`animation-delay: ${i * 100}ms`}>
          <div class="process-card__top">
            <div class="process-card__icon-wrap">
              <Icon name={type.icon} width={24} height={24} />
            </div>
          </div>
          <div class="process-card__body">
            <h4 class="process-card__name">{type.label}</h4>
            <p class="process-card__desc">{type.desc}</p>
            <div class="process-card__divider"></div>
            <div class="process-card__meta">
              <div class="process-card__meta-item">
                <span class="process-card__meta-label">Flavour Profile</span>
                <div class="process-card__flavours">
                  {type.flavours.map(f => <span class="flavour-chip">{f}</span>)}
                </div>
              </div>
              <div class="process-card__meta-item">
                <span class="process-card__meta-label">Cup Character</span>
                <span class="process-card__meta-value">{type.cup}</span>
              </div>
              <div class="process-card__meta-item">
                <span class="process-card__meta-label">Suitable Roast</span>
                <span class="process-card__meta-value">{type.roast}</span>
              </div>
            </div>
          </div>
          <div class="process-card__footer">
            <span class="process-card__feature-badge">
              <Icon name="mdi:star" width={14} height={14} />
              {type.feature}
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA Final -->
    <div class="partnerships__cta">
      <div class="partnerships__cta-bg">
        <Image
          src={bgImg}
          alt=""
          loading="lazy"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="partnerships__cta-img"
        />
      </div>
      <p class="partnerships__cta-text">{tr.b2b.ctaFinal}</p>
      <a href="#contact" class="btn btn--primary partnerships__cta-btn">
        {tr.b2b.ctaButton}
      </a>
    </div>

  </div>
</section>
