---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);
const tc = t.company;
---
  <!-- ── Location & Map ───────────────────────────────── -->
  <section id="our-office" class="location section" aria-labelledby="location-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="location-heading" class="section-title">{tc.locationTitle}</h2>
        <p class="section-sub">{tc.locationSub}</p>
      </div>
      <div class="location__map animate-on-scroll">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4879.739208830867!2d106.9037104!3d-6.295721899999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3007f623b53%3A0x118fc0912e442961!2sPT.%20Siholta%20Toba%20Indonesia!5e1!3m2!1sid!2sid!4v1780411154960!5m2!1sid!2sid" width="100%" height="400"
          style="border:0; border-radius: var(--radius-lg);" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Lokasi PT Siholta Toba Indonesia"></iframe>

      </div>
      <div class="location__address animate-on-scroll">
        <Icon name="mdi:map-marker" width="16" height="16" />
        <span>{t.contact.address}</span>
      </div>
    </div>
  </section>