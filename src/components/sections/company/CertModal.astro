---
import { Icon } from 'astro-icon/components';

const { lang } = Astro.props;
---
  <!-- ── Certificate Viewer Modal ───────────────── -->
  <div id="cert-modal" class="cert-modal" role="dialog" aria-modal="true" aria-labelledby="cert-modal-title" hidden>
    <div class="cert-modal__backdrop"></div>
    <div class="cert-modal__panel">
      <div class="cert-modal__header">
        <h3 id="cert-modal-title" class="cert-modal__title"></h3>
        <button id="cert-modal-close" class="cert-modal__close" type="button" aria-label="Close">
          <Icon name="mdi:close" width="20" height="20" />
        </button>
      </div>
      <div class="cert-modal__body">
        <iframe id="cert-modal-iframe" class="cert-modal__iframe" title="" src="" width="100%" height="100%"></iframe>
      </div>
    </div>
  </div>

  <style>
.cert-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-4);
}

.cert-modal[hidden] { display: none; }

.cert-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(10, 6, 3, 0.85);
  backdrop-filter: blur(6px);
  animation: certModalFadeIn 200ms ease forwards;
}

.cert-modal__panel {
  position: relative;
  z-index: 1;
  width: min(900px, 100%);
  height: min(90vh, 720px);
  background: #fff;
  border-radius: var(--radius-2xl);
  box-shadow: 0 32px 80px rgba(10, 6, 3, 0.5);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: certModalSlideIn 250ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes certModalFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes certModalSlideIn {
  from { opacity: 0; transform: translateY(20px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.cert-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-6);
  border-bottom: 1px solid var(--color-neutral-100, #eee);
  flex-shrink: 0;
}

.cert-modal__title {
  font-family: var(--font-display);
  font-size: clamp(15px, 2vw, 18px);
  font-weight: 700;
  color: var(--color-brand-earth, #3E1F0D);
  margin: 0;
}

.cert-modal__close {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: transparent;
  border: 1px solid var(--color-neutral-200, #ddd);
  color: var(--color-neutral-600, #555);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 180ms ease, color 180ms ease;
  flex-shrink: 0;
}

.cert-modal__body {
  flex: 1;
  overflow: hidden;
  background: #f5f3f0;
}

.cert-modal__iframe {
  border: none;
  width: 100%; height: 100%;
  display: block;
}

@media (max-width: 640px) {
  .cert-modal { padding: var(--space-2); }
  .cert-modal__panel { height: 92vh; border-radius: var(--radius-xl); }
  .cert-modal__header { padding: var(--space-3) var(--space-4); }
}

@media (hover: hover) {
  .cert-modal__close:hover {
    background: var(--color-neutral-100, #f5f5f5);
    color: #1a0f08;
  }
}


  </style>

  <script>
  const modal = document.getElementById('cert-modal') as HTMLElement;
  const modalTitle = document.getElementById('cert-modal-title') as HTMLElement;
  const modalIframe = document.getElementById('cert-modal-iframe') as HTMLIFrameElement;
  const modalClose = document.getElementById('cert-modal-close') as HTMLButtonElement;
  const modalBackdrop = modal?.querySelector('.cert-modal__backdrop') as HTMLElement;

  function openCertModal(pdfPath: string, title: string) {
    if (!modal || !modalIframe || !modalTitle) return;
    modalTitle.textContent = title;
    modalIframe.src = pdfPath;
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    modalClose?.focus();
  }

  function closeCertModal() {
    if (!modal || !modalIframe) return;
    modal.setAttribute('hidden', '');
    modalIframe.src = '';
    document.body.style.overflow = '';
  }

  // Event Delegation agar selektor tetap aman bekerja
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.cert-card__btn');
    if (btn) {
      const pdf = btn.getAttribute('data-cert-pdf');
      const title = btn.getAttribute('data-cert-title');
      if (pdf && title) {
        e.preventDefault();
        openCertModal(pdf, title);
      }
    }
  });

  modalClose?.addEventListener('click', closeCertModal);
  modalBackdrop?.addEventListener('click', closeCertModal);

  document.addEventListener('keydown', (e) => {
    if (modal && !modal.hasAttribute('hidden') && e.key === 'Escape') closeCertModal();
  });
</script>