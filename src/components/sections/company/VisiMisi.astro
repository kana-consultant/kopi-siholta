---
const { lang, tc, t } = Astro.props;
---

  <section class="visimisi section" aria-labelledby="visimisi-heading">
    <div class="container">

      <div class="visimisi__header animate-on-scroll">
        <h2 id="visimisi-heading" class="visimisi__title">{tc.visimisiTitle}</h2>
        <p class="visimisi__sub">{tc.visimisiHeadlineLeft}</p>
      </div>

      <div class="visimisi__grid animate-on-scroll">
        <div class="visimisi__col visimisi__col--vision">
          <h3 class="visimisi__col-tag">Visi</h3>
          <p class="visimisi__col-text">{tc.visimisiVision}</p>
        </div>

        <div class="visimisi__col visimisi__col--mission">
          <h3 class="visimisi__col-tag">Misi</h3>
          <ul class="visimisi__list" role="list">
            <li class="visimisi__item">{tc.visimisiMission1}</li>
            <li class="visimisi__item">{tc.visimisiMission2}</li>
            <li class="visimisi__item">{tc.visimisiMission3}</li>
            <li class="visimisi__item">{tc.visimisiMission4}</li>
            <li class="visimisi__item">{tc.visimisiMission5}</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

<style>
.visimisi {
  padding-inline: var(--space-4);
  padding-bottom: var(--space-8);
}

.visimisi__header {
  max-width: 680px;
  margin-bottom: var(--space-8);
}

.visimisi__title {
  font-family: var(--font-display);
  font-size: clamp(32px, 4vw, 56px);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.0;
  letter-spacing: -0.03em;
  margin: 0 0 var(--space-4) 0;
}

.visimisi__sub {
  font-family: var(--font-body);
  font-size: clamp(16px, 2vw, 20px);
  line-height: 1.6;
  color: var(--color-brand-muted);
  margin: 0;
}

.visimisi__grid {
  display: grid;
  grid-template-columns: 1fr;
  position: relative;
}

.visimisi__col {
  padding: var(--space-8) var(--space-4);
  position: relative;
  transition: background 250ms ease;
  cursor: default;
}

.visimisi__col--vision {
  border-bottom: 1px solid var(--color-neutral-200);
}

.visimisi__col-tag {
  font-family: var(--font-display);
  font-size: clamp(22px, 2.5vw, 36px);
  font-weight: 700;
  color: var(--color-brand-earth);
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-4) 0;
  line-height: 1.1;
}

.visimisi__col-text {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.8;
  color: var(--color-brand-earth);
  margin: 0;
}

.visimisi__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  margin: 0; 
  padding: 0;
}

.visimisi__item {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.7;
  color: var(--color-brand-muted);
  padding-left: var(--space-5);
  position: relative;
  transition: color 250ms ease;
}

.visimisi__item::before {
  content: '';
  position: absolute;
  left: 0; 
  top: 10px;
  width: 4px; 
  height: 4px;
  background: var(--color-brand-earth);
  border-radius: 50%;
  transition: transform 250ms ease;
}


@media (min-width: 768px) {
  .visimisi {
    padding-inline: var(--space-6);
    padding-bottom: var(--space-12);
  }

  .visimisi__header { 
    margin-bottom: var(--space-12); 
  }

  .visimisi__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .visimisi__col--vision {
    border-bottom: none;
    padding-right: var(--space-12); 
  }
  
  .visimisi__col--mission { 
    padding-left: var(--space-12); 
  }

  .visimisi__col {
    padding: var(--space-10) var(--space-8);
  }

  .visimisi__grid::before {
    content: '';
    position: absolute;
    left: 50%; 
    top: 0; 
    bottom: 0;
    width: 1px;
    background: var(--color-neutral-200);
    transform: translateX(-50%);
  }

  .visimisi__col:hover { 
    background: rgba(255, 255, 255, 0.6); 
  }

  .visimisi__col--mission:hover .visimisi__item { 
    color: var(--color-brand-earth); 
  }

  .visimisi__col--mission:hover .visimisi__item::before { 
    transform: scale(1.3); 
  }
}
</style>