---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import certBrand from '../../../images/certified/brand-certificate.webp';
import certHalal from '../../../images/certified/halal-certificate.webp';
import certTraining from '../../../images/certified/training-certificate.webp';
import certPirt from '../../../images/certified/P-IRT.webp';
import { useTranslations } from '../../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);
const tc = t.company;
const certs = [
  {
    nameKey: 'certBrandName', descKey: 'certBrandDesc',
    img: certBrand, altKey: 'Sertifikat Merek Kopi Siholta',
    iconName: 'mdi:certificate', pdf: '/docs/brand-certificate.pdf',
  },
  {
    nameKey: 'certHalalName', descKey: 'certHalalDesc',
    img: certHalal, altKey: 'Sertifikat Halal Kopi Siholta',
    iconName: 'mdi:shield-check', pdf: '/docs/halal-certificate.pdf',
  },
  {
    nameKey: 'certTrainingName', descKey: 'certTrainingDesc',
    img: certTraining, altKey: 'Sertifikat Pelatihan Keamanan Pangan Kopi Siholta',
    iconName: 'mdi:food-apple', pdf: '/docs/training-certificate.pdf',
  },
  {
    nameKey: 'certPirtName', descKey: 'certPirtDesc',
    img: certPirt, altKey: 'SPP-IRT Kopi Siholta',
    iconName: 'mdi:food', pdf: '/docs/spp-irt.pdf',
  },
];
---

 <!-- ── Trusted & Certified ─────────────────────── -->
<section id="certificates" class="certifications section" aria-labelledby="certifications-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="certifications-heading" class="section-title">{tc.certificationsTitle}</h2>
        <p class="section-sub">{tc.certificationsSubtitle}</p>
      </div>

      <div class="certifications__grid">
        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certBrand}
              alt="Sertifikat Merek Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:certificate" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certBrandName}</h3>
            <p class="cert-card__desc">{tc.certBrandDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/brand-certificate.pdf"
               data-cert-title={tc.certBrandName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>

        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certHalal}
              alt="Sertifikat Halal Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:shield-check" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certHalalName}</h3>
            <p class="cert-card__desc">{tc.certHalalDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/halal-certificate.pdf"
               data-cert-title={tc.certHalalName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>

        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certTraining}
              alt="Sertifikat Pelatihan Keamanan Pangan Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:food-apple" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certTrainingName}</h3>
            <p class="cert-card__desc">{tc.certTrainingDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/training-certificate.pdf"
               data-cert-title={tc.certTrainingName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>

        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certPirt}
              alt="SPP-IRT Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:food" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certSppPirtName}</h3>
            <p class="cert-card__desc">{tc.certSppPirtDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/spp-irt.pdf"
               data-cert-title={tc.certSppPirtName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
.certifications__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  margin-top: var(--space-8);
}

@media (min-width: 640px) {
  .certifications__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
  </style>