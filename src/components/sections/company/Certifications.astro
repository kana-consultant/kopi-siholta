---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import certBrand from '../../../images/certified/brand-certificate.webp';
import certHalal from '../../../images/certified/halal-certificate.webp';
import certTraining from '../../../images/certified/training-certificate.webp';
import certPirt from '../../../images/certified/P-IRT.webp';
import { useTranslations } from '../../../i18n/utils';

const { lang } = Astro.props;
const t = useTranslations(lang);
const tc = t.company;
const certs = [
  {
    nameKey: 'certBrandName', descKey: 'certBrandDesc',
    img: certBrand, altKey: 'Sertifikat Merek Kopi Siholta',
    iconName: 'mdi:certificate', pdf: '/docs/brand-certificate.pdf',
  },
  {
    nameKey: 'certHalalName', descKey: 'certHalalDesc',
    img: certHalal, altKey: 'Sertifikat Halal Kopi Siholta',
    iconName: 'mdi:shield-check', pdf: '/docs/halal-certificate.pdf',
  },
  {
    nameKey: 'certTrainingName', descKey: 'certTrainingDesc',
    img: certTraining, altKey: 'Sertifikat Pelatihan Keamanan Pangan Kopi Siholta',
    iconName: 'mdi:food-apple', pdf: '/docs/training-certificate.pdf',
  },
  {
    nameKey: 'certPirtName', descKey: 'certPirtDesc',
    img: certPirt, altKey: 'SPP-IRT Kopi Siholta',
    iconName: 'mdi:food', pdf: '/docs/spp-irt.pdf',
  },
];
---

 <!-- ── Trusted & Certified ─────────────────────── -->
<section id="certificates" class="certifications section" aria-labelledby="certifications-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="certifications-heading" class="section-title">{tc.certificationsTitle}</h2>
        <p class="section-sub">{tc.certificationsSubtitle}</p>
      </div>

      <div class="certifications__grid">
        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certBrand}
              alt="Sertifikat Merek Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:certificate" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certBrandName}</h3>
            <p class="cert-card__desc">{tc.certBrandDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/brand-certificate.pdf"
               data-cert-title={tc.certBrandName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>

        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certHalal}
              alt="Sertifikat Halal Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:shield-check" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certHalalName}</h3>
            <p class="cert-card__desc">{tc.certHalalDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/halal-certificate.pdf"
               data-cert-title={tc.certHalalName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>

        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certTraining}
              alt="Sertifikat Pelatihan Keamanan Pangan Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:food-apple" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certTrainingName}</h3>
            <p class="cert-card__desc">{tc.certTrainingDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/training-certificate.pdf"
               data-cert-title={tc.certTrainingName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>

        <article class="cert-card animate-on-scroll">
          <div class="cert-card__img-wrap">
            <Image
              src={certPirt}
              alt="SPP-IRT Kopi Siholta"
              class="cert-card__img"
              loading="lazy"
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 33vw"
            />
          </div>
          <div class="cert-card__body">
            <div class="cert-card__icon" aria-hidden="true"><Icon name="mdi:food" width="28" height="28" /></div>
            <h3 class="cert-card__name">{tc.certSppPirtName}</h3>
            <p class="cert-card__desc">{tc.certSppPirtDesc}</p>
            <button class="cert-card__btn"
               type="button"
               data-cert-pdf="/docs/spp-irt.pdf"
               data-cert-title={tc.certSppPirtName}>
              <Icon name="mdi:eye" width="14" height="14" aria-hidden="true" />
              {tc.certViewBtn}
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <style>
.certifications__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  margin-top: var(--space-8);
}

/* ── Certification Card ─────────────────────────────────── */
.cert-card {
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: #fff;
  border: 0.5px solid var(--color-neutral-200);
  transition: box-shadow 300ms ease, transform 300ms ease;
  display: flex;
  flex-direction: column;
  position: relative;
  min-height: 380px; 
}

.cert-card:hover {
  box-shadow: 0 12px 40px rgba(92, 61, 30, 0.12);
  transform: translateY(-3px);
}

.cert-card__img-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.cert-card__img {
  width: 100%; 
  height: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  transition: transform 500ms ease;
}

.cert-card:hover .cert-card__img { 
  transform: scale(1.02); 
}

.cert-card__img-wrap::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(26,15,8,0.75) 0%, rgba(26,15,8,0.85) 100%);
  pointer-events: none;
}

.cert-card__body {
  padding: var(--space-5); 
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex: 1;
  justify-content: flex-end;
  position: relative;
  z-index: 1;
}

.cert-card__icon {
  width: 48px; 
  height: 48px;
  border-radius: var(--radius-lg);
  background: rgba(205, 18, 34, 0.15);
  color: var(--color-brand-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  backdrop-filter: blur(8px);
}

.cert-card__name {
  font-family: var(--font-display);
  font-size: clamp(18px, 2vw, 22px);
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  width: 100%;
  word-wrap: break-word;
  white-space: normal;
}

.cert-card__desc {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  width: 100%;
  word-wrap: break-word;
  white-space: normal;
}

.cert-card__btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: var(--space-2);
  padding: 8px 16px;
  font-family: var(--font-label);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-brand-gold);
  background: rgba(205, 18, 34, 0.12);
  border: 1px solid rgba(205, 18, 34, 0.35);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background 200ms ease, border-color 200ms ease, transform 150ms ease;
  width: fit-content;
}

.cert-card__btn:hover {
  background: rgba(205, 18, 34, 0.22);
  border-color: rgba(205, 18, 34, 0.6);
  transform: translateY(-1px);
}

.cert-card__btn:active { 
  transform: translateY(0); 
}

@media (min-width: 640px) {
  .certifications__grid {
    grid-template-columns: repeat(2, 1fr);
  }
    .cert-card { 
    min-height: 420px; 
  }
  .cert-card__body { 
    padding: var(--space-6); 
  }
}

@media (min-width: 769px) {
  .cert-card { 
    min-height: 480px; 
  }
}

@media (hover: hover) {
  .cert-card:hover {
    box-shadow: 0 12px 40px rgba(92, 61, 30, 0.12);
    transform: translateY(-3px);
  }
}
  </style>