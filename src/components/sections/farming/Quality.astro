---
import { Image } from 'astro:assets';

import fProcess7b from '../../../images/farming/process (7).jpg';
import fGreen   from '../../../images/farming/coffee-green.jpg';
import fCup2    from '../../../images/farming/cup-and-test(2).jpg';

const { t } = Astro.props;
const nl = (s: string) => s.split('\n').join('<br>');
---
  <!-- ── Quality Editorial ───────── -->
  <section class="quality-editorial section" aria-labelledby="quality-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="quality-heading" class="section-title">{nl(t.coffeeFarming.qualityTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.qualitySubtitle}</p>
      </div>

      <div class="quality-editorial__body">

        <!-- Left: photo grid -->
        <div class="quality-editorial__gallery">
          <div class="quality-editorial__gallery-item">
            <Image src={fCup2} alt={t.coffeeFarming.qualityGallery1Alt} loading="lazy" widths={[600,1200]} sizes="(max-width:768px) 100vw, 50vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery1}</span>
          </div>
          <div class="quality-editorial__gallery-item">
            <Image src={fGreen} alt={t.coffeeFarming.qualityGallery2Alt} loading="lazy" widths={[300,600]} sizes="(max-width:768px) 50vw, 25vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery2}</span>
          </div>
          <div class="quality-editorial__gallery-item">
            <Image src={fProcess7b} alt={t.coffeeFarming.qualityGallery3Alt} loading="lazy" widths={[300,600]} sizes="(max-width:768px) 50vw, 25vw" class="quality-editorial__gallery-img" />
            <span class="quality-editorial__gallery-label">{t.coffeeFarming.qualityGallery3}</span>
          </div>
        </div>

        <!-- Right: editorial text panel -->
        <div class="quality-editorial__panel animate-on-scroll">
          <div>
            <h3 class="quality-editorial__panel-title">{nl(t.coffeeFarming.qualityPanelTitle)}</h3>
          </div>
          <p class="quality-editorial__panel-text">{t.coffeeFarming.qualityPanelText}</p>
          <div class="quality-editorial__panel-stats">
            <div class="editorial-stat animate-on-scroll"><span class="editorial-stat__value">{t.coffeeFarming.qualityStat1Value}</span><span class="editorial-stat__label">{t.coffeeFarming.qualityStat1Label}</span></div>
            <div class="editorial-stat animate-on-scroll" style="transition-delay:80ms"><span class="editorial-stat__value">{t.coffeeFarming.qualityStat2Value}</span><span class="editorial-stat__label">{t.coffeeFarming.qualityStat2Label}</span></div>
            <div class="editorial-stat animate-on-scroll" style="transition-delay:160ms"><span class="editorial-stat__value">{t.coffeeFarming.qualityStat3Value}</span><span class="editorial-stat__label">{t.coffeeFarming.qualityStat3Label}</span></div>
            <div class="editorial-stat animate-on-scroll" style="transition-delay:240ms"><span class="editorial-stat__value">{t.coffeeFarming.qualityStat4Value}</span><span class="editorial-stat__label">{t.coffeeFarming.qualityStat4Label}</span></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <style>
.quality-editorial { padding-top: var(--space-16); }

.quality-editorial__body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-top: var(--space-8);
  align-items: stretch;
}

.quality-editorial__gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 320px 200px;
  gap: var(--space-3);
}

.quality-editorial__gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-xl);
}

.quality-editorial__gallery-item:first-child { grid-column: span 2; }

.quality-editorial__gallery-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.quality-editorial__gallery-item:hover .quality-editorial__gallery-img { transform: scale(1.05); }

.quality-editorial__gallery-label {
  position: absolute;
  bottom: var(--space-3);
  left: var(--space-4);
  font-family: var(--font-label);
  font-size: 8px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.9);
  background: rgba(26,15,8,0.6);
  backdrop-filter: blur(4px);
  padding: 3px 8px;
  border-radius: 2px;
}

.quality-editorial__panel {
  background: var(--color-brand-earth);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-6);
  position: relative;
  overflow: hidden;
}

.quality-editorial__panel::before {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  pointer-events: none;
}

.quality-editorial__panel-title {
  font-family: var(--font-display);
  font-size: clamp(24px, 2.8vw, 34px);
  font-weight: 700;
  color: #fff;
  line-height: 1.15;
}

.quality-editorial__panel-text {
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.8;
  color: rgba(255,255,255,0.75);
}

.quality-editorial__panel-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

@media (max-width: 1024px) {
  .quality-editorial__body { grid-template-columns: 1fr; }
  .quality-editorial__panel { padding: var(--space-6); }
}

@media (max-width: 768px) {
  .quality-editorial__gallery { grid-template-columns: 1fr; grid-template-rows: 240px 160px 160px; }
  .quality-editorial__gallery-item:first-child { grid-column: span 1; }
  .quality-editorial__panel-stats { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 480px) {
  .quality-editorial { padding-top: var(--space-10); }
  .quality-editorial__gallery { grid-template-rows: 200px 140px 140px; }
  .quality-editorial__panel { padding: var(--space-5); gap: var(--space-4); }
  .quality-editorial__panel-title { font-size: 20px; }
  .editorial-stat__value { font-size: 24px; }
}
  </style>