---
const { t } = Astro.props;
const nl = (s: string) => s.split('\n').join('<br>');

---
  <!-- ── Process: Coffee Processing Methods ─────────── -->
  <section class="journey section section--cream" id="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="process-heading" class="section-title">{nl(t.coffeeFarming.processTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.processSubtitle}</p>
      </div>

      <!-- Method tabs -->
      <div class="process-tabs animate-on-scroll" role="tablist" aria-label="Coffee processing methods" data-process-tabs>
        <button class="process-tab process-tab--active" role="tab" aria-selected="true" aria-controls="panel-wet" id="tab-wet" data-process-tab="wet" data-short={t.coffeeFarming.processWetTagShort}>
          <span class="process-tab__num">01</span>
          <span class="process-tab__label">{t.coffeeFarming.processWetTag}</span>
        </button>
        <button class="process-tab" role="tab" aria-selected="false" aria-controls="panel-semi" id="tab-semi" data-process-tab="semi" tabindex="-1" data-short={t.coffeeFarming.processSemiTagShort}>
          <span class="process-tab__num">02</span>
          <span class="process-tab__label">{t.coffeeFarming.processSemiTag}</span>
        </button>
        <button class="process-tab" role="tab" aria-selected="false" aria-controls="panel-dry" id="tab-dry" data-process-tab="dry" tabindex="-1" data-short={t.coffeeFarming.processDryTagShort}>
          <span class="process-tab__num">03</span>
          <span class="process-tab__label">{t.coffeeFarming.processDryTag}</span>
        </button>
      </div>

      <!-- Wet Processing Panel -->
      <div class="process-panel process-panel--active" id="panel-wet" role="tabpanel" aria-labelledby="tab-wet" data-process-panel="wet">
        <div class="process-panel__intro animate-on-scroll">
          <h3 class="process-panel__title">{t.coffeeFarming.processWetTitle}</h3>
          <p class="process-panel__desc">{t.coffeeFarming.processWetDesc}</p>
        </div>
        <div class="process-steps">
          <div class="process-step animate-on-scroll">
            <div class="process-step__num" aria-hidden="true">01</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep1Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep1Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:60ms">
            <div class="process-step__num" aria-hidden="true">02</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep2Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep2Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:120ms">
            <div class="process-step__num" aria-hidden="true">03</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep3Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep3Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:180ms">
            <div class="process-step__num" aria-hidden="true">04</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep4Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep4Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:240ms">
            <div class="process-step__num" aria-hidden="true">05</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep5Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep5Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:300ms">
            <div class="process-step__num" aria-hidden="true">06</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processWetStep6Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processWetStep6Desc}</p>
            </div>
          </div>
        </div>
        <div class="process-panel__outro animate-on-scroll">
          <p>{t.coffeeFarming.processWetOutro}</p>
        </div>
      </div>

      <!-- Semi-Wet Processing Panel -->
      <div class="process-panel" id="panel-semi" role="tabpanel" aria-labelledby="tab-semi" data-process-panel="semi" hidden>
        <div class="process-panel__intro animate-on-scroll">
          <h3 class="process-panel__title">{t.coffeeFarming.processSemiTitle}</h3>
          <p class="process-panel__desc">{t.coffeeFarming.processSemiDesc}</p>
        </div>
        <div class="process-steps">
          <div class="process-step animate-on-scroll">
            <div class="process-step__num" aria-hidden="true">01</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep1Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep1Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:60ms">
            <div class="process-step__num" aria-hidden="true">02</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep2Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep2Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:120ms">
            <div class="process-step__num" aria-hidden="true">03</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep3Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep3Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:180ms">
            <div class="process-step__num" aria-hidden="true">04</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep4Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep4Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:240ms">
            <div class="process-step__num" aria-hidden="true">05</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep5Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep5Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:300ms">
            <div class="process-step__num" aria-hidden="true">06</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processSemiStep6Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processSemiStep6Desc}</p>
            </div>
          </div>
        </div>
        <div class="process-panel__outro animate-on-scroll">
          <p>{t.coffeeFarming.processSemiOutro}</p>
        </div>
      </div>

      <!-- Dry Processing Panel -->
      <div class="process-panel" id="panel-dry" role="tabpanel" aria-labelledby="tab-dry" data-process-panel="dry" hidden>
        <div class="process-panel__intro animate-on-scroll">
          <h3 class="process-panel__title">{t.coffeeFarming.processDryTitle}</h3>
          <p class="process-panel__desc">{t.coffeeFarming.processDryDesc}</p>
        </div>
        <div class="process-steps">
          <div class="process-step animate-on-scroll">
            <div class="process-step__num" aria-hidden="true">01</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep1Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep1Desc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:60ms">
            <div class="process-step__num" aria-hidden="true">02</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep2Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep2Desc}</p>
            </div>
          </div>
          <div class="process-step process-step--split animate-on-scroll" style="transition-delay:120ms">
            <div class="process-step__num" aria-hidden="true">03</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep3aTitle}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep3aDesc}</p>
            </div>
            <div class="process-step__divider" aria-hidden="true">|</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep3bTitle}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep3bDesc}</p>
            </div>
          </div>
          <div class="process-step animate-on-scroll" style="transition-delay:180ms">
            <div class="process-step__num" aria-hidden="true">04</div>
            <div class="process-step__body">
              <h4 class="process-step__title">{t.coffeeFarming.processDryStep4Title}</h4>
              <p class="process-step__desc">{t.coffeeFarming.processDryStep4Desc}</p>
            </div>
          </div>
        </div>
        <div class="process-panel__outro animate-on-scroll">
          <p>{t.coffeeFarming.processDryOutro}</p>
        </div>
      </div>
    </div>
  </section>
  <script>
      /* ── Mobile: swap long tab label → short label ─── */
  const SHORT_BREAKPOINT = 480;

  function isMobileTab(): boolean {
    return window.matchMedia(`(max-width: ${SHORT_BREAKPOINT - 1}px)`).matches;
  }

  function applyMobileLabels() {
    const isMobile = isMobileTab();
    tabs.forEach(tab => {
      const label = tab.querySelector<HTMLElement>('.process-tab__label');
      const short = tab.dataset.short ?? '';
      if (label) {
        label.textContent = isMobile && short ? short : (tab.dataset.fullLabel ?? label.textContent);
      }
    });
  }

  const tabs    = document.querySelectorAll<HTMLElement>('[data-process-tab]');
  const panels  = document.querySelectorAll<HTMLElement>('[data-process-panel]');

  /* Store full label before any mobile swap */
  tabs.forEach(tab => {
    const label = tab.querySelector<HTMLElement>('.process-tab__label');
    if (label) tab.dataset.fullLabel = label.textContent ?? '';
  });

  applyMobileLabels();
  window.addEventListener('resize', applyMobileLabels);

  /* ── Process method tabs ───────────────────────── */
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.processTab ?? '';

      /* Update ARIA states */
      tabs.forEach(t => {
        const isActive = t.dataset.processTab === target;
        t.classList.toggle('process-tab--active', isActive);
        t.setAttribute('aria-selected', String(isActive));
        t.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      /* Show/hide panels */
      panels.forEach(p => {
        const isActive = p.dataset.processPanel === target;
        if (isActive) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });

      /* Re-trigger animations */
      panels.forEach(p => {
        if (!p.hasAttribute('hidden')) {
          p.style.animation = 'none';
          p.offsetHeight; /* force reflow */
          p.style.animation = '';
        }
      });
    });

    /* Keyboard navigation within tabs */
    tab.addEventListener('keydown', (e: KeyboardEvent) => {
      const tabArr = Array.from(tabs);
      const idx = tabArr.indexOf(tab as HTMLElement);
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const next = tabArr[idx + 1] ?? tabArr[0];
        next.focus();
        (next as HTMLElement).click();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = tabArr[idx - 1] ?? tabArr[tabArr.length - 1];
        prev.focus();
        (prev as HTMLElement).click();
      }
    });
  });
  </script>