---
import { Image } from 'astro:assets';
import fFarmer1 from '../../../images/farming/farmer-m.png';
import fFarmer2 from '../../../images/farming/farmer-f.png';
import { useTranslations } from '../../../i18n/utils';

interface Props {
  lang: 'id' | 'en' | 'fr';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const nl = (s: string) => s.split('\n').join('<br>');

const farmers = [
  { nameKey: 'farmerMale', villageKey: 'farmerMaleVillage', sinceKey: 'farmerMaleSince', quoteKey: 'farmerMaleQuote', img: fFarmer1 },
  { nameKey: 'farmerFemale',     villageKey: 'farmerFemaleVillage',     sinceKey: 'farmerFemaleSince',     quoteKey: 'farmerFemaleQuote',     img: fFarmer2 },
];
---

<section class="farmers section" aria-labelledby="farmers-heading">
  <div class="container">
    <header class="section__header animate-on-scroll">
      <h2 id="farmers-heading" class="section-title" set:html={nl(t.coffeeFarming.farmersTitle)}></h2>
      <p class="section-sub">{t.coffeeFarming.farmersSubtitle}</p>
    </header>

    <div class="farmers__grid">
      {farmers.map((farmer, i) => (
        <article class="farmer-card animate-on-scroll">
          <div class={`farmer-card__media ${i % 2 !== 0 ? 'desktop-order-2' : ''}`}>
            <Image
              src={farmer.img}
              alt={`${t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]} — ${t.coffeeFarming.farmerRole}`}
              loading="lazy"
              widths={[480, 768]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="farmer-card__img"
            />
            <div class="farmer-card__info-badge">
              <span class="farmer-card__village">{t.coffeeFarming[farmer.villageKey as keyof typeof t.coffeeFarming]}</span>
              <span class="farmer-card__since">{t.coffeeFarming[farmer.sinceKey as keyof typeof t.coffeeFarming]}</span>
            </div>
          </div>
          
          <div class="farmer-card__content">
            <blockquote class="farmer-card__quote">
              <p>"{t.coffeeFarming[farmer.quoteKey as keyof typeof t.coffeeFarming]}"</p>
            </blockquote>
            <footer class="farmer-card__author">
              <span class="farmer-card__name">{t.coffeeFarming[farmer.nameKey as keyof typeof t.coffeeFarming]}</span>
              <cite class="farmer-card__role">{t.coffeeFarming.farmerRole}</cite>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.farmers__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  margin-top: var(--space-8);
}

.farmer-card {
  display: grid;
  grid-template-columns: 1fr;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: #fff;
  border: 0.5px solid var(--color-neutral-200);
  transition: box-shadow 300ms ease;
}

.farmer-card__media { 
  position: relative; 
  overflow: hidden; 
  min-height: 180px; 
}

.farmer-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  transition: transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.farmer-card__content {
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-4);
}

.farmer-card__quote {
  margin: 0;
  border-left: 3px solid var(--color-brand-red);
  padding-left: var(--space-4);
}

.farmer-card__quote p {
  font-family: var(--font-display);
  font-size: clamp(16px, 1.8vw, 22px);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.45;
  letter-spacing: -0.01em;
  font-style: italic;
  margin: 0;
}

.farmer-card__author { 
  display: flex; 
  flex-direction: column; 
  gap: 2px; 
  font-style: normal;
}

.farmer-card__name {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-brand-earth);
}

.farmer-card__role {
  font-family: var(--font-label);
  font-size: 0.75rem;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
  font-style: normal;
}

/* Info badge styling */
.farmer-card__info-badge {
  position: absolute;
  bottom: var(--space-3);
  right: var(--space-3);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background: rgba(26,15,8,0.75);
  backdrop-filter: blur(4px);
  padding: 6px 10px;
  border-radius: var(--radius-md);
  color: #fff;
}
.farmer-card__village { font-size: 1rem; font-weight: 600; }
.farmer-card__since { font-size: 0.75rem; opacity: 0.8; }

/* ── Media Queries Mobile First ── */
@media (min-width: 481px) {
  .farmer-card__media { min-height: 220px; }
}

@media (min-width: 769px) {
  .farmer-card { grid-template-columns: 1fr 1fr; }
  .farmer-card__media { min-height: 280px; }
  .farmer-card__content { padding: var(--space-8) var(--space-6); }
  
  /* Modern CSS Order menggantikan direction: RTL */
  .desktop-order-2 {
    order: 2;
  }
}

@media (min-width: 1025px) {
  .farmers__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (hover: hover) {
  .farmer-card:hover { box-shadow: 0 12px 40px rgba(92,61,30,0.10); }
  .farmer-card:hover .farmer-card__img { transform: scale(1.04); }
}
</style>