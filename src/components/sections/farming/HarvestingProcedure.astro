---
const { t } = Astro.props;
const nl = (s: string) => s.split('\n').join('<br>');

---
  <!-- ── Harvesting Procedure ────────────────────────── -->
  <section class="harvest-proc section" id="harvest-procedure" aria-labelledby="harvest-proc-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="harvest-proc-heading" class="section-title">{nl(t.coffeeFarming.harvestProcTitle)}</h2>
        <p class="section-sub">{t.coffeeFarming.harvestProcSubtitle}</p>
      </div>

      <div class="harvest-steps">
        <div class="harvest-steps__grid">
          <div class="harvest-step-card animate-on-scroll">
            <div class="harvest-step-card__num" aria-hidden="true">01</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep1Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep1Desc}</p>
            </div>
          </div>
          <div class="harvest-step-card animate-on-scroll" style="transition-delay:80ms">
            <div class="harvest-step-card__num" aria-hidden="true">02</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep2Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep2Desc}</p>
            </div>
          </div>
          <div class="harvest-step-card animate-on-scroll" style="transition-delay:160ms">
            <div class="harvest-step-card__num" aria-hidden="true">03</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep3Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep3Desc}</p>
            </div>
          </div>
          <div class="harvest-step-card animate-on-scroll" style="transition-delay:240ms">
            <div class="harvest-step-card__num" aria-hidden="true">04</div>
            <div class="harvest-step-card__body">
              <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep4Title}</h3>
              <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep4Desc}</p>
            </div>
          </div>
        </div>
        <div class="harvest-proc__outro animate-on-scroll">
          <p>{t.coffeeFarming.harvestProcOutro}</p>
        </div>
      </div>
    </div>
  </section>