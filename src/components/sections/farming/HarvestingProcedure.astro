---
import { useTranslations } from '../../../i18n/utils';

const { lang } = Astro.props;
const currentLang = ['id', 'en', 'fr'].includes(lang || '') ? (lang as 'id' | 'en' | 'fr') : 'id';
const t = useTranslations(currentLang);
const nl = (s: string) => s.split('\n').join('<br>');
---
<section class="harvest-proc section" id="harvest-procedure" aria-labelledby="harvest-proc-heading">
  <div class="container">
    <header class="section__header animate-on-scroll">
      <h2 id="harvest-proc-heading" class="section-title" set:html={nl(t.coffeeFarming.harvestProcTitle)} />
      <p class="section-sub">{t.coffeeFarming.harvestProcSubtitle}</p>
    </header>

    <div class="harvest-steps">
      <ol class="harvest-steps__grid">
        <li class="harvest-step-card animate-on-scroll">
          <div class="harvest-step-card__num" aria-hidden="true">01</div>
          <div class="harvest-step-card__body">
            <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep1Title}</h3>
            <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep1Desc}</p>
          </div>
        </li>
        <li class="harvest-step-card animate-on-scroll" style="transition-delay:80ms">
          <div class="harvest-step-card__num" aria-hidden="true">02</div>
          <div class="harvest-step-card__body">
            <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep2Title}</h3>
            <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep2Desc}</p>
          </div>
        </li>
        <li class="harvest-step-card animate-on-scroll" style="transition-delay:160ms">
          <div class="harvest-step-card__num" aria-hidden="true">03</div>
          <div class="harvest-step-card__body">
            <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep3Title}</h3>
            <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep3Desc}</p>
          </div>
        </li>
        <li class="harvest-step-card animate-on-scroll" style="transition-delay:240ms">
          <div class="harvest-step-card__num" aria-hidden="true">04</div>
          <div class="harvest-step-card__body">
            <h3 class="harvest-step-card__title">{t.coffeeFarming.harvestProcStep4Title}</h3>
            <p class="harvest-step-card__desc">{t.coffeeFarming.harvestProcStep4Desc}</p>
          </div>
        </li>
      </ol>
      <div class="harvest-proc__outro animate-on-scroll">
        <p>{t.coffeeFarming.harvestProcOutro}</p>
      </div>
    </div>
  </div>
</section>

<style>
.harvest-proc {
  padding-top: var(--space-16);
  padding-bottom: var(--space-16);
  background: #fff;
}

.harvest-steps { overflow: hidden; }

.harvest-steps__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  margin-top: var(--space-8);
  padding: 0;
  list-style: none;
}

.harvest-step-card {
  background: #FAF8F5;
  border: 0.5px solid rgba(205, 18, 34, 0.10);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  transition: box-shadow 300ms ease, transform 300ms ease;
}

.harvest-step-card__num {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 700;
  color: rgba(205, 18, 34, 1);
  line-height: 1;
  letter-spacing: -0.04em;
}

.harvest-step-card__body { display: flex; flex-direction: column; gap: var(--space-2); }

.harvest-step-card__title {
  font-family: var(--font-display);
  font-size: clamp(14px, 1.5vw, 17px);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.25;
}

.harvest-step-card__desc {
  font-family: var(--font-body);
  font-size: 0.75rem;
  line-height: 1.75;
  color: var(--color-brand-muted);
}

.harvest-proc__outro {
  margin-top: var(--space-8);
  padding: var(--space-6);
  background: rgba(205, 18, 34, 0.04);
  border-left: 3px solid var(--color-brand-red);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
}

.harvest-proc__outro p {
  font-family: var(--font-body);
  font-size: 0.875rem;
  line-height: 1.75;
  color: var(--color-brand-earth);
  font-style: italic;
}

@media (min-width: 768px) {
  .harvest-steps__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (hover: hover) {
  .harvest-step-card:hover {
    box-shadow: 0 8px 32px rgba(92, 61, 30, 0.10);
    transform: translateY(-2px);
  }
}
</style>