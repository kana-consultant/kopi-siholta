---
import { Image } from 'astro:assets';
import fFarm from '../../../images/farming/coffee-plantation.jpg';
import fFarm2 from '../../../images/farming/coffee-plantation (2).jpg';
import fFarm3 from '../../../images/farming/coffee-plantation (3).jpg';
import { useTranslations } from '../../../i18n/utils';

interface Props {
  lang: 'id' | 'en' | 'fr';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const nl = (s: string) => s.split('\n').join('<br>');

const regions = [
  { nameKey: 'regionLintong', altKey: 'regionLintongAlt', descKey: 'regionLintongDesc', img: fFarm },
  { nameKey: 'regionDolok',   altKey: 'regionDolokAlt',   descKey: 'regionDolokDesc',   img: fFarm2   },
  { nameKey: 'regionHumbang', altKey: 'regionHumbangAlt', descKey: 'regionHumbangDesc', img: fFarm3 },
];
---

<section class="regions section section--cream" aria-labelledby="regions-heading">
  <div class="container">
    <header class="section__header animate-on-scroll">
      <h2 id="regions-heading" class="section-title" set:html={nl(t.coffeeFarming.regionsTitle)}></h2>
      <p class="section-sub">{t.coffeeFarming.regionsSubtitle}</p>
    </header>

    <div class="regions__grid">
      {regions.map((region, i) => (
        <article class="region-card animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
          <figure class="region-card__media">
            <Image
              src={region.img}
              alt={`Perkebunan kopi di ${t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              widths={[480, 768]}
              sizes="(max-width: 768px) 100vw, 33vw"
              class="region-card__img"
            />
          </figure>
          <div class="region-card__body">
            <h3 class="region-card__name">{t.coffeeFarming[region.nameKey as keyof typeof t.coffeeFarming]}</h3>
            <p class="region-card__desc">{t.coffeeFarming[region.descKey as keyof typeof t.coffeeFarming]}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.regions__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  margin-top: var(--space-8);
}

.region-card {
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: #fff;
  border: 0.5px solid var(--color-neutral-200);
  transition: box-shadow 300ms ease, transform 300ms ease;
}

.region-card__media { position: relative; overflow: hidden; margin: 0; }

.region-card__img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
  transition: transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.region-card__body { padding: var(--space-5); }

.region-card__name {
  font-family: var(--font-display);
  font-size: clamp(16px, 1.8vw, 20px);
  font-weight: 700;
  color: var(--color-brand-earth);
  margin-bottom: var(--space-2);
  line-height: 1.2;
}

.region-card__desc {
  font-family: var(--font-body);
  font-size: 0.75rem;
  line-height: 1.7;
  color: var(--color-brand-muted);
}

/* ── Media Queries Mobile First ── */
@media (min-width: 641px) {
  .regions__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1025px) {
  .regions__grid { grid-template-columns: repeat(3, 1fr); }
}

@media (hover: hover) {
  .region-card:hover {
    box-shadow: 0 12px 40px rgba(92,61,30,0.12);
    transform: translateY(-3px);
  }
  .region-card:hover .region-card__img { transform: scale(1.05); }
}
</style>