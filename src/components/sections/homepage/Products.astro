---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
// Product images from images/products/
import product1Img from '../../../images/products/arabicabubuk250g.png';
import product2Img from '../../../images/products/arabica-bubuk70g.png';
import product3Img from '../../../images/products/arabica rosbeans70g.png';
import product4Img from '../../../images/products/arabicakapsul70g.png';
import product5Img from '../../../images/products/robustabubuk250g.png';
import product6Img from '../../../images/products/robustabubuk70g.png';
import product7Img from '../../../images/products/robustarosbeans70g.png';
import product8Img from '../../../images/products/robustakapsul70g.png';
import tokpedLogo from '../../../images/logo/logo-tokopedia.png';
import shopeeLogo from '../../../images/logo/logo-shopee.png';
import { t } from '../../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

// Marketplace shortlinks per product (order matches products array)
const tokpedLinks = [
  'https://tk.tokopedia.com/ZSxRaCBXg/',
  'https://tk.tokopedia.com/ZSxRmkexJ/',
  'https://tk.tokopedia.com/ZSxRm12mu/',
  'https://tk.tokopedia.com/ZSxRaEDUp/',
  'https://tk.tokopedia.com/ZSxRaCBXg/',
  'https://tk.tokopedia.com/ZSxRmkexJ/',
  'https://tk.tokopedia.com/ZSxRaCBXg/',
  'https://tk.tokopedia.com/ZSxRaEDUp/',
];
const shopeeLinks = [
  'https://s.shopee.co.id/BQeqUtbv3',
  'https://s.shopee.co.id/1BJC2ICX6K',
  'https://s.shopee.co.id/BQeqUtbv3',
  'https://s.shopee.co.id/1BJC2ICX6K',
  'https://s.shopee.co.id/5L8l02GVoQ',
  'https://s.shopee.co.id/2VoZcrNoF8',
  'https://s.shopee.co.id/5L8l02GVoQ',
  'https://s.shopee.co.id/2VoZcrNoF8',
];

const products = [
  { slug: 'arabica-bubuk-250',       img: product1Img, alt: tr.products.product1Name ?? 'Kopi Siholta Arabica Bubuk 250 gr' },
  { slug: 'arabica-bubuk-70',        img: product2Img, alt: tr.products.product2Name ?? 'Kopi Siholta Arabica Bubuk 70 gr' },
  { slug: 'arabica-roasted-bean-70',  img: product3Img, alt: tr.products.product3Name ?? 'Kopi Siholta Arabica Roasted Bean 70 gr' },
  { slug: 'arabica-kopi-kapsul-10x7', img: product4Img, alt: tr.products.product4Name ?? 'Kopi Siholta Arabica Kopi Kapsul 10 x 7 gr' },
  { slug: 'robusta-bubuk-250',       img: product5Img, alt: tr.products.product5Name ?? 'Kopi Siholta Robusta Bubuk 250 gr' },
  { slug: 'robusta-bubuk-70',         img: product6Img, alt: tr.products.product6Name ?? 'Kopi Siholta Robusta Bubuk 70 gr' },
  { slug: 'robusta-roasted-bean-70',  img: product7Img, alt: tr.products.product7Name ?? 'Kopi Siholta Robusta Roasted Bean 70 gr' },
  { slug: 'robusta-kopi-kapsul-10x7', img: product8Img, alt: tr.products.product8Name ?? 'Kopi Siholta Robusta Kopi Kapsul 10 x 7 gr' },
];

// Key lookups per product index
const nameKeys   = ['product1Name','product2Name','product3Name','product4Name','product5Name','product6Name','product7Name','product8Name'];
const descKeys   = ['product1Desc','product2Desc','product3Desc','product4Desc','product5Desc','product6Desc','product7Desc','product8Desc'];
const qrKeys     = ['product1QR',  'product2QR',  'product3QR',  'product4QR',  'product5QR',  'product6QR',  'product7QR',  'product8QR'];
const badgeKeys  = ['tagBestSeller','tagPopular','tagValuePack','tagGiftReady','tagBestSeller','tagPopular','tagValuePack','tagGiftReady'];
const badgeColors = ['#2A7B40','#CD1222','#4A2511','#C17F3C','#4A2511','#CD1222','#2A7B40','#C17F3C'];
---

<section class="products section" id="products" aria-label="Product Showcase">
  <div class="container">

    <!-- Header -->
    <div class="section__header">
      <h2 class="section-title">{tr.products.title}</h2>
      <p class="section-sub">{tr.products.subtitle}</p>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
      {products.map((product, i) => {
        const name       = tr.products[nameKeys[i]  as keyof typeof tr.products] as string ?? '';
        const desc       = tr.products[descKeys[i]  as keyof typeof tr.products] as string ?? '';
        const qr         = tr.products[qrKeys[i]     as keyof typeof tr.products] as string ?? '';
        const badge      = tr.products[badgeKeys[i]  as keyof typeof tr.products] as string ?? '';
        const badgeColor = badgeColors[i];
        const tokpedUrl  = tokpedLinks[i];
        const shopeeUrl  = shopeeLinks[i];

        return (
          <article class="product-card" aria-label={name}>
            <!-- Image -->
            <div class="product-card__media">
              <Image
                src={product.img}
                alt={product.alt}
                class="product-card__img"
                loading={i < 4 ? 'eager' : 'lazy'}
                widths={[320, 480, 640]}
                sizes="(max-width: 540px) 100vw, (max-width: 900px) 50vw, (max-width: 1280px) 33vw, 25vw"
              />
              <div class="product-card__overlay"></div>
              <span class="product-card__badge" style={`background: ${badgeColor}`}>{badge}</span>
            </div>

            <!-- Body -->
            <div class="product-card__body">
              <span class="product-card__variant">Kopi Siholta</span>
              <h3 class="product-card__name">{name}</h3>
              <p class="product-card__desc">{desc}</p>

              {qr && (
                <div class="product-card__barcode" aria-label={`Product code: ${qr}`}>
                  <span class="product-card__barcode-label">CODE</span>
                  <span class="product-card__barcode-num">{qr}</span>
                </div>
              )}
            </div>

            <!-- Footer -->
            <div class="product-card__footer">
              <div class="product-card__ecomm">
                <a href={tokpedUrl} target="_blank" rel="noopener noreferrer"
                  class="ecomm-btn ecomm-btn--tokped"
                  aria-label={`${tr.products.buyTokopedia} — ${name}`}>
                  <Image src={tokpedLogo} alt="Tokopedia" width={52} />
                </a>
                <a href={shopeeUrl} target="_blank" rel="noopener noreferrer"
                  class="ecomm-btn ecomm-btn--shopee"
                  aria-label={`${tr.products.buyShopee} — ${name}`}>
                  <Image src={shopeeLogo} alt="Shopee" width={52} />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>