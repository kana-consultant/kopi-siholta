---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
// Product images from images/products/
import product1Img from '../../../images/products/arabicabubuk250g.png';
import product2Img from '../../../images/products/arabica-bubuk70g.png';
import product3Img from '../../../images/products/arabica rosbeans70g.png';
import product4Img from '../../../images/products/arabicakapsul70g.png';
import product5Img from '../../../images/products/robustabubuk250g.png';
import product6Img from '../../../images/products/robustabubuk70g.png';
import product7Img from '../../../images/products/robustarosbeans70g.png';
import product8Img from '../../../images/products/robustakapsul70g.png';
import tokpedLogo from '../../../images/logo/logo-tokopedia.png';
import shopeeLogo from '../../../images/logo/logo-shopee.png';
import { t } from '../../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

// Marketplace shortlinks per product (order matches products array)
const tokpedLinks = [
  'https://tk.tokopedia.com/ZSxRaCBXg/',
  'https://tk.tokopedia.com/ZSxRmkexJ/',
  'https://tk.tokopedia.com/ZSxRm12mu/',
  'https://tk.tokopedia.com/ZSxRaEDUp/',
  'https://tk.tokopedia.com/ZSxRaCBXg/',
  'https://tk.tokopedia.com/ZSxRmkexJ/',
  'https://tk.tokopedia.com/ZSxRaCBXg/',
  'https://tk.tokopedia.com/ZSxRaEDUp/',
];
const shopeeLinks = [
  'https://s.shopee.co.id/BQeqUtbv3',
  'https://s.shopee.co.id/1BJC2ICX6K',
  'https://s.shopee.co.id/BQeqUtbv3',
  'https://s.shopee.co.id/1BJC2ICX6K',
  'https://s.shopee.co.id/5L8l02GVoQ',
  'https://s.shopee.co.id/2VoZcrNoF8',
  'https://s.shopee.co.id/5L8l02GVoQ',
  'https://s.shopee.co.id/2VoZcrNoF8',
];

const products = [
  { slug: 'arabica-bubuk-250',       img: product1Img, alt: tr.products.product1Name ?? 'Kopi Siholta Arabica Bubuk 250 gr' },
  { slug: 'arabica-bubuk-70',        img: product2Img, alt: tr.products.product2Name ?? 'Kopi Siholta Arabica Bubuk 70 gr' },
  { slug: 'arabica-roasted-bean-70',  img: product3Img, alt: tr.products.product3Name ?? 'Kopi Siholta Arabica Roasted Bean 70 gr' },
  { slug: 'arabica-kopi-kapsul-10x7', img: product4Img, alt: tr.products.product4Name ?? 'Kopi Siholta Arabica Kopi Kapsul 10 x 7 gr' },
  { slug: 'robusta-bubuk-250',       img: product5Img, alt: tr.products.product5Name ?? 'Kopi Siholta Robusta Bubuk 250 gr' },
  { slug: 'robusta-bubuk-70',         img: product6Img, alt: tr.products.product6Name ?? 'Kopi Siholta Robusta Bubuk 70 gr' },
  { slug: 'robusta-roasted-bean-70',  img: product7Img, alt: tr.products.product7Name ?? 'Kopi Siholta Robusta Roasted Bean 70 gr' },
  { slug: 'robusta-kopi-kapsul-10x7', img: product8Img, alt: tr.products.product8Name ?? 'Kopi Siholta Robusta Kopi Kapsul 10 x 7 gr' },
];

// Key lookups per product index
const nameKeys   = ['product1Name','product2Name','product3Name','product4Name','product5Name','product6Name','product7Name','product8Name'];
const descKeys   = ['product1Desc','product2Desc','product3Desc','product4Desc','product5Desc','product6Desc','product7Desc','product8Desc'];
const qrKeys     = ['product1QR',  'product2QR',  'product3QR',  'product4QR',  'product5QR',  'product6QR',  'product7QR',  'product8QR'];
const badgeKeys  = ['tagBestSeller','tagPopular','tagValuePack','tagGiftReady','tagBestSeller','tagPopular','tagValuePack','tagGiftReady'];
const badgeColors = ['#2A7B40','#CD1222','#4A2511','#C17F3C','#4A2511','#CD1222','#2A7B40','#C17F3C'];
---

<section class="products section" id="products" aria-label="Product Showcase">
  <div class="container">

    <!-- Header -->
    <div class="section__header">
      <h2 class="section-title">{tr.products.title}</h2>
      <p class="section-sub">{tr.products.subtitle}</p>
    </div>

    <!-- Product Grid -->
    <div class="product-grid">
      {products.map((product, i) => {
        const name       = tr.products[nameKeys[i]  as keyof typeof tr.products] as string ?? '';
        const desc       = tr.products[descKeys[i]  as keyof typeof tr.products] as string ?? '';
        const qr         = tr.products[qrKeys[i]     as keyof typeof tr.products] as string ?? '';
        const badge      = tr.products[badgeKeys[i]  as keyof typeof tr.products] as string ?? '';
        const badgeColor = badgeColors[i];
        const tokpedUrl  = tokpedLinks[i];
        const shopeeUrl  = shopeeLinks[i];

        return (
          <article class="product-card" aria-label={name}>
            <!-- Image -->
            <div class="product-card__media">
              <Image
                src={product.img}
                alt={product.alt}
                class="product-card__img"
                loading={i < 4 ? 'eager' : 'lazy'}
                widths={[320, 480, 640]}
                sizes="(max-width: 540px) 100vw, (max-width: 900px) 50vw, (max-width: 1280px) 33vw, 25vw"
              />
              <div class="product-card__overlay"></div>
              <span class="product-card__badge" style={`background: ${badgeColor}`}>{badge}</span>
            </div>

            <!-- Body -->
            <div class="product-card__body">
              <span class="product-card__variant">Kopi Siholta</span>
              <h3 class="product-card__name">{name}</h3>
              <p class="product-card__desc">{desc}</p>

              {qr && (
                <div class="product-card__barcode" aria-label={`Product code: ${qr}`}>
                  <span class="product-card__barcode-label">CODE</span>
                  <span class="product-card__barcode-num">{qr}</span>
                </div>
              )}
            </div>

            <!-- Footer -->
            <div class="product-card__footer">
              <div class="product-card__ecomm">
                <a href={tokpedUrl} target="_blank" rel="noopener noreferrer"
                  class="ecomm-btn ecomm-btn--tokped"
                  aria-label={`${tr.products.buyTokopedia} — ${name}`}>
                  <Image src={tokpedLogo} alt="Tokopedia" width={52} />
                </a>
                <a href={shopeeUrl} target="_blank" rel="noopener noreferrer"
                  class="ecomm-btn ecomm-btn--shopee"
                  aria-label={`${tr.products.buyShopee} — ${name}`}>
                  <Image src={shopeeLogo} alt="Shopee" width={52} />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<style>
  
.products {
  background: var(--color-brand-cream);
  padding-block: var(--space-12);
}

.products .section-title { color: var(--color-brand-earth); font-family: var(--font-display); font-size: clamp(28px, 4vw, 48px); }
.products .section-sub { color: var(--color-brand-muted); }

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  margin-top: var(--space-8);
}

.product-card {
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-xl);
  overflow: hidden;
  background: #fff;
  border: 0.5px solid var(--color-neutral-200);
  transition:
    border-color 240ms ease,
    box-shadow 240ms ease,
    transform 200ms ease;
  cursor: pointer;
}

.product-card:hover {
  border-color: var(--color-brand-red);
  box-shadow: 0 8px 32px rgba(92,61,30,0.10);
  transform: translateY(-3px);
}

.product-card__media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--color-neutral-100);
}

.product-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.product-card:hover .product-card__img { transform: scale(1.05); }

/* Overlay: subtle warm tint on hover */
.product-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(92,61,30,0.08) 0%,
    rgba(92,61,30,0.02) 100%
  );
  transition: opacity 240ms ease;
}

.product-card:hover .product-card__overlay { opacity: 0.6; }

/* ── Badge ─────────────────────────────────────── */
.product-card__badge {
  position: absolute;
  top: 10px;
  left: 10px;
  font-family: var(--font-label);
  font-size: 7px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
  padding: 3px 9px;
  border-radius: 2px;
  font-weight: 600;
  line-height: 1;
  backdrop-filter: blur(4px);
}

.product-card__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-5) var(--space-5) var(--space-4);
  flex: 1;
}

.product-card__variant {
  font-family: var(--font-label);
  font-size: 7px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
  opacity: 0.8;
}

.product-card__name {
  font-family: var(--font-display);
  font-size: clamp(13px, 1.2vw, 15px);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.25;
  letter-spacing: -0.01em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-card__desc {
  font-family: var(--font-body);
  font-size: 11.5px;
  line-height: 1.65;
  color: var(--color-brand-muted);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.product-card__barcode {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px 5px 8px;
  background: color-mix(in srgb, var(--color-brand-red) 8%, transparent);
  border-radius: var(--radius-sm);
  width: fit-content;
}

.product-card__barcode-label {
  font-family: var(--font-label);
  font-size: 6px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-brand-earth);
  opacity: 0.65;
}

.product-card__barcode-num {
  font-family: var(--font-label);
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--color-brand-earth);
  font-weight: 500;
}

.product-card__footer {
  display: flex;
  gap: var(--space-2);
  padding: 0 var(--space-5) var(--space-5);
}

.product-card__ecomm {
  display: flex;
  gap: var(--space-2);
  flex: 1;
}

.ecomm-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px 8px;
  border-radius: 4px;
  transition: opacity 180ms ease, transform 180ms ease;
  flex-shrink: 0;
}

.ecomm-btn img { display: block; height: 15px; width: auto; }
.ecomm-btn:hover { opacity: 0.8; transform: translateY(-1px); }
.ecomm-btn--tokped { background: rgba(255,255,255,0.95); }

.ecomm-btn--shopee {
  background: rgba(238, 77, 45, 0.12);
  border: 0.5px solid rgba(238, 77, 45, 0.30);
}

.ecomm-btn--shopee:hover { background: rgba(238, 77, 45, 0.22); }

/* ── Responsive Breakpoints ─────────────────────── */
@media (max-width: 1280px) {
  .product-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 900px) {
  .product-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
}

@media (max-width: 540px) {
  .product-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .product-card__name { font-size: 15px; }
  .product-card__body { padding: var(--space-4); }
  .product-card__footer { padding: 0 var(--space-4) var(--space-4); }
}

</style>