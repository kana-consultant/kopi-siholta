---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import globePic from '../../../images/globe-p.png';
import { t } from '../../../i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const tr = t(lang);

const countryKeys = ['countryUSA', 'countryJapan', 'countryKorea', 'countryTimurTengah', 'countryHongkong', 'countryBelanda', 'countryAfrika'] as const;
const codes = ['US', 'JP', 'KR', 'AE', 'HK', 'NL', 'ZA'];
const flags = ['🇺🇸', '🇯🇵', '🇰🇷', '🇦🇪', '🇭🇰', '🇳🇱', '🇿🇦'];
const active = [true, true, true, false, false, false, false];

const kpiKeys = [
  { num: '100T', labelKey: 'kpi1' as const },
  { num: '6+',   labelKey: 'kpi2' as const },
  { num: '15+',  labelKey: 'kpi3' as const },
  { num: '12+',  labelKey: 'kpi4' as const },
];
---

<section class="export" id="export" aria-label="Jangkauan Internasional">
  <div class="export__wrap">
    <div class="export__top">
      <div class="export__head">
        <h2 class="export__title">{tr.export.title}</h2>
        <p class="export__desc">{tr.export.subtitle}</p>
        <div class="export__routes">
          <p class="export__routes-label">{tr.export.routesLabel}</p>
          <div class="export__route-list">
            {countryKeys.slice(0, 3).map((key, i) => (
              <div class="export__route-item">
                <Icon name="mdi:map-marker" width="10" height="10" />
                <span>{tr.export[key]}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="export__globe-wrap" aria-hidden="true">
        <Image src={globePic} alt={tr.export.mapAlt} class="export__globe-img"
          loading="lazy" widths={[400, 600, 800]}
          sizes="(max-width: 1024px) 100vw, 50vw" />
      </div>
    </div>

    <!-- KPI Strip -->
    <div class="export__kpi-strip">
      {kpiKeys.map(kpi => (
        <div class="export__kpi-cell">
          <div class="export__kpi-icon">
            <Icon name={kpi.labelKey === 'kpi1' ? 'mdi:weight' : kpi.labelKey === 'kpi2' ? 'mdi:earth' : kpi.labelKey === 'kpi3' ? 'mdi:calendar' : 'mdi:handshake'} width="18" height="18" />
          </div>
          <span class="export__kpi-num">{kpi.num}</span>
          <span class="export__kpi-label">{tr.export[kpi.labelKey]}</span>
        </div>
      ))}
    </div>

    <!-- Country Grid -->
    <div class="export__country-grid">
      <div class="export__country-section">
        <div class="export__country-cards">
          {countryKeys.slice(0, 3).map((key, i) => (
            <div class="export__country-card export__country-card--active">
              <div class="export__country-card-code">{codes[i]}</div>
              <div class="export__country-card-info">
                <span class="export__country-card-name">{tr.export[key]}</span>
                <span class="export__country-card-status">{tr.export.statusActive}</span>
              </div>
              <Icon name="mdi:check-circle" width="14" height="14" class="export__country-card-check" />
            </div>
          ))}
        </div>
      </div>

      <div class="export__country-section">
        <div class="export__country-cards">
          {countryKeys.slice(3).map((key, i) => (
            <div class="export__country-card">
              <div class="export__country-card-code">{codes[i + 3]}</div>
              <div class="export__country-card-info">
                <span class="export__country-card-name">{tr.export[key]}</span>
                <span class="export__country-card-status">{tr.export.statusSoon}</span>
              </div>
              <Icon name="mdi:clock-outline" width="14" height="14" class="export__country-card-clock" />
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.export {
  background: var(--color-brand-cream);
  padding-block: var(--space-16);
  position: relative;
  overflow: hidden;
}

.export::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 60% at 50% 30%, rgba(92,61,30,0.06) 0%, transparent 70%),
    radial-gradient(ellipse 50% 50% at 80% 80%, rgba(205,18,34,0.04) 0%, transparent 60%);
  pointer-events: none;
}

.export__wrap {
  position: relative;
  z-index: 1;
  max-width: var(--grid-max-width, 1200px);
  margin-inline: auto;
  padding-inline: var(--section-padding-x);
  display: flex;
  flex-direction: column;
  gap: var(--space-10);
}

.export__top {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-10);
  align-items: center;
}

.export__head {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.export__title {
  font-family: var(--font-display);
  font-size: clamp(28px, 3.5vw, 46px);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.export__desc {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.75;
  color: var(--color-brand-muted);
  max-width: 400px;
}

.export__routes {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  background: rgba(205,18,34,0.05);
  border: 0.5px solid rgba(205,18,34,0.12);
  border-radius: var(--radius-xl);
}

.export__routes-label {
  font-family: var(--font-label);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
}

.export__route-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.export__route-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-label);
  font-size: 12px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: var(--color-brand-red);
  opacity: 0.9;
}

/* ── Globe ─────────────────────────────── */
.export__globe-wrap {
  position: relative;
  display: flex;
  justify-content: center;
}

.export__globe-img {
  width: 100%;
  max-width: 420px;
  height: auto;
  border-radius: var(--radius-xl);
}

/* ── KPI Strip ─────────────────────────── */
.export__kpi-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: rgba(92,61,30,0.10);
  border: 0.5px solid rgba(92,61,30,0.10);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.export__kpi-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-6) var(--space-5);
  background: var(--color-brand-cream);
  transition: background 200ms ease;
}

.export__kpi-cell:hover { background: rgba(205,18,34,0.04); }

.export__kpi-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  background: rgba(205,18,34,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-brand-red);
}

.export__kpi-num {
  font-family: var(--font-display);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 700;
  color: var(--color-brand-red);
  line-height: 1;
  letter-spacing: -0.02em;
}

.export__kpi-label {
  font-family: var(--font-label);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
  text-align: center;
}

/* ── Country Grid ───────────────────────── */
.export__country-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
}

.export__country-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.export__country-section-header {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-label);
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
}

.export__country-section-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.export__country-section-dot--active {
  background: var(--color-brand-red);
  box-shadow: 0 0 8px rgba(205,18,34,0.5);
}

.export__country-section-dot--planned {
  background: var(--color-brand-earth);
  opacity: 0.4;
}

.export__country-cards {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.export__country-card {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4) var(--space-5);
  border: 0.5px solid rgba(92,61,30,0.12);
  border-radius: var(--radius-lg);
  background: #fff;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

.export__country-card--active {
  border-color: rgba(205,18,34,0.25);
  background: rgba(205,18,34,0.04);
}

.export__country-card--active:hover {
  border-color: rgba(205,18,34,0.5);
  box-shadow: 0 4px 16px rgba(205,18,34,0.10);
}

.export__country-card:not(.export__country-card--active):hover {
  border-color: rgba(92,61,30,0.3);
  box-shadow: 0 4px 16px rgba(92,61,30,0.08);
}

.export__country-card-code {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  color: rgba(92,61,30,0.4);
  letter-spacing: 0.02em;
  min-width: 36px;
  text-align: center;
}

.export__country-card--active .export__country-card-code { color: var(--color-brand-red); }

.export__country-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.export__country-card-name {
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 600;
  color: var(--color-brand-earth);
}

.export__country-card-status {
  font-family: var(--font-label);
  font-size: 12px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
}

.export__country-card--active .export__country-card-status { color: var(--color-brand-red); }

.export__country-card-check { color: var(--color-brand-red); flex-shrink: 0; opacity: 0.7; }
.export__country-card-clock { color: rgba(92,61,30,0.4); flex-shrink: 0; }

@media (max-width: 1024px) {
  .export__top { grid-template-columns: 1fr; }
  .export__globe-wrap { order: -1; max-width: 320px; margin-inline: auto; }
  .export__kpi-strip { grid-template-columns: repeat(2, 1fr); }
  .export__country-grid { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .export__kpi-strip { grid-template-columns: 1fr 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  .export__globe-label-dot { animation: none; }
}

</style>