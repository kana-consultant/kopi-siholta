---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heritage1 from '../../../images/heritage/heritage-6.jpg';
import heritage2 from '../../../images/farming/farmer-1.jpg';
import heritage3 from '../../../images/heritage/heritage-1.jpg';
import heritage4 from '../../../images/heritage/batak-people.jpg';
import heritage5 from '../../../images/heritage/heritage-5.jpg';
import companyLogo from '../../../images/logo/logo-STI.png';
import { t } from '../../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const sectors = [
  { nameKey: 'sectorFarming' as const, iconName: 'mdi:coffee',        href: `/${lang}/coffee-farming` },
  { nameKey: 'sectorFnB' as const,       iconName: 'mdi:cup',         href: `/${lang}/fnb` },
  { nameKey: 'sectorIndustry' as const,   iconName: 'mdi:office-building', href: `/${lang}/tourism` },
];

function multiline(label: string) {
  return label.split('\n');
}
---

<!-- ── Company Pioneer Banner ───────────────────────── -->
<section class="company-banner" aria-label="PT Siholta Toba Indonesia" id="heritage">
  <div class="container company-banner__inner">
    <div class="company-banner__logo-wrap">
      <Image
        src={companyLogo}
        alt={tr.companyBanner.name}
        width={288}
        height={288}
        quality="max"
        class="company-banner__logo-img"
      />
    </div>
    <div class="company-banner__content">
      <h2 class="company-banner__name">{tr.companyBanner.name}</h2>
      <p class="company-banner__tagline">{tr.companyBanner.tagline}</p>
    </div>
    <div class="company-banner__divider" aria-hidden="true"></div>
    <div class="company-banner__sectors">
      <p class="company-banner__sectors-label">{tr.companyBanner.sectorsLabel}</p>
      {sectors.map(sector => (
        <a href={sector.href} class="company-banner__sector" style={`--sector-color: ${sector.iconName === 'mdi:coffee' ? '#5C2E10' : sector.iconName === 'mdi:cup' ? '#1A3A5C' : '#2A4A20'}`}>
          <span class="company-banner__sector-icon" aria-hidden="true"><Icon name={sector.iconName} width="18" height="18" /></span>
          <span class="company-banner__sector-name">{tr.companyBanner[sector.nameKey]}</span>
        </a>
      ))}
    </div>

    <a href={`/${lang}/company`} class="company-banner__see-more" aria-label={tr.companyBanner.ctaAria}>
      {tr.companyBanner.cta}
    </a>
  </div>
</section>

<!-- ── Heritage Section ─────────────────────────────── -->
<section class="heritage" aria-label="Heritage and Identity">
  <div class="bento">

    <!-- Feature Card -->
    <article class="bento__card bento__card--feature">
      <div class="bento__card-img-wrap">
        <Image src={heritage1} alt={tr.coffeeFarming.farmImages.altCherry} class="bento__card-img" loading="eager" format="webp" quality={75} widths={[360, 540, 720]} sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 600px" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">
          {multiline(tr.heritage.card1Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card1Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card1Desc}</p>
      </div>
    </article>

    <!-- Stat Card -->
    <article class="bento__card bento__card--stat">
      <div class="bento__card-img-wrap">
        <Image src={heritage2} alt={tr.coffeeFarming.farmImages.altFerment} class="bento__card-img" loading="lazy" format="webp" quality={75} widths={[360, 540]} sizes="(max-width: 480px) 100vw, (max-width: 1024px) 50vw, 320px" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title bento__card-title--sm">
          {multiline(tr.heritage.card2Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card2Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card2Desc}</p>
      </div>
    </article>

    <!-- Text Card -->
    <article class="bento__card bento__card--text">
      <div class="bento__card-img-wrap">
        <Image src={heritage3} alt={tr.coffeeFarming.farmImages.altSorting} class="bento__card-img" loading="lazy" format="webp" quality={75} widths={[360, 540]} sizes="(max-width: 480px) 100vw, (max-width: 1024px) 50vw, 320px" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">
          {multiline(tr.heritage.card3Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card3Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card3Desc}</p>
      </div>
    </article>

    <!-- Portrait Card -->
    <article class="bento__card bento__card--portrait">
      <div class="bento__card-img-wrap">
        <Image src={heritage4} alt={tr.coffeeFarming.farmImages.altFarm} class="bento__card-img" loading="lazy" format="webp" quality={75} widths={[360, 540]} sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 250px" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title bento__card-title--sm">
          {multiline(tr.heritage.card4Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card4Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card4Desc}</p>
      </div>
    </article>

    <!-- Wide Card -->
    <article class="bento__card bento__card--wide">
      <div class="bento__card-img-wrap">
        <Image src={heritage5} alt={tr.coffeeFarming.farmImages.altRoasting} class="bento__card-img" loading="lazy" format="webp" quality={75} widths={[360, 540, 720]} sizes="(max-width: 480px) 100vw, (max-width: 1024px) 50vw, 450px" />
        <div class="bento__card-overlay"></div>
      </div>
      <div class="bento__card-content">
        <h3 class="bento__card-title">
          {multiline(tr.heritage.card5Title).map((line, i) => (
            <>{line}{i < multiline(tr.heritage.card5Title).length - 1 ? <br /> : null}</>
          ))}
        </h3>
        <p class="bento__card-desc">{tr.heritage.card5Desc}</p>
      </div>
    </article>

  </div>
</section>

<style>
  /* ── Company Banner ─────────────────────────────── */
.company-banner {
  background: var(--color-brand-cream);
  padding-block: var(--space-8);
  border-top: 0.5px solid var(--color-neutral-200);
  border-bottom: 0.5px solid var(--color-neutral-200);
}

.company-banner__inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.company-banner__logo-wrap {
  flex-shrink: 0;
  width: 72px;
  height: 72px;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 0.5px solid var(--color-neutral-200);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.company-banner__logo-img {
  width: 72px;
  height: 72px;
  object-fit: cover;
  object-position: center;
  image-rendering: -webkit-optimize-contrast;

}

.company-banner__content { flex: 1; min-width: 180px; }

.company-banner__name {
  font-family: var(--font-display);
  font-size: clamp(18px, 2.5vw, 26px);
  font-weight: 700;
  color: var(--color-brand-earth);
  margin-bottom: 4px;
  line-height: 1.15;
}

.company-banner__tagline {
  font-size: 0.75rem;
  color: var(--color-brand-muted);
  line-height: 1.6;
}

.company-banner__tagline em { font-style: normal; color: var(--color-brand-red); }

.company-banner__divider {
  width: 100%;
  height: 0.5px;
  background: var(--color-neutral-300);
  flex-shrink: 0;
}

.company-banner__sectors {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  flex-shrink: 0;
}

.company-banner__sectors-label {
  font-family: var(--font-label);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
  margin-bottom: 2px;
}

.company-banner__sector {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: 4px 10px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.8);
  border: 0.5px solid var(--color-neutral-200);
  text-decoration: none;
  transition: background 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
}

.company-banner__sector:hover {
  background: rgba(255, 255, 255, 1);
  border-color: var(--color-brand-red);
  box-shadow: 0 2px 8px rgba(92, 61, 30, 0.10);
}

.company-banner__sector-icon {
  color: var(--sector-color, var(--color-brand-earth));
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.company-banner__sector-name {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-brand-earth);
}

.company-banner__see-more {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: var(--color-brand-red);
  color: #fff;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 200ms ease;
  flex-shrink: 0;
  width: 100%;
  justify-content: center;
}

.company-banner__see-more:hover {
  background: var(--color-brand-red);
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(205, 18, 34, 0.35);
}

/* ── Heritage Section ────────────────────────────── */
.heritage {
  background: var(--color-neutral-100);
  padding-block: var(--space-8);
  overflow: hidden;
}

/* ── Bento Grid ─────────────────────────────── */
.bento {
  display: grid;
  grid-template-columns: 1fr;
  grid-auto-rows: 220px;
  gap: var(--space-3);
  padding-inline: var(--section-padding-x);
  max-width: var(--grid-max-width);
  margin-inline: auto;
}

.bento__card {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 300ms ease;
}

.bento__card:hover {
  transform: translateY(-4px) scale(1.01);
  box-shadow: 0 16px 40px rgba(26, 15, 8, 0.12);
}

.bento__card--feature,
.bento__card--stat,
.bento__card--text,
.bento__card--portrait,
.bento__card--wide { 
  grid-column: 1 / -1; 
  grid-row: auto; 
}

.bento__card--text {
  background: #fff;
  border: var(--border-default);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--space-5);
}

.bento__card-img-wrap {
  position: absolute;
  inset: 0;
}

.bento__card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.bento__card:hover .bento__card-img { transform: scale(1.06); }

.bento__card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(20, 10, 5, 0.92) 0%,
    rgba(20, 10, 5, 0.65) 45%,
    rgba(20, 10, 5, 0.18) 100%
  );
}

.bento__card-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--space-5);
  z-index: 1;
}

.bento__card-title {
  font-family: var(--font-display);
  font-size: clamp(20px, 2vw, 28px);
  font-weight: 700;
  color: var(--color-text-red);
  line-height: 1.15;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-2);
}

.bento__card-title--sm { font-size: clamp(16px, 1.5vw, 22px); }

.bento__card-desc {
  font-family: var(--font-body);
  font-size: 0.75rem;
  line-height: 1.6;
  color: var(--color-text-main);
  margin-bottom: var(--space-3);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Responsive Media Queries (Mobile First) ── */

/* Tablet Kecil & Menengah (481px ke atas) */
@media (min-width: 481px) {
  .bento {
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 240px;
  }
  .bento__card--feature { grid-column: 1 / -1; grid-row: auto; }
  .bento__card--stat     { grid-column: 1 / 2;  grid-row: auto; }
  .bento__card--text     { grid-column: 2 / 3;  grid-row: auto; }
  .bento__card--portrait { grid-column: 1 / 2;  grid-row: auto; }
  .bento__card--wide     { grid-column: 2 / 3;  grid-row: auto; }
}

/* Tablet Besar / Laptop (769px ke atas) */
@media (min-width: 768px) {
  .company-banner__inner {
    flex-direction: row;
    align-items: center;
  }
  .company-banner__divider {
    width: 0.5px;
    height: 48px;
  }
  .company-banner__sectors {
    gap: var(--space-2);
  }
  .company-banner__see-more {
    width: auto;
  }

  .heritage { 
    padding-block: var(--space-12); 
  }

  .bento {
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 260px;
    gap: var(--space-4);
  }
  .bento__card--feature  { grid-column: 1 / 4; grid-row: 1 / 2; }
  .bento__card--stat     { grid-column: 4 / 7; grid-row: 1 / 2; }
  .bento__card--text     { grid-column: 1 / 4; grid-row: 2 / 3; }
  .bento__card--portrait { grid-column: 4 / 5; grid-row: 2 / 3; }
  .bento__card--wide     { grid-column: 5 / 7; grid-row: 2 / 3; }
}

@media (min-width: 1024px) {
  .bento {
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 280px;
  }
  .bento__card--feature  { grid-column: 1 / 7;  grid-row: 1 / 3; }
  .bento__card--stat     { grid-column: 7 / 10; grid-row: 1 / 2; }
  .bento__card--text     { grid-column: 10 / 13; grid-row: 1 / 2; }
  .bento__card--portrait { grid-column: 7 / 9;  grid-row: 2 / 3; }
  .bento__card--wide     { grid-column: 9 / 13; grid-row: 2 / 3; }
}
</style>