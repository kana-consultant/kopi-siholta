---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import waLogo from '@/images/logo/logo-whatsapp.png';
import tokpedLogo from '@/images/logo/logo-tokopedia.png';
import shopeeLogo from '@/images/logo/logo-shopee.png';
import igLogo from '@/images/logo/logo-instagram.png';
import tiktokLogo from '@/images/logo/logo-tiktok.png';
import linktreeLogo from '@/images/logo/logo-linktree.png';
import { getTranslations } from '@/i18n/utils';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);

const WHATSAPP_NUMBER = '6281322518527';
const WHATSAPP_MSG_ID = 'Halo, saya tertarik dengan Kopi Siholta. Bisa info lengkap lebih lanjut?';
const WHATSAPP_MSG_EN = 'Hello, I\'m interested in Kopi Siholta. Can I get more details?';
const WHATSAPP_MSG_FR = 'Bonjour, je suis intéressé(e) par Kopi Siholta. Pourriez-vous m\'en dire plus ?';
const WHATSAPP_MSG = lang === 'fr' ? WHATSAPP_MSG_FR : lang === 'en' ? WHATSAPP_MSG_EN : WHATSAPP_MSG_ID;
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MSG)}`;
const EMAIL = 'siholtatobaindonesia@gmail.com';
const INSTAGRAM_URL = 'https://www.instagram.com/kopi_siholta.id/';
const TOKPED_URL = 'https://www.tokopedia.com/kopisiholta';
const SHOPEE_URL = 'https://shopee.co.id/kopi_siholta';
const TIKTOK_URL = 'https://www.tiktok.com/@kopisiholta';
const LINKTREE_URL = 'https://linktr.ee/kopisiholta';
---

<section class="contact section" id="contact" aria-label="Contact Section">
  <div class="container contact__inner">

    <aside class="contact__info">
      <header class="section__header">
        <h2 class="section-title">{t.contact.title}</h2>
        <p class="section-sub">{t.contact.subtitle}</p>
      </header>
      <nav class="contact__social-grid" aria-label="Social Media">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="social-card" aria-label={t.contact.followInstagram}>
          <Image src={igLogo} alt="Instagram" width={80} height={80} quality="max" class="social-img" />
          <span>@kopi_siholta.id</span>
        </a>
        <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer" class="social-card" aria-label={t.contact.followTiktok}>
          <Image src={tiktokLogo} alt="Tiktok" width={80} height={80} quality="max" class="social-img" />
          <span>@kopisiholta</span>
        </a>
        <a href={LINKTREE_URL} target="_blank" rel="noopener noreferrer" class="social-card" aria-label="Linktree">
          <Image src={linktreeLogo} alt="Linktree" width={104} height={104} quality="max" class="social-img linktree-adjust" />
          <span>@kopisiholta</span>
        </a>
        <a href={TOKPED_URL} target="_blank" rel="noopener noreferrer" class="social-card" aria-label="Tokopedia">
          <Image src={tokpedLogo} alt="Tokopedia" width={80} height={80} quality="max" class="social-img" />
          <span>@kopisiholta</span>
        </a>
        <a href={SHOPEE_URL} target="_blank" rel="noopener noreferrer" class="social-card" aria-label="Shopee">
          <Image src={shopeeLogo} alt="Shopee" width={80} height={80} quality="max" class="social-img" />
          <span>@kopi_siholta</span>
        </a>
      </nav>

      <address class="contact__details">
        <div class="contact__detail-item">
          <Icon name="mdi:map-marker" width="14" height="14" />
          <span>{t.contact.address}</span>
        </div>
        <div class="contact__detail-item">
          <Icon name="mdi:email" width="14" height="14" />
          <a href={`mailto:${EMAIL}`} class="contact__link">{EMAIL}</a>
        </div>
        <div class="contact__detail-item">
          <Icon name="mdi:phone" width="14" height="14" />
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="contact__link">+62 813 2251 8527</a>
        </div>
      </address>

      <div class="contact__maps">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4879.739208830867!2d106.9037104!3d-6.295721899999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3007f623b53%3A0x118fc0912e442961!2sPT.%20Siholta%20Toba%20Indonesia!5e1!3m2!1sid!2sid!4v1780411154960!5m2!1sid!2sid" width="100%" height="180"
          style="border:0; border-radius: var(--radius-lg);" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={t.contact.mapsLabel}></iframe>
      </div>
    </div>

    <div class="contact__form-wrap">
      <form class="contact__form" id="contactForm" novalidate>

        <!-- Row 1: Full Name + Email -->
        <div class="form-row">
          <div class="form-group">
            <label for="fullName" class="form-label">
              {t.contact.formFullName}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              class="form-input"
              placeholder={t.contact.formFullNamePlaceholder}
              required
              autocomplete="name"
            />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">
              {t.contact.formEmail}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder={t.contact.formEmailPlaceholder}
              required
              autocomplete="email"
            />
          </div>
        </div>

        <!-- Row 2: Phone + Company -->
        <div class="form-row">
          <div class="form-group">
            <label for="phone" class="form-label">
              {t.contact.formPhone}
              <span class="form-required" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="form-input"
              placeholder={t.contact.formPhonePlaceholder}
              required
              autocomplete="tel"
            />
          </div>
          <div class="form-group">
            <label for="company" class="form-label">
              {t.contact.formCompany}
              <span class="form-optional">({t.contact.optional})</span>
            </label>
            <input
              type="text"
              id="company"
              name="company"
              class="form-input"
              placeholder={t.contact.formCompanyPlaceholder}
              autocomplete="organization"
            />
          </div>
        </div>

        <!-- Row 3: Inquiry Type -->
        <div class="form-group">
          <label for="inquiryType" class="form-label">
            {t.contact.formInquiryType}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <select id="inquiryType" name="inquiryType" class="form-input form-select" required>
            <option value="" disabled selected>{t.contact.formInquiryTypePlaceholder}</option>
            <option value={t.contact.formInquiryOpt1}>{t.contact.formInquiryOpt1}</option>
            <option value={t.contact.formInquiryOpt2}>{t.contact.formInquiryOpt2}</option>
            <option value={t.contact.formInquiryOpt3}>{t.contact.formInquiryOpt3}</option>
            <option value={t.contact.formInquiryOpt4}>{t.contact.formInquiryOpt4}</option>
          </select>
        </div>

        <!-- Row 4: Message -->
        <div class="form-group">
          <label for="message" class="form-label">
            {t.contact.formMessage}
            <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            class="form-input form-textarea"
            rows="7"
            placeholder={t.contact.formMessagePlaceholder}
            required
          ></textarea>
        </div>

        <!-- Action Buttons -->
        <div class="form-actions">
          <button
            type="button"
            id="btnWhatsApp"
            class="btn btn--whatsapp form-btn"
            aria-label={t.contact.formSendWaAria}
          >
            <Image src={waLogo} alt="WhatsApp" width={72} height={72} quality="max" class="button-wa-img"/>
            {t.contact.formSendWa}
          </button>
          <button
            type="button"
            id="btnEmail"
            class="btn btn--email form-btn"
            aria-label={t.contact.formSendEmailAria}
          >
            <Icon name="mdi:email-outline" width={18} height={18} />
            {t.contact.formSendEmail}
          </button>
        </div>

        <!-- Validation feedback -->
        <p class="form-error" id="formError" role="alert" aria-live="polite" hidden></p>

      </form>
    </div>

  </div>
</section>

<style>
  
.contact { background: var(--color-neutral-100); }

.contact__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
}

.contact__info {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.section__header {
  margin-bottom: var(--space-2);
}

.contact__social-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr); 
  gap: var(--space-2);
  width: 100%;
}

.social-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3);
  background: #fff;
  border: var(--border-default);
  border-radius: var(--radius-md);
  text-decoration: none;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  color: var(--color-brand-earth);
  transition: all 200ms ease;
  text-align: center;
}

.social-card:hover {
  border-color: var(--color-brand-red);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(26, 15, 8, 0.08);
}

.social-img {
  width: 20px;
  height: 20px;
  object-fit: contain;
  flex-shrink: 0;
  image-rendering: -webkit-optimize-contrast;
}

.social-img.linktree-adjust {
  width: 24px;
  height: 24px;
}

.contact__details {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.contact__detail-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--color-brand-muted);
  line-height: 1.5;
}

.contact__detail-item svg {
  flex-shrink: 0;
  margin-top: 1px;
  color: var(--color-brand-red);
}

.contact__link {
  color: var(--color-brand-muted);
  text-decoration: none;
  transition: color 200ms ease;
}

.contact__link:hover { 
  color: var(--color-brand-red); 
}

.contact__maps {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.contact__form-wrap {
  background: #fff;
  border: var(--border-default);
  border-radius: var(--radius-xl);
  padding: 1.25rem;
}

.contact__form {
  display: flex;
  padding: 0;
  flex-direction: column;
  gap: var(--space-4);
}

.form-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  width: 100%;
}

.form-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;     
  padding: 0.75rem 1rem;
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
}

.button-wa-img {
  width: 18px;
  height: 18px;
  object-fit: contain;
  image-rendering: -webkit-optimize-contrast;
}


/* ── Form Feedback ─────────────────────── */
.form-error {
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--color-error);
  padding: var(--space-2) var(--space-3);
  background: rgba(220, 53, 69, 0.06);
  border: 0.5px solid rgba(220, 53, 69, 0.2);
  border-radius: var(--radius-md);
  line-height: 1.5;
}

.form-required {
  color: var(--color-brand-red);
  margin-left: 2px;
}

.form-optional {
  font-weight: 400;
  color: var(--color-brand-muted);
  font-size: 0.75;
  margin-left: 4px;
}

@media (min-width: 481px) {
  .contact__social-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 641px) {
  .form-row { 
    grid-template-columns: 1fr 1fr; 
  }
}

@media (min-width: 1025px) {
  .contact__inner {
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-12);
  }
  .contact__social-grid { grid-template-columns: repeat(5, 1fr); }
  .form-actions {
    flex-direction: row;
  }
}



</style>

<script define:vars={{ WHATSAPP_NUMBER, EMAIL }}>
  const btnWa    = document.getElementById('btnWhatsApp');
  const btnEmail = document.getElementById('btnEmail');
  const errEl    = document.getElementById('formError');

  function getVal(id) { return document.getElementById(id).value.trim(); }

  function validate() {
    const fullName = getVal('fullName');
    const email    = getVal('email');
    const phone    = getVal('phone');
    const inquiry  = document.getElementById('inquiryType').value;
    const message  = getVal('message');
    const company  = getVal('company');

    if (!fullName || !email || !phone || !inquiry || !message) {
      errEl.textContent = 'Please fill in all required fields.';
      errEl.hidden = false;
      return null;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = 'Please enter a valid email address.';
      errEl.hidden = false;
      return null;
    }
    errEl.hidden = true;
    return { fullName, email, phone, company, inquiry, message };
  }

  // ---------- Send via WhatsApp ----------
  btnWa.addEventListener('click', () => {
    const d = validate();
    if (!d) return;
    const companyLine = d.company
      ? `\n*Perusahaan/Instansi:* ${d.company}` : '';
    const waText =
`Nama Lengkap: ${d.fullName}
*Email:* ${d.email}
*No. HP/WA:* ${d.phone}${companyLine}
*Jenis Keperluan:* ${d.inquiry}

*Pesan:*
${d.message}`;
    window.open(
      `https://api.whatsapp.com/send?phone=${WHATSAPP_NUMBER}&text=${encodeURIComponent(waText)}`,
      '_blank', 'noopener,noreferrer'
    );
  });

  // ---------- Send via Email ----------
  btnEmail.addEventListener('click', () => {
    const d = validate();
    if (!d) return;
    const subject = `[Kopi Siholta] ${d.inquiry} — ${d.fullName}`;
    const companyLine = d.company
      ? `Perusahaan/Instansi: ${d.company}\n` : '';
    const body =
`Nama Lengkap: ${d.fullName}
Email: ${d.email}
No. HP/WA: ${d.phone}
${companyLine}Jenis Keperluan: ${d.inquiry}

Pesan:
${d.message}`;
    window.location.href =
      `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
