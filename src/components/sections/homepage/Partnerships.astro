---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../../i18n/utils';
import '../../../styles/components/stats.css';
import '../../../styles/page.css';

import logoHypermart from '../../../images/logo/logo-hypermart.webp';
import logoHyfresh from '../../../images/logo/logo-hyfresh.webp';
import logoAngkasaPura from '../../../images/logo/logo-angkasapura.webp';
import logoSendys from '../../../images/logo/logo-sendys.webp';
import logoPrimo from '../../../images/logo/logo-primo.webp';
import logoAngkasaPura from '../../../images/logo/logo-angkasapura.png';
import logoSendys from '../../../images/logo/logo-sendys.png';
import logoPrimo from '../../../images/logo/logo-primo.png';

interface Props {
  lang: 'id' | 'en' | 'fr';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const partnerCategories = [
  {
    label: t.b2b.categoryModernRetail,
    brands: [
      { type: 'img', src: logoHypermart, alt: 'Hypermart' },
      { type: 'img', src: logoHyfresh, alt: 'Hyfresh' },
    ],
  },
  {
    label: t.b2b.categoryCorporate,
    brands: [
      { type: 'img', src: logoAngkasaPura, alt: 'Angkasa Pura' },
    ],
  },
  {
    label: t.b2b.categoryHoreca,
    brands: [
      { type: 'img', src: logoSendys, alt: 'Sendys' },
      { type: 'img', src: logoPrimo, alt: 'Primo' },
    ],
  },
];

const solutions = [
  {
    id: 'green-bean',
    icon: 'mdi:coffee',
    headline: t.b2b.cardGreenBeanTitle,
    tagline: t.b2b.cardGreenBeanTagline,
    body: t.b2b.cardGreenBeanBody,
    chips: [
      t.b2b.chipLintong,
      t.b2b.chipMoq,
      t.b2b.chipExport,
    ],
    cta: t.b2b.cardGreenBeanCta,
    accentClass: 'solution-card--green-bean',
    iconColor: '#225522',
  },
  {
    id: 'private-label',
    icon: 'mdi:tag-outline',
    headline: t.b2b.cardPrivateLabelTitle,
    tagline: t.b2b.cardPrivateLabelTagline,
    body: t.b2b.cardPrivateLabelBody,
    chips: [
      t.b2b.chipCustomRoast,
      t.b2b.chipFlexiblePackaging,
      t.b2b.chipFreeSample,
    ],
    cta: t.b2b.cardPrivateLabelCta,
    accentClass: 'solution-card--private-label',
    iconColor: '#cd1222',
  },
  {
    id: 'horeca',
    icon: 'mdi:coffee-outline',
    headline: t.b2b.cardHorecaTitle,
    tagline: t.b2b.cardHorecaTagline,
    body: t.b2b.cardHorecaBody,
    chips: [
      t.b2b.chipRoastedToOrder,
      t.b2b.chipScheduledDelivery,
      t.b2b.chipFreeConsultation,
    ],
    cta: t.b2b.cardHorecaCta,
    accentClass: 'solution-card--horeca',
    iconColor: '#5C3D1E',
  },
];

const benefits = [
  { title: t.b2b.benefit1Title, body: t.b2b.benefit1Body },
  { title: t.b2b.benefit2Title, body: t.b2b.benefit2Body },
  { title: t.b2b.benefit3Title, body: t.b2b.benefit3Body },
  { title: t.b2b.benefit4Title, body: t.b2b.benefit4Body },
];
---

<section class="b2b section" id="b2b" aria-labelledby="b2b-heading">
  <div class="container">

    <!-- Component 1: Brand Cloud with Partnership Categories -->
    <header class="b2b__header reveal">
      <h2 id="b2b-heading" class="b2b__title">{t.b2b.title}</h2>
      <p class="b2b__subtitle">{t.b2b.subtitle}</p>
    </header>

    <div class="brand-cloud reveal" aria-label="Our Trusted Partners">
      {partnerCategories.map((cat, i) => (
        <div class="brand-cloud__category reveal" style={`transition-delay: ${i * 100}ms`}>
          <span class="brand-cloud__pill">{cat.label}</span>
          <div class="brand-cloud__row">
            {cat.brands.map(brand => (
              brand.type === 'img' ? (
                <Image src={brand.src} alt={brand.alt} width={120} height={48} quality={75} class="partner-logo" loading="lazy" />
              ) : (
                <span class="brand-cloud__text">{brand.text}</span>
              )
            ))}
          </div>
        </div>
      ))}
    </div>

    <ul class="partnerships__trust-strip" role="list">
      <li class="trust-stat reveal">
        <span class="trust-stat__icon" aria-hidden="true">
          <Icon name="mdi:account-group" width={24} height={24} />
        </span>
        <div>
          <p class="trust-stat__value">{t.b2b.stat1Value}</p>
          <p class="trust-stat__label">{t.b2b.stat1Label}</p>
        </div>
      </li>
      <li class="trust-stat reveal">
        <span class="trust-stat__icon" aria-hidden="true">
          <Icon name="mdi:star-outline" width={24} height={24} />
        </span>
        <div>
          <p class="trust-stat__value">{t.b2b.stat2Value}</p>
          <p class="trust-stat__label">{t.b2b.stat2Label}</p>
        </div>
      </li>
      <li class="trust-stat reveal">
        <span class="trust-stat__icon" aria-hidden="true">
          <Icon name="mdi:shield-check-outline" width={24} height={24} />
        </span>
        <div>
          <p class="trust-stat__value">{t.b2b.stat3Value}</p>
          <p class="trust-stat__label">{t.b2b.stat3Label}</p>
        </div>
      </li>
    </ul>

    <!-- Component 2: Solutions Cards -->
    <header class="solutions__header reveal">
      <h3 class="solutions__title">{t.b2b.solutionsTitle}</h3>
      <p class="solutions__subtitle">{t.b2b.solutionsSubtitle}</p>
    </header>

    <div class="solutions-grid">
      {solutions.map((s, i) => (
        <article class={`solution-card ${s.accentClass} reveal`} style={`transition-delay: ${i * 100}ms`}>
          <div class="solution-card__icon-wrap" style={`color: ${s.iconColor}`}>
            <Icon name={s.icon} width={36} height={36} aria-hidden="true" />
          </div>
          <h4 class="solution-card__headline">{s.headline}</h4>
          <p class="solution-card__tagline">{s.tagline}</p>
          <p class="solution-card__body">{s.body}</p>
          <div class="solution-card__chips">
            {s.chips.map(chip => <span class="spec-chip">{chip}</span>)}
          </div>
          <a href={`/${lang}/#contact`} class="solution-card__cta">
            {s.cta} <Icon name="mdi:arrow-right" width={16} height={16} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>

    <!-- Component 3: Benefits Strip -->
    <div class="benefits-strip reveal">
      <div class="benefits-headline-wrap">
        <span class="eyebrow">{t.b2b.benefitsEyebrow}</span>
        <h3 class="benefits-headline">{t.b2b.benefitsHeadline}</h3>
        <p class="benefits-micro">{t.b2b.benefitsMicro}</p>
      </div>
      <ul class="benefit-list" role="list">
        {benefits.map((b, i) => (
          <li class="benefit-item reveal" style={`transition-delay: ${i * 80}ms`}>
            <span class="benefit-item__check" aria-hidden="true">
              <Icon name="mdi:check" width={20} height={20} />
            </span>
            <div>
              <h4 class="benefit-item__title">{b.title}</h4>
              <p class="benefit-item__body">{b.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Bottom CTA Bar -->
    <div class="b2b-cta reveal" aria-label={t.b2b.ctaBanner}>
      <div class="b2b-cta__inner">
        <div class="b2b-cta__text">
          <h3 class="b2b-cta__title">{t.b2b.ctaTitle}</h3>
          <p class="b2b-cta__sub">{t.b2b.ctaSubtitle}</p>
        </div>
        <div class="b2b-cta__actions">
          <a href={`/${lang}/#contact`} class="b2b-cta__btn b2b-cta__btn--primary">
            {t.b2b.ctaPrimary} <Icon name="mdi:arrow-right" width={16} height={16} aria-hidden="true" />
          </a>
          <a href={`/${lang}/#contact`} class="b2b-cta__btn b2b-cta__btn--secondary">
            {t.b2b.ctaSecondary}
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.b2b { background: var(--color-neutral-100); }

/* ── Eyebrow (shared) ─────────────────── */
.eyebrow {
  display: inline-block;
  font-family: var(--font-label);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-brand-red);
  margin-bottom: var(--space-3);
}

/* ── Header ─────────────────────────── */
.b2b__header {
  text-align: center;
  margin-bottom: var(--space-10);
}

.b2b__title {
  font-family: var(--font-display);
  font-size: clamp(28px, 3.5vw, 46px);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.2;
  letter-spacing: -0.02em;
}

/* ── B2B Subtitle ────────────────────── */
.b2b__subtitle {
  font-family: var(--font-body);
  font-size: clamp(1rem, 1.25vw, 1.125rem);
  line-height: 1.65;
  color: var(--color-brand-muted);
  max-width: 560px;
  margin: 0 auto 0;
}

.partnerships__trust-strip {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--space-6);
  list-style: none;
  padding: 0;
  margin: 0;
  margin-bottom: var(--space-12);
}

.trust-stat {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px 20px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid rgba(92, 61, 30, 0.10);
}

.trust-stat__icon {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  background: rgba(34, 85, 34, 0.10);
  color: #225522;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.trust-stat__value {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1;
  margin-bottom: 6px;
}

.trust-stat__label {
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: var(--color-brand-muted);
  line-height: 1.4;
}

/* ── Brand Cloud ──────────────────────── */
.brand-cloud {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  padding: var(--space-6) 0;
  margin-bottom: var(--space-4);
  border-bottom: 1px solid rgba(92, 61, 30, 0.10);
}

.brand-cloud__category {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3);
}

.brand-cloud__pill {
  display: inline-block;
  background: var(--color-accent, #225522);
  color: #fff;
  font-family: var(--font-label);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 6px 16px;
  border-radius: 6px;
  white-space: nowrap;
}

.brand-cloud__row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--space-8);
}

.partner-logo {
  height: 36px;
  width: auto;
  object-fit: contain;
  filter: grayscale(1) opacity(0.55);
  transition: filter 350ms ease, opacity 350ms ease;
}

.partner-logo:hover {
  filter: grayscale(0) opacity(1);
}

.brand-cloud__text {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-brand-muted);
  white-space: nowrap;
  transition: color 200ms ease, opacity 200ms ease;
  opacity: 0.65;
  cursor: default;
}

.brand-cloud__text:hover {
  color: var(--color-brand-earth);
  opacity: 1;
}

/* ── Solutions Header ───────────────── */
.solutions__header {
  text-align: center;
  margin-bottom: var(--space-8);
}

.solutions__title {
  font-family: var(--font-display);
  font-size: clamp(24px, 3vw, 34px);
  font-weight: 700;
  color: var(--color-brand-earth);
  margin-bottom: var(--space-3);
  line-height: 1.2;
}

.solutions__subtitle {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-brand-muted);
  max-width: 560px;
  margin: 0 auto;
}

/* ── Solutions Grid ──────────────────── */
.solutions-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-5);
  margin-bottom: var(--space-16);
}

.solution-card {
  background: #fff;
  border: 1px solid rgba(92, 61, 30, 0.10);
  border-radius: 20px;
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  position: relative;
  overflow: hidden;
  transition: transform 200ms ease, box-shadow 200ms ease;
}

.solution-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  border-radius: 20px 20px 0 0;
}

.solution-card--green-bean::before  { background: #225522; }
.solution-card--private-label::before { background: #cd1222; }
.solution-card--horeca::before      { background: #5C3D1E; }

.solution-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 36px rgba(92, 61, 30, 0.12);
}

.solution-card__icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: rgba(92, 61, 30, 0.06);
  flex-shrink: 0;
}

.solution-card__headline {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.2;
  margin-top: 2px;
}

.solution-card__tagline {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-brand-red);
  line-height: 1.4;
  margin: 0;
}

.solution-card__body {
  font-family: var(--font-body);
  font-size: 0.875rem;
  line-height: 1.65;
  color: var(--color-brand-muted);
  margin: 0;
}

.solution-card__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
}

.spec-chip {
  display: inline-block;
  background: var(--color-neutral);
  color: var(--color-text-brown);
  font-size: 0.75rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid rgba(92, 61, 30, 0.15);
}

.solution-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  align-self: flex-start;
  margin-top: var(--space-2);
  color: var(--color-brand-red);
  font-family: var(--font-label);
  font-size: 0.875rem;
  font-weight: 700;
  text-decoration: none;
  transition: gap 150ms ease, color 150ms ease;
}

.solution-card__cta:hover {
  gap: 10px;
  color: #a80e1a;
}

/* ── Benefits Strip ─────────────────── */
.benefits-strip {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
  padding: var(--space-12) 0;
  margin-bottom: var(--space-12);
  border-top: 1px solid rgba(92, 61, 30, 0.10);
  border-bottom: 1px solid rgba(92, 61, 30, 0.10);
}

.benefits-headline-wrap {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.benefits-headline {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  color: var(--color-brand-earth);
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-4);
}

.benefits-micro {
  font-family: var(--font-body);
  font-size: 0.875rem;
  line-height: 1.7;
  color: var(--color-brand-muted);
  max-width: 460px;
}

.benefit-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  list-style: none;
  padding: 0;
  margin: 0;
}

.benefit-item {
  display: grid;
  grid-template-columns: 28px 1fr;
  gap: 14px;
  align-items: start;
}

.benefit-item__check {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: rgba(34, 85, 34, 0.12);
  color: #225522;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 200ms ease, color 200ms ease, transform 200ms ease;
}

.benefit-item:hover .benefit-item__check {
  background: #225522;
  color: #fff;
  transform: scale(1.15);
}

.benefit-item__title {
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--color-brand-earth);
  margin-bottom: 4px;
  line-height: 1.3;
}

.benefit-item__body {
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: rgba(92, 61, 30, 0.70);
  line-height: 1.6;
  margin: 0;
}

/* ── Bottom CTA ──────────────────────── */
.b2b-cta {
  background: #a80e1a;
  border-radius: 20px;
  padding: var(--space-10) var(--space-6);
  color: #fff;
  margin-bottom: var(--space-8);
}

.b2b-cta__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  align-items: center;
}

.b2b-cta__title {
  font-family: var(--font-display);
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: var(--space-2);
  color: #fff;
}

.b2b-cta__sub {
  font-family: var(--font-body);
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.85);
  max-width: 520px;
  margin: 0;
}

.b2b-cta__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
}

.b2b-cta__btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-label);
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 12px 22px;
  border-radius: 999px;
  text-decoration: none;
  transition: background 200ms ease, color 200ms ease, gap 200ms ease;
  white-space: nowrap;
}

.b2b-cta__btn--primary {
  background: #fff;
  color: #cd1222;
}

.b2b-cta__btn--primary:hover {
  background: var(--color-neutral);
  gap: 10px;
}

.b2b-cta__btn--secondary {
  background: transparent;
  color: #fff;
  border: 2px solid rgba(255, 255, 255, 0.6);
}

.b2b-cta__btn--secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #fff;
  gap: 10px;
}

/* ── Reveal Animation ────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 500ms ease, transform 500ms ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; transform: none; transition: none; }
}

/* ── Responsive ──────────────────────── */
@media (min-width: 640px) {
  .solutions-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 768px) {
  .benefits-strip {
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 80px 0;
  }
  .b2b-cta {
    padding: var(--space-12) var(--space-10);
  }
  .b2b-cta__inner {
    grid-template-columns: 1fr auto;
    gap: var(--space-10);
  }
}

@media (min-width: 1024px) {
  .solutions-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .brand-cloud {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-8);
  }
  .brand-cloud__category {
    flex: 1;
    align-items: center;
  }
  .brand-cloud__row {
    gap: var(--space-6);
  }
}
</style>

<script>
  // Scroll-triggered reveal — IntersectionObserver
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(el => io.observe(el));
  } else {
    reveals.forEach(el => el.classList.add('visible'));
  }
</script>
