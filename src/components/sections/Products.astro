---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import arabicaImg from '../../images/products/arabica-beans.jpg';
import robustaImg from '../../images/products/robusta-beans.jpg';
import hampersImg from '../../images/products/hampers.png';
import groundImg from '../../images/products/arabica-ground.jpg';
import tokpedLogo from '../../images/logo/logo-tokopedia.png';
import shopeeLogo from '../../images/logo/logo-shopee.png';
import { t } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const SHOPEE_URL = 'https://shopee.co.id/kopi_siholta';
const TOKPED_URL = 'https://www.tokopedia.com/kopisiholta';
const RB_TOKPED_URL = 'https://tk.tokopedia.com/ZSxRaCBXg/';
const RG_TOKPED_URL = 'https://tk.tokopedia.com/ZSxRmkexJ/';
const AG_TOKPED_URL = 'https://tk.tokopedia.com/ZSxRm12mu/';
const AB_TOKPED_URL = 'https://tk.tokopedia.com/ZSxRaEDUp/';
const RB_SHOPEE_URL = 'https://s.shopee.co.id/5L8l02GVoQ?share_channel_code=1';
const RG_SHOPEE_URL = 'https://s.shopee.co.id/2VoZcrNoF8?share_channel_code=1';
const AB_SHOPEE_URL = 'https://s.shopee.co.id/BQeqUtbv3?share_channel_code=1';
const AG_SHOPEE_URL = 'https://s.shopee.co.id/1BJC2ICX6K?share_channel_code=1';

const products = [
  {
    slug: 'Arabica-roasted-beans',
    image: arabicaImg,
    shopeeUrl: AB_SHOPEE_URL,
    tokpedUrl: AB_TOKPED_URL,
    badgeColor: '#2A7B40',
    i: 0,
    alt: 'Arabica Roasted Beans — whole roasted coffee from Lintong Nihuta',
  },
  {
    slug: 'Arabica-ground',
    image: groundImg,
    shopeeUrl: AG_SHOPEE_URL,
    tokpedUrl: AG_TOKPED_URL,
    badgeColor: '#CD1222',
    i: 1,
    alt: 'Arabica Ground — premium ground coffee for manual brew and espresso',
  },
  {
    slug: 'robusta-premium',
    image: robustaImg,
    shopeeUrl: RB_SHOPEE_URL,
    tokpedUrl: RB_TOKPED_URL,
    badgeColor: '#4A2511',
    i: 2,
    alt: 'Robusta Premium — natural dry process robusta from Lake Toba',
  },
  {
    slug: 'hampers-gift-set',
    image: hampersImg,
    shopeeUrl: SHOPEE_URL,
    tokpedUrl: TOKPED_URL,
    badgeColor: '#C17F3C',
    i: 3,
    alt: 'Hampers & Gift Set — premium corporate gift packaging Kopi Siholta',
  },
];
---

<section class="products section" id="products" aria-label="Product Showcase">
  <div class="container">

    <!-- Header -->
    <div class="section__header">
      <h2 class="section-title">{tr.products.title}</h2>
      <p class="section-sub">{tr.products.subtitle}</p>
    </div>

    <!-- Product Rows -->
    {products.map((product) => {
      const nameKey = `product${product.slug.split('-').map((w, i) => i === 0 ? w.charAt(0).toUpperCase() + w.slice(1) : w.charAt(0).toUpperCase() + w.slice(1)).join('')}` as keyof typeof tr.products;
      const notesKey = `notes${product.slug.split('-').map((w, i) => i === 0 ? w.charAt(0).toUpperCase() + w.slice(1) : w.charAt(0).toUpperCase() + w.slice(1)).join('')}` as keyof typeof tr.products;
      const badgeKey = product.i === 0 ? 'tagBestSeller' : product.i === 1 ? 'tagPopular' : product.i === 2 ? 'tagValuePack' : 'tagGiftReady';
      const originKey = product.i === 3 ? 'originPremium' : 'originLintong';
      const altitudeKey = product.i === 3 ? 'altitudeVarious' : product.i === 2 ? 'altitudeRobusta' : 'altitudeLintong';
      const processKey = product.i === 3 ? 'processMulti' : product.i === 2 ? 'processNaturalDry' : 'processWetHulled';
      const roastKey = product.i === 3 ? 'roastVarious' : product.i === 2 ? 'roastMediumDark' : product.i === 1 ? 'roastMedium' : 'roastLightMedium';
      const weightKey = product.i === 3 ? 'weightCustom' : product.i === 2 ? 'weightRobusta' : 'weightArabica';

      const name = tr.products[nameKey] ?? tr.products.productArabicaBeans;
      const notes = (tr.products[notesKey] ?? tr.products.notesArabica) as string[];
      const badge = tr.products[badgeKey];
      const origin = tr.products[originKey];
      const altitude = tr.products[altitudeKey];
      const process = tr.products[processKey];
      const roast = tr.products[roastKey];
      const weight = tr.products[weightKey];

      return (
        <article
          class={`product-row ${product.i % 2 === 0 ? 'product-row--image-left' : 'product-row--image-right'} ${product.i === 0 ? 'product-row--feature' : ''}`}
        >
          <!-- Image Panel -->
          <div class="product-row__media">
            <Image
              src={product.image}
              alt={product.alt}
              class="product-row__img"
              loading={product.i < 2 ? 'eager' : 'lazy'}
              widths={[480, 768, 1024, 1280]}
              sizes={product.i === 0 ? '100vw' : '(max-width: 768px) 100vw, 50vw'}
            />
            <div class="product-row__img-overlay"></div>
            <div class="product-row__badge-wrap">
              <span class="product-row__badge" style={`background: ${product.badgeColor}`}>{badge}</span>
            </div>
          </div>

          <!-- Content Panel -->
          <div class="product-row__content">
            <h3 class="product-row__name">{name}</h3>
            <p class="product-row__desc">{tr.products.subtitle}</p>
            <div class="product-row__notes">
              {notes.map(note => (
                <span class="product-row__note">{note}</span>
              ))}
            </div>
            <div class="product-row__details">
              <div class="product-row__detail">
                <span class="product-row__detail-label">{tr.products.process}</span>
                <span class="product-row__detail-value">{process}</span>
              </div>
              <div class="product-row__detail">
                <span class="product-row__detail-label">{tr.products.roast}</span>
                <span class="product-row__detail-value">{roast}</span>
              </div>
              <div class="product-row__detail">
                <span class="product-row__detail-label">{tr.products.altitude}</span>
                <span class="product-row__detail-value">{altitude}</span>
              </div>
              <div class="product-row__detail">
                <span class="product-row__detail-label">{tr.products.weight}</span>
                <span class="product-row__detail-value">{weight}</span>
              </div>
            </div>
            <div class="product-row__footer">
              <div class="product-row__ecomm">
                <a href={product.tokpedUrl} target="_blank" rel="noopener noreferrer"
                  class="ecomm-btn ecomm-btn--tokped"
                  aria-label={`${tr.products.buyTokopedia} ${name}`}>
                  <Image src={tokpedLogo} alt="Tokopedia" width={56} />
                </a>
                <a href={product.shopeeUrl} target="_blank" rel="noopener noreferrer"
                  class="ecomm-btn ecomm-btn--shopee"
                  aria-label={`${tr.products.buyShopee} ${name}`}>
                  <Image src={shopeeLogo} alt="Shopee" width={58} />
                </a>
              </div>
            </div>
          </div>
        </article>
      );
    })}

  </div>
</section>