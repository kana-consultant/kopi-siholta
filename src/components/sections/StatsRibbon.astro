---
import { t } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const stats = [
  { num: '6+', labelKey: 'statCountries' as const },
  { num: '100T', labelKey: 'statTonsYear' as const },
  { num: '#1', labelKey: 'statPioneer' as const },
  { num: '2035', labelKey: 'statVision' as const },
  { num: '3', labelKey: 'statSectors' as const },
];
---

<div class="stats-ribbon" role="region" aria-label="Key Statistics">
  <div class="stats-ribbon__inner container">
    {stats.map((stat, i) => (
      <>
        <div class="stats-ribbon__item">
          <span class="stats-ribbon__num">{stat.num}</span>
          <span class="stats-ribbon__label">{tr.hero[stat.labelKey]}</span>
        </div>
        {i < stats.length - 1 && (
          <div class="stats-ribbon__sep" aria-hidden="true"></div>
        )}
      </>
    ))}
  </div>
</div>