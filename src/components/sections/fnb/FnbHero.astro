---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import fnbBg from '../../../images/bg/bg-fnb.jpg';
import { useTranslations } from '../../../i18n/utils';

interface Props {
  lang: 'id' | 'en' | 'fr';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="page-hero page-hero--mid" aria-label={t.fnb.page}>
  <div class="page-hero__bg">
    <Image
      src={fnbBg}
      alt={t.fnb.gallery?.altAtmosphere ?? 'Suasana Cafe Kopi Siholta'}
      class="page-hero__img"
      style="object-position: center 40%"
      loading="eager"
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <div class="page-hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="container page-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={`/${lang}/`} class="breadcrumb__link">{t.breadcrumb.home}</a>
        </li>
        <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
        <li class="breadcrumb__item">
          <a href={`/${lang}/company`} class="breadcrumb__link">{t.breadcrumb.company}</a>
        </li>
        <li class="breadcrumb__sep" aria-hidden="true"><Icon name="mdi:chevron-right" width="10" height="10" /></li>
        <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{t.fnb.page}</li>
      </ol>
    </nav>

    <div class="fnb-hero__content">
      <h1 class="page-hero__title">{t.fnb.titleLine1}<br />{t.fnb.titleLine2}</h1>
      <p class="page-hero__sub">{t.fnb.subtitle}</p>
    </div>
  </div>
</section>