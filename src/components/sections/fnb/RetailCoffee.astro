---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import fnbHero2 from '../../../images/fnb/coffee-powder.jpg';
import fnbHero4 from '../../../images/fnb/coffee-beans.jpg';
import fnbHero6 from '../../../images/fnb/caffee.jpg';
import fnbHero9 from '../../../images/fnb/green-beans.jpg';



const { lang, t } = Astro.props;
const nl = (s: string) => s.split('\n').join('<br>');
/* ── Retail Product Data ─────────────────── */
const retailProducts = {
  main: {
    nameKey: 'retailCoffeeBeans',
    tag: 'ARABIKA • ROBUSTA • SPECIALTY GRADE',
    descKey: 'retailCoffeeBeansDesc',
    img: fnbHero4,
    imgAltKey: 'altCoffeeBeans',
  },
  items: [
    {
      nameKey: 'retailCoffeePowder',
      descKey: 'retailCoffeePowderDesc',
      img: fnbHero2,
      imgAltKey: 'altCoffeePowder',
    },
    {
      nameKey: 'retailGreenBeans',
      descKey: 'retailGreenBeansDesc',
      img: fnbHero9,
      imgAltKey: 'altGreenBeans',
    },
    {
      nameKey: 'retailCoffeeCapsule',
      descKey: 'retailCoffeeCapsuleDesc',
      img: fnbHero6,
      imgAltKey: 'altCoffeeCapsule',
    },
  ],
};
---
  <section class="retail-coffee section" aria-labelledby="retail-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="retail-heading" class="section-title">{t.fnb.retailTitle ?? 'Retail Coffee Collection'}</h2>
        <p class="section-sub">{t.fnb.retailSubtitle ?? 'Diproses dari biji kopi pilihan dataran tinggi Sumatera untuk kebutuhan retail, horeca, dan specialty coffee market.'}</p>
      </div>

      <div class="retail-coffee__grid">
        <!-- Main large card -->
        <article class="retail-card retail-card--main animate-on-scroll">
          <div class="retail-card__media">
            <Image
              src={retailProducts.main.img}
              alt={t.fnb.gallery?.[retailProducts.main.imgAltKey as keyof typeof t.fnb.gallery] ?? ''}
              loading="eager"
              widths={[480, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 55vw"
              class="retail-card__img"
            />
            <div class="retail-card__tag">{retailProducts.main.tag}</div>
          </div>
          <div class="retail-card__body">
            <h3 class="retail-card__name">{t.fnb[retailProducts.main.nameKey as keyof typeof t.fnb] ?? 'Coffee Beans'}</h3>
            <p class="retail-card__desc">{t.fnb[retailProducts.main.descKey as keyof typeof t.fnb] ?? 'Biji kopi pilihan dengan karakter khas Sumatera Utara, tersedia dalam berbagai profil roasting.'}</p>
            <a href={`/${lang}/company`} class="retail-card__link">
              {t.fnb.retailCta ?? 'Lihat Produk'}
              <Icon name="mdi:arrow-right" width="16" height="16" />
            </a>
          </div>
        </article>

        <!-- 3 small cards stacked -->
        <div class="retail-coffee__stack">
          {retailProducts.items.map((item, i) => (
            <article class="retail-card retail-card--sm animate-on-scroll" style={`transition-delay: ${i * 80}ms`}>
              <div class="retail-card__media retail-card__media--sm">
                <Image
                  src={item.img}
                  alt={t.fnb.gallery?.[item.imgAltKey as keyof typeof t.fnb.gallery] ?? ''}
                  loading="lazy"
                  widths={[300, 480]}
                  sizes="(max-width: 768px) 50vw, 22vw"
                  class="retail-card__img"
                />
              </div>
              <div class="retail-card__body">
                <h3 class="retail-card__name retail-card__name--sm">{t.fnb[item.nameKey as keyof typeof t.fnb] ?? ''}</h3>
                <p class="retail-card__desc retail-card__desc--sm">{t.fnb[item.descKey as keyof typeof t.fnb] ?? ''}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
