---
import { Icon } from "astro-icon/components";

const { lang, t } = Astro.props;
const nl = (s: string) => s.split('\n').join('<br>');
---
<!-- SUSTAINABILITY -->
  <section class="sustainability section section--olive" aria-labelledby="sustainability-heading">
    <div class="container sustainability__inner">
      <div class="sustainability__text animate-on-scroll">
        <h2 id="sustainability-heading" class="section-title">{t.fnb.sustainabilityTitle ?? 'Sustainability Commitment'}</h2>
        <p class="section-sub">{t.fnb.sustainabilitySubtitle ?? 'Kopi Siholta berkomitmen pada keberlanjutan lingkungan melalui penggunaan kapsul aluminium daur ulang 80% dan dukungan untuk petani kopi lokal Sumatera.'}</p>
      </div>
      <div class="sustainability__visual animate-on-scroll">
        <div class="sustainability__icon-wrap" aria-hidden="true">
          <Icon name="mdi:leaf" width="64" height="64" />
        </div>
      </div>
    </div>
  </section>