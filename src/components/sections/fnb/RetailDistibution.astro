---
import { Icon } from "astro-icon/components";


const { lang, t } = Astro.props;
/* ── Distribution Data ─────────────────── */
const retailNetworks = ['Hypermart', 'Sendys', 'KPD'];
const regions = ['Jabodetabek', 'Palangka Raya', 'Bali'];

const cafeLocations = [
  {
    cityKey: 'locationPalangkaRaya',
    addressKey: 'locationPalangkaRayaAddress',
  },
  {
    cityKey: 'locationJakarta',
    addressKey: 'locationJakartaAddress',
  },
];
---
  <section class="distribution section" aria-labelledby="distribution-heading">
    <div class="container">
      <div class="section__header animate-on-scroll">
        <h2 id="distribution-heading" class="section-title">{t.fnb.distributionTitle ?? 'Distribusi &amp; Lokasi'}</h2>
      </div>

      <div class="distribution__grid animate-on-scroll">

        <!-- LEFT: Retail Distribution -->
        <div class="distribution-card distribution-card--retail">
          <h3 class="distribution-card__heading">{t.fnb.retailNetworkHeading ?? 'Tersedia di Jaringan Retail Modern'}</h3>
          <p class="distribution-card__desc">{t.fnb.retailNetworkDesc ?? 'Produk Kopi Siholta telah hadir di berbagai retail modern dan swalayan regional di Indonesia.'}</p>

          <!-- Logo Grid -->
          <div class="retail-logos">
            {retailNetworks.map((brand) => (
              <div class="retail-logo">
                <span class="retail-logo__name">{brand}</span>
              </div>
            ))}
          </div>

          <!-- Regional Chips -->
          <div class="region-chips">
            {regions.map((region) => (
              <span class="region-chip">{region}</span>
            ))}
          </div>
        </div>

        <!-- RIGHT: Cafe Locations -->
        <div class="distribution-card distribution-card--cafe">
          <h3 class="distribution-card__heading">{t.fnb.cafeLocationsHeading ?? 'Kunjungi Gerai Kami'}</h3>

          <div class="cafe-locations">
            {cafeLocations.map((loc) => (
              <div class="cafe-location">
                <div class="cafe-location__icon" aria-hidden="true">
                  <Icon name="mdi:map-marker" width="18" height="18" />
                </div>
                <div class="cafe-location__info">
                  <p class="cafe-location__city">{t.fnb[loc.cityKey as keyof typeof t.fnb] ?? ''}</p>
                  <p class="cafe-location__address">{t.fnb[loc.addressKey as keyof typeof t.fnb] ?? ''}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Mini Map Preview -->
          <div class="cafe-map-preview" aria-hidden="true">
            <div class="cafe-map-preview__dots">
              <div class="cafe-map-dot cafe-map-dot--active"></div>
              <div class="cafe-map-dot"></div>
            </div>
            <p class="cafe-map-preview__label">{t.fnb.mapPreviewLabel ?? '2 Lokasi Tersedia'}</p>
          </div>
        </div>

      </div>
    </div>
  </section>