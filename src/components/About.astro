---
import { Leaf, Mountain, Award, Users, Droplets, Coffee } from 'lucide-astro';
import { Image } from 'astro:assets';
import myImage from '../images/about.webp';



const features = [
  {
    icon: Mountain,
    title: "Dari Lereng Toba",
    description: "Berasal dari dataran tinggi Lintong Nihuta pada ketinggian 1.200-1.500 mdpl dengan udara sejuk dan tanah vulkanis subur."
  },
  {
    icon: Leaf,
    title: "Organik & Alami",
    description: "Ditanam secara tradisional oleh petani lokal dengan metode organik, tanpa pestisida kimia berbahaya."
  },
  {
    icon: Droplets,
    title: "Proses Khusus",
    description: "Menggunakan metode pasca-panen Giling Basah (wet-hulled) yang memberikan ciri rasa unik dan distinctive."
  },
  {
    icon: Coffee,
    title: "Pilihan Roast",
    description: "Light roast, medium roast, dan dark roast."
  },
  {
    icon: Award,
    title: "Kualitas Premium",
    description: "Setiap batch melewati quality control ketat untuk memastikan hanya biji terbaik yang layak jual."
  },
  {
    icon: Users,
    title: "Petani Berpengalaman",
    description: "Ditanam oleh petani kopi berpengalaman turun-temurun yang mencintai tradisi menanam kopi."
  }
];
---

<section id="tentang" class="section-padding bg-[var(--color-cream)] relative overflow-hidden">
  <div class="container-custom relative">

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-[var(--color-roasted)]/10 rounded-full text-[var(--color-roasted)]/70 font-medium text-sm mb-4">
        Cerita Kami
      </span>
      <h2 class="section-title text-nowrap">
        Warisan Kopi dari
        <span class="text-gradient">Tanah Toba</span>
      </h2>
      <p class="section-subtitle mx-auto">
        PT. Siholta Toba Indonesia lahir dari kecintaan terhadap kopi dan tanah Sumatera Utara yang subur. Kami berkomitmen menghasilkan kopi berkualitas premium.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">

      <div class="relative">
        <div class="relative aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl group bg-[var(--color-roasted)]/10">
          <!-- Skeleton loader for image -->
          <div class="skeleton-wrapper absolute inset-0"></div>
          <Image
            src={myImage}
            alt="Kopi Siholta - Dataran Tinggi Lintong"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 relative z-10"
            width={800}
            height={600}
            loading="lazy"
            decoding="async"
            format="avif"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-dark-brown)]/60 via-transparent to-transparent"></div>
        </div>

        <div class="absolute -top-4 -left-4 w-24 h-24 border-4 border-[var(--color-gold)]/30 rounded-2xl -z-10"></div>
      </div>

      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl md:text-3xl font-display font-bold text-[var(--color-dark-brown)] leading-tight">
          Menghadirkan Kelezatan Kopi Lintong untuk Dunia
        </h3>
        <p class="text-[var(--color-roasted)]/80 leading-relaxed text-sm sm:text-base">
          Kopi Lintong telah mengukuhkan posisinya sebagai salah satu kopi specialty terbaik dari Sumatera.
        </p>
        <p class="text-[var(--color-roasted)]/80 leading-relaxed text-sm sm:text-base">
          Berasal dari dataran tinggi Lintong Nihuta, kopi ini menawarkan karakteristik unik yang memadukan <strong class="text-[var(--color-red)]">aroma rempah (spicy), herba, serta sentuhan kacang dan cokelat yang memikat</strong>. Melalui brand Siholta, kebanggaan lokal ini kini telah melintasi batas negara dan dinikmati oleh para pencinta kopi di berbagai belahan dunia.
        </p>

        <div class="grid grid-cols-2 gap-4 mt-8">
          {[
            { text: 'Arabika & Robusta', check: true },
            { text: 'Kemasan 100-1000gr', check: true },
            { text: 'Quality Control', check: true },
            { text: 'Ekspor Global', check: true }
          ].map((item) => (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[var(--color-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-[var(--color-dark-brown)] font-medium">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 animate-stagger">
      {features.map((feature, index) => (
        <div class="group bg-white rounded-xl sm:rounded-2xl p-5 sm:p-6 shadow-lg hover:shadow-2xl hover:-translate-y-1 sm:hover:-translate-y-2 animate-on-scroll">
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-lg sm:rounded-xl bg-gradient-to-br from-[var(--color-gold)]/20 to-[var(--color-red)]/10 flex items-center justify-center mb-3 sm:mb-4 group-hover:scale-110 transition-transform duration-300">
            <feature.icon class="w-5.5 h-5.5 sm:w-7 sm:h-7 text-[var(--color-roasted)]" />
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-[var(--color-dark-brown)] mb-1.5 sm:mb-2">{feature.title}</h4>
          <p class="text-sm sm:text-[var(--color-roasted)]/70 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>