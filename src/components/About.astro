---
import { Leaf, Mountain, Award, Users, Droplets, Sun } from 'lucide-astro';
import { Image } from 'astro:assets';
import myImage from '../images/about.webp';



const features = [
  {
    icon: Mountain,
    title: "Dari Lereng Toba",
    description: "Berasal dari dataran tinggi Lintong Nihuta pada ketinggian 1.200-1.500 mdpl dengan udara sejuk dan tanah vulkanis subur."
  },
  {
    icon: Leaf,
    title: "Organik & Alami",
    description: "Ditanam secara tradisional oleh petani lokal dengan metode organik, tanpa pestisida kimia berbahaya."
  },
  {
    icon: Droplets,
    title: "Proses Khusus",
    description: "Menggunakan metode pasca-panen Giling Basah (wet-hulled) yang memberikan ciri rasa unik dan distinctive."
  },
  {
    icon: Sun,
    title: "Papa Kering Mandiri",
    description: "Diolah dengan penjemuran alami di bawah sinar matahari plateau Sumatera untuk menjaga kualitas aroma."
  },
  {
    icon: Award,
    title: "Kualitas Premium",
    description: "Setiap batch melewati quality control ketat untuk memastikan hanya biji terbaik yang layak jual."
  },
  {
    icon: Users,
    title: "Petani Berpengalaman",
    description: "Diwakki oleh petani kopi berpengalaman turun-temurun yang mencintai tradisi menanam kopi."
  }
];
---

<section id="tentang" class="section-padding bg-[#F9F6F0] relative overflow-hidden">
  <div class="container-custom relative">

    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-[#4A2511]/10 rounded-full text-[#4A2511]/70 font-medium text-sm mb-4">
        Cerita Kami
      </span>
      <h2 class="section-title" style="white-space: nowrap;">
        Warisan Kopi dari
        <span class="text-gradient">Tanah Toba</span>
      </h2>
      <p class="section-subtitle mx-auto">
        PT. Siholta Toba Indonesia lahir dari kecintaan terhadap kopi dan tanah Sumatera Utara yang subur. Kami berkomitmen menghasilkan kopi berkualitas premium.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 items-center mb-20">

      <div class="relative">
        <div class="relative aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl">
          <Image
            src={myImage}
            alt="Kopi Siholta - Dataran Tinggi Lintong"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1C0F07]/60 via-transparent to-transparent"></div>
        </div>

        <div class="absolute -top-4 -left-4 w-24 h-24 border-4 border-[#F3B700]/30 rounded-2xl -z-10"></div>
      </div>

      <div class="space-y-6">
        <h3 class="text-2xl md:text-3xl font-display font-bold text-[#1C0F07]">
          Menghadirkan Kelezatan Kopi Lintong untuk Dunia
        </h3>
        <p class="text-[#4A2511]/80 leading-relaxed">
          Kopi Lintong telah lama dikenal sebagai salah satu kopi specialty terbaik di Indonesia. Berasal dari kawasan Lintong Nihuta, kopi ini memiliki karakter unik yang tidak ditemukan di daerah lain.
        </p>
        <p class="text-[#4A2511]/80 leading-relaxed">
          Dengan <strong class="text-[#CD1222]">aroma spicy, herba, rempah, kacang, dan cokelat</strong>, Kopi Lintong Siholta memberikan pengalaman yang tak terlupakan. Saat ini, kopi kami telah menjangkau pasar nasional dan internasional di Korea, Jepang, Belanda, Jerman, Rusia, dan Amerika.
        </p>

        <div class="grid grid-cols-2 gap-4 mt-8">
          {[
            { text: 'Arabika & Robusta', check: true },
            { text: 'Kemasan 250-500gr', check: true },
            { text: 'Quality Control', check: true },
            { text: 'Ekspor Global', check: true }
          ].map((item) => (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-[#F3B700]/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-[#F3B700]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-[#1C0F07] font-medium">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <div class="group bg-white rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 animate-on-scroll" style={`animation-delay: ${index * 100}ms`}>
          <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#F3B700]/20 to-[#CD1222]/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <feature.icon class="w-7 h-7 text-[#4A2511]" />
          </div>
          <h4 class="text-xl font-display font-bold text-[#1C0F07] mb-2">{feature.title}</h4>
          <p class="text-[#4A2511]/70 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>