---
// About.astro — Kopi Siholta "Tentang Kami" section
---

<section id="tentang" class="tentang-section">
  <div class="tentang-container">

    <!-- Header -->
    <div class="tentang-header reveal-on-scroll">
      <h2 class="tentang-title">
        Warisan Kopi dari
        <span class="title-toba">Tanah Toba</span>
      </h2>
      <p class="tentang-subtitle">
        PT. Siholta Toba Indonesia lahir dari kecintaan terhadap kopi dan tanah Sumatera Utara yang subur.
        Kami berkomitmen menghasilkan kopi berkualitas premium.
      </p>
    </div>

    <!-- 2-column content -->
    <div class="tentang-content-grid reveal-on-scroll">

      <!-- Image column -->
      <div class="tentang-image-wrapper">
        <div class="tentang-image-frame">
          <img
            src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=80&auto=format&fit=crop"
            alt="Kopi Siholta — Dataran Tinggi Lintong"
            loading="lazy"
            class="tentang-image"
          />
          <div class="tentang-image-overlay"></div>
        </div>
        <!-- Decorative gold frame — top-left -->
        <div class="deco-frame deco-gold fade-in gold-delay"></div>
        <!-- Decorative red frame — bottom-right -->
        <div class="deco-frame deco-red fade-in red-delay"></div>
      </div>

      <!-- Text column -->
      <div class="tentang-text-wrapper reveal-on-scroll">
        <h3 class="tentang-text-heading">
          Menghadirkan Kelezatan Kopi Lintong untuk Dunia
        </h3>
        <p class="tentang-text-para">
          Kopi Lintong telah mengukuhkan posisinya sebagai salah satu kopi specialty terbaik dari Sumatera.
        </p>
        <p class="tentang-text-para">
          Berasal dari dataran tinggi Lintong Nihuta, kopi ini menawarkan karakteristik unik yang memadukan
          <strong class="strong-red">
            aroma rempah (spicy), herba, serta sentuhan kacang dan cokelat yang memikat
          </strong>
          . Melalui brand Siholta, kebanggaan lokal ini kini telah melintasi batas negara dan dinikmati
          oleh para pencinta kopi di berbagai belahan dunia.
        </p>

        <!-- Checklist -->
        <ul class="tentang-checklist">
          <li class="tentang-check-item reveal-on-scroll">
            <span class="tentang-check-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>Arabika &amp; Robusta</span>
          </li>
          <li class="tentang-check-item reveal-on-scroll">
            <span class="tentang-check-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>Kemasan 100–1000gr</span>
          </li>
          <li class="tentang-check-item reveal-on-scroll">
            <span class="tentang-check-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>Quality Control</span>
          </li>
          <li class="tentang-check-item reveal-on-scroll">
            <span class="tentang-check-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span>Ekspor Global</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="tentang-features-grid">
      <!-- Card 1: Dari Lereng Toba -->
      <div class="tentang-feature-card reveal-on-scroll">
        <div class="tentang-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
          </svg>
        </div>
        <h4>Dari Lereng Toba</h4>
        <p>Berasal dari dataran tinggi Lintong Nihuta pada ketinggian 1.200–1.500 mdpl dengan udara sejuk dan tanah vulkanis subur.</p>
      </div>

      <!-- Card 2: Organik & Alami -->
      <div class="tentang-feature-card reveal-on-scroll">
        <div class="tentang-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </div>
        <h4>Organik &amp; Alami</h4>
        <p>Ditanam secara tradisional oleh petani lokal dengan metode organik, tanpa pestisida kimia berbahaya.</p>
      </div>

      <!-- Card 3: Proses Khusus -->
      <div class="tentang-feature-card reveal-on-scroll">
        <div class="tentang-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
          </svg>
        </div>
        <h4>Proses Khusus</h4>
        <p>Menggunakan metode pasca-panen Giling Basah (wet-hulled) yang memberikan ciri rasa unik dan distinctive.</p>
      </div>

      <!-- Card 4: Pilihan Roast -->
      <div class="tentang-feature-card reveal-on-scroll">
        <div class="tentang-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 8h1a4 4 0 0 1 0 8h-1"/>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
            <line x1="6" y1="2" x2="6" y2="4"/>
            <line x1="10" y1="2" x2="10" y2="4"/>
            <line x1="14" y1="2" x2="14" y2="4"/>
          </svg>
        </div>
        <h4>Pilihan Roast</h4>
        <p>Light roast, medium roast, dan dark roast.</p>
      </div>

      <!-- Card 5: Kualitas Premium -->
      <div class="tentang-feature-card reveal-on-scroll">
        <div class="tentang-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="6"/>
            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
          </svg>
        </div>
        <h4>Kualitas Premium</h4>
        <p>Setiap batch melewati quality control ketat untuk memastikan hanya biji terbaik yang layak jual.</p>
      </div>

      <!-- Card 6: Petani Berpengalaman -->
      <div class="tentang-feature-card reveal-on-scroll">
        <div class="tentang-feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h4>Petani Berpengalaman</h4>
        <p>Ditanam oleh petani kopi berpengalaman turun-temurun yang mencintai tradisi menanam kopi.</p>
      </div>
    </div>

  </div>
</section>

<style>
  /* =============================================
     SECTION & CONTAINER
  ============================================= */
  .tentang-section {
    position: relative;
    background-color: var(--color-cream);
    overflow: hidden;
  }

  .tentang-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (min-width: 1024px) {
    .tentang-container {
      padding-top: 6rem;
      padding-bottom: 6rem;
    }
  }

  /* =============================================
     HEADER
  ============================================= */
  .tentang-header {
    text-align: center;
    max-width: 3xl;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 4rem;
  }

  .tentang-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1.2;
    color: var(--color-dark-brown);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .tentang-title {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .tentang-title {
      font-size: 3.75rem;
    }
  }

  .title-toba {
    display: block;
    background: linear-gradient(
      to right,
      var(--color-gold),
      var(--color-copper)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .tentang-subtitle {
    color: color-mix(in srgb, var(--color-roasted) 80%, transparent);
    font-size: 1rem;
    line-height: 1.625;
    max-width: 42rem;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    .tentang-subtitle {
      font-size: 1.125rem;
    }
  }

  /* =============================================
     2-COLUMN GRID
  ============================================= */
  .tentang-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  @media (min-width: 1024px) {
    .tentang-content-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* =============================================
     IMAGE COLUMN
  ============================================= */
  .tentang-image-wrapper {
    position: relative;
  }

  .tentang-image-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1rem;
    box-shadow:
      0 25px 50px -12px color-mix(in srgb, var(--color-dark-brown) 20%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-dark-brown) 5%, transparent);
  }

  .tentang-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tentang-image-frame:hover .tentang-image {
    transform: scale(1.05);
  }

  .tentang-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-dark-brown) 60%, transparent) 0%,
      transparent 40%,
      transparent 100%
    );
  }

  /* Decorative frames */
  .deco-frame {
    position: absolute;
    border-radius: 1rem;
    border: 4px solid;
    box-shadow: 0 10px 25px -5px;
    z-index: -1;
  }

  .deco-gold {
    top: -1rem;
    left: -1rem;
    width: 7rem;
    height: 7rem;
    border-color: color-mix(in srgb, var(--color-gold) 30%, transparent);
    box-shadow:
      0 10px 25px -5px color-mix(in srgb, var(--color-gold) 10%, transparent),
      inset 0 0 0 0 var(--color-gold);
  }

  .deco-red {
    bottom: -1rem;
    right: -1rem;
    width: 5rem;
    height: 5rem;
    border-color: color-mix(in srgb, var(--color-red) 30%, transparent);
    box-shadow:
      0 10px 25px -5px color-mix(in srgb, var(--color-red) 10%, transparent);
  }

  /* Fade-in animation for decorative frames */
  .fade-in {
    animation: fade-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .gold-delay {
    animation-delay: 0.4s;
  }

  .red-delay {
    animation-delay: 0.5s;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: rotate(-10deg);
    }
    to {
      opacity: 1;
      transform: rotate(0deg);
    }
  }

  /* =============================================
     TEXT COLUMN
  ============================================= */
  .tentang-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tentang-text-heading {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--color-dark-brown);
    margin: 0;
  }

  @media (min-width: 640px) {
    .tentang-text-heading {
      font-size: 1.875rem;
    }
  }

  @media (min-width: 1024px) {
    .tentang-text-heading {
      font-size: 2rem;
    }
  }

  .tentang-text-para {
    color: color-mix(in srgb, var(--color-roasted) 80%, transparent);
    font-size: 0.875rem;
    line-height: 1.625;
    margin: 0;
  }

  @media (min-width: 640px) {
    .tentang-text-para {
      font-size: 1rem;
    }
  }

  .strong-red {
    color: var(--color-red);
  }

  /* =============================================
     CHECKLIST
  ============================================= */
  .tentang-checklist {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .tentang-check-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 20%, transparent);
    color: var(--color-dark-brown);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .tentang-check-item:last-child {
    border-bottom: none;
  }

  .tentang-check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    background-color: color-mix(in srgb, var(--color-gold) 15%, transparent);
    border-radius: 0.5rem;
    color: var(--color-gold);
  }

  .tentang-check-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* =============================================
     FEATURE GRID
  ============================================= */
  .tentang-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .tentang-features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .tentang-features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* =============================================
     FEATURE CARD
  ============================================= */
  .tentang-feature-card {
    background-color: white;
    border-radius: 1rem;
    padding: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 20%, transparent);
    box-shadow:
      0 10px 25px -5px color-mix(in srgb, var(--color-dark-brown) 8%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-dark-brown) 3%, transparent);
    cursor: pointer;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }

  .tentang-feature-card:hover {
    transform: translateY(-0.5rem);
    box-shadow:
      0 20px 35px -8px color-mix(in srgb, var(--color-dark-brown) 12%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-gold) 10%, transparent),
      inset 0 0 2rem 0 color-mix(in srgb, var(--color-gold) 6%, transparent);
  }

  .tentang-feature-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.75rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-gold) 20%, transparent) 0%,
      color-mix(in srgb, var(--color-red) 10%, transparent) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    color: var(--color-roasted);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tentang-feature-card:hover .tentang-feature-icon {
    transform: scale(1.1);
  }

  .tentang-feature-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .tentang-feature-card h4 {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-dark-brown);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .tentang-feature-card p {
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--color-roasted) 70%, transparent);
    line-height: 1.625;
    margin: 0;
  }

  /* =============================================
     SCROLL REVEAL
  ============================================= */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(2.5rem);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for feature cards (nth-child 1–6) */
  .tentang-features-grid .reveal-on-scroll:nth-child(1) { transition-delay: 0ms; }
  .tentang-features-grid .reveal-on-scroll:nth-child(2) { transition-delay: 100ms; }
  .tentang-features-grid .reveal-on-scroll:nth-child(3) { transition-delay: 200ms; }
  .tentang-features-grid .reveal-on-scroll:nth-child(4) { transition-delay: 300ms; }
  .tentang-features-grid .reveal-on-scroll:nth-child(5) { transition-delay: 400ms; }
  .tentang-features-grid .reveal-on-scroll:nth-child(6) { transition-delay: 500ms; }

  /* Stagger delays for checklist items */
  .tentang-checklist .reveal-on-scroll:nth-child(1) { transition-delay: 0ms; }
  .tentang-checklist .reveal-on-scroll:nth-child(2) { transition-delay: 80ms; }
  .tentang-checklist .reveal-on-scroll:nth-child(3) { transition-delay: 160ms; }
  .tentang-checklist .reveal-on-scroll:nth-child(4) { transition-delay: 240ms; }

  /* =============================================
     FADE-IN-UP KEYFRAME
  ============================================= */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(2.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Scroll-reveal via IntersectionObserver
  (function () {
    const targets = document.querySelectorAll<HTMLElement>('.reveal-on-scroll');

    if (!targets.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: '-80px 0px',
      }
    );

    targets.forEach((el) => observer.observe(el));
  })();
</script>