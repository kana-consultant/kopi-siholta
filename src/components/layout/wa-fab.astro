---
import { Image } from 'astro:assets';
import waLogo from '@/images/logo/logo-whatsapp.png';
import { WHATSAPP_NUMBER } from '@/constants/site';

interface Props {
  waNumber?: string;
  message?: string;
}

const {
  waNumber = WHATSAPP_NUMBER,
  message = 'Halo, saya tertarik dengan Kopi Siholta. Bisa info lengkap lebih lanjut?',
} = Astro.props;

const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
---

<a
  href={waLink}
  class="whatsapp-fab"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat via WhatsApp"
  title="Chat via WhatsApp"
>
  <Image src={waLogo} alt="WhatsApp" width={128} height={128} quality="max" class="whatsapp-fab__img" />
</a>

<style>
  
.whatsapp-fab {
  position: fixed;
  bottom: var(--space-4);
  right: var(--space-4);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--color-wa-green);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(118, 131, 123, 0.4);
  z-index: 90;
  transition: transform 200ms ease, box-shadow 200ms ease;
  overflow: hidden;
}

.whatsapp-fab__img {
  width: 100%;
  height: 100%;
  border-radius: 50% !important;
  display: block;
  object-fit: contain;
  image-rendering: -webkit-optimize-contrast;
}

.whatsapp-fab:hover {
  transform: scale(1.08) translateY(-2px);
}

.whatsapp-fab:active { 
  transform: scale(0.97); 
}

@media (min-width: 769px) {
  .whatsapp-fab {
    bottom: var(--space-6);
    right: var(--space-6);
    width: 52px;
    height: 52px;
  }
  
  .whatsapp-fab__img {
    width: 32px !important;
    height: 32px !important;
  }
}
</style>

