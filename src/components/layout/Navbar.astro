---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logoLight from '../../images/logo/logo-kopi-siholta.png';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'id' } = Astro.props;
const t = useTranslations(lang);

const nav = t.nav as Record<string, string>;

const currentPath = Astro.url.pathname;

function localeHref(targetLang: string): string {
  const segs = currentPath.split('/');
  if (segs[1] && ['id', 'en', 'fr'].includes(segs[1])) {
    segs[1] = targetLang;
  } else {
    segs.splice(1, 0, targetLang);
  }
  return segs.join('/') || '/';
}

const navItems = [
  { key: 'company',       href: `/${lang}/company` },
  { key: 'products',      href: `/${lang}/#products` },
  { key: 'export',        href: `/${lang}/#export` },
  { key: 'b2b',           href: `/${lang}/#b2b` },
  { key: 'contact',       href: `/${lang}/#contact` },
];
---

<header class="navbar" role="banner">
  <div class="navbar__inner container">

    <!-- ── Logo ─────────────────────────────────── -->
    <a href={`/${lang}/`} class="navbar__logo" aria-label="Kopi Siholta — Home">
      <Image
        src={logoLight}
        alt="Kopi Siholta"
        width="32"
        height="32"
        class="navbar__logo-img"
      />
      <span class="navbar__wordmark">KOPI SIHOLTA</span>
    </a>

    <!-- ── Desktop Nav ─────────────────────────── -->
    <nav class="navbar__nav hide-mobile" aria-label="Main navigation">
      <ul class="navbar__links">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="navbar__link">
              {nav[item.key] ?? item.key}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- ── Right Controls ──────────────────────── -->
    <div class="navbar__right">

      <!-- Language Switcher with icon + dropdown -->
      <div class="hide-mobile">
        <LanguageSwitcher currentLang={lang} />
      </div>

      <!-- CTA -->
      <a href={`/${lang}/#contact`} class="btn btn--primary navbar__cta hide-mobile">
        {nav.cta || 'Hubungi Kami'}
      </a>

      <!-- Mobile Hamburger -->
      <button
        class="navbar__hamburger hide-desktop"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- ── Mobile Drawer ─────────────────────────── -->
  <div
    class="mobile-menu"
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    data-menu
  >
    <div class="mobile-menu__overlay" data-menu-close></div>
    <nav class="mobile-menu__panel">
      <button class="mobile-menu__close" aria-label="Close menu" data-menu-close>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      <ul class="mobile-menu__links">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="mobile-menu__link">
              {nav[item.key] ?? item.key}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile: Lang + CTA -->
      <div class="mobile-menu__footer">
        <!-- Language row -->
        <div class="mobile-menu__lang">
          {['id', 'en', 'fr'].map(code => (
            <a
              href={localeHref(code)}
              class={`lang-btn ${lang === code ? 'lang-btn--active' : ''}`}
            >
              {code.toUpperCase()}
            </a>
          ))}
        </div>

        <!-- CTA -->
        <a href={`/${lang}/#contact`} class="mobile-menu__cta">
          {nav.cta}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* ── Navbar shell ────────────────────────────── */
  .navbar {
    position: sticky;
    top: 0;
    z-index: var(--z-navbar);
    background: var(--color-brand-cream);
    border-bottom: 0.5px solid rgba(205, 18, 34, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    height: 52px;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* ── Logo ─────────────────────────────────────── */
  .navbar__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar__logo-img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: contain;
  }

  .navbar__wordmark {
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }

  /* ── Nav links ────────────────────────────────── */
  .navbar__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar__link {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-earth);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .navbar__link:hover {
    color: var(--color-brand-red);
    border-bottom-color: var(--color-brand-red);
  }

  /* ── Right side ───────────────────────────────── */
  .navbar__right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .navbar__cta { padding: 7px 14px; font-size: 10px; }

  /* ── Language Buttons ───────────────── */
  .mobile-menu__lang {
    display: flex;
    gap: var(--space-2);
  }

  .lang-btn {
    font-family: var(--font-label);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 3px;
    color: var(--color-brand-earth);
    border: 0.5px solid rgba(92, 61, 30, 0.3);
    background: transparent;
    text-decoration: none;
    transition: all 200ms ease;
    cursor: pointer;
  }

  .lang-btn--active {
    background: var(--color-brand-red);
    color: #fff;
    border-color: var(--color-brand-red);
  }

  .lang-btn:not(.lang-btn--active):hover {
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
  }

  /* ── Hamburger ────────────────────────────────── */
  .navbar__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 8px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 200ms ease;
  }

  .navbar__hamburger:hover { background: var(--color-neutral-200); }

  .navbar__hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--color-brand-earth);
    border-radius: 2px;
    transition: all 200ms ease;
    transform-origin: center;
  }

  .navbar__hamburger.is-open span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }

  .navbar__hamburger.is-open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .navbar__hamburger.is-open span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ── Mobile Menu ──────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-menu__overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 15, 8, 0);
    transition: background 300ms ease;
  }

  .mobile-menu.is-open .mobile-menu__overlay {
    background: rgba(26, 15, 8, 0.50);
  }

  .mobile-menu__panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: min(300px, 85vw);
    background: var(--color-brand-cream);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__close {
    align-self: flex-end;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-brand-earth);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 200ms ease;
    margin-bottom: var(--space-2);
  }

  .mobile-menu__close:hover { background: var(--color-neutral-200); }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu__link {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-brand-earth);
    text-decoration: none;
    padding: var(--space-4) var(--space-2);
    border-bottom: 0.5px solid var(--color-neutral-200);
    transition: color 200ms ease;
    text-transform: capitalize;
  }

  .mobile-menu__link:hover { color: var(--color-brand-red); }

  .mobile-menu__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 0.5px solid var(--color-neutral-200);
  }

  .mobile-menu__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 13px 20px;
    background: var(--color-brand-red);
    color: #fff;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 12px rgba(205, 18, 34, 0.25);
    transition: background 200ms ease, transform 200ms ease;
    width: 100%;
  }

  .mobile-menu__cta:hover {
    background: #B01020;
    transform: translateY(-1px);
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .navbar { height: 48px; }
  }
</style>

<script>
  /* ── Mobile Menu ─────────────────────────────── */
  const menu   = document.querySelector('[data-menu]') as HTMLElement | null;
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const closeBtns = document.querySelectorAll('[data-menu-close]');
  const navLinks = menu?.querySelectorAll('.mobile-menu__link') ?? [];

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.add('is-open');
    toggle.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    const closeBtn = menu.querySelector('[data-menu-close]') as HTMLElement | null;
    closeBtn?.focus();
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove('is-open');
    toggle.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    menu?.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  closeBtns.forEach(btn => btn.addEventListener('click', closeMenu));
  navLinks.forEach(link => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) closeMenu();
  });

  window.addEventListener('beforeunload', () => {
    document.body.style.overflow = '';
  });
</script>