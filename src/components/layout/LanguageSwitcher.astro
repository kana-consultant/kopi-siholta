---
// LanguageSwitcher.astro — ID/EN/FR dropdown with flag icons
interface Props {
  currentLang?: string;
}

const { currentLang = 'id' } = Astro.props;

const langs = [
  { code: 'id', label: 'ID', flag: '🇮🇩', name: 'Bahasa Indonesia' },
  { code: 'en', label: 'EN', flag: '🇬🇧', name: 'English' },
  { code: 'fr', label: 'FR', flag: '🇫🇷', name: 'Français' },
];
---

<div class="lang-switcher" id="lang-switcher">
  <button
    class="lang-trigger"
    id="lang-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Pilih bahasa"
  >
    <span class="lang-current-flag" id="lang-current-flag">
      {langs.find(l => l.code === currentLang)?.flag ?? '🇮🇩'}
    </span>
    <span class="lang-current-code" id="lang-current-code">
      {currentLang.toUpperCase()}
    </span>
    <svg class="lang-chevron" id="lang-chevron" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <ul
    class="lang-dropdown"
    id="lang-dropdown"
    role="listbox"
    aria-label="Pilih bahasa"
    hidden
  >
    {langs.map((lang) => (
      <li
        class={`lang-option ${lang.code === currentLang ? 'lang-active' : ''}`}
        data-lang={lang.code}
        role="option"
        aria-selected={lang.code === currentLang}
      >
        <span class="lang-option-flag">{lang.flag}</span>
        <div class="lang-option-text">
          <span class="lang-option-code">{lang.label}</span>
          <span class="lang-option-name">{lang.name}</span>
        </div>
        {lang.code === currentLang && (
          <svg class="lang-check" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }

  /* Trigger button */
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    background: rgba(249, 246, 240, 0.1);
    border: 1px solid rgba(243, 183, 0, 0.2);
    border-radius: 9999px;
    color: rgba(249, 246, 240, 0.85);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  .lang-trigger:hover {
    background: rgba(243, 183, 0, 0.15);
    border-color: rgba(243, 183, 0, 0.4);
    color: #F3B700;
  }

  .lang-trigger:focus-visible {
    outline: 2px solid #F3B700;
    outline-offset: 2px;
  }

  .lang-current-flag {
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lang-current-code {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .lang-chevron {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .lang-switcher.open .lang-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 10rem;
    background: rgba(28, 15, 7, 0.97);
    border: 1px solid rgba(243, 183, 0, 0.2);
    border-radius: 0.75rem;
    padding: 0.375rem;
    box-shadow:
      0 16px 40px rgba(28, 15, 7, 0.4),
      0 0 0 1px rgba(243, 183, 0, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    list-style: none;
    margin: 0;
    z-index: 100;
    opacity: 0;
    transform: translateY(-8px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .lang-switcher.open .lang-dropdown {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  /* Individual option */
  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .lang-option:hover {
    background: rgba(243, 183, 0, 0.1);
  }

  .lang-option.lang-active {
    background: rgba(243, 183, 0, 0.08);
  }

  .lang-option-flag {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lang-option-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .lang-option-code {
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgba(249, 246, 240, 0.9);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .lang-option-name {
    font-size: 0.6875rem;
    color: rgba(249, 246, 240, 0.5);
    line-height: 1.3;
  }

  .lang-check {
    width: 1rem;
    height: 1rem;
    color: #F3B700;
    flex-shrink: 0;
  }
</style>

<script>
  const switcher = document.getElementById('lang-switcher');
  const trigger = document.getElementById('lang-trigger');
  const dropdown = document.getElementById('lang-dropdown');
  const chevron = document.getElementById('lang-chevron');

  // Toggle dropdown
  trigger?.addEventListener('click', () => {
    const isOpen = switcher?.classList.toggle('open');
    trigger.setAttribute('aria-expanded', String(isOpen));
    if (dropdown) dropdown.hidden = !isOpen;
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!switcher?.contains(e.target as Node)) {
      switcher?.classList.remove('open');
      trigger?.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.hidden = true;
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      switcher?.classList.remove('open');
      trigger?.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.hidden = true;
    }
  });

  // Select language
  dropdown?.querySelectorAll('.lang-option').forEach((option) => {
    option.addEventListener('click', () => {
      const lang = (option as HTMLElement).dataset.lang ?? 'id';
      document.cookie = `preferred_lang=${lang}; path=/; max-age=${60 * 60 * 24 * 365}; samesite=lax`;
      window.location.reload();
    });
  });
</script>