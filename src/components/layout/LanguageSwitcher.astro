---
import { Image } from 'astro:assets';
import logoLight from '../../images/logo/logo-kopi-siholta.png';

interface Props {
  currentLang?: string;
  t?: Record<string, string>;
}

const { currentLang = 'id', t = {} } = Astro.props;

const langs = [
  { code: 'id', label: 'ID', flag: '🇮🇩', name: 'Bahasa Indonesia' },
  { code: 'en', label: 'EN', flag: '🇬🇧', name: 'English' },
  { code: 'fr', label: 'FR', flag: '🇫🇷', name: 'Français' },
];

const current = langs.find(l => l.code === currentLang) ?? langs[0];
---

<div class="lang-switcher" id="lang-switcher">
  <!-- Trigger Button -->
  <button
    class="lang-trigger"
    id="lang-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t.selectLang || 'Select language'}
  >
    <span class="lang-current-flag" id="lang-current-flag" aria-hidden="true">
      {current.flag}
    </span>
    <span class="lang-current-code" id="lang-current-code">
      {current.code.toUpperCase()}
    </span>
    <svg class="lang-chevron" id="lang-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <!-- Dropdown -->
  <ul
    class="lang-dropdown"
    id="lang-dropdown"
    role="listbox"
    aria-label={t.selectLang || 'Select language'}
    hidden
  >
    {langs.map((lang) => (
      <li
        class={`lang-option ${lang.code === currentLang ? 'lang-option--active' : ''}`}
        data-lang={lang.code}
        role="option"
        aria-selected={lang.code === currentLang}
      >
        <span class="lang-option-flag" aria-hidden="true">{lang.flag}</span>
        <div class="lang-option-text">
          <span class="lang-option-code">{lang.label}</span>
          <span class="lang-option-name">{lang.name}</span>
        </div>
        {lang.code === currentLang && (
          <svg class="lang-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  /* ── Switcher Container ─────────────────────────── */
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }

  /* ── Trigger Button ──────────────────────────── */
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    background: rgba(249, 246, 240, 0.1);
    border: 1px solid rgba(205, 18, 34, 0.2);
    border-radius: 9999px;
    color: rgba(92, 61, 30, 0.85);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .lang-trigger:hover {
    background: rgba(205, 18, 34, 0.08);
    border-color: rgba(205, 18, 34, 0.4);
    color: var(--color-brand-red);
  }

  .lang-trigger:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }

  .lang-current-flag {
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lang-current-code {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-brand-earth);
  }

  .lang-chevron {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--color-brand-earth);
  }

  .lang-switcher.open .lang-chevron {
    transform: rotate(180deg);
  }

  /* ── Dropdown Panel ─────────────────────────── */
  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 10rem;
    background: #F9F6F0;
    border: 1px solid rgba(205, 18, 34, 0.15);
    border-radius: 0.75rem;
    padding: 0.375rem;
    box-shadow:
      0 8px 24px rgba(92, 61, 30, 0.12),
      0 2px 8px rgba(92, 61, 30, 0.08),
      0 0 0 1px rgba(205, 18, 34, 0.04);
    list-style: none;
    margin: 0;
    z-index: 200;
    opacity: 0;
    transform: translateY(-8px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .lang-switcher.open .lang-dropdown {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  /* ── Individual Option ───────────────────────── */
  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .lang-option:hover {
    background: rgba(205, 18, 34, 0.06);
  }

  .lang-option--active {
    background: rgba(205, 18, 34, 0.05);
  }

  .lang-option-flag {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lang-option-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .lang-option-code {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-brand-earth);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .lang-option-name {
    font-size: 0.6875rem;
    color: var(--color-brand-muted);
    line-height: 1.3;
  }

  .lang-check {
    width: 1rem;
    height: 1rem;
    color: var(--color-brand-red);
    flex-shrink: 0;
  }
</style>

<script>
  const VALID_LANGS = ['id', 'en', 'fr'];

  /* Derive the locale href from the current URL — same logic as the server-side
     function in Navbar.astro, but runs client-side so navigation actually changes
     the page to the correct language route. */
  function localeHref(targetLang: string): string {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    if (pathParts[0] && VALID_LANGS.includes(pathParts[0])) {
      pathParts[0] = targetLang;
    } else {
      pathParts.unshift(targetLang);
    }
    return '/' + pathParts.join('/') || '/';
  }

  const switcher = document.getElementById('lang-switcher');
  const trigger   = document.getElementById('lang-trigger');
  const dropdown  = document.getElementById('lang-dropdown');

  /* Toggle */
  trigger?.addEventListener('click', () => {
    const isOpen = switcher?.classList.toggle('open');
    trigger.setAttribute('aria-expanded', String(isOpen));
    if (dropdown) dropdown.hidden = !isOpen;
  });

  /* Close on outside click */
  document.addEventListener('click', (e) => {
    if (!switcher?.contains(e.target as Node)) {
      switcher?.classList.remove('open');
      trigger?.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.hidden = true;
    }
  });

  /* Close on Escape */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      switcher?.classList.remove('open');
      trigger?.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.hidden = true;
    }
  });

  /* Select language → persist cookie + navigate to the correct language URL */
  dropdown?.querySelectorAll('.lang-option').forEach((option) => {
    option.addEventListener('click', () => {
      const lang = (option as HTMLElement).dataset.lang ?? 'id';
      document.cookie = `preferred_lang=${lang}; path=/; max-age=${60 * 60 * 24 * 365}; samesite=lax`;
      window.location.href = localeHref(lang);
    });
  });
</script>