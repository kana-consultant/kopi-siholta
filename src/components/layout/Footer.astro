---
import { Image } from 'astro:assets';
import logo from '../../images/logo-kopi-siholta.png';
import tokpedLogo from '../../images/logo-tokopedia.png';
import shopeeLogo from '../../images/logo-shopee.png';
import igLogo from '../../images/logo-instagram.png';
import waLogo from '../../images/logo-whatsapp.png';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const WHATSAPP_NUMBER = '6281322518527';
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}`;
const EMAIL = 'siholtatobaindonesia@gmail.com';
const INSTAGRAM_URL = 'https://www.instagram.com/kopi_siholta.id/';
const TOKPED_URL = 'https://www.tokopedia.com/kopisiholta';
const SHOPEE_URL = 'https://shopee.co.id/kopi_siholta';

const columns = [
  {
    title: 'Tentang Kami',
    links: [
      { label: 'Tentang Kopi Siholta', href: `/${lang}/company` },
      { label: 'Sejarah Perusahaan', href: `/${lang}/company` },
      { label: 'Sertifikasi', href: `/${lang}/company` },
    ],
  },
  {
    title: 'Produk',
    links: [
      { label: 'Arabica Roasted Beans', href: `/${lang}/products` },
      { label: 'Arabica Ground', href: `/${lang}/products` },
      { label: 'Robusta Premium', href: `/${lang}/products` },
      { label: 'Hampers & Gift Set', href: `/${lang}/products` },
    ],
  },
  {
    title: 'Bisnis & Wisata',
    links: [
      { label: 'Profil Perusahaan', href: `/${lang}/company` },
      { label: 'Kemitraan B2B', href: `/${lang}/#b2b` },
      { label: 'Wisata Kopi', href: `/${lang}/tourism` },
      { label: 'Kunjungan Farm', href: `/${lang}/#contact` },
    ],
  },
  {
    title: 'Hubungi Kami',
    links: [
      { label: EMAIL, href: `mailto:${EMAIL}` },
      { label: '+62 813 2251 8527', href: WHATSAPP_URL },
      { label: 'Lintong Nihuta, Sumatera Utara', href: WHATSAPP_URL },
    ],
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner container">

    <!-- Top: Brand + Columns side by side -->
    <div class="footer__top">

      <!-- Brand -->
      <div class="footer__brand">
        <div class="footer__brand-logo">
          <Image src={logo} alt="Kopi Siholta" width={40} height={40} class="footer__logo-img" />
          <span class="footer__wordmark">KOPI SIHOLTA</span>
        </div>
        <p class="footer__tagline">Dari dataran tinggi Humbang Hasundutan ke seluruh dunia — pionir kopi specialty Indonesia yang membawa cita rasa Sumatra ke meja dunia.</p>

        <!-- Shop + Social buttons -->
        <div class="footer__shop-row">
          <p class="footer__shop-label">Belanja di:</p>
          <div class="footer__shop-btns">
            <a href={TOKPED_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="Tokopedia">
              <Image src={tokpedLogo} alt="Tokopedia" width={52} height={16} class="footer__shop-logo" />
            </a>
            <a href={SHOPEE_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="Shopee">
              <Image src={shopeeLogo} alt="Shopee" width={52} height={16} class="footer__shop-logo" />
            </a>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="Instagram">
              <Image src={igLogo} alt="Instagram" width={18} height={18} />
            </a>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="footer__social-btn footer__social-btn--wa" aria-label="WhatsApp">
              <Image src={waLogo} alt="WhatsApp" width={18} height={18} />
            </a>
          </div>
        </div>
      </div>

      <!-- Link Columns -->
      <div class="footer__cols">
        {columns.map(col => (
          <div class="footer__col">
            <p class="footer__col-title">{col.title}</p>
            <ul class="footer__col-links">
              {col.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    class="footer__link"
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Divider -->
    <div class="footer__divider" aria-hidden="true"></div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">© 2025 PT. Siholta Toba Indonesia. Seluruh hak dilindungi.</p>
      <div class="footer__bottom-links">
        <a href={`/${lang}/privacy`} class="footer__bottom-link">Kebijakan Privasi</a>
        <span class="footer__bottom-sep" aria-hidden="true">·</span>
        <a href={`/${lang}/terms`} class="footer__bottom-link">Syarat & Ketentuan</a>
      </div>
    </div>

  </div>
</footer>

