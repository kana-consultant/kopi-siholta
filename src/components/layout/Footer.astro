---
import { Image } from 'astro:assets';
import logo from '../../images/logo/logo-siholta.png';
import tokpedLogo from '../../images/logo/logo-tokopedia.png';
import shopeeLogo from '../../images/logo/logo-shopee.png';
import igLogo from '../../images/logo/logo-instagram.png';
import waLogo from '../../images/logo/logo-whatsapp.png';
import tiktokLogo from '../../images/logo/logo-tiktok.png';
import linktreeLogo from '../../images/logo/logo-linktree.png';
import { getTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = await getTranslations(lang);

const WHATSAPP_NUMBER = '6281322518527';
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}`;
const EMAIL = 'siholtatobaindonesia@gmail.com';
const INSTAGRAM_URL = 'https://www.instagram.com/kopi_siholta.id/';
const TOKPED_URL = 'https://www.tokopedia.com/kopisiholta';
const SHOPEE_URL = 'https://shopee.co.id/kopi_siholta';
const TIKTOK_URL = 'https://www.tiktok.com/@kopisiholta';
const LINKTREE_URL = 'https://linktr.ee/kopisiholta';


const columns = [
  {
    title: t.footer.col1Title,
    links: [
      { label: t.footer.col1About, href: `/${lang}/company/#about`, desc: '' },
      { label: t.footer.col1History, href: `/${lang}/company/#timeline`, desc: '' },
      { label: t.footer.col1Certification, href: `/${lang}/company/#certificates`, desc: '' },
    ],
  },
  {
    title: t.footer.col2Title,
    links: [
      { label: t.footer.col2ArabicaBeans, href: `/${lang}/#products`, desc: '' },
      { label: t.footer.col2ArabicaGround, href: `/${lang}/#products`, desc: '' },
      { label: t.footer.col2Robusta, href: `/${lang}/#products`, desc: '' },
    ],
  },
  {
    title: t.footer.col3Title,
    links: [
      { label: t.footer.col3B2B, href: `/${lang}/#b2b`, desc: '' },
      { label: t.footer.col3Tourism, href: `/${lang}/tourism`, desc: '' },
      { label: t.footer.col3FarmVisit, href: `/${lang}/coffee-farming`, desc: '' },
    ],
  },
  {
    title: t.footer.col4Title,
    links: [
      { label: `${t.footer.col4Email}: ${EMAIL}`, href: `mailto:${EMAIL}`, desc: t.footer.col4EmailAria },
      { label: `${t.footer.col4Phone}: ${WHATSAPP_NUMBER}`, href: WHATSAPP_URL, desc: t.footer.col4PhoneAria },
      { label: t.footer.col4Address, href: `/${lang}/company/#our-office`, desc: t.footer.col4AddressAria },
    ],
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner container">

    <div class="footer__top">

    <div class="footer__brand">
      <div class="footer__brand-logo">
        <Image src={logo} alt="Kopi Siholta" width={160} height={160} quality="max" class="footer__logo-img" />
        <span class="footer__wordmark">KOPI SIHOLTA</span>
      </div>
      <div class="footer__shop-row">
        <p class="footer__shop-label">{t.footer.shopLabel}</p>
        <div class="footer__shop-btns">
          <a href={TOKPED_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="Tokopedia">
            <Image src={tokpedLogo} alt="Tokopedia" width={96} height={96} quality="max" class="footer__shop-logo" />
          </a>
          <a href={SHOPEE_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="Shopee">
            <Image src={shopeeLogo} alt="Shopee" width={96} height={96} quality="max" class="footer__shop-logo" />
          </a>
          
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="Instagram">
            <Image src={igLogo} alt="Instagram" width={96} height={96} quality="max" class="footer__shop-logo" />
          </a>
          <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="TikTok">
            <Image src={tiktokLogo} alt="TikTok" width={96} height={96} quality="max" class="footer__shop-logo" />
          </a>
          <a href={LINKTREE_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="Linktree">
            <Image src={linktreeLogo} alt="Linktree" width={96} height={96} quality="max" class="footer__shop-logo" />
          </a>
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="footer__shop-btn" aria-label="WhatsApp">
            <Image src={waLogo} alt="WhatsApp" width={96} height={96} quality="max" class="footer__shop-logo" />
          </a>
        </div>
      </div>
    </div>

      <div class="footer__cols">
        {columns.map(col => (
          <div class="footer__col">
            <p class="footer__col-title">{col.title}</p>
            <ul class="footer__col-links">
              {col.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    class="footer__link"
                    aria-label={link.desc}
                    target={link.href.startsWith('http') || link.href.startsWith('mailto') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer__divider" aria-hidden="true"></div>

    <div class="footer__copyright">
      <p>{t.footer.copyright}</p>
    </div>

  </div>
</footer>
<style>

.footer {
  background: var(--color-brand-red);
  padding-top: var(--space-8);
  padding-bottom: var(--space-6);
}

.footer__inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  width: 100%;
  max-width: var(--grid-max-width);
  margin-inline: auto;
  padding-inline: var(--space-5);
}

.footer__top {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  align-items: start;
}

.footer__brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.footer__brand-logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.footer__logo-img {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  object-fit: cover;
  flex-shrink: 0;
  border: 0.5px solid rgba(255, 255, 255, 0.2);
  image-rendering: -webkit-optimize-contrast;
}

.footer__shop-row {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.footer__shop-btns {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;   
}

.footer__shop-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.footer__shop-btn:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}

.footer__shop-logo {
  width: 24px;
  height: 24px;
  object-fit: contain;
  flex-shrink: 0;
  image-rendering: -webkit-optimize-contrast;
}
.footer__wordmark {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #fff;
}

.footer__tagline {
  font-family: var(--font-body);
  font-size: 0.75rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.92);
  max-width: 280px;
}

.footer__shop-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.footer__shop-label {
  font-family: var(--font-label);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-main);
}

.footer__shop-btns {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.footer__shop-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 14px;
  background: rgba(255,255,255,0.15);
  border: 0.5px solid rgba(255,255,255,0.2);
  border-radius: var(--radius-md);
  transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  text-decoration: none;
}

.footer__shop-btn:hover {
  background: rgba(255,255,255,0.22);
  border-color: rgba(255,255,255,0.35);
  transform: translateY(-1px);
}

.footer__shop-logo {
  height: 22px;
  width: auto;
  object-fit: contain;
  display: block;
}


.footer__cols {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
}

.footer__col-title {
  font-family: var(--font-label);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-text-main);
  margin-bottom: var(--space-4);
}

.footer__col-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.footer__link {
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: rgba(255,255,255,0.90);
  text-decoration: none;
  transition: color 150ms ease;
  line-height: 1.5;
}

.footer__link:hover { color: #fff; }
.footer__link:focus-visible { outline: 2px solid rgba(255,255,255,0.8); outline-offset: 2px; border-radius: 2px; }

.footer__divider {
  height: 0.5px;
  background: rgba(255,255,255,0.12);
}

.footer__copyright {
  display: flex;
  justify-content: center;
}

.footer__copyright p {
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--color-text-main);
}

.footer__bottom-sep {
  color: rgba(255,255,255,0.25);
  font-size: 0.75rem;
}

/* ── Responsive ─────────────────────────── */
@media (min-width: 640px) {
  .footer {
    padding-top: var(--space-10);
    padding-bottom: var(--space-8);
  }
  .footer__inner {
    padding-inline: var(--space-8);
    gap: var(--space-8);
  }
  .footer__top {
    grid-template-columns: 1.3fr 2fr;
    gap: var(--space-10);
  }
  .footer__cols {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer__brand {
    gap: var(--space-5);
  }

  .footer__shop-btns {
    flex-wrap: nowrap;
    gap: 1rem;
  }
}

@media (min-width: 1024px) {
  .footer {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }
  .footer__inner {
    padding-inline: var(--section-padding-x);
    gap: var(--space-8);
  }
  .footer__top { gap: var(--space-12); }
  .footer__cols {
    grid-template-columns: repeat(4, 1fr);
  }
  .footer__bottom {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

</style>

