---
import { Icon } from 'astro-icon/components';

interface Props {
  currentLang?: string;
  t?: Record<string, string>;
}

const { currentLang = 'id', t = {} } = Astro.props;

const langs = [
  { code: 'id', label: 'ID', name: 'Bahasa Indonesia' },
  { code: 'en', label: 'EN', name: 'English' },
  { code: 'fr', label: 'FR', name: 'Français' },
];

const current = langs.find(l => l.code === currentLang) ?? langs[0];
---

<div class="lang-switcher js-lang-switcher">
  <button
    class="lang-trigger js-lang-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t.selectLang ? `Bahasa dipilih: ${current.name}` : `Current language: ${current.name}. Change language`}
  >
    <span class="lang-trigger__icon" aria-hidden="true">
      <Icon name="mdi:globe" width="13" height="13" />
    </span>
    <span class="lang-current-code">
      {current.code.toUpperCase()}
    </span>
    <svg class="lang-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <ul
    class="lang-dropdown js-lang-dropdown"
    role="listbox"
    aria-label={t.selectLang ? 'Pilih bahasa' : 'Choose a language'}
    aria-orientation="vertical"
    hidden
  >
    {langs.map((lang) => (
      <li
        class={`lang-option ${lang.code === currentLang ? 'lang-option--active' : ''}`}
        data-lang={lang.code}
        role="option"
        aria-selected={lang.code === currentLang}
        tabindex="0"
      >
        <span class="lang-option__check" aria-hidden="true">
          {lang.code === currentLang && (
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          )}
        </span>
        <div class="lang-option-text">
          <span class="lang-option-code">{lang.label}</span>
          <span class="lang-option-name">{lang.name}</span>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;      
    background: rgba(249, 246, 240, 0.1);
    border: 1px solid rgba(205, 18, 34, 0.2);
    border-radius: 9999px;
    color: rgba(92, 61, 30, 0.85);
    cursor: pointer;
    font-size: 0.75rem;          
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    min-height: 32px;                
    min-width: auto;
  }

  .lang-trigger:hover {
    background: rgba(205, 18, 34, 0.08);
    border-color: rgba(205, 18, 34, 0.4);
    color: var(--color-brand-red);
  }

  .lang-trigger:active {
    background: rgba(205, 18, 34, 0.14);
    transform: scale(0.97);
    transition: transform 0.1s ease;
  }

  .lang-trigger:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }

  .lang-trigger__icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-brand-earth);
  }

  .lang-current-code {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-brand-earth);
  }

  .lang-chevron {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--color-brand-earth);
  }

  .lang-switcher.open .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    left: auto;
    min-width: 10rem;
    background: #F9F6F0;
    border: 1px solid rgba(205, 18, 34, 0.15);
    border-radius: 0.5rem;
    padding: 0.25rem;
    box-shadow:
      0 8px 24px rgba(92, 61, 30, 0.14),
      0 2px 8px rgba(92, 61, 30, 0.08);
    list-style: none;
    margin: 0;
    z-index: 300;
    opacity: 0;
    transform: translateY(-8px) scale(0.96);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .lang-switcher.open .lang-dropdown {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  .lang-switcher--mobile.open .lang-dropdown {
    margin-right: var(--space-1);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background 0.15s ease;
    min-height: 38px;
    position: relative;
  }

  .lang-option:hover {
    background: rgba(205, 18, 34, 0.06);
  }

  .lang-option:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: -2px;
    background: rgba(205, 18, 34, 0.06);
  }

  .lang-option--active {
    background: rgba(205, 18, 34, 0.05);
    font-weight: 600;
  }

  .lang-option__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--color-brand-red);
  }

  .lang-option-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .lang-option-code {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand-earth);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .lang-option-name {
    font-size: 0.625rem;
    color: var(--color-brand-muted);
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .lang-dropdown {
      right: auto;
      left: 0; 
    }

    .lang-switcher--mobile.open .lang-dropdown {
      margin-right: 0; 
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-trigger, .lang-chevron, .lang-dropdown { transition: none; }
    .lang-switcher.open .lang-dropdown { opacity: 1; transform: none; }
  }
</style>

<script>
  const VALID_LANGS = ['id', 'en', 'fr'];

  function localeHref(targetLang: string): string {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    if (pathParts[0] && VALID_LANGS.includes(pathParts[0])) {
      pathParts[0] = targetLang;
    } else {
      pathParts.unshift(targetLang);
    }
    return '/' + pathParts.join('/') || '/';
  }

  function selectLanguage(lang: string): void {
    document.cookie = `preferred_lang=${lang}; path=/; max-age=${60 * 60 * 24 * 7}; samesite=lax`;
    window.location.href = localeHref(lang);
  }

  const switchers = document.querySelectorAll('.js-lang-switcher');

  switchers.forEach((switcher) => {
    const trigger = switcher.querySelector('.js-lang-trigger') as HTMLButtonElement | null;
    const dropdown = switcher.querySelector('.js-lang-dropdown') as HTMLElement | null;

    if (!trigger || !dropdown) return;

    const isMobileContext = !!(
      switcher.closest('.mobile-menu') || 
      switcher.closest('.mobile-navbar-lang') ||
      switcher.closest('.nav-mobile-wrapper') || 
      document.querySelector('.mobile-menu.is-open')
    );

    if (isMobileContext) {
      switcher.classList.add('lang-switcher--mobile');
    }

    function openDropdown(): void {
      switcher.classList.add('open');
      trigger!.setAttribute('aria-expanded', 'true');
      dropdown!.hidden = false;
      const first = dropdown!.querySelector<HTMLElement>('.lang-option');
      first?.focus();
    }

    function closeDropdown(): void {
      switcher.classList.remove('open');
      trigger!.setAttribute('aria-expanded', 'false');
      dropdown!.hidden = true;
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = switcher.classList.contains('open');
      document.querySelectorAll('.js-lang-switcher').forEach(s => s.classList.remove('open'));
      isOpen ? closeDropdown() : openDropdown();
    });

    dropdown.addEventListener('keydown', (e: KeyboardEvent) => {
      const allOptions = Array.from(dropdown.querySelectorAll<HTMLElement>('.lang-option'));
      const currentIndex = allOptions.findIndex((o) => o === document.activeElement);

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          if (currentIndex < allOptions.length - 1) allOptions[currentIndex + 1].focus();
          else allOptions[0].focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          if (currentIndex > 0) allOptions[currentIndex - 1].focus();
          else allOptions[allOptions.length - 1].focus();
          break;
        case 'Enter':
        case ' ':
          e.preventDefault();
          if (document.activeElement) {
            const lang = (document.activeElement as HTMLElement).dataset.lang ?? 'id';
            selectLanguage(lang);
          }
          break;
        case 'Escape':
        case 'Tab':
          e.preventDefault();
          closeDropdown();
          trigger.focus();
          break;
      }
    });

    dropdown.querySelectorAll('.lang-option').forEach((option) => {
      option.addEventListener('click', () => {
        const lang = (option as HTMLElement).dataset.lang ?? 'id';
        selectLanguage(lang);
      });
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.js-lang-switcher').forEach((switcher) => {
      switcher.classList.remove('open');
      const trigger = switcher.querySelector('.js-lang-trigger');
      const dropdown = switcher.querySelector('.js-lang-dropdown') as HTMLElement | null;
      trigger?.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.hidden = true;
    });
  });
</script>