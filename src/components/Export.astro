---
import { MapPin, TrendingUp, Award, ArrowRight, Plane } from 'lucide-astro';

const markets = [
  { country: 'Korea Selatan', flag: '🇰🇷', status: 'Aktif' },
  { country: 'Jepang', flag: '🇯🇵', status: 'Aktif' },
  { country: 'Belanda', flag: '🇳🇱', status: 'Aktif' },
  { country: 'Jerman', flag: '🇩🇪', status: 'Aktif' },
  { country: 'Rusia', flag: '🇷🇺', status: 'Aktif' },
  { country: 'Amerika Serikat', flag: '🇺🇸', status: 'Aktif' },
  { country: 'China', flag: '🇨🇳', status: 'Target 2026' },
  { country: 'Australia', flag: '🇦🇺', status: 'Target 2026' }
];

const achievements = [
  { value: '6+', label: 'Negara Tujuan Ekspor' },
  { value: '50+', label: 'Importir & Distributor' },
  { value: '100 Ton', label: 'Volume Ekspor/Tahun' },
  { value: '99%', label: 'Klien Puas' }
];
---

<section id="ekspor" class="section-padding bg-[var(--color-cream)] relative overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[var(--color-gold)]/5 to-transparent"></div>
  </div>

  <div class="container-custom relative">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-[var(--color-roasted)]/10 rounded-full text-[var(--color-roasted)]/70 font-medium text-sm mb-4">
        Pasar Internasional
      </span>
      <h2 class="section-title">
        Merambah
        <span class="text-gradient">Pasar Dunia</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Kopi Siholta telah menembus pasar internasional dan terus berkembang. Komitmen kami adalah menghadirkan kopi specialty Indonesia ke seluruh dunia.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 md:gap-6 mb-12 sm:mb-16">
      {achievements.map((stat, index) => (
        <div class="text-center p-4 sm:p-6 bg-white rounded-xl sm:rounded-2xl shadow-lg animate-on-scroll" style={`animation-delay: ${index * 100}ms`}>
          <div class="text-3xl sm:text-4xl md:text-5xl font-display font-bold text-[var(--color-red)] mb-1 sm:mb-2">{stat.value}</div>
          <div class="text-xs sm:text-sm text-[var(--color-roasted)]/70 font-medium">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Market List -->
    <div class="max-w-4xl mx-auto mb-16">
      <div class="flex items-center gap-4 mb-8">
        <div class="w-12 h-12 rounded-xl bg-[var(--color-red)]/10 flex items-center justify-center">
          <TrendingUp class="w-6 h-6 text-[var(--color-red)]" />
        </div>
        <div>
          <h3 class="text-lg sm:text-xl md:text-2xl font-display font-bold text-[var(--color-dark-brown)] leading-tight">Jangkauan Global</h3>
          <p class="text-[var(--color-roasted)]/70">Mencapai 6+ negara di berbagai benua</p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-6">
        {markets.map((market) => (
          <div class="flex items-center gap-2 sm:gap-3 p-3 sm:p-4 bg-white rounded-lg sm:rounded-xl shadow-md hover:shadow-lg transition-shadow">
            <span class="text-xl sm:text-2xl">{market.flag}</span>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-[var(--color-dark-brown)] text-xs sm:text-sm truncate">{market.country}</div>
              <div class={`text-xs font-medium ${market.status === 'Aktif' ? 'text-[var(--color-green)]' : 'text-[var(--color-blue)]'}`}>
                {market.status}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="flex items-center gap-3 sm:gap-4 p-4 sm:p-6 bg-gradient-to-r from-[var(--color-gold)]/10 to-[var(--color-red)]/10 rounded-xl sm:rounded-2xl border border-[var(--color-gold)]/20">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[var(--color-gold)] flex items-center justify-center flex-shrink-0">
          <Award class="w-5 h-5 sm:w-6 sm:h-6 text-[var(--color-dark-brown)]" />
        </div>
        <div>
          <div class="font-display font-bold text-[var(--color-dark-brown)]">Target Ekspor 2026</div>
          <p class="text-sm text-[var(--color-roasted)]/70">Memperluas jaringan ke China, Australia, dan negara-negara Asia Tenggara</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
        href="#kontak"
        class="inline-flex items-center gap-3 px-8 py-4 bg-[var(--color-roasted)] text-[var(--color-cream)] font-semibold rounded-full hover:bg-[var(--color-warm)] transition-colors group"
      >
        <Plane class="w-5 h-5" />
        <span>Jadilah Mitra Ekspor Kami</span>
        <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>
</section>