---
import { ArrowRight } from 'lucide-astro';
---

<section id="beranda" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-dark-brown)] via-[var(--color-roasted)] to-[var(--color-dark-brown)]"></div>

    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_2px_2px,_var(--tw-gradient-stops))] from-[var(--color-gold)]/30 via-transparent to-transparent [background-size:24px_24px]"></div>

    <div class="absolute top-20 left-10 w-32 h-32 rounded-full bg-[var(--color-gold)]/10 blur-3xl animate-float"></div>
    <div class="absolute bottom-40 right-20 w-48 h-48 rounded-full bg-[var(--color-red)]/10 blur-3xl animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/3 right-1/4 w-24 h-24 rounded-full bg-[var(--color-cream)]/5 blur-2xl animate-float" style="animation-delay: 4s;"></div>
  </div>

  <div class="container-custom relative z-10 text-center px-4 py-32">

    <div class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-gold)]/20 rounded-full mb-8 animate-fade-in-up">
      <span class="w-2 h-2 bg-[var(--color-gold)] rounded-full animate-pulse"></span>
      <span class="text-[var(--color-gold)] font-medium text-sm tracking-wide">Kopi Lintong Asli Sumatera Utara</span>
    </div>

    <h1 class="text-responsive-lg font-display font-bold text-[var(--color-cream)] mb-6 leading-tight">
      <span class="block animate-fade-in-up delay-100">Nikmati Keindahan</span>
      <span class="block animate-fade-in-up delay-200">Danau Toba dalam</span>
      <span class="block bg-gradient-to-r from-[var(--color-gold)] via-[var(--color-copper)] to-[var(--color-red)] bg-clip-text text-transparent animate-fade-in-up delay-300">
        Setiap Cangkir
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-[var(--color-cream)]/80 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in-up delay-400">
      Kopi Siholta menghadirkan aroma dan cita rasa khas Lintong Nihuta dengan notes spicy, herba, rempah, dan cokelat yang tak terlupakan.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up delay-500">
      <a href="#produk" class="btn-primary group">
        <span>Lihat Produk</span>
        <ArrowRight class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
      </a>
      <a href="#tentang" class="btn-secondary">
        <span>Tentang Kami</span>
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
    <span class="text-[var(--color-cream)]/50 text-xs tracking-[0.3em] uppercase">Scroll</span>
    <div class="w-6 h-10 rounded-full border-2 border-[var(--color-cream)]/30 flex justify-center pt-2">
      <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-gold)] animate-bounce"></div>
    </div>
  </div>
</section>

<style>
  .text-responsive-lg {
    font-size: clamp(2.5rem, 8vw, 5rem);
  }
</style>