---
import { ArrowRight } from 'lucide-astro';
---

<section id="beranda" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Critical: Background renders immediately, no animations -->
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-dark-brown)] via-[var(--color-roasted)] to-[var(--color-dark-brown)]"></div>

  <!-- Decorative elements with animations (non-critical, will-load) -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_2px_2px,_var(--tw-gradient-stops))] from-[var(--color-gold)]/30 via-transparent to-transparent [background-size:24px_24px]"></div>
    <div class="absolute top-[15%] left-[10%] w-40 h-40 rounded-full bg-[var(--color-gold)]/8 blur-3xl animate-float"></div>
    <div class="absolute bottom-[25%] right-[15%] w-56 h-56 rounded-full bg-[var(--color-red)]/8 blur-3xl animate-float-alt" style="animation-delay: 1.5s;"></div>
    <div class="absolute top-[40%] right-[20%] w-28 h-28 rounded-full bg-[var(--color-cream)]/5 blur-2xl animate-float-slow" style="animation-delay: 3s;"></div>
    <div class="absolute bottom-[15%] left-[25%] w-20 h-20 rounded-full bg-[var(--color-gold)]/5 blur-2xl animate-float-alt" style="animation-delay: 4.5s;"></div>
  </div>

  <!-- Critical content: Renders immediately, visible at page load -->
  <div class="container-custom relative z-10 text-center px-4 py-32">
    <!-- Badge - visible immediately -->
    <div class="inline-flex items-center gap-2 px-5 py-2.5 bg-[var(--color-gold)]/15 rounded-full mb-8" style="animation: fadeIn 0.6s ease-out forwards;">
      <span class="w-2.5 h-2.5 bg-[var(--color-gold)] rounded-full animate-pulse"></span>
      <span class="text-[var(--color-gold)] font-medium text-sm tracking-wide">Kopi Lintong Asli Sumatera Utara</span>
    </div>

    <!-- H1 - LCP element, renders immediately -->
    <h1 class="text-responsive-lg font-display font-bold text-[var(--color-cream)] mb-6 leading-tight" style="animation: fadeIn 0.6s ease-out 0.1s forwards; opacity: 0;">
      <span class="block">Nikmati Keindahan</span>
      <span class="block">Danau Toba dalam</span>
      <span class="block hero-gradient">
        Setiap Cangkir
      </span>
    </h1>

    <!-- Description - visible immediately -->
    <p class="text-lg md:text-xl text-[var(--color-cream)]/80 max-w-2xl mx-auto mb-10 leading-relaxed" style="animation: fadeIn 0.6s ease-out 0.2s forwards; opacity: 0;">
      Kopi Siholta menghadirkan cita rasa khas Lintong Nihuta dengan aroma spicy, herba, rempah, dan cokelat yang tak terlupakan.
    </p>

    <!-- CTA buttons - visible immediately -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4" style="animation: fadeIn 0.6s ease-out 0.3s forwards; opacity: 0;">
      <a href="#produk" class="btn-primary group">
        <span>Lihat Produk</span>
        <ArrowRight class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
      </a>
      <a href="#tentang" class="btn-secondary">
        <span>Tentang Kami</span>
      </a>
    </div>
  </div>

  <!-- Scroll indicator - non-critical -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3" style="animation: fadeIn 1s ease-out 0.5s forwards; opacity: 0;" aria-hidden="true">
    <span class="text-[var(--color-cream)]/50 text-xs tracking-[0.3em] uppercase">Scroll</span>
    <div class="w-6 h-10 rounded-full border-2 border-[var(--color-cream)]/30 flex justify-center pt-2">
      <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-gold)] animate-bounce"></div>
    </div>
  </div>
</section>

<style>
  .text-responsive-lg {
    font-size: clamp(2.5rem, 8vw, 5rem);
  }

  /* Critical: Instant fade-in for LCP */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>