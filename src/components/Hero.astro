---
// Hero.astro — Kopi Siholta Landing Hero (Pure Astro, no React/JS libraries)
---

<section id="beranda" class="beranda">
  <!-- Parallax Background -->
  <div class="parallax-bg" id="parallax-bg">
    <div
      class="bg-img"
      style="background-image: url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=1920&q=80&auto=format&fit=crop')"
    ></div>

    <!-- Layered gradient overlays -->
    <div class="overlay-coffee"></div>
    <div class="overlay-top-fade"></div>
    <div class="overlay-side-accent"></div>
  </div>

  <!-- Dot grid texture -->
  <div class="dot-grid"></div>

  <!-- Floating decorative orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="orb orb-4"></div>

  <!-- Main content -->
  <div class="content-wrapper" id="hero-content">
    <div class="content-inner reveal-on-scroll is-visible">

      <!-- Eyebrow badge -->
      <div class="eyebrow reveal-on-scroll is-visible">
        <span class="pulse-dot"></span>
        <span class="eyebrow-text">Produsen Kopi Specialty dari Dataran Tinggi Toba</span>
      </div>

      <!-- H1 headline -->
      <h1 class="headline reveal-on-scroll is-visible">
        <span class="headline-line line-1">Nikmati Keindahan</span>
        <span class="headline-line line-2">Danau Toba dalam</span>
        <span class="headline-line line-3">
          <span class="gradient-text">Setiap Cangkir</span>
        </span>
      </h1>

      <!-- Description -->
      <p class="description reveal-on-scroll is-visible">
        Kopi Siholta menghadirkan cita rasa khas Lintong Nihuta —
        <span class="highlight">aroma rempah, herba, dan cokelat</span>
        yang tak terlupakan dari lereng Danau Toba.
      </p>

      <!-- CTA buttons -->
      <div class="cta-group reveal-on-scroll is-visible">
        <!-- Primary CTA -->
        <a href="#produk" class="btn btn-primary">
          <span>Lihat Produk</span>
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>

        <!-- Secondary CTA -->
        <a href="#tentang" class="btn btn-secondary">
          <span>Tentang Kami</span>
          <svg class="arrow-icon-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <span class="scroll-label">Scroll</span>
    <div class="scroll-mouse">
      <div class="scroll-dot"></div>
    </div>
  </div>

  <!-- Bottom gradient fade -->
  <div class="bottom-fade"></div>
</section>

<style>
  /* ===== CSS Custom Properties (color aliases) ===== */
  .beranda {
    --color-cream: #F9F6F0;
    --color-dark-brown: #1C0F07;
    --color-gold: #F3B700;
    --color-red: #CD1222;
    --color-copper: #C17F3C;
    --color-roasted: #4A2511;

    /* Inherit font families from global / theme */
    font-family: var(--font-body, 'Plus Jakarta Sans', sans-serif);
  }

  /* ===== Keyframe Animations ===== */
  @keyframes float-orb-1 {
    0%, 100% { transform: translateY(0px) scale(1); }
    50%       { transform: translateY(-30px) scale(1.05); }
  }
  @keyframes float-orb-2 {
    0%, 100% { transform: translateY(0px) scale(1); }
    50%       { transform: translateY(25px) scale(1.03); }
  }
  @keyframes float-orb-3 {
    0%, 100% { transform: translateY(0px) scale(1); }
    50%       { transform: translateY(-20px) scale(1.06); }
  }
  @keyframes float-orb-4 {
    0%, 100% { transform: translateY(0px) scale(1); }
    50%       { transform: translateY(15px) scale(1.04); }
  }
  @keyframes pulse-gold {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(1.3); }
  }
  @keyframes bounce-dot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%       { transform: translateY(12px); opacity: 0.3; }
  }
  @keyframes border-glow {
    0%, 100% { border-color: rgba(249, 246, 240, 0.3); }
    50%       { border-color: rgba(243, 183, 0, 0.8); }
  }
  @keyframes shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ===== Section base ===== */
  .beranda {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-dark-brown);
  }

  /* ===== Parallax Background ===== */
  .parallax-bg {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .bg-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .overlay-coffee {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg,
      rgba(28, 15, 7, 0.92) 0%,
      rgba(74, 37, 17, 0.85) 50%,
      rgba(28, 15, 7, 0.95) 100%
    );
  }
  .overlay-top-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
      rgba(28, 15, 7, 0.6) 0%,
      transparent 40%,
      transparent 100%
    );
  }
  .overlay-side-accent {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
      rgba(243, 183, 0, 0.05) 0%,
      transparent 50%,
      rgba(205, 18, 34, 0.05) 100%
    );
  }

  /* ===== Dot Grid ===== */
  .dot-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, var(--color-gold) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.06;
  }

  /* ===== Floating Orbs ===== */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(40px);
  }
  .orb-1 {
    top: 10%;
    left: 5%;
    width: 18rem;
    height: 18rem;
    background: rgba(243, 183, 0, 0.08);
    animation: float-orb-1 8s ease-in-out infinite;
  }
  .orb-2 {
    bottom: 20%;
    right: 10%;
    width: 24rem;
    height: 24rem;
    background: rgba(205, 18, 34, 0.06);
    animation: float-orb-2 10s ease-in-out infinite;
    animation-delay: 1s;
  }
  .orb-3 {
    top: 40%;
    right: 15%;
    width: 10rem;
    height: 10rem;
    background: rgba(249, 246, 240, 0.04);
    animation: float-orb-3 7s ease-in-out infinite;
    animation-delay: 2s;
    filter: blur(24px);
  }
  .orb-4 {
    bottom: 10%;
    left: 20%;
    width: 8rem;
    height: 8rem;
    background: rgba(243, 183, 0, 0.06);
    animation: float-orb-4 9s ease-in-out infinite;
    animation-delay: 3s;
    filter: blur(24px);
  }

  /* ===== Main Content ===== */
  .content-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 75rem;
    margin: 0 auto;
    padding: 8rem 1.5rem 6rem;
    text-align: center;
    will-change: transform;
  }
  .content-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  /* ===== Eyebrow Badge ===== */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    border: 1px solid rgba(243, 183, 0, 0.3);
    background: rgba(243, 183, 0, 0.1);
    backdrop-filter: blur(8px);
  }
  .pulse-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-gold);
    animation: pulse-gold 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  .eyebrow-text {
    color: var(--color-gold);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ===== H1 Headline ===== */
  .headline {
    font-family: var(--font-serif, 'Playfair Display', Georgia, serif);
    font-weight: 700;
    color: var(--color-cream);
    margin-bottom: 2rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .headline-line {
    display: block;
  }
  .line-1, .line-2 {
    color: rgba(249, 246, 240, 0.8);
    font-weight: 300;
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    margin-bottom: 0.5rem;
  }
  .line-2 {
    margin-bottom: 1rem;
  }
  .line-3 {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
  }
  .gradient-text {
    background: linear-gradient(
      to right,
      var(--color-gold) 0%,
      var(--color-copper) 50%,
      var(--color-red) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ===== Description ===== */
  .description {
    color: rgba(249, 246, 240, 0.7);
    font-size: clamp(1rem, 2vw, 1.25rem);
    max-width: 42rem;
    margin: 0 auto 3rem;
    line-height: 1.75;
    font-weight: 300;
  }
  .highlight {
    color: var(--color-gold);
    font-weight: 500;
  }

  /* ===== CTA Buttons ===== */
  .cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .cta-group {
      flex-direction: row;
      justify-content: center;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.125rem 2.5rem;
    border-radius: 9999px;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.3s ease,
                color 0.3s ease,
                background 0.3s ease;
  }
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 100%
    );
    transform: translateX(-100%);
    transition: transform 0.5s ease;
    pointer-events: none;
  }
  .btn:hover::after {
    animation: shimmer 0.6s ease forwards;
  }

  /* Primary button */
  .btn-primary {
    background: linear-gradient(to right, var(--color-red), #9B0E1A);
    color: #fff;
    box-shadow: 0 1.5rem 3rem rgba(205, 18, 34, 0.3);
  }
  .btn-primary:hover {
    transform: scale(1.05);
    box-shadow: 0 1.5rem 4rem rgba(205, 18, 34, 0.45);
  }
  .btn-primary:active {
    transform: scale(0.97);
  }

  /* Secondary button */
  .btn-secondary {
    background: transparent;
    border: 2px solid rgba(249, 246, 240, 0.3);
    color: rgba(249, 246, 240, 0.8);
    backdrop-filter: blur(8px);
  }
  .btn-secondary:hover {
    color: var(--color-cream);
    border-color: rgba(249, 246, 240, 0.6);
    transform: scale(1.04);
  }
  .btn-secondary:active {
    transform: scale(0.97);
  }

  /* Arrow icons */
  .arrow-icon,
  .arrow-icon-down {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .btn-primary:hover .arrow-icon {
    transform: translateX(4px);
  }
  .btn-secondary:hover .arrow-icon-down {
    transform: translateY(4px);
  }

  /* ===== Scroll Indicator ===== */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    z-index: 20;
  }
  .scroll-label {
    color: rgba(249, 246, 240, 0.4);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .scroll-mouse {
    width: 1.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 2px solid rgba(249, 246, 240, 0.3);
    display: flex;
    justify-content: center;
    padding-top: 0.5rem;
    animation: border-glow 2s ease-in-out infinite;
  }
  .scroll-dot {
    width: 0.25rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-gold);
    animation: bounce-dot 1.5s ease-in-out infinite;
  }

  /* ===== Bottom gradient fade ===== */
  .bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 8rem;
    background: linear-gradient(to top, var(--color-cream) 0%, transparent 100%);
    pointer-events: none;
    z-index: 5;
  }

  /* ===== Scroll-reveal animation ===== */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered delays for children */
  .reveal-on-scroll.is-visible .eyebrow   { transition-delay: 0.1s; }
  .reveal-on-scroll.is-visible .headline  { transition-delay: 0.25s; }
  .reveal-on-scroll.is-visible .description { transition-delay: 0.4s; }
  .reveal-on-scroll.is-visible .cta-group { transition-delay: 0.55s; }

  /* Headline lines stagger */
  .reveal-on-scroll.is-visible .line-1 { animation: fade-in-up 0.8s cubic-bezier(0.22,1,0.36,1) 0.25s both; }
  .reveal-on-scroll.is-visible .line-2 { animation: fade-in-up 0.8s cubic-bezier(0.22,1,0.36,1) 0.38s both; }
  .reveal-on-scroll.is-visible .line-3 { animation: fade-in-up 0.8s cubic-bezier(0.22,1,0.36,1) 0.51s both; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const parallaxBg = document.getElementById('parallax-bg') as HTMLElement | null;
    const heroContent = document.getElementById('hero-content') as HTMLElement | null;

    /* ── Parallax scroll effect ── */
    const handleScroll = () => {
      const scrollY = window.scrollY;
      if (parallaxBg) {
        parallaxBg.style.transform = `translateY(${scrollY * 0.3}px)`;
      }
      if (heroContent) {
        // Text parallax — slower than background for depth
        const progress = Math.min(scrollY / 600, 1);
        heroContent.style.transform = `translateY(${scrollY * 0.15}px)`;
        heroContent.style.opacity = String(1 - progress * 0.8);
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // run once on load

    /* ── IntersectionObserver for scroll-reveal ── */
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            // Unobserve after revealing (one-shot animation)
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px',
      }
    );

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
      observer.observe(el);
    });
  });
</script>