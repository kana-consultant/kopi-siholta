---
import { Coffee, MapPin, Phone, Mail, Instagram, Facebook, ChevronRight, Heart } from 'lucide-astro';
import {Image} from 'astro:assets';
import Logo from '../images/logo-kopi-siholta.png';

const quickLinks = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Tentang Kami', href: '#tentang' },
  { label: 'Produk', href: '#produk' },
  { label: 'Pasar Internasional', href: '#ekspor' },
  { label: 'Kerjasama', href: '#kerjasama' },
  { label: 'Kontak', href: '#kontak' }
];

const productLinks = [
  { label: 'Arabika Biji Utuh', href: '#produk' },
  { label: 'Arabika Giling Halus', href: '#produk' },
  { label: 'Robusta Premium', href: '#produk' },
  { label: 'Hampers & Gift Set', href: '#produk' }
];

const socialLinks = [
  { icon: Instagram, label: '@kopi_siholta.id', href: 'https://instagram.com/kopi_siholta.id' },
  { icon: Facebook, label: 'Facebook', href: 'https://www.facebook.com/kopisiholta' }
];
---

<footer class="bg-[var(--color-dark-brown)] text-[var(--color-cream)] pt-20 pb-8 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(circle_at_2px_2px,_var(--tw-gradient-stops))] from-[var(--color-gold)] via-transparent to-transparent [background-size:20px_20px] rotate-[30deg]"></div>

  <div class="container-custom relative">
    <!-- Main Content -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="#beranda" class="flex items-center gap-3 mb-6">
          <div class="w-14 h-14 rounded-full bg-gradient-to-br from-[var(--color-gold)] to-[var(--color-red)] flex items-center justify-center shadow-lg overflow-hidden">
            <Image
              src={Logo}
              width={56}
              height={56}
              class="w-full h-full object-cover"
              alt="Logo Kopi Kopi Siholta"
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>
        <p class="text-[var(--color-cream)]/70 leading-relaxed mb-6">
          Kopi Lintong asli Sumatera Utara. Menghadirkan kelezatan dan kehangatan dari lereng Danau Toba dalam setiap cangkir.
        </p>
        <div class="flex items-center gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-[var(--color-cream)]/10 flex items-center justify-center hover:bg-[var(--color-gold)] hover:text-[var(--color-dark-brown)] transition-all duration-300"
              aria-label={social.label}
            >
              <social.icon class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-lg font-display font-bold text-[var(--color-gold)] mb-6">Navigasi</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--color-cream)]/70 hover:text-[var(--color-gold)] transition-colors duration-300 inline-flex items-center gap-2 group"
              >
                <ChevronRight class="w-4 h-4 text-[var(--color-gold)]/50 group-hover:text-[var(--color-gold)] group-hover:translate-x-1 transition-all" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Products -->
      <div>
        <h4 class="text-lg font-display font-bold text-[var(--color-gold)] mb-6">Produk</h4>
        <ul class="space-y-3">
          {productLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[var(--color-cream)]/70 hover:text-[var(--color-gold)] transition-colors duration-300 inline-flex items-center gap-2 group"
              >
                <ChevronRight class="w-4 h-4 text-[var(--color-gold)]/50 group-hover:text-[var(--color-gold)] group-hover:translate-x-1 transition-all" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-lg font-display font-bold text-[var(--color-gold)] mb-6">Kontak</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-[var(--color-gold)] flex-shrink-0 mt-0.5" />
            <span class="text-[var(--color-cream)]/70 text-sm">Dusun IV, Desa Sitolu Bahal, Kec. Lintong Nihuta, Kab. Humbang Hasundutan, Sumatera Utara 22475</span>
          </li>
          <li class="flex items-start gap-3">
            <Phone class="w-5 h-5 text-[var(--color-gold)] flex-shrink-0 mt-0.5" />
            <span class="text-[var(--color-cream)]/70 text-sm">+62 813 2251 8527</span>
          </li>
          <li class="flex items-start gap-3">
            <Mail class="w-5 h-5 text-[var(--color-gold)] flex-shrink-0 mt-0.5" />
            <span class="text-[var(--color-cream)]/70 text-sm">siholtatobaindonesia@gmail.com</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Newsletter -->
    <div class="border-t border-[var(--color-cream)]/10 pt-12 mb-12">
      <div class="max-w-xl mx-auto text-center">
        <h4 class="text-2xl font-display font-bold text-[var(--color-cream)] mb-4">Tetap Terhubung</h4>
        <p class="text-[var(--color-cream)]/60 mb-6">Dapatkan update terbaru tentang produk dan promo spesial.</p>
        <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input
            type="email"
            placeholder="Masukkan email Anda"
            class="flex-1 px-6 py-4 rounded-full bg-[var(--color-cream)]/10 border border-[var(--color-cream)]/20 text-[var(--color-cream)] placeholder:text-[var(--color-cream)]/50 focus:border-[var(--color-gold)] focus:outline-none transition-colors"
          />
          <button
            type="submit"
            class="px-8 py-4 bg-gradient-to-r from-[var(--color-gold)] to-[var(--color-red)] text-white font-bold rounded-full hover:shadow-lg hover:shadow-[var(--color-gold)]/30 transition-all duration-300"
          >
            Berlangganan
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-[var(--color-cream)]/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[var(--color-cream)]/50 text-sm text-center md:text-left">
        &copy; {new Date().getFullYear()} PT. Siholta Toba Indonesia. All rights reserved.
      </p>
      <div class="flex items-center gap-2 text-[var(--color-cream)]/50 text-sm">
        <span>Dibuat dengan</span>
        <Heart class="w-4 h-4 text-[var(--color-red)]" />
        <span>untuk kopi Indonesia</span>
      </div>
    </div>
  </div>
</footer>