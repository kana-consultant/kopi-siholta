---
// Footer.astro — Pure Astro, no React
import Logo from '../images/logo-kopi-siholta.png';
---

<footer class="relative bg-[var(--color-dark-brown)] text-[var(--color-cream)] pt-20 pb-8 overflow-hidden">
  <!-- Dot texture overlay -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03]"
    style="background-image: radial-gradient(circle, var(--color-gold) 1px, transparent 1px); background-size: 24px 24px; transform: rotate(30deg);"
  ></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <!-- 4-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Brand Column -->
      <div class="lg:col-span-1 reveal-on-scroll" id="footer-brand">
        <a href="#beranda" class="flex items-center gap-3 mb-6 group">
          <div class="w-14 h-14 rounded-full overflow-hidden shadow-lg transition-transform duration-300 group-hover:scale-110">
            <img src={Logo.src} alt="Kopi Siholta" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <span class="font-serif text-xl font-bold tracking-wide">
            Kopi Siholta
          </span>
        </a>
        <p class="text-[var(--color-cream)]/60 leading-relaxed mb-6 text-sm">
          Kopi Lintong asli Sumatera Utara. Menghadirkan kelezatan dan kehangatan
          dari lereng Danau Toba dalam setiap cangkir.
        </p>
        <!-- Social Links -->
        <div class="flex items-center gap-3">
          <a
            href="https://instagram.com/kopi_siholta.id"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full bg-[var(--color-cream)]/10 flex items-center justify-center hover:bg-[var(--color-gold)] hover:text-[var(--color-dark-brown)] text-[var(--color-cream)]/70 transition-all duration-300 hover:-translate-y-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/kopisiholta"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-10 h-10 rounded-full bg-[var(--color-cream)]/10 flex items-center justify-center hover:bg-[var(--color-gold)] hover:text-[var(--color-dark-brown)] text-[var(--color-cream)]/70 transition-all duration-300 hover:-translate-y-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="reveal-on-scroll" id="footer-nav">
        <h4 class="text-lg font-serif font-bold text-[var(--color-gold)] mb-6">Navigasi</h4>
        <ul class="space-y-3">
          <li>
            <a href="#beranda" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Beranda
            </a>
          </li>
          <li>
            <a href="#tentang" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Tentang Kami
            </a>
          </li>
          <li>
            <a href="#produk" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Produk
            </a>
          </li>
          <li>
            <a href="#ekspor" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Pasar Internasional
            </a>
          </li>
          <li>
            <a href="#kerjasama" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Kerjasama
            </a>
          </li>
          <li>
            <a href="#kontak" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Kontak
            </a>
          </li>
        </ul>
      </div>

      <!-- Products Column -->
      <div class="reveal-on-scroll" id="footer-products">
        <h4 class="text-lg font-serif font-bold text-[var(--color-gold)] mb-6">Produk</h4>
        <ul class="space-y-3">
          <li>
            <a href="#produk" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Arabika Biji Utuh
            </a>
          </li>
          <li>
            <a href="#produk" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Arabika Giling Halus
            </a>
          </li>
          <li>
            <a href="#produk" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Robusta Premium
            </a>
          </li>
          <li>
            <a href="#produk" class="footer-link text-[var(--color-cream)]/60 hover:text-[var(--color-gold)]">
              Hampers & Gift Set
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="reveal-on-scroll" id="footer-contact">
        <h4 class="text-lg font-serif font-bold text-[var(--color-gold)] mb-6">Kontak</h4>
        <ul class="space-y-4 text-sm text-[var(--color-cream)]/60">
          <li class="flex items-start gap-3">
            <span class="text-[var(--color-gold)] mt-0.5 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <span>Dusun IV, Desa Sitolu Bahal, Kec. Lintong Nihuta, Kab. Humbang Hasundutan, Sumatera Utara 22475</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-[var(--color-gold)] flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.7 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </span>
            <a href="tel:+6281322518527" class="hover:text-[var(--color-gold)] transition-colors duration-300">
              +62 813 2251 8527
            </a>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-[var(--color-gold)] flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </span>
            <a href="mailto:siholtatobaindonesia@gmail.com" class="hover:text-[var(--color-gold)] transition-colors duration-300 break-all">
              siholtatobaindonesia@gmail.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Newsletter -->
    <div class="border-t border-[var(--color-cream)]/10 pt-12 mb-12 reveal-on-scroll" id="footer-newsletter">
      <div class="max-w-xl mx-auto text-center">
        <h4 class="text-2xl font-serif font-bold text-[var(--color-cream)] mb-4">
          Tetap Terhubung
        </h4>
        <p class="text-[var(--color-cream)]/50 mb-6 text-sm">
          Dapatkan update terbaru tentang produk dan promo spesial.
        </p>
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" novalidate>
          <input
            type="email"
            id="newsletter-email"
            placeholder="Masukkan email Anda"
            required
            class="flex-1 px-6 py-4 rounded-full bg-[var(--color-cream)]/10 border border-[var(--color-cream)]/20 text-[var(--color-cream)] placeholder:text-[var(--color-cream)]/40 focus:border-[var(--color-gold)] focus:outline-none transition-colors duration-300 text-sm"
          />
          <button
            type="submit"
            class="px-8 py-4 bg-gradient-to-r from-[var(--color-gold)] to-[var(--color-red)] text-white font-bold rounded-full hover:shadow-[0_12px_32px_rgba(243,183,0,0.3)] transition-all duration-300 hover:scale-[1.04] active:scale-[0.97] whitespace-nowrap"
          >
            Berlangganan
          </button>
        </form>
        <!-- Newsletter success -->
        <p id="newsletter-success" class="hidden mt-4 text-sm text-[var(--color-gold)]">
          ✅ Terima kasih! Anda berhasil berlangganan.
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-[var(--color-cream)]/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-[var(--color-cream)]/40 text-sm text-center md:text-left">
        © <span id="current-year"></span> PT. Siholta Toba Indonesia. All rights reserved.
      </p>
      <p class="text-[var(--color-cream)]/40 text-sm flex items-center gap-1.5">
        <span>Made with</span>
        <span class="text-[var(--color-red)]">❤</span>
        <span>untuk kopi Indonesia</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-link:hover {
    color: var(--color-gold);
  }

  .footer-link::before {
    content: '›';
    color: var(--color-gold);
    opacity: 0.4;
    transition: opacity 0.3s, color 0.3s;
  }

  .footer-link:hover::before {
    opacity: 1;
  }

  /* Scroll reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger reveals */
  #footer-brand { transition-delay: 0ms; }
  #footer-nav { transition-delay: 80ms; }
  #footer-products { transition-delay: 160ms; }
  #footer-contact { transition-delay: 240ms; }
  #footer-newsletter { transition-delay: 320ms; }
</style>

<script>
  // Set current year
  const yearEl = document.getElementById('current-year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());

  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { once: true, margin: '-60px' }
  );

  document.querySelectorAll('footer .reveal-on-scroll').forEach((el) => {
    observer.observe(el);
  });

  // Newsletter form
  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const newsletterSuccess = document.getElementById('newsletter-success');
  const newsletterEmail = document.getElementById('newsletter-email') as HTMLInputElement | null;

  if (newsletterForm && newsletterSuccess && newsletterEmail) {
    newsletterForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!newsletterEmail.value) return;

      newsletterSuccess.classList.remove('hidden');
      newsletterForm.reset();

      setTimeout(() => {
        newsletterSuccess.classList.add('hidden');
      }, 4000);
    });
  }
</script>