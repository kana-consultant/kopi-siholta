---
// Partnership.astro — Pure Astro, no React
---

<section id="kerjasama" class="relative overflow-hidden bg-gradient-to-b from-[var(--color-roasted)] to-[var(--color-dark-brown)] py-24 md:py-32">
  <!-- Decorative top gradient -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(243,183,0,0.08)_0%,transparent_60%)]"></div>

  <div class="relative mx-auto max-w-6xl px-6 md:px-12 lg:px-20">
    <!-- Section Header -->
    <div class="mb-16 text-center reveal-on-scroll">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-[var(--color-gold)]">
        Bergabung Bersama Kami
      </p>
      <h2 class="text-4xl font-serif font-bold md:text-5xl text-[var(--color-cream)]">
        <span class="bg-gradient-to-r from-[var(--color-gold)] via-[#E8A000] to-[var(--color-red)] bg-clip-text text-transparent">
          Berkolaborasi
        </span>
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-[var(--color-cream)]/70 text-base md:text-lg leading-relaxed">
        Terbuka untuk berbagai bentuk kerja sama — dari supplied kopi hingga
        franchise kedai kopi. Mari bangun bisnis bersama.
      </p>
    </div>

    <!-- Partnership Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16" id="partnership-grid">
      <!-- Card 1: Coffee Shop & Cafe -->
      <div class="partnership-card group relative rounded-2xl border border-[var(--color-cream)]/20 bg-[var(--color-dark-brown)]/60 p-7 backdrop-blur-md cursor-default reveal-on-scroll">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-gold)] to-[var(--color-red)] shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-dark-brown)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 8h1a4 4 0 0 1 0 8h-1"/>
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z"/>
            <line x1="6" y1="2" x2="6" y2="4"/>
            <line x1="10" y1="2" x2="10" y2="4"/>
            <line x1="14" y1="2" x2="14" y2="4"/>
          </svg>
        </div>
        <h3 class="font-serif font-bold text-[var(--color-cream)] text-xl mb-2">Coffee Shop & Cafe</h3>
        <p class="text-sm text-[var(--color-cream)]/65 leading-relaxed mb-5">
          Program supplied untuk coffee shop dan cafe. Dapatkan kopi berkualitas dengan harga kompetitif dan support marketing.
        </p>
        <ul class="grid grid-cols-2 gap-2">
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Harga penawaran khusus
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Marketing support
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Barista training
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Custom blend option
          </li>
        </ul>
        <!-- Bottom accent line -->
        <div class="accent-line"></div>
      </div>

      <!-- Card 2: Restoran & Hotel -->
      <div class="partnership-card group relative rounded-2xl border border-[var(--color-cream)]/20 bg-[var(--color-dark-brown)]/60 p-7 backdrop-blur-md cursor-default reveal-on-scroll">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-gold)] to-[var(--color-red)] shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-dark-brown)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
            <path d="M9 22v-4h6v4"/>
            <path d="M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01M8 14h.01M16 14h.01M12 14h.01"/>
          </svg>
        </div>
        <h3 class="font-serif font-bold text-[var(--color-cream)] text-xl mb-2">Restoran & Hotel</h3>
        <p class="text-sm text-[var(--color-cream)]/65 leading-relaxed mb-5">
          Jasa supplied kopi untuk restoran, hotel, dan hospitality bisnis. Layanan lengkap dari konsultasi hingga delivery.
        </p>
        <ul class="grid grid-cols-2 gap-2">
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Custom packaging
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Priority delivery
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Menu consultation
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Quality guarantee
          </li>
        </ul>
        <div class="accent-line"></div>
      </div>

      <!-- Card 3: Franchise Kedai Kopi -->
      <div class="partnership-card group relative rounded-2xl border border-[var(--color-cream)]/20 bg-[var(--color-dark-brown)]/60 p-7 backdrop-blur-md cursor-default reveal-on-scroll">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-gold)] to-[var(--color-red)] shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-dark-brown)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <h3 class="font-serif font-bold text-[var(--color-cream)] text-xl mb-2">Franchise Kedai Kopi</h3>
        <p class="text-sm text-[var(--color-cream)]/65 leading-relaxed mb-5">
          Mari bangun bisnis kedai kopi bersama Kopi Siholta. Dapatkan brand support, training komprehensif, dan ongoing assistance.
        </p>
        <ul class="grid grid-cols-2 gap-2">
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Brand licensing
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Store design support
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Operational training
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Marketing package
          </li>
        </ul>
        <div class="accent-line"></div>
      </div>

      <!-- Card 4: Distributor & Reseller -->
      <div class="partnership-card group relative rounded-2xl border border-[var(--color-cream)]/20 bg-[var(--color-dark-brown)]/60 p-7 backdrop-blur-md cursor-default reveal-on-scroll">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-gold)] to-[var(--color-red)] shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-dark-brown)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <h3 class="font-serif font-bold text-[var(--color-cream)] text-xl mb-2">Distributor & Reseller</h3>
        <p class="text-sm text-[var(--color-cream)]/65 leading-relaxed mb-5">
          Bergabung sebagai distributor atau reseller resmi Kopi Siholta. Dapatkan margin kompetitif dan priority akses produk.
        </p>
        <ul class="grid grid-cols-2 gap-2">
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Exclusive territory
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Competitive margin
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Marketing materials
          </li>
          <li class="flex items-center gap-2 text-sm text-[var(--color-cream)]/80">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-gold)]"></span>
            Priority stock
          </li>
        </ul>
        <div class="accent-line"></div>
      </div>
    </div>

    <!-- Benefits Section -->
    <div class="mb-16 rounded-2xl border border-[var(--color-cream)]/20 bg-[var(--color-dark-brown)]/60 p-8 md:p-12 backdrop-blur-md reveal-on-scroll" id="benefits-section">
      <h3 class="text-lg font-bold text-[var(--color-gold)] text-center mb-8 uppercase tracking-wider">
        Keuntungan Menjadi Mitra
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Kualitas Terjamin -->
        <div class="flex flex-col items-center text-center reveal-on-scroll">
          <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full border border-[var(--color-green)]/40 bg-[var(--color-green)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <h4 class="font-bold text-[var(--color-cream)] text-sm mb-1">Kualitas Terjamin</h4>
          <p class="text-xs text-[var(--color-cream)]/60">Setiap batch melewati quality control ketat</p>
        </div>

        <!-- Harga Kompetitif -->
        <div class="flex flex-col items-center text-center reveal-on-scroll">
          <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full border border-[var(--color-green)]/40 bg-[var(--color-green)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
          </div>
          <h4 class="font-bold text-[var(--color-cream)] text-sm mb-1">Harga Kompetitif</h4>
          <p class="text-xs text-[var(--color-cream)]/60">Margin menguntungkan untuk mitra bisnis</p>
        </div>

        <!-- Delivery Cepat -->
        <div class="flex flex-col items-center text-center reveal-on-scroll">
          <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full border border-[var(--color-green)]/40 bg-[var(--color-green)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <h4 class="font-bold text-[var(--color-cream)] text-sm mb-1">Delivery Cepat</h4>
          <p class="text-xs text-[var(--color-cream)]/60">Pengiriman tepat waktu ke seluruh Indonesia</p>
        </div>

        <!-- Support Penuh -->
        <div class="flex flex-col items-center text-center reveal-on-scroll">
          <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full border border-[var(--color-green)]/40 bg-[var(--color-green)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3v5zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3v5z"/>
            </svg>
          </div>
          <h4 class="font-bold text-[var(--color-cream)] text-sm mb-1">Support Penuh</h4>
          <p class="text-xs text-[var(--color-cream)]/60">Tim support siap membantu 24/7</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center reveal-on-scroll">
      <p class="mb-5 text-[var(--color-cream)]/60 text-sm">
        Tertarik bekerja sama dengan Kopi Siholta?
      </p>
      <a href="#kontak" class="inline-flex items-center gap-2 px-10 py-5 bg-gradient-to-r from-[var(--color-gold)] to-[var(--color-red)] text-[var(--color-dark-brown)] font-bold rounded-full shadow-lg hover:shadow-[var(--color-gold)]/40 transition-shadow duration-300">
        Hubungi Kami Sekarang
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .partnership-card {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease, border-color 0.3s ease;
  }

  .partnership-card:hover {
    transform: scale(1.02);
    border-color: rgba(243, 183, 0, 0.5);
    box-shadow: 0 0 40px rgba(243, 183, 0, 0.12);
  }

  /* Accent line that grows on hover */
  .accent-line {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    border-radius: 9999px;
    background: linear-gradient(to right, var(--color-gold), var(--color-red));
    opacity: 0;
    transition: width 0.5s ease, opacity 0.3s ease;
  }

  .partnership-card:hover .accent-line {
    width: 100%;
    opacity: 1;
  }

  /* Scroll reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered delay for partnership cards */
  #partnership-grid .reveal-on-scroll:nth-child(1) { transition-delay: 0ms; }
  #partnership-grid .reveal-on-scroll:nth-child(2) { transition-delay: 120ms; }
  #partnership-grid .reveal-on-scroll:nth-child(3) { transition-delay: 240ms; }
  #partnership-grid .reveal-on-scroll:nth-child(4) { transition-delay: 360ms; }

  /* Benefits stagger */
  #benefits-section .reveal-on-scroll:nth-child(1) { transition-delay: 0ms; }
  #benefits-section .reveal-on-scroll:nth-child(2) { transition-delay: 100ms; }
  #benefits-section .reveal-on-scroll:nth-child(3) { transition-delay: 200ms; }
  #benefits-section .reveal-on-scroll:nth-child(4) { transition-delay: 300ms; }
</style>

<script>
  // IntersectionObserver for scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          // Once visible, no need to keep observing
          observer.unobserve(entry.target);
        }
      });
    },
    { once: true, margin: '-80px' }
  );

  document.querySelectorAll('#kerjasama .reveal-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>