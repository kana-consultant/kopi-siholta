---
import { Handshake, Building2, Users, Coffee, Star, ArrowRight, Shield, DollarSign, Truck, Users2, Check } from 'lucide-astro';

const partnershipTypes = [
  {
    icon: Building2,
    title: 'Coffee Shop & Cafe',
    description: 'Program supplied untuk coffee shop dan cafe. Dapatkan kopi berkualitas dengan harga kompetitif dan support marketing.',
    features: ['Harga penawaran khusus', 'Marketing support', 'Barista training', 'Custom blend option']
  },
  {
    icon: Coffee,
    title: 'Restoran & Hotel',
    description: 'Jasa supplied kopi untuk restoran, hotel, dan hospitality bisnis. Layanan lengkap dari konsultasi hingga delivery.',
    features: ['Custom packaging', 'Priority delivery', 'Menu consultation', 'Quality guarantee']
  },
  {
    icon: Users,
    title: 'Franchise Kedai Kopi',
    description: 'Mari bangun bisnis kedai kopi bersama Kopi Siholta. Dapatkan brand support, training komprehensif, dan ongoing assistance.',
    features: ['Brand licensing', 'Store design support', 'Operational training', 'Marketing package']
  },
  {
    icon: Star,
    title: 'Distributor & Reseller',
    description: 'Bergabung sebagai distributor atau reseller resmi Kopi Siholta. Dapatkan margin kompetitif dan priority akses produk.',
    features: ['Exclusive territory', 'Competitive margin', 'Marketing materials', 'Priority stock']
  }
];
---

<section id="kerjasama" class="section-padding bg-gradient-to-b from-[var(--color-roasted)] to-[var(--color-dark-brown)] relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-[repeating-linear-gradient(45deg,_transparent,_transparent_10px,_rgba(249,246,240,0.3)_10px,_rgba(249,246,240,0.3)_11px)]"></div>

  <div class="container-custom relative">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-[var(--color-cream)]/20 rounded-full text-[var(--color-cream)]/80 font-medium text-sm mb-4">
        Kemitraan
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold text-[var(--color-cream)] mb-4 sm:mb-6 leading-tight">
        Mari
        <span class="bg-gradient-to-r from-[var(--color-gold)] to-[var(--color-red)] bg-clip-text text-transparent">Berkolaborasi</span>
      </h2>
      <p class="text-lg text-[var(--color-cream)]/70 max-w-2xl mx-auto">
        Kopi Siholta membuka peluang kemitraan untuk berbagai sektor bisnis. Bersama, kita bisa menghadirkan kelezatan kopi Lintong ke lebih banyak konsumen.
      </p>
    </div>

    <!-- Partnership Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 mb-12 sm:mb-16">
      {partnershipTypes.map((type, index) => (
        <div class="group bg-[var(--color-cream)]/10 backdrop-blur-md rounded-2xl sm:rounded-3xl p-5 sm:p-6 md:p-8 border border-[var(--color-cream)]/20 hover:border-[var(--color-gold)]/50 transition-all duration-500 animate-on-scroll" style={`animation-delay: ${index * 100}ms`}>
          <div class="flex items-start gap-4 sm:gap-6">
            <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-gradient-to-br from-[var(--color-gold)] to-[var(--color-red)] flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
              <type.icon class="w-6 h-6 sm:w-8 sm:h-8 text-white" />
            </div>
            <div class="flex-1">
              <h3 class="text-xl sm:text-2xl font-display font-bold text-[var(--color-cream)] mb-2 sm:mb-3">{type.title}</h3>
              <p class="text-[var(--color-cream)]/70 leading-relaxed mb-4 sm:mb-6 text-sm sm:text-base">{type.description}</p>
              <div class="grid grid-cols-2 gap-2 sm:gap-3">
                {type.features.map((feature) => (
                  <div class="flex items-center gap-1.5 sm:gap-2">
                    <Check class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[var(--color-green)] flex-shrink-0" />
                    <span class="text-[var(--color-cream)]/80 text-xs sm:text-sm">{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Benefits -->
    <div class="bg-[var(--color-cream)]/10 backdrop-blur-md rounded-2xl sm:rounded-3xl p-5 sm:p-6 md:p-12 border border-[var(--color-cream)]/20 mb-12 sm:mb-16">
      <h3 class="text-xl sm:text-2xl md:text-3xl font-display font-bold text-[var(--color-cream)] text-center mb-6 sm:mb-10">
        Mengapa Bermitra dengan Kami?
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 md:gap-8">
        {[
          { icon: Shield, title: 'Kualitas Terjamin', desc: 'Setiap batch melewati quality control ketat' },
          { icon: DollarSign, title: 'Harga Kompetitif', desc: 'Margin menguntungkan untuk mitra bisnis' },
          { icon: Truck, title: 'Delivery Cepat', desc: 'Pengiriman tepat waktu ke seluruh Indonesia' },
          { icon: Users2, title: 'Support Penuh', desc: 'Tim support siap membantu 24/7' }
        ].map((item) => (
          <div class="text-center">
            <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-[var(--color-gold)]/20 flex items-center justify-center mx-auto mb-3 sm:mb-4">
              <item.icon class="w-5.5 h-5.5 sm:w-8 sm:h-8 text-[var(--color-gold)]" />
            </div>
            <h4 class="text-base sm:text-lg font-display font-bold text-[var(--color-cream)] mb-1 sm:mb-2">{item.title}</h4>
            <p class="text-[var(--color-cream)]/60 text-xs sm:text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <p class="text-[var(--color-cream)]/70 mb-4 sm:mb-6 text-base sm:text-lg">Siap memulai perjalanan bisnis bersama kami?</p>
      <a
        href="#kontak"
        class="inline-flex items-center gap-2 sm:gap-3 px-6 sm:px-8 sm:px-10 py-3 sm:py-4 sm:py-5 bg-gradient-to-r from-[var(--color-red)] to-[var(--color-red)] text-white font-bold rounded-full hover:shadow-lg hover:shadow-[var(--color-red)]/30 transition-all duration-300 hover:scale-105"
      >
        <Handshake class="w-5 h-5 sm:w-6 sm:h-6" />
        <span class="text-sm sm:text-base">Mulai Kerjasama Sekarang</span>
        <ArrowRight class="w-4 h-4 sm:w-5 sm:h-5" />
      </a>
    </div>
  </div>
</section>