---
import { ShoppingBag, Package, Star, Shield, Truck, Check, ArrowRight } from 'lucide-astro';
import { Image } from 'astro:assets';
import arabicaBeans from '../images/arabica-beans.jpg';
import arabicaGround from '../images/arabica-ground.jpg';
import robustaBeans from '../images/robusta-beans.jpg';
import hampers from '../images/hampers.png';

const products = [
  {
    name: 'Arabica Roasted Beans',
    weight: '100gr - 1000gr',
    origin: 'Lintong Nihuta',
    notes: ['Spicy', 'Herba', 'Rempah', 'Cokelat'],
    description: 'Biji kopi arabika pilihan dari dataran tinggi Lintong. Cocok untuk pour over, French press, atau espresso.',
    image: arabicaBeans,
    badge: 'Best Seller',
    features: ['Grinding optional', 'Fresh roasted', 'Vacuum packed']
  },
  {
    name: 'Arabika Ground',
    weight: '100gr - 1000gr',
    origin: 'Lintong Nihuta',
    notes: ['Nutty', 'Chocolate', 'Fruity', 'Floral'],
    description: 'Arabika yang sudah digiling halus, siap seduh. Ideal untuk drip coffee atau mesin kopi otomatis.',
    image: arabicaGround,
    badge: 'Popular',
    features: ['Pre-ground', 'Fine grind', 'Nitrogen flush']
  },
  {
    name: 'Robusta Roasted Beans',
    weight: '100gr - 1000gr',
    origin: 'Lintong Nihuta',
    notes: ['Strong', 'Bold', 'Earthy', 'Chocolate'],
    description: 'Robusta berkualitas tinggi dengan body kuat dan crema yang tebal. Cocok untuk espresso blend atau Vietnamese drip.',
    image: robustaBeans,
    badge: 'Value Pack',
    features: ['High caffeine', 'Strong crema', 'Bold flavor']
  },
  {
    name: 'Hampers & Gift Set',
    weight: 'Custom',
    origin: 'Pilihan Premium',
    notes: ['Premium Selection', 'Gift Packaging', 'Customizable'],
    description: 'Pilihan hadiah eksklusif untuk momen spesial. Tersedia berbagai varian dan dapat dikustomisasi sesuai kebutuhan.',
    image: hampers,
    badge: 'Gift Ready',
    features: ['Premium box', 'Include guide', 'Custom ribbon']
  }
];

const features = [
  { icon: Star, text: 'Kualitas Premium Grade 1' },
  { icon: Shield, text: 'Garansi 100% Asli' },
  { icon: Truck, text: 'Pengiriman Seluruh Indonesia' },
  { icon: Package, text: 'Kemasan Kedap Udara' }
];
---

<section id="produk" class="section-padding bg-gradient-to-b from-[var(--color-roasted)] to-[var(--color-dark-brown)] relative overflow-hidden">
  <div class="absolute top-0 left-0 w-64 h-64 bg-[var(--color-gold)]/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-[var(--color-red)]/5 rounded-full blur-3xl"></div>

  <div class="container-custom relative">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-[var(--color-cream)]/20 rounded-full text-[var(--color-cream)]/80 font-medium text-sm mb-4">
        Produk Kami
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-[var(--color-cream)] mb-6">
        Pilihan Kopi
        <span class="bg-gradient-to-r from-[var(--color-gold)] to-[var(--color-red)] bg-clip-text text-transparent">Berkualitas</span>
      </h2>
      <p class="text-lg text-[var(--color-cream)]/70 max-w-2xl mx-auto">
        Dari biji utuh hingga giling halus, Hampers hadiah, kami menyediakan berbagai pilihan untuk kebutuhan Anda.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-4 mb-12">
      {features.map((feature) => (
        <div class="flex items-center gap-2 px-4 py-2 bg-[var(--color-cream)]/10 rounded-full backdrop-blur-sm">
          <feature.icon class="w-4 h-4 text-[var(--color-gold)]" />
          <span class="text-[var(--color-cream)]/90 text-sm font-medium">{feature.text}</span>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 animate-stagger">
      {products.map((product, index) => (
        <article
          class="group relative bg-[var(--color-cream)] rounded-3xl overflow-hidden shadow-2xl card-hover animate-on-scroll"
        >
          {product.badge && (
            <div class="absolute top-4 left-4 z-10 px-3 py-1 bg-[var(--color-red)] text-white text-xs font-bold rounded-full">
              {product.badge}
            </div>
          )}

          <div class="relative aspect-square overflow-hidden">
            <Image
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              width={600}
              height={600}
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-dark-brown)]/60 via-transparent to-transparent"></div>
          </div>

          <div class="p-6">
            <h3 class="text-xl font-display font-bold text-[var(--color-dark-brown)] mb-2">{product.name}</h3>
            <p class="text-sm text-[var(--color-roasted)]/60 mb-3">{product.weight} • {product.origin}</p>
            <p class="text-[var(--color-roasted)]/80 text-sm leading-relaxed mb-4">{product.description}</p>

            <div class="flex flex-wrap gap-2 mb-4">
              {product.notes.map((note) => (
                <span class="px-2 py-1 bg-[var(--color-gold)]/20 text-[var(--color-roasted)] text-xs font-medium rounded-full">
                  {note}
                </span>
              ))}
            </div>

            <div class="space-y-1 mb-4">
              {product.features.map((feature) => (
                <div class="flex items-center gap-2 text-xs text-[var(--color-roasted)]/70">
                  <Check class="w-3 h-3 text-[var(--color-green)] flex-shrink-0" />
                  <span>{feature}</span>
                </div>
              ))}
            </div>

            <a
              href="https://www.tokopedia.com/kopisiholta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[var(--color-red)] font-semibold hover:text-[var(--color-red)] transition-colors group"
            >
              <span>Beli di Tokopedia</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-16">
      <p class="text-[var(--color-cream)]/70 mb-6">Butuh jumlah besar untuk bisnis atau evento?</p>
      <a href="#kontak" class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--color-gold)] text-[var(--color-dark-brown)] font-semibold rounded-full hover:bg-[var(--color-gold)] transition-colors">
        <ShoppingBag class="w-5 h-5" />
        <span>Hubungi untuk Penawaran Wholesale</span>
      </a>
    </div>
  </div>
</section>