---
import arabicaBeans from '../images/arabica-beans.jpg';
import arabicaGround from '../images/arabica-ground.jpg';
import robustaBeans from '../images/robusta-beans.jpg';
import hampersImg from '../images/hampers.png';

const products = [
  {
    name: 'Arabica Roasted Beans',
    weight: '100gr - 1000gr',
    origin: 'Lintong Nihuta',
    notes: ['Spicy', 'Herbal', 'Rempah', 'Cokelat'],
    badge: 'Best Seller',
    src: arabicaBeans,
    alt: 'Arabica Roasted Beans',
  },
  {
    name: 'Arabika Ground',
    weight: '100gr - 1000gr',
    origin: 'Lintong Nihuta',
    notes: ['Nutty', 'Chocolate', 'Fruity', 'Floral'],
    badge: 'Popular',
    src: arabicaGround,
    alt: 'Arabika Ground Coffee',
  },
  {
    name: 'Robusta Roasted Beans',
    weight: '100gr - 1000gr',
    origin: 'Lintong Nihuta',
    notes: ['Strong', 'Bold', 'Earthy', 'Chocolate'],
    badge: 'Value Pack',
    src: robustaBeans,
    alt: 'Robusta Roasted Beans',
  },
  {
    name: 'Hampers & Gift Set',
    weight: 'Custom',
    origin: 'Pilihan Premium',
    notes: ['Premium Selection', 'Gift Packaging', 'Customizable'],
    badge: 'Gift Ready',
    src: hampersImg,
    alt: 'Hampers & Gift Set',
  },
];

const features = [
  'Kualitas Premium Grade 1',
  'Garansi 100% Asli',
  'Pengiriman Seluruh Indonesia',
  'Kemasan Kedap Udara',
];
---

<section id="produk" class="relative overflow-hidden bg-gradient-to-b from-[var(--color-roasted)] to-[var(--color-dark-brown)]">

  <!-- Decorative orbs -->
  <div class="orb-top"></div>
  <div class="orb-bottom"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative py-24 lg:py-32">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 reveal-on-scroll">
      <p class="text-xs tracking-widest text-gold uppercase mb-4">Pilihan Kopi</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-cream mb-5 leading-tight">
        Berkualitas
        <span class="bg-gradient-to-r from-gold to-red bg-clip-text text-transparent">
          {' '}Pilihan Kopi
        </span>
      </h2>
      <p class="text-lg text-cream/65 max-w-2xl mx-auto leading-relaxed">
        Dari biji utuh hingga giling halus, hingga hampers hadiah, kami menyediakan berbagai pilihan untuk kebutuhan Anda.
      </p>
    </div>

    <!-- Feature pills -->
    <div class="flex flex-wrap justify-center gap-3 mb-14 reveal-on-scroll">
      {features.map((feature) => (
        <div class="flex items-center gap-2 px-4 py-2.5 bg-cream/10 rounded-full backdrop-blur-sm border border-cream/15">
          <svg class="w-3.5 h-3.5 text-gold flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="text-cream/90 text-sm font-medium whitespace-nowrap">{feature}</span>
        </div>
      ))}
    </div>

    <!-- Product grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map((product) => (
        <div class="product-card group relative bg-cream rounded-3xl overflow-hidden shadow-xl shadow-[var(--color-dark-brown)]/20 cursor-pointer reveal-on-scroll">
          <!-- Badge -->
          {product.badge && (
            <div class="absolute top-4 left-4 z-20 px-3 py-1 bg-red text-white text-xs font-bold rounded-full shadow-lg">
              {product.badge}
            </div>
          )}

          <!-- Image -->
          <div class="relative aspect-[4/3] overflow-hidden bg-[var(--color-roasted)]/10">
            <img
              src={product.src}
              alt={product.alt}
              class="product-image w-full h-full object-cover"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-dark-brown)]/50 via-transparent to-transparent"></div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-serif font-bold text-[var(--color-dark-brown)] mb-1 leading-tight">
              {product.name}
            </h3>
            <p class="text-sm text-cream/60 mb-3 font-medium">
              {product.weight} &bull; {product.origin}
            </p>
            <!-- Notes tags -->
            <div class="flex flex-wrap gap-1.5 mb-5">
              {product.notes.map((note) => (
                <span class="px-2.5 py-0.5 bg-gold/20 text-[var(--color-roasted)] text-xs font-semibold rounded-full">
                  {note}
                </span>
              ))}
            </div>
            <!-- Tokopedia link -->
            <a
              href="https://www.tokopedia.com/kopisiholta"
              target="_blank"
              rel="noopener noreferrer"
              class="tokopedia-link inline-flex items-center gap-2 text-green font-semibold hover:text-[var(--color-green)]/80 transition-colors duration-200"
            >
              <span>Beli di Tokopedia</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-20 reveal-on-scroll">
      <p class="text-cream/55 mb-6 text-base">Butuh jumlah besar untuk bisnis?</p>
      <a href="#kontak" class="cta-button inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-gold to-copper text-[var(--color-dark-brown)] font-bold rounded-full shadow-2xl shadow-gold/25 hover:shadow-gold/40 transition-shadow duration-300">
        <span class="text-lg">Hubungi untuk Penawaran Menarik</span>
        <span class="chevron-wrapper">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>

  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '-80px' }
  );

  document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>

<style>
  /* Decorative orbs */
  .orb-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 20rem;
    height: 20rem;
    background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);
    border-radius: 9999px;
    opacity: 0.05;
    pointer-events: none;
    filter: blur(3rem);
  }

  .orb-bottom {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 24rem;
    height: 24rem;
    background: radial-gradient(circle, var(--color-red) 0%, transparent 70%);
    border-radius: 9999px;
    opacity: 0.05;
    pointer-events: none;
    filter: blur(3rem);
  }

  /* Product card hover lift */
  .product-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-0.5rem);
    box-shadow: 0 25px 50px -12px var(--color-dark-brown) / 0.25;
  }

  /* Product image zoom on card hover */
  .product-card:hover .product-image {
    transform: scale(1.1);
  }

  .product-image {
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Scroll reveal — initial hidden state */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(3.75rem);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Scroll reveal — visible state (triggered by JS) */
  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Staggered reveal delays per card */
  .reveal-on-scroll:nth-child(1) { transition-delay: 0ms; }
  .reveal-on-scroll:nth-child(2) { transition-delay: 100ms; }
  .reveal-on-scroll:nth-child(3) { transition-delay: 200ms; }
  .reveal-on-scroll:nth-child(4) { transition-delay: 300ms; }

  /* CTA button chevron bounce animation */
  @keyframes chevron-bounce {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(0.3125rem); }
  }

  .cta-button .chevron-wrapper {
    display: flex;
    animation: chevron-bounce 1.5s ease-in-out infinite;
  }
</style>