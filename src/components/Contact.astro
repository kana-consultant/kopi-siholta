---
import { MapPin, Phone, Mail, Clock, Send, MessageCircle, Store } from 'lucide-astro';

const contactInfo = [
  {
    icon: MapPin,
    title: 'Alamat Kantor',
    lines: [
      'Dusun IV, Desa/Kelurahan Sitolu Bahal',
      'Kec. Lintong Nihuta, Kab. Humbang Hasundutan',
      'Provinsi Sumatera Utara, Kode Pos 22475'
    ]
  },
  {
    icon: Store,
    title: 'Toko Jakarta',
    lines: ['Jln. Lubang Buaya No. 50', 'Cipayung, Jakarta Timur']
  },
  {
    icon: Phone,
    title: 'WhatsApp',
    lines: ['+62 813 2251 8527']
  },
  {
    icon: Mail,
    title: 'Email',
    lines: ['siholtatobaindonesia@gmail.com']
  },
  {
    icon: Clock,
    title: 'Jam Operasional',
    lines: ['Senin - Jumat: 08.00 - 17.00 WIB', 'Sabtu: 08.00 - 14.00 WIB']
  }
];
---

<section id="kontak" class="section-padding bg-[var(--color-cream)] relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-gold)]/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-[var(--color-red)]/5 rounded-full blur-3xl"></div>

  <div class="container-custom relative">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-[var(--color-roasted)]/10 rounded-full text-[var(--color-roasted)]/70 font-medium text-sm mb-4">
        Hubungi Kami
      </span>
      <h2 class="section-title">
        Tertarik untuk
        <span class="text-gradient">Berkolaborasi?</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Jangan ragu untuk menghubungi kami. Tim Kopi Siholta siap membantu Anda menemukan solusi kopi yang tepat.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Left: Contact Info -->
      <div class="space-y-6">
        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/6281322518527?text=Halo%20Kopi%20Siholta,%20saya%20tertarik%20dengan%20produk%20anda"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 p-6 bg-gradient-to-r from-[var(--color-green)] to-[var(--color-blue)] rounded-2xl text-white hover:shadow-lg hover:shadow-[var(--color-green)]/30 transition-all duration-300 group"
        >
          <div class="w-14 h-14 rounded-full bg-white/20 flex items-center justify-center">
            <MessageCircle class="w-7 h-7" />
          </div>
          <div>
            <div class="font-display font-bold text-lg">Chat WhatsApp</div>
            <div class="text-white/80 text-sm">Respon cepat, biasanya dalam 1x24 jam</div>
          </div>
          <svg class="w-6 h-6 ml-auto group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Contact Cards -->
        <h3 class="sr-only">Informasi Kontak</h3>
        <div class="grid gap-4">
          {contactInfo.map((info) => (
            <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow">
              <div class="w-12 h-12 rounded-xl bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0">
                <info.icon class="w-6 h-6 text-[var(--color-roasted)]" />
              </div>
              <div>
                <h4 class="font-display font-bold text-[var(--color-dark-brown)] mb-1">{info.title}</h4>
                {info.lines.map((line) => (
                  <p class="text-[var(--color-roasted)]/70 text-sm">{line}</p>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Online Store Links -->
        <div class="p-6 bg-gradient-to-r from-[var(--color-roasted)]/5 to-[var(--color-gold)]/5 rounded-2xl border border-[var(--color-gold)]/20">
          <h3 class="font-display font-bold text-[var(--color-dark-brown)] mb-4">Toko Online</h3>
          <a
            href="https://www.tokopedia.com/kopisiholta"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-[var(--color-red)] hover:text-[var(--color-red)] transition-colors group"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
            <span class="font-semibold">Tokopedia: kopisiholta</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <div class="mt-3">
            <a
              href="https://instagram.com/kopi_siholta.id"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-[var(--color-blue)] hover:text-[var(--color-green)] transition-colors group"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span class="font-semibold">@kopi_siholta.id</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-white rounded-3xl p-8 shadow-2xl">
        <h3 class="text-2xl font-display font-bold text-[var(--color-dark-brown)] mb-6">Kirim Pesan</h3>
        <form id="contact-form" class="space-y-5">
          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Nama Lengkap</label>
              <input
                type="text"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 focus:border-[var(--color-gold)] focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all outline-none"
                placeholder="Masukkan nama Anda"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Email</label>
              <input
                type="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 focus:border-[var(--color-gold)] focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all outline-none"
                placeholder="email@contoh.com"
              />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Nomor WhatsApp</label>
            <input
              type="tel"
              name="phone"
              class="w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 focus:border-[var(--color-gold)] focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all outline-none"
              placeholder="+62 812 xxxx xxxx"
            />
          </div>
          <div>
            <label for="subject" class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Subjek</label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 focus:border-[var(--color-gold)] focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all outline-none bg-white"
            >
              <option value="">Pilih subjek pesan</option>
              <option value="produk">Pertanyaan Produk</option>
              <option value="wholesale">Penawaran Wholesale</option>
              <option value="mitra">Kerjasama Kemitraan</option>
              <option value="ekspor">Pertanyaan Ekspor</option>
              <option value="lainnya">Lainnya</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Pesan</label>
            <textarea
              name="message"
              rows="4"
              required
              class="w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 focus:border-[var(--color-gold)] focus:ring-2 focus:ring-[var(--color-gold)]/20 transition-all outline-none resize-none"
              placeholder="Tulis pesan Anda di sini..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-4 bg-gradient-to-r from-[var(--color-red)] to-[var(--color-red)] text-white font-bold rounded-xl hover:shadow-lg hover:shadow-[var(--color-red)]/30 transition-all duration-300 flex items-center justify-center gap-2 group"
          >
            <Send class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
            <span>Kirim Pesan</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Map Section -->
    <div class="mt-16">
      <h3 class="text-2xl font-display font-bold text-[var(--color-dark-brown)] text-center mb-8">Lokasi Kami</h3>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
          <div class="aspect-video bg-[var(--color-roasted)]/10">
            <iframe
              title="Peta Lokasi Kantor Pusat Kopi Siholta di Sumatera Utara"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3985.8!2d98.5!3d2.3!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMsKwMTgnMDAuMCJTIDk4wrAyOScwMC4wIkU!5e0!3m2!1sen!2sid!4v1234567890"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="p-4">
            <h3 class="font-display font-bold text-[var(--color-dark-brown)]">Kantor Pusat - Sumatera Utara</h3>
            <p class="text-[var(--color-roasted)]/70 text-sm">Lintong Nihuta, Humbang Hasundutan</p>
          </div>
        </div>
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
          <div class="aspect-video bg-[var(--color-roasted)]/10">
            <iframe
              title="Peta Lokasi Toko Kopi Siholta di Jakarta"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.2!2d106.9!3d-6.3!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNsKwMTgnMDAuMCJTIDEwNsKwNTQnMDAuMCJF!5e0!3m2!1sen!2sid!4v1234567890"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="p-4">
            <h3 class="font-display font-bold text-[var(--color-dark-brown)]">Toko Jakarta</h3>
            <p class="text-[var(--color-roasted)]/70 text-sm">Jln. Lubang Buaya No. 50, Cipayung, Jakarta Timur</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Terima kasih! Pesan Anda telah dikirim. Kami akan segera menghubungi Anda.');
    (form as HTMLFormElement).reset();
  });
</script>