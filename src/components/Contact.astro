---
// Contact.astro — Pure Astro, no React
---

<section id="kontak" class="relative overflow-hidden bg-[var(--color-cream)] py-24 md:py-32">
  <!-- Decorative blobs -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-gold)]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-[var(--color-red)]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll" id="contact-header">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-[var(--color-dark-brown)] mb-4">
        Tertarik untuk
        <span class="bg-gradient-to-r from-[var(--color-gold)] to-[var(--color-copper)] bg-clip-text text-transparent"> Berkontribusi?</span>
      </h2>
      <p class="text-[var(--color-roasted)]/70 text-base md:text-lg leading-relaxed mx-auto">
        Jangan ragu untuk menghubungi kami. Tim Kopi Siholta siap membantu Anda menemukan solusi kopi yang tepat.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Left: WhatsApp + Contact Cards -->
      <div class="space-y-6 reveal-on-scroll" id="contact-left">
        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/6281322518527?text=Halo%20Kopi%20Siholta,%20saya%20tertarik%20dengan%20produk%20anda"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-5 p-6 bg-gradient-to-r from-[var(--color-green)] to-[var(--color-blue)] rounded-2xl text-white hover:shadow-xl hover:shadow-[var(--color-green)]/25 transition-all duration-300 group"
        >
          <div class="w-14 h-14 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
            <span class="text-2xl">💬</span>
          </div>
          <div>
            <div class="font-serif font-bold text-lg">Chat WhatsApp</div>
            <div class="text-white/80 text-sm">Respon cepat, biasanya dalam 1x24 jam</div>
          </div>
          <svg
            class="w-6 h-6 ml-auto transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

        <!-- Contact Cards -->
        <div class="grid gap-4">
          <!-- Alamat Kantor -->
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow reveal-on-scroll">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0 text-[var(--color-roasted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <h4 class="font-serif font-bold text-[var(--color-dark-brown)] mb-1">Alamat Kantor</h4>
              <p class="text-[var(--color-roasted)]/70 text-sm">Dusun IV, Desa/Kelurahan Sitolu Bahal</p>
              <p class="text-[var(--color-roasted)]/70 text-sm">Kec. Lintong Nihuta, Kab. Humbang Hasundutan</p>
              <p class="text-[var(--color-roasted)]/70 text-sm">Provinsi Sumatera Utara, Kode Pos 22475</p>
            </div>
          </div>

          <!-- Toko Jakarta -->
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow reveal-on-scroll">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0 text-[var(--color-roasted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/>
                <path d="M2 7h20"/>
                <path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"/>
              </svg>
            </div>
            <div>
              <h4 class="font-serif font-bold text-[var(--color-dark-brown)] mb-1">Toko Jakarta</h4>
              <p class="text-[var(--color-roasted)]/70 text-sm">Jln. Lubang Buaya No. 50</p>
              <p class="text-[var(--color-roasted)]/70 text-sm">Cipayung, Jakarta Timur</p>
            </div>
          </div>

          <!-- Nomor Telepon -->
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow reveal-on-scroll">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0 text-[var(--color-roasted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.7 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <h4 class="font-serif font-bold text-[var(--color-dark-brown)] mb-1">Nomor Telepon</h4>
              <p class="text-[var(--color-roasted)]/70 text-sm">+62 813 2251 8527</p>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow reveal-on-scroll">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0 text-[var(--color-roasted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <div>
              <h4 class="font-serif font-bold text-[var(--color-dark-brown)] mb-1">Email</h4>
              <p class="text-[var(--color-roasted)]/70 text-sm">siholtatobaindonesia@gmail.com</p>
            </div>
          </div>

          <!-- Jam Operasional -->
          <div class="flex items-start gap-4 p-5 bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow reveal-on-scroll">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-gold)]/20 flex items-center justify-center flex-shrink-0 text-[var(--color-roasted)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <h4 class="font-serif font-bold text-[var(--color-dark-brown)] mb-1">Jam Operasional</h4>
              <p class="text-[var(--color-roasted)]/70 text-sm">Senin - Jumat: 08.00 - 17.00 WIB</p>
              <p class="text-[var(--color-roasted)]/70 text-sm">Sabtu: 08.00 - 14.00 WIB</p>
            </div>
          </div>
        </div>

        <!-- Online Store -->
        <div class="p-6 bg-gradient-to-r from-[var(--color-roasted)]/5 to-[var(--color-gold)]/5 rounded-2xl border border-[var(--color-gold)]/20 reveal-on-scroll">
          <h3 class="font-serif font-bold text-[var(--color-dark-brown)] mb-4">Toko Online</h3>
          <div class="space-y-3">
            <a href="https://www.tokopedia.com/kopisiholta" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[var(--color-green)] hover:text-[var(--color-green)] transition-colors group">
              <span class="font-semibold">Tokopedia: kopisiholta</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
            <a href="https://shopee.co.id/kopi_siholta" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[var(--color-red)] hover:text-[var(--color-red)] transition-colors group">
              <span class="font-semibold">Shopee: kopi_siholta</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Right: Contact Form -->
      <div class="bg-white rounded-3xl p-8 shadow-2xl reveal-on-scroll" id="contact-form-wrapper">
        <h3 class="text-2xl font-serif font-bold text-[var(--color-dark-brown)] mb-6">Kirim Pesan</h3>

        <form id="contact-form" class="space-y-5" novalidate>
          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Nama Lengkap</label>
              <input
                type="text"
                name="name"
                required
                placeholder="Masukkan nama Anda"
                class="form-input w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 outline-none transition-all text-sm placeholder:text-[var(--color-roasted)]/40"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Email</label>
              <input
                type="email"
                name="email"
                required
                placeholder="email@example.com"
                class="form-input w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 outline-none transition-all text-sm placeholder:text-[var(--color-roasted)]/40"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Nomor WhatsApp</label>
            <input
              type="tel"
              name="phone"
              placeholder="+62 812 xxxx xxxx"
              class="form-input w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 outline-none transition-all text-sm placeholder:text-[var(--color-roasted)]/40"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Subjek</label>
            <select
              name="subject"
              required
              class="form-input w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 outline-none transition-all text-sm bg-white text-[var(--color-roasted)]/70 appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Pilih subjek pesan</option>
              <option value="produk">Pertanyaan Produk</option>
              <option value="wholesale">Penawaran Wholesale Menarik</option>
              <option value="mitra">Kerjasama Kemitraan</option>
              <option value="ekspor">Pertanyaan Ekspor</option>
              <option value="lainnya">Lainnya</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-[var(--color-roasted)]/80 mb-2">Pesan</label>
            <textarea
              name="message"
              rows="4"
              required
              placeholder="Tulis pesan Anda di sini..."
              class="form-input w-full px-4 py-3 rounded-xl border border-[var(--color-roasted)]/20 outline-none transition-all text-sm resize-none placeholder:text-[var(--color-roasted)]/40"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-gradient-to-r from-[var(--color-red)] to-[#9B0E1A] text-white font-bold rounded-xl hover:shadow-lg hover:shadow-[var(--color-red)]/30 transition-all duration-300 flex items-center justify-center gap-2"
          >
            <span>Kirim Pesan</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>
        </form>

        <!-- Success message (hidden by default) -->
        <div id="form-success" class="hidden text-center py-16">
          <div class="text-5xl mb-4">✅</div>
          <h4 class="text-xl font-serif font-bold text-[var(--color-dark-brown)] mb-2">Pesan Terkirim!</h4>
          <p class="text-[var(--color-roasted)]/60">Kami akan segera menghubungi Anda.</p>
        </div>
      </div>
    </div>

    <!-- Map Section -->
    <div class="mt-16 reveal-on-scroll" id="map-section">
      <h3 class="text-2xl font-serif font-bold text-[var(--color-dark-brown)] text-center mb-8">Lokasi Kami</h3>
      <div class="grid md:grid-cols-2 gap-6">
        <!-- PT Siholta Toba Indonesia -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
          <div class="aspect-video bg-[var(--color-roasted)]/10">
            <iframe
              title="PT Siholta Toba Indonesia"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3020.790969851621!2d106.9011354735554!3d-6.295716561615304!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3007f623b53%3A0x118fc0912e442961!2sPT.%20Siholta%20Toba%20Indonesia!5e1!3m2!1sid!2sid!4v1776950452968!5m2!1sid!2sid"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="p-4">
            <h3 class="font-serif font-bold text-[var(--color-dark-brown)]">PT Siholta Toba Indonesia</h3>
            <p class="text-[var(--color-roasted)]/70 text-sm">Lintong Nihuta, Humbang Hasundutan, Sumatera Utara</p>
          </div>
        </div>

        <!-- Kopi Siholta -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
          <div class="aspect-video bg-[var(--color-roasted)]/10">
            <iframe
              title="Kopi Siholta"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12438339.054801596!2d80.33203125!3d2.28455066023697!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x302e1702ecca12b9%3A0xddab3e62499da70!2sKopi%20Siholta!5e1!3m2!1sid!2sid!4v1776950518694!5m2!1sid!2sid"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="p-4">
            <h3 class="font-serif font-bold text-[var(--color-dark-brown)]">Kopi Siholta</h3>
            <p class="text-[var(--color-roasted)]/70 text-sm">Lintong Nihuta, Sumatera Utara</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Form input focus styles */
  .form-input:focus {
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(243, 183, 0, 0.15);
    outline: none;
  }

  /* Scroll reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger reveals */
  #contact-header { transition-delay: 0ms; }
  #contact-left .reveal-on-scroll:nth-child(1) { transition-delay: 0ms; }
  #contact-left .reveal-on-scroll:nth-child(2) { transition-delay: 100ms; }
  #contact-form-wrapper { transition-delay: 0ms; }
  #map-section { transition-delay: 0ms; }
</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { once: true, margin: '-80px' }
  );

  document.querySelectorAll('#kontak .reveal-on-scroll').forEach((el) => {
    observer.observe(el);
  });

  // Form submission handler
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');

  if (form && successMsg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Show success, hide form
      form.style.display = 'none';
      successMsg.classList.remove('hidden');
      successMsg.classList.add('animate-fade-in');

      // Reset and restore after 3 seconds
      setTimeout(() => {
        form.reset();
        successMsg.classList.add('hidden');
        form.style.display = 'block';
      }, 3000);
    });
  }
</script>

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>