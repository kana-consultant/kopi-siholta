---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kopi Siholta | Produsen Kopi Khas Danau Toba - Jual Kopi Kemasan Premium',
  description = 'Kopi Siholta - Produsen kopi khas Danau Toba dari Lintong Nihuta, Sumatera Utara. Jual kopi kemasan premium Arabika & Robusta untuk wholesale, bisnis, dan ekspor. Buka kesempatan kemitraan franchise.'
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1C0F07" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- DNS Prefetch for external resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preconnect for faster connections -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload critical font subset for LCP -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap" media="print" onload="this.media='all'" />

    <!-- Critical CSS - Inlined for instant FCP -->
    <style>
      /* System fonts for instant render - matches Tailwind defaults */
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #1C0F07;
        color: #F5E6D3;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      /* Critical hero styles for LCP */
      h1 {
        font-size: clamp(2.5rem, 8vw, 5rem);
        line-height: 1.1;
        margin: 0 0 1.5rem 0;
        font-weight: 700;
      }
      /* Prevent CLS with min-height */
      #beranda {
        min-height: 100vh;
      }
      /* Hero text gradient for LCP */
      .hero-gradient {
        background: linear-gradient(135deg, #F3B700, #C17F3C, #CD1222);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      /* Critical animation - instant */
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      /* Loading skeleton */
      .skeleton {
        background: linear-gradient(90deg, #2a1a0f 25%, #3d2a1a 50%, #2a1a0f 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
      }
      @keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
    </style>

    <!-- Font loading: Load fonts async, apply when ready -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    </noscript>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="kopi siholta, kopi lintong, kopi danau toba, kopi kemasan premium,kopi export, kopi arabika sumatera, bisnis kopi" />
    <meta name="author" content="PT. Siholta Toba Indonesia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.kopisiholta.com/" />

    <!-- Open Graph -->
    <meta property="og:title" content="Kopi Siholta | Produsen Kopi Khas Danau Toba" />
    <meta property="og:description" content="Jual kopi kemasan premium dari Lintong Nihuta. Tersedia Arabika & Robusta untuk wholesale, ekspor, dan kemitraan franchise." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.kopisiholta.com/" />
    <meta property="og:site_name" content="Kopi Siholta" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Kopi Siholta | Produsen Kopi Khas Danau Toba" />
    <meta name="twitter:description" content="Jual kopi kemasan premium untuk wholesale, ekspor, dan kemitraan." />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Kopi Siholta",
        "alternateName": "PT. Siholta Toba Indonesia",
        "url": "https://www.kopisiholta.com",
        "logo": "https://www.kopisiholta.com/favicon.svg",
        "description": "Produsen kopi khas Danau Toba dari Lintong Nihuta, Sumatera Utara",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Lintong Nihuta",
          "addressRegion": "Sumatera Utara",
          "addressCountry": "ID"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+6281322518527",
          "contactType": "sales"
        }
      }
    </script>
  </head>
  <body class="grain-overlay">
    <slot />
  </body>
</html>
