---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../images/logo/logo-siholta.png';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title = "Kopi Siholta | Indonesia's Specialty Coffee Pioneer",
  description = "PT Siholta Toba Indonesia is Indonesia's first specialty coffee producer and exporter from Sumatera Lintong, Humbang Hasundutan, North Sumatra.",
  lang = 'en',
  breadcrumbs,
} = Astro.props;

const canonicalURL = Astro.url.href;

const SITE_ORIGIN = 'https://www.kopisiholta.com';

const logoAbsURL = new URL(logo.src, Astro.site ?? SITE_ORIGIN).href;
const ogImageAbsURL = `${SITE_ORIGIN}/og.png`;

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const langPrefixes = ['en', 'id', 'fr'];
const currentLang = pathSegments[0];

const pageSlug = langPrefixes.includes(currentLang) ? pathSegments.slice(1) : pathSegments;
const slugPath = pageSlug.length === 0 ? '' : '/' + pageSlug.join('/'); 
const localizedPath = (l: string) => `/${l}${slugPath}`;

const HREFLANG_LOCALES = [
  { code: 'id', url: `${SITE_ORIGIN}${localizedPath('id')}` },
  { code: 'en', url: `${SITE_ORIGIN}${localizedPath('en')}` },
];

const ENABLE_FR = true;
if (ENABLE_FR) {
  HREFLANG_LOCALES.push({ code: 'fr', url: `${SITE_ORIGIN}${localizedPath('fr')}` });
}

const X_DEFAULT_URL = `${SITE_ORIGIN}${localizedPath('en')}`;
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1C0F07" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="kopi siholta, kopi lintong, kopi danau toba, kopi kemasan premium, kopi export, kopi arabika sumatera, bisnis kopi" />
    <meta name="author" content="PT. Siholta Toba Indonesia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    {HREFLANG_LOCALES.map(l => (
      <link rel="alternate" hreflang={l.code} href={l.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={X_DEFAULT_URL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageAbsURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kopi Siholta — Specialty Coffee from Lake Toba, Sumatera Lintong" />
    <meta property="og:site_name" content="Kopi Siholta" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : lang === 'fr' ? 'fr_FR' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/png" href={logo.src}  />
    <link rel="shortcut icon" type="image/x-icon" href={logo.src}  />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <style>
      .global-page-loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: #F9F9F9; 
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease-in-out;
        padding: 1rem;
        box-sizing: border-box;
        overflow-y: auto;
      }

      .global-page-loader.is-active {
        opacity: 1;
        pointer-events: auto;
      }

      .skeleton-placeholder {
        background: linear-gradient(90deg, #EBEBEB 25%, #F5F5F5 50%, #EBEBEB 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite linear;
        border-radius: 4px;
      }

      @keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      .skeleton-layout {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
      }

      .sk-navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 0.5rem 0;
        border-bottom: 1px solid #EAEAEA;
      }
      .sk-logo-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .sk-logo-text {
        width: 120px;
        height: 20px;
      }
      .sk-navitems {
        display: flex;
        gap: 1rem;
        align-items: center;
      }
      .sk-cart {
        width: 80px;
        height: 32px;
        border-radius: 6px;
      }
      .sk-btn-save {
        width: 65px;
        height: 32px;
        border-radius: 6px;
      }

      .sk-subnav {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
      }
      .sk-subnav-item {
        width: 90px;
        height: 16px;
        flex-shrink: 0;
      }

      .sk-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-align: center;
        margin: 1rem auto 0 auto;
        width: 100%;
        max-width: 600px;
      }
      .sk-title-large {
        width: 40%;
        height: 24px;
      }
      .sk-title-sub {
        width: 80%;
        height: 14px;
      }

      .sk-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .sk-card {
        background: #FFFFFF;
        border: 1px solid #EAEAEA;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .sk-card-image {
        width: 100%;
        height: 200px;
        border-radius: 0;
      }
      .sk-card-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .sk-line-long {
        width: 70%;
        height: 14px;
      }
      .sk-line-medium {
        width: 85%;
        height: 12px;
      }
      .sk-line-short {
        width: 50%;
        height: 12px;
      }
      .sk-card-footer {
        height: 40px;
        margin-top: 0.5rem;
        width: 100%;
        border-radius: 0;
      }

      @media (min-width: 768px) {
        .global-page-loader {
          padding: 2rem;
        }
        .sk-subnav {
          gap: 2.5rem;
        }
        .sk-subnav-item {
          width: 110px;
        }
        .sk-grid {
          grid-template-columns: repeat(3, 1fr);
          gap: 2rem;
        }
      }
    </style>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Mono:wght@400&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Mono:wght@400&display=swap" />
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PT Siholta Toba Indonesia",
      "alternateName": "Kopi Siholta",
      "url": "https://www.kopisiholta.com",
      "logo": logoAbsURL,
      "description": "First specialty coffee producer and exporter from Sumatera Lintong, Indonesia.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Lubang Buaya Raya No.50, RT.2/RW.9, Lubang Buaya",
        "addressLocality": "Jakarta Timur",
        "addressRegion": "DKI Jakarta",
        "postalCode": "13810",
        "addressCountry": "ID"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+6281322518527",
        "contactType": "sales",
        "email": "info@kopisiholta.com",
        "areaServed": ["ID", "US", "JP", "KR", "AE", "HK", "NL", "ZA"]
      },
      "sameAs": [
        "https://www.instagram.com/kopisiholta",
        "https://www.tokopedia.com/kopisiholta",
        "https://shopee.co.id/kopisiholta"
      ]
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Kopi Siholta",
      "alternateName": "PT Siholta Toba Indonesia",
      "url": "https://www.kopisiholta.com",
      "inLanguage": ["id", "en"],
      "publisher": {
        "@type": "Organization",
        "name": "PT Siholta Toba Indonesia",
        "logo": logoAbsURL
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.kopisiholta.com/{lang}/#products"
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    {breadcrumbs && breadcrumbs.length > 0 && (() => {
      const pageLang = lang === 'id' ? 'id-ID' : lang === 'fr' ? 'fr-FR' : 'en-US';
      return (<>
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": title,
          "description": description,
          "url": canonicalURL,
          "inLanguage": pageLang,
          "isPartOf": {
            "@id": `https://www.kopisiholta.com${slugPath.startsWith('/') ? slugPath : '/' + slugPath}`
          }
        })} />
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumbs.map((b, idx) => ({
            "@type": "ListItem",
            "position": idx + 1,
            "name": b.name,
            "item": b.href.startsWith("http") ? b.href : `https://www.kopisiholta.com${b.href}`
          }))
        })} />
      </>);
    })()}

  <GoogleAnalytics />
    
  </head>
  <body class="grain-overlay">
    
    <div id="global-page-loader" class="global-page-loader is-active" aria-hidden="true">
      <div class="skeleton-layout">
        
        <div class="sk-navbar">
          <div class="sk-logo-group">
            <div class="sk-logo-text skeleton-placeholder"></div>
          </div>
          <div class="sk-navitems">
            <div class="sk-cart skeleton-placeholder"></div>
            <div class="sk-btn-save skeleton-placeholder"></div>
          </div>
        </div>

        <div class="sk-subnav">
          <div class="sk-subnav-item skeleton-placeholder"></div>
          <div class="sk-subnav-item skeleton-placeholder"></div>
          <div class="sk-subnav-item skeleton-placeholder"></div>
          <div class="sk-subnav-item skeleton-placeholder"></div>
        </div>
        
        <div class="sk-hero">
          <div class="sk-title-large skeleton-placeholder"></div>
          <div class="sk-title-sub skeleton-placeholder"></div>
        </div>

        <div class="sk-grid">
          <div class="sk-card">
            <div class="sk-card-image skeleton-placeholder"></div>
            <div class="sk-card-body">
              <div class="sk-line-long skeleton-placeholder"></div>
              <div class="sk-line-medium skeleton-placeholder"></div>
              <div class="sk-line-short skeleton-placeholder"></div>
            </div>
            <div class="sk-card-footer skeleton-placeholder"></div>
          </div>

          <div class="sk-card">
            <div class="sk-card-image skeleton-placeholder"></div>
            <div class="sk-card-body">
              <div class="sk-line-long skeleton-placeholder"></div>
              <div class="sk-line-medium skeleton-placeholder"></div>
              <div class="sk-line-short skeleton-placeholder"></div>
            </div>
            <div class="sk-card-footer skeleton-placeholder"></div>
          </div>

          <div class="sk-card">
            <div class="sk-card-image skeleton-placeholder"></div>
            <div class="sk-card-body">
              <div class="sk-line-long skeleton-placeholder"></div>
              <div class="sk-line-medium skeleton-placeholder"></div>
              <div class="sk-line-short skeleton-placeholder"></div>
            </div>
            <div class="sk-card-footer skeleton-placeholder"></div>
          </div>

          <div class="sk-card">
            <div class="sk-card-image skeleton-placeholder"></div>
            <div class="sk-card-body">
              <div class="sk-line-long skeleton-placeholder"></div>
              <div class="sk-line-medium skeleton-placeholder"></div>
              <div class="sk-line-short skeleton-placeholder"></div>
            </div>
            <div class="sk-card-footer skeleton-placeholder"></div>
          </div>

          <div class="sk-card">
            <div class="sk-card-image skeleton-placeholder"></div>
            <div class="sk-card-body">
              <div class="sk-line-long skeleton-placeholder"></div>
              <div class="sk-line-medium skeleton-placeholder"></div>
              <div class="sk-line-short skeleton-placeholder"></div>
            </div>
            <div class="sk-card-footer skeleton-placeholder"></div>
          </div>

          <div class="sk-card">
            <div class="sk-card-image skeleton-placeholder"></div>
            <div class="sk-card-body">
              <div class="sk-line-long skeleton-placeholder"></div>
              <div class="sk-line-medium skeleton-placeholder"></div>
              <div class="sk-line-short skeleton-placeholder"></div>
            </div>
            <div class="sk-card-footer skeleton-placeholder"></div>
          </div>
        </div>

      </div>
    </div>

    <slot />

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      const pageLoader = document.getElementById('global-page-loader');

      const hideLoader = () => {
        pageLoader?.classList.remove('is-active');
      };

      window.addEventListener('load', hideLoader);
      window.addEventListener('pageshow', hideLoader);

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const anchor = target.closest('a');

        if (!anchor) return;

        const href = anchor.getAttribute('href');
        const targetAttr = anchor.getAttribute('target');

        if (
          targetAttr === '_blank' || 
          !href || 
          href.startsWith('#') || 
          href.includes('#') || 
          href.startsWith('tel:') || 
          href.startsWith('mailto:') ||
          href.startsWith('https://wa.me')
        ) {
          return;
        }

        pageLoader?.classList.add('is-active');
      });
    </script>

  </body>
</html>